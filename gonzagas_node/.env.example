# ─── Ambiente ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Base de dados (MariaDB) ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gonzagas_prod
DB_USER=gonzagas_user
DB_PASSWORD=CHANGE_ME
DB_SSL=false

# ─── Sessão ────────────────────────────────────────────────────────────────────
SESSION_SECRET=CHANGE_ME_USE_RANDOM_64_CHARS

# ─── Protecção do site (acesso público) ────────────────────────────────────────
# Activa automaticamente só quando NODE_ENV=production
# Em development o site fica aberto (sem ecrã de password)
SITE_PASSWORD=0009

# ─── URLs ──────────────────────────────────────────────────────────────────────
BASE_URL=https://artnshine.pt
PUBLIC_URL=https://artnshine.pt
SITE_URL=https://artnshine.pt

# ─── Google Analytics 4 ────────────────────────────────────────────────────────
GA_TRACKING_ID=G-VYM82NFR22

# ─── Google OAuth (login clientes) ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-CHANGE_ME
GOOGLE_CALLBACK_URL=https://artnshine.pt/account/auth/google/callback

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
# OBRIGATÓRIO desde que a conta passou a ser precisa para finalizar a compra:
# sem isto não é possível enviar o link de recuperação de password, e quem
# perder a password fica sem forma de comprar. A página de recuperação detecta
# a ausência e avisa o cliente, em vez de fingir que enviou o email.
# Também é o que faz sair as notificações de encomenda para o admin.
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=Gonzaga Art & Shine <geral@artnshine.pt>

# ─── Stripe (pagamentos) ───────────────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# ─── Instagram ─────────────────────────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=CHANGE_ME
INSTAGRAM_USER_ID=CHANGE_ME

# ─── Opcionais ─────────────────────────────────────────────────────────────────
