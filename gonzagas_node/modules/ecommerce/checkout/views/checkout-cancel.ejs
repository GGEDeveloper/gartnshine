<link rel="stylesheet" href="/ecommerce/css/checkout.css">
<section class="ecommerce-cancel-page container py-5 text-center">
  <h1>Pagamento cancelado</h1>
  <% if (order) { %>
    <p>O pedido <strong><%= order.order_number %></strong> ficou pendente de pagamento.</p>
  <% } %>
  <p>Pode tentar novamente ou contactar-nos via WhatsApp.</p>
  <a href="/checkout" class="btn btn-primary mt-3">Voltar ao checkout</a>
</section>
