<link rel="stylesheet" href="/ecommerce/css/checkout.css">
<section class="ecommerce-success-page container py-5 text-center">
  <h1>Pedido recebido</h1>
  <% if (order) { %>
    <p>Obrigado! O seu pedido <strong><%= order.order_number %></strong> foi registado.</p>
    <p>Total: €<%= parseFloat(order.total_amount).toFixed(2) %></p>
    <% if (order.payment_status === 'pending') { %>
      <p class="text-muted">Pagamento pendente — entraremos em contacto em breve.</p>
    <% } else { %>
      <p class="text-success">Pagamento confirmado.</p>
    <% } %>
    <% if (typeof customerLoggedIn !== 'undefined' && !customerLoggedIn && order.customer_email) { %>
      <p class="account-success-register mt-3">
        <a href="/account/register?email=<%= encodeURIComponent(order.customer_email) %>&returnTo=/account/orders" class="account-nav-banner-cta">Criar conta</a>
        com este email para acompanhar o pedido <strong><%= order.order_number %></strong>.
      </p>
    <% } else if (typeof customerLoggedIn !== 'undefined' && customerLoggedIn) { %>
      <p class="account-nav-hint mt-3"><a href="/account/orders">Ver todos os meus pedidos</a></p>
    <% } %>
  <% } else { %>
    <p>Obrigado pela sua compra.</p>
  <% } %>
  <a href="/catalog" class="btn btn-outline-light mt-3">Continuar a comprar</a>
</section>

<script>
if (typeof gtag === 'function' && <%= order ? 'true' : 'false' %>) {
  gtag('event', 'purchase', {
    transaction_id: '<%= order ? order.order_number : '' %>',
    value: <%= order ? parseFloat(order.total_amount) : 0 %>,
    currency: 'EUR'
  });
}
</script>
