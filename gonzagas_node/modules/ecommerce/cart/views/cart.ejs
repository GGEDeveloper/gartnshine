<section class="ecommerce-cart-page">
  <div class="container py-4">
    <h1>Carrinho</h1>

    <% if (!cart.items.length) { %>
      <p class="text-muted">O carrinho está vazio.</p>
      <a href="/catalog" class="btn btn-outline-light">Ver catálogo</a>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-dark table-striped align-middle">
          <thead>
            <tr>
              <th>Produto</th>
              <th>Preço</th>
              <th>Qtd</th>
              <th>Total</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="cart-items-body">
            <% cart.items.forEach(function(item) { %>
              <tr data-product-id="<%= item.productId %>">
                <td data-label="Produto"><%= item.name %></td>
                <td data-label="Preço unit.">€<%= item.unitPrice.toFixed(2) %></td>
                <td data-label="Quantidade">
                  <input type="number" min="1" max="<%= item.maxStock %>" value="<%= item.quantity %>"
                         class="form-control form-control-sm cart-qty-input" style="max-width:80px">
                </td>
                <td data-label="Total">€<%= item.totalPrice.toFixed(2) %></td>
                <td data-label="">
                  <button type="button" class="btn btn-sm btn-outline-danger cart-remove-btn">Remover</button>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <div class="cart-summary mt-3">
        <p>Subtotal: <strong>€<%= totals.subtotal.toFixed(2) %></strong></p>
        <% if (totals.taxAmount > 0) { %>
          <p>IVA (<%= totals.taxRate %>%<%= totals.pricesIncludeTax ? ' incl.' : '' %>): €<%= totals.taxAmount.toFixed(2) %></p>
        <% } %>
        <p class="h5">Total estimado: €<%= totals.total.toFixed(2) %></p>
        <a href="/checkout" class="btn btn-primary mt-2">Finalizar compra</a>
      </div>
    <% } %>
  </div>
</section>

<link rel="stylesheet" href="/ecommerce/css/cart.css">
<script src="/ecommerce/js/shopping-cart.js"></script>
