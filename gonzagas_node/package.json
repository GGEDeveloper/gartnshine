{
  "name": "gonzagas_node",
  "version": "1.0.0",
  "description": "Gonzaga's Art & Shine - Sterling silver jewelry catalog and admin panel",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup": "node scripts/setup.js",
    "db:init": "node scripts/init-db.js",
    "db:reset": "node scripts/init-db.js",
    "db:migrate": "node scripts/run-migrations.js",
    "db:test": "node -e 'require(\"./config/database\").testConnection().then(console.log).catch(console.error)'",
    "db:create-cookie-table": "node scripts/create-cookie-table.js",
    "db:create-user-rights-table": "node scripts/create-user-rights-table.js",
    "db:create-audit-logs-table": "node scripts/create-audit-logs-table.js",
    "backup": "node scripts/backup-system.js backup",
    "backup:list": "node scripts/backup-system.js list",
    "backup:restore": "node scripts/backup-system.js restore"
  },
  "keywords": [
    "jewelry",
    "catalog",
    "silver",
    "boho",
    "bali"
  ],
  "author": "Gonzaga's Art & Shine",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "connect-flash": "^0.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "express-ejs-layouts": "^2.5.1",
    "express-messages": "^1.0.1",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.13.0",
    "nodemailer": "^7.0.5",
    "readline-sync": "^1.4.10",
    "sharp": "^0.34.4",
    "uuid": "^9.0.1",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
