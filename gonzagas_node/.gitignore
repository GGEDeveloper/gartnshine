# ============================================
# .gitignore - Gonzaga's Art & Shine
# ============================================
# Atualizado: 2026-02-18 (Fase 4)
# Previne versionamento de ficheiros temporários,
# backups, dumps SQL e dados sensíveis
# ============================================

# ============================================
# NODE.JS
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.npm
.yarn-integrity

# ============================================
# AMBIENTE E CONFIGURAÇÕES SENSÍVEIS
# ============================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
config/local.js
config/credentials.js

# ============================================
# DATABASE - SQL DUMPS
# ============================================
# Dumps SQL na raiz (exceto estrutura essencial)
*.sql
!import_essential_only.sql
!database/schema/*.sql
!database/migrations/*.sql

# Pasta backups (dumps automáticos)
backups/*.sql
backups/**/*.sql

# Dumps arquivados (já versionados em _archive)
_archive/sql-dumps-archived/**/*.sql

# ============================================
# FICHEIROS DE TESTE TEMPORÁRIOS
# ============================================
# Testes one-off (devem ir para _archive se importantes)
test-*.js
test_*.js
test-*.html
*.test.tmp.js

# Exceto testes oficiais
!tests/**/*.test.js
!__tests__/**/*.test.js

# ============================================
# BACKUPS E VERSÕES ANTIGAS
# ============================================
*.backup
*.bak
*.old
*.orig
*~
*.swp
*.swo
.DS_Store

# Backups de ficheiros específicos
*.ejs.backup
*.js.old
*.css.backup

# ============================================
# LOGS E DEBUG
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
pids/
*.pid
*.seed
*.pid.lock

# ============================================
# SISTEMA OPERATIVO
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ============================================
# IDEs E EDITORES
# ============================================
# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Cursor AI
.cursor/
.cursorignore

# JetBrains IDEs
.idea/
*.iml
*.ipr
*.iws
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]

# ============================================
# BUILD E COMPILAÇÃO
# ============================================
dist/
build/
out/
.cache/
.parcel-cache/
.next/
.nuxt/
.vuepress/dist/

# ============================================
# UPLOADS E MEDIA (se temporários)
# ============================================
# Descomentar se uploads não devem ser versionados
# public/uploads/temp/*
# public/uploads/cache/*

# ============================================
# DEPENDÊNCIAS E CACHE
# ============================================
# Bower
bower_components/

# Grunt
.grunt/

# TypeScript
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# ============================================
# SERVERLESS E CLOUD
# ============================================
.serverless/
.fusebox/
.dynamodb/
.tern-port
.vercel
.netlify/

# ============================================
# TESTES E COVERAGE
# ============================================
coverage/
*.lcov
.nyc_output/
junit.xml

# ============================================
# TEMPORÁRIOS DO PROJETO
# ============================================
# Scripts de teste já executados (mover para _archive)
fase*-test.sh
temp-*.js
tmp/
temp/

# Ficheiros de debug
debug-*.js
debug-*.log

# CSS audit artifacts (backups + screenshots from Fase 3)
docs/css-audit/

# ============================================
# CREDENCIAIS E CERTIFICADOS
# ============================================
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# SSH keys
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# ============================================
# ESPECÍFICO DO PROJETO
# ============================================
# Scripts de deploy sensíveis (se houver)
# deploy-secrets.sh

# Dumps de produção com dados reais
*production*.sql
*prod*.sql

# Configs de servidor
# .htaccess.local

# ============================================
# EXCEÇÕES (ficheiros que DEVEM ser versionados)
# ============================================
# Estrutura essencial SQL
!import_essential_only.sql

# Schemas e migrations
!database/schema/*.sql
!database/migrations/*.sql

# Configs exemplo
!config/example.env
!.env.example

# ============================================
# ARQUIVO (já versionado)
# ============================================
# Pasta _archive é versionada (histórico)
# Mas SQL dumps dentro dela não precisam reindexar
_archive/**/*.sql

# ============================================
# NOTAS FINAIS
# ============================================
# Este .gitignore protege:
# ✓ Credenciais e dados sensíveis
# ✓ Ficheiros temporários e de teste
# ✓ Backups e versões antigas
# ✓ Logs e cache
# ✓ Dumps SQL de produção
#
# Mantém versionado:
# ✓ Estrutura SQL essencial
# ✓ Migrations de DB
# ✓ Configs de exemplo
# ✓ Arquivo histórico (_archive)
# ✓ Documentação
# ============================================
