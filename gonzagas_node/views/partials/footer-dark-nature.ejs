<!-- JavaScript para Newsletter e Interações -->
<script>
(function() {
    'use strict';
    
    // Newsletter subscription
    window.subscribeNewsletter = function(event) {
        event.preventDefault();
        
        const form = event.target;
        const emailInput = form.querySelector('input[type="email"]');
        const submitButton = form.querySelector('button[type="submit"]');
        const originalText = submitButton.textContent;
        
        // Visual feedback
        submitButton.textContent = 'A subscrever...';
        submitButton.disabled = true;
        
        // Simular subscription (integrar com serviço real)
        setTimeout(() => {
            submitButton.textContent = 'Subscrito!';
            submitButton.style.background = 'var(--forest)';
            emailInput.value = '';
            
            // Analytics tracking
            if (typeof gtag !== 'undefined') {
                gtag('event', 'newsletter_subscribe', {
                    method: 'footer_form',
                    email_domain: emailInput.value.split('@')[1] || 'unknown'
                });
            }
            
            setTimeout(() => {
                submitButton.textContent = originalText;
                submitButton.style.background = 'var(--gold-old)';
                submitButton.disabled = false;
            }, 3000);
            
        }, 1000);
    };
    
    // Footer link tracking
    document.querySelectorAll('.footer-link').forEach(link => {
        link.addEventListener('click', function() {
            const linkText = this.textContent.trim();
            const section = this.closest('.footer-section')?.querySelector('.footer-section__title')?.textContent || 'Unknown';
            
            if (typeof gtag !== 'undefined') {
                gtag('event', 'footer_link_click', {
                    link_text: linkText,
                    footer_section: section,
                    link_url: this.href
                });
            }
        });
    });
    
    // Social media tracking
    document.querySelectorAll('.footer-social-link').forEach(link => {
        link.addEventListener('click', function() {
            const platform = this.href.includes('instagram') ? 'Instagram' : 
                           this.href.includes('facebook') ? 'Facebook' : 
                           this.href.includes('wa.me') ? 'WhatsApp' : 'Unknown';
            
            if (typeof gtag !== 'undefined') {
                gtag('event', 'social_media_click', {
                    platform: platform,
                    location: 'footer'
                });
            }
        });
    });
    
    // Stone collection tracking
    document.querySelectorAll('.footer-link--onyx, .footer-link--tiger').forEach(link => {
        link.addEventListener('click', function() {
            const stoneType = this.classList.contains('footer-link--onyx') ? 'onix' : 'olho-de-tigre';
            
            if (typeof gtag !== 'undefined') {
                gtag('event', 'stone_collection_click', {
                    stone_type: stoneType,
                    location: 'footer'
                });
            }
        });
    });
    
})();
</script>

<!-- =============================================
     CSS INLINE PARA NEWSLETTER
     (Será movido para components se necessário)
     ============================================= -->
<style>
.footer-newsletter-input:focus {
    outline: none;
    border-color: var(--gold-old);
    box-shadow: 0 0 0 1px rgba(176,141,87,0.3);
}

.footer-newsletter-input::placeholder {
    color: var(--slate);
    opacity: 0.7;
}

/* Animation for successful subscription */
@keyframes success-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
}

.footer-social-link:hover {
    animation: success-pulse 0.3s ease;
}

/* Responsive footer adjustments */
@media (max-width: 480px) {
    .footer-brand__description {
        font-size: 0.875rem;
        line-height: 1.5;
    }
    
    .footer-trust {
        flex-direction: column !important;
        gap: var(--space-sm) !important;
    }
    
    .footer-social {
        justify-content: center;
    }
    
    .footer-bottom {
        font-size: 0.75rem;
        line-height: 1.4;
    }
}
</style>

