<div class="product-card" data-name="<%= product.name ? product.name.toLowerCase() : '' %>" data-product-id="<%= product.id %>">
  <div class="product-image">
    <%
      // O cartão liga à FICHA DO PRODUTO. Antes ligava a `/loja?family=N`,
      // o que levava quem clicasse numa peça para uma listagem — e nem sequer
      // filtrava, porque o catálogo lê `families` (plural) e isto mandava
      // `family`. A ramificação alternativa (abrir a imagem em lightbox) só
      // era usada por um ficheiro .backup e foi removida.
      const produtoLink = `/loja/produto/${product.slug || product.id}`;
      const cardImg = productImg(product.image_url, 'small');
    %>

    <a href="<%= produtoLink %>" class="d-block mb-2" aria-label="Ver <%= product.name %>">
      <picture>
        <% if (cardImg.webp) { %><source srcset="<%= cardImg.webp %>" type="image/webp"><% } %>
        <img src="<%= cardImg.jpg %>" alt="<%= product.name %> — joia artesanal prata 925" loading="lazy" class="img-fluid" onerror="this.onerror=null;this.src='/images/imagem-nao-disponivel.svg'">
      </picture>
    </a>
  </div>
  <div class="product-info">
    <% if (product.reference) { %>
      <p class="product-reference mb-1">Ref: <%= product.reference %></p>
    <% } %>
    <% if (product.family_name) { %>
      <p class="product-family mb-1"><small class="text-highlight"><%= product.family_name %></small></p>
    <% } %>
    <%
      // O nome não aparecia no cartão — só referência, categoria e preço.
      // Quem via uma peça numa categoria não sabia como se chamava.
    %>
    <h3 class="product-name">
      <a href="<%= produtoLink %>"><%= product.name %></a>
    </h3>
    <p class="product-price">
      <% if (typeof siteSettings !== 'undefined' && siteSettings.hide_catalog_prices) { %>
        <span class="text-muted fst-italic">Preço sob consulta</span>
      <% } else { %>
      <% if (product.formatted_sale_price && product.formatted_purchase_price && 
            parseFloat(product.sale_price) < parseFloat(product.purchase_price)) { %>
        <span class="sale-price fw-bold"><%= product.formatted_sale_price %></span>
        <span class="original-price text-muted text-decoration-line-through ms-2">
          <small><%= product.formatted_purchase_price %></small>
        </span>
      <% } else if (product.formatted_sale_price) { %>
        <span class="sale-price"><%= product.formatted_sale_price %></span>
      <% } else { %>
        <span class="text-muted fst-italic">Preço sob consulta</span>
        <% } %>
      <% } %>
    </p>
    <% if (typeof ecommerceEnabled !== 'undefined' && ecommerceEnabled && product.current_stock > 0 && !(typeof siteSettings !== 'undefined' && siteSettings.hide_catalog_prices)) { %>
      <button type="button" class="btn btn-sm btn-outline-light btn-add-to-cart mt-2" data-product-id="<%= product.id %>">
        Adicionar ao carrinho
      </button>
    <% } %>
  </div>
</div>
