<div class="product-item" 
     data-product-id="<%= product.id %>"
     data-aos="fade-up">
  <div class="product-card">
    <div class="product-image-container">
      <%
        const cardImg = productImg(product.image_url, 'small');
        const imageUrl = cardImg.jpg;
        const productLink = `/loja/produto/${product.slug || product.id}`;
      %>
      <a href="<%= productLink %>"
         class="product-image-link">
        <picture>
          <% if (cardImg.webp) { %><source srcset="<%= cardImg.webp %>" type="image/webp"><% } %>
          <%
            // width/height são as dimensões REAIS do ficheiro (as variantes
            // `small` são 400x400). Sem eles o browser não sabe que espaço
            // reservar e a página salta quando cada imagem chega (CLS).
            // O posicionamento vive agora em CSS (.product-image-container),
            // não num atributo `style` com 13 !important.
          %>
          <img src="<%= imageUrl %>"
               alt="<%= product.name %> — joia artesanal prata 925"
               class="product-image lazy-load"
               loading="lazy"
               decoding="async"
               width="400" height="400"
               data-src="<%= imageUrl %>"
               onerror="this.onerror=null;this.src='/images/imagem-nao-disponivel.svg';">
        </picture>
      </a>
    </div>
    <div class="product-info">
      <p class="product-reference">Ref: <%= product.reference || 'N/A' %></p>
      <% if (product.family_name) { %>
        <p class="product-family"><span class="text-highlight"><%= product.family_name %></span></p>
      <% } %>
      <%
        // "€0.00" é uma string verdadeira — quem decide é o número. Sem isto,
        // uma peça sob consulta anunciava-se a zero euros no cartão.
        const semPreco = !product.sale_price || parseFloat(product.sale_price) <= 0;
      %>
      <p class="product-price">
        <% if (semPreco || (typeof siteSettings !== 'undefined' && siteSettings.hide_catalog_prices)) { %>
          <span class="text-muted fst-italic">Preço sob consulta</span>
        <% } else if (product.formatted_sale_price) { %>
          <span class="sale-price"><%= product.formatted_sale_price %></span>
        <% } else { %>
          <span class="text-muted fst-italic">Preço sob consulta</span>
        <% } %>
      </p>
    </div>
  </div>
</div>

