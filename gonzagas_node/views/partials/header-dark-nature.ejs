<!-- JavaScript para Mobile Menu -->
<script>
(function() {
    'use strict';
    
    // Elementos do DOM
    const mobileToggle = document.querySelector('[data-mobile-toggle]');
    const mobileMenu = document.querySelector('[data-mobile-menu]');
    const mobileClose = document.querySelector('[data-mobile-close]');
    const mobileOverlay = document.querySelector('[data-mobile-overlay]');
    const body = document.body;
    
    // Estado do menu
    let isMenuOpen = false;
    
    // Funções de controlo
    function openMenu() {
        isMenuOpen = true;
        mobileToggle.setAttribute('aria-expanded', 'true');
        mobileToggle.setAttribute('aria-label', 'Fechar menu de navegação');
        mobileMenu.setAttribute('aria-hidden', 'false');
        mobileMenu.classList.add('site-header__mobile-menu--open');
        body.classList.add('mobile-menu-open');
        
        // Focus no primeiro item do menu
        const firstMenuItem = mobileMenu.querySelector('.site-header__mobile-menu-link');
        if (firstMenuItem) {
            setTimeout(() => firstMenuItem.focus(), 100);
        }
    }
    
    function closeMenu() {
        isMenuOpen = false;
        mobileToggle.setAttribute('aria-expanded', 'false');
        mobileToggle.setAttribute('aria-label', 'Abrir menu de navegação');
        mobileMenu.setAttribute('aria-hidden', 'true');
        mobileMenu.classList.remove('site-header__mobile-menu--open');
        body.classList.remove('mobile-menu-open');
        
        // Retornar focus ao botão toggle
        mobileToggle.focus();
    }
    
    function toggleMenu() {
        isMenuOpen ? closeMenu() : openMenu();
    }
    
    // Event Listeners
    if (mobileToggle) {
        mobileToggle.addEventListener('click', toggleMenu);
    }
    
    if (mobileClose) {
        mobileClose.addEventListener('click', closeMenu);
    }
    
    if (mobileOverlay) {
        mobileOverlay.addEventListener('click', closeMenu);
    }
    
    // Fechar menu com ESC
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && isMenuOpen) {
            closeMenu();
        }
    });
    
    // Fechar menu ao clicar em links (mobile)
    const mobileMenuLinks = document.querySelectorAll('.site-header__mobile-menu-link');
    mobileMenuLinks.forEach(link => {
        link.addEventListener('click', () => {
            // Delay para permitir navegação
            setTimeout(closeMenu, 100);
        });
    });
    
    // Gerir focus dentro do menu mobile
    const focusableElements = 'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';
    
    document.addEventListener('keydown', function(e) {
        if (!isMenuOpen) return;
        
        if (e.key === 'Tab') {
            const focusable = Array.from(mobileMenu.querySelectorAll(focusableElements))
                .filter(el => el.offsetParent !== null); // Apenas elementos visíveis
            
            const firstFocusable = focusable[0];
            const lastFocusable = focusable[focusable.length - 1];
            
            if (e.shiftKey) {
                if (document.activeElement === firstFocusable) {
                    lastFocusable.focus();
                    e.preventDefault();
                }
            } else {
                if (document.activeElement === lastFocusable) {
                    firstFocusable.focus();
                    e.preventDefault();
                }
            }
        }
    });
    
    // Fechar menu em resize para desktop
    window.addEventListener('resize', function() {
        if (window.innerWidth >= 1024 && isMenuOpen) {
            closeMenu();
        }
    });
    
    // Analytics - Menu Interaction Tracking
    function trackMenuInteraction(action, item) {
        if (typeof gtag !== 'undefined') {
            gtag('event', 'menu_interaction', {
                menu_action: action,
                menu_item: item,
                device_type: window.innerWidth >= 1024 ? 'desktop' : 'mobile'
            });
        }
    }
    
    // Track desktop menu clicks
    document.querySelectorAll('.site-header__menu-link').forEach(link => {
        link.addEventListener('click', function() {
            const menuText = this.querySelector('.site-header__menu-text').textContent;
            trackMenuInteraction('click', menuText);
        });
    });
    
    // Track mobile menu clicks
    mobileMenuLinks.forEach(link => {
        link.addEventListener('click', function() {
            const menuText = this.querySelector('.site-header__mobile-menu-text').textContent;
            trackMenuInteraction('mobile_click', menuText);
        });
    });
    
})();
</script>

<!-- =============================================
     CSS INLINE CRÍTICO PARA HEADER
     (Será movido para components-dark-nature.css)
     ============================================= -->
<style>
/* Prevent FOUC */
.site-header { opacity: 1; }
.mobile-menu-open { overflow: hidden; }

/* Basic mobile menu styles */
.site-header__mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background: var(--black);
    transform: translateX(-100%);
    transition: transform var(--duration-normal) var(--ease-out);
    z-index: var(--z-modal);
}

.site-header__mobile-menu--open {
    transform: translateX(0);
}

@media (min-width: 1024px) {
    .site-header__mobile-toggle,
    .site-header__mobile-menu {
        display: none;
    }
}

@media (max-width: 1023px) {
    .site-header__menu {
        display: none;
    }
}
</style>