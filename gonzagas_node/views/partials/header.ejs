<header class="main-header">
  <div class="header-container">
    <nav class="main-nav">
      <button class="menu-toggle" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
      
      <ul class="nav-menu">
        <li><a href="/" class="<%= typeof title !== 'undefined' && title === 'Home' ? 'active' : '' %>">Home</a></li>
        
        <!-- Collections link -->
        <li><a href="/collections" class="<%= typeof title !== 'undefined' && title === 'Collections' ? 'active' : '' %>">Gallery</a></li>
        
        <!-- Catalog link -->
        <li><a href="/catalog" class="<%= typeof title !== 'undefined' && title === 'Catalog' ? 'active' : '' %>">Catalog</a></li>
        
        <li><a href="/about" class="<%= typeof title !== 'undefined' && title === 'About Gonzaga\'s Art & Shine' ? 'active' : '' %>">About</a></li>
        
        <% if (typeof user !== 'undefined' && user) { %>
          <li class="dropdown admin-menu">
            <a href="/admin" class="dropdown-toggle">Admin</a>
            <ul class="dropdown-menu">
              <li><a href="/admin/dashboard">Dashboard</a></li>
              <li><a href="/admin/products">Products</a></li>
              <li><a href="/admin/families">Categories</a></li>
              <li><a href="/admin/inventory">Inventory</a></li>
              <li><a href="/admin/checkpoints">Checkpoints</a></li>
              <li><a href="/admin/logout">Logout</a></li>
            </ul>
          </li>
        <% } else { %>
          <!-- Hidden admin link that only shows on hover, providing subtle access -->
          <li class="admin-link"><a href="/admin/login">Admin</a></li>
        <% } %>
      </ul>
    </nav>

    <div class="logo-container">
      <a href="/" class="logo">
        <h1><%= typeof siteTitle !== 'undefined' ? siteTitle : 'Gonzaga\'s Art & Shine' %></h1>
      </a>
    </div>
  </div>
</header>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Toggle mobile menu
  const menuToggleButton = document.querySelector('.menu-toggle');
  const navMenu = document.querySelector('.nav-menu');

  // console.log('[DEBUG DOMContentLoaded] Menu Toggle Button:', menuToggleButton);
  // console.log('[DEBUG DOMContentLoaded] Nav Menu:', navMenu);

  let isMenuOpen = false; // Standard: menu starts closed.

  if (menuToggleButton && navMenu) {
    // Initial sync: If JS assumes menu is open, but button is hamburger, make button active (X)
    // However, the user describes the button starting as hamburger while panel is open.
    // So, the first click should make isMenuOpen = false, remove active from panel (closing it),
    // and remove active from button (keeping it hamburger, which is correct for closed state).

    menuToggleButton.addEventListener('click', function() {
      isMenuOpen = !isMenuOpen; // Toggle state

      if (isMenuOpen) {
        // This state means: Menu should be OPEN, Button should be X
        navMenu.classList.add('active');
        this.classList.add('active');
        console.log('[DEBUG Click] State: OPEN. navMenu:', navMenu.classList.toString(), 'Button:', this.classList.toString());
      } else {
        // This state means: Menu should be CLOSED, Button should be Hamburger
        navMenu.classList.remove('active');
        this.classList.remove('active');
        console.log('[DEBUG Click] State: CLOSED. navMenu:', navMenu.classList.toString(), 'Button:', this.classList.toString());
      }
    });
  } else {
    console.error('[DEBUG DOMContentLoaded] Menu toggle button or nav menu not found!');
  }
  
  // Handle dropdowns
  document.querySelectorAll('.dropdown-toggle').forEach(toggle => {
    toggle.addEventListener('click', function(e) {
      e.preventDefault();
      this.parentNode.classList.toggle('open');
    });
  });
});
</script>