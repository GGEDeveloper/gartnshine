<header class="main-header">
  <div class="header-container">
    <!-- Logo - primeiro para não sobrepor -->
    <div class="logo-container">
      <a href="/" class="logo">
        <h1><%= typeof siteTitle !== 'undefined' ? siteTitle : 'Gonzaga\'s Art & Shine' %></h1>
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="main-nav desktop-nav">
      <ul class="nav-menu">
        <li><a href="/" class="<%= typeof title !== 'undefined' && title === 'Home' ? 'active' : '' %>">Home</a></li>
        
        <!-- Collections link -->
        <li><a href="/collections" class="<%= typeof title !== 'undefined' && title === 'Collections' ? 'active' : '' %>">Gallery</a></li>
        
        <!-- Catalog link -->
        <% if (typeof siteSettings !== 'undefined' && siteSettings.catalog_page_enabled) { %>
        <li><a href="/catalog" class="<%= typeof title !== 'undefined' && title === 'Catalog' ? 'active' : '' %>">Catalog</a></li>
        <% } %>
        
        <li><a href="/about" class="<%= typeof title !== 'undefined' && title === 'About Gonzaga\'s Art & Shine' ? 'active' : '' %>">About</a></li>
        
        <% if (typeof user !== 'undefined' && user) { %>
          <li class="dropdown admin-menu">
            <a href="/admin" class="dropdown-toggle">Admin</a>
            <ul class="dropdown-menu">
              <li><a href="/admin/dashboard">Dashboard</a></li>
              <li><a href="/admin/products">Products</a></li>
              <li><a href="/admin/families">Categories</a></li>
              <li><a href="/admin/inventory">Inventory</a></li>
              <li><a href="/admin/checkpoints">Checkpoints</a></li>
              <li><a href="/admin/settings">Settings</a></li>
              <li><a href="/admin/logout">Logout</a></li>
            </ul>
          </li>
        <% } else { %>
          <!-- Hidden admin link that only shows on hover, providing subtle access -->
          <li class="admin-link"><a href="/admin/login">Admin</a></li>
        <% } %>
      </ul>
    </nav>

    <!-- Search: desktop full bar, mobile icon that expands -->
    <div class="header-search-wrapper">
      <button type="button" class="mobile-search-toggle" id="mobile-search-toggle" aria-label="Abrir pesquisa" aria-expanded="false">
        <i class="fas fa-search" aria-hidden="true"></i>
      </button>
      <div class="header-search" id="header-search">
        <input type="search" name="search" class="search-input" placeholder="Pesquisar produtos..." autocomplete="off" aria-label="Pesquisar produtos">
        <button type="button" class="mobile-search-close" id="mobile-search-close" aria-label="Fechar pesquisa">
          <i class="fas fa-times" aria-hidden="true"></i>
        </button>
      </div>
    </div>
    
    <% if (typeof ecommerceEnabled !== 'undefined' && ecommerceEnabled) { %>
    <a href="/cart" class="header-cart-link" aria-label="Carrinho">
      <i class="fas fa-shopping-cart"></i>
      <span class="header-cart-badge" style="display:none">0</span>
    </a>
    <%- include('_customerAccountNav') %>
    <% } %>

    <!-- Mobile Navigation Toggle -->
    <button class="mobile-nav-toggle" id="mobile-nav-toggle" aria-label="Abrir menu de navegação">
      <div class="hamburger">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </div>
    </button>
  </div>
</header>

<!-- Mobile Navigation Menu -->
<nav class="mobile-nav" id="mobile-nav">
  <div class="mobile-nav-content">
    <!-- Mobile Nav Header -->
    <div class="mobile-nav-header">
      <div class="header-logo">
        <h1><%= typeof siteTitle !== 'undefined' ? siteTitle : 'Gonzaga\'s Art & Shine' %></h1>
      </div>
      <button class="mobile-nav-close" id="mobile-nav-close" aria-label="Fechar menu de navegação">
        <i class="fas fa-times"></i>
      </button>
    </div>
    
    <!-- Mobile Navigation Links -->
    <div class="mobile-nav-links">
      <a href="/" class="mobile-nav-link <%= typeof title !== 'undefined' && title === 'Home' ? 'active' : '' %>">
        <i class="fas fa-home"></i>
        <span>Início</span>
      </a>
      
      <% if (typeof siteSettings !== 'undefined' && siteSettings.catalog_page_enabled) { %>
      <a href="/catalog" class="mobile-nav-link <%= typeof title !== 'undefined' && title === 'Catalog' ? 'active' : '' %>">
        <i class="fas fa-gem"></i>
        <span>Catálogo</span>
      </a>
      <% } %>
      
      <a href="/collections" class="mobile-nav-link <%= typeof title !== 'undefined' && title === 'Collections' ? 'active' : '' %>">
        <i class="fas fa-layer-group"></i>
        <span>Coleções</span>
      </a>
      
      <a href="/about" class="mobile-nav-link <%= typeof title !== 'undefined' && title === 'About Gonzaga\'s Art & Shine' ? 'active' : '' %>">
        <i class="fas fa-info-circle"></i>
        <span>Sobre Nós</span>
      </a>

      <% if (typeof ecommerceEnabled !== 'undefined' && ecommerceEnabled) { %>
      <a href="/cart" class="mobile-nav-link <%= typeof currentPath !== 'undefined' && currentPath === '/cart' ? 'active' : '' %>">
        <i class="fas fa-shopping-cart"></i>
        <span>Carrinho<% if (typeof cartItemCount !== 'undefined' && cartItemCount > 0) { %> (<%= cartItemCount %>)<% } %></span>
      </a>
      <% var accountNavContext = 'mobile'; %>
      <%- include('_customerAccountNav') %>
      <% } %>
      
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/admin" class="mobile-nav-link">
          <i class="fas fa-user-shield"></i>
          <span>Admin</span>
        </a>
      <% } else { %>
        <a href="/admin/login" class="mobile-nav-link">
          <i class="fas fa-user-shield"></i>
          <span>Admin</span>
        </a>
      <% } %>
    </div>
    
    <!-- Mobile Navigation Actions -->
    <div class="mobile-nav-actions">
      <!-- Social Links -->
      <div class="mobile-nav-social">
        <a href="https://www.instagram.com/gonzagaartnshine/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <i class="fab fa-instagram"></i>
        </a>
        <a href="https://www.facebook.com/profile.php?id=61573519807731" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <i class="fab fa-facebook"></i>
        </a>
      </div>
      
      <!-- Contact Info -->
      <div class="mobile-nav-contact">
        <p>Entre em contacto:</p>
        <p><a href="mailto:geral@artnshine.pt">geral@artnshine.pt</a></p>
        <p><a href="https://artnshine.pt">artnshine.pt</a></p>
      </div>
    </div>
  </div>
</nav>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Toggle mobile menu
  const menuToggleButton = document.querySelector('.menu-toggle');
  const navMenu = document.querySelector('.nav-menu');

  // console.log('[DEBUG DOMContentLoaded] Menu Toggle Button:', menuToggleButton);
  // console.log('[DEBUG DOMContentLoaded] Nav Menu:', navMenu);

  let isMenuOpen = false; // Standard: menu starts closed.

  if (menuToggleButton && navMenu) {
    // Initial sync: If JS assumes menu is open, but button is hamburger, make button active (X)
    // However, the user describes the button starting as hamburger while panel is open.
    // So, the first click should make isMenuOpen = false, remove active from panel (closing it),
    // and remove active from button (keeping it hamburger, which is correct for closed state).

    menuToggleButton.addEventListener('click', function() {
      isMenuOpen = !isMenuOpen; // Toggle state

      if (isMenuOpen) {
        // This state means: Menu should be OPEN, Button should be X
        navMenu.classList.add('active');
        this.classList.add('active');
        console.log('[DEBUG Click] State: OPEN. navMenu:', navMenu.classList.toString(), 'Button:', this.classList.toString());
      } else {
        // This state means: Menu should be CLOSED, Button should be Hamburger
        navMenu.classList.remove('active');
        this.classList.remove('active');
        console.log('[DEBUG Click] State: CLOSED. navMenu:', navMenu.classList.toString(), 'Button:', this.classList.toString());
      }
    });
  } else {
    console.error('[DEBUG DOMContentLoaded] Menu toggle button or nav menu not found!');
  }
  
  // Handle dropdowns
  document.querySelectorAll('.dropdown-toggle').forEach(toggle => {
    toggle.addEventListener('click', function(e) {
      e.preventDefault();
      this.parentNode.classList.toggle('open');
    });
  });

  // Search expand/collapse (mobile + desktop)
  const searchToggle = document.getElementById('mobile-search-toggle');
  const searchClose = document.getElementById('mobile-search-close');
  const headerSearch = document.getElementById('header-search');

  function getSearchInput() {
    return document.querySelector('#header-search .search-input, #header-search input[name="search"], #header-search input[type="search"]');
  }

  function expandSearch() {
    if (!headerSearch) return;
    headerSearch.classList.add('expanded');
    if (searchToggle) searchToggle.setAttribute('aria-expanded', 'true');
    var inp = getSearchInput();
    if (inp) { inp.focus(); }
    document.body.classList.add('mobile-search-expanded');
  }

  function collapseSearch() {
    if (!headerSearch) return;
    headerSearch.classList.remove('expanded');
    if (searchToggle) searchToggle.setAttribute('aria-expanded', 'false');
    var inp = getSearchInput();
    if (inp) { inp.blur(); }
    document.body.classList.remove('mobile-search-expanded');
  }

  if (searchToggle) {
    searchToggle.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      expandSearch();
    });
  }

  if (searchClose) {
    searchClose.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      collapseSearch();
    });
  }

  document.addEventListener('click', function(e) {
    if (!headerSearch || !headerSearch.classList.contains('expanded')) return;
    if (headerSearch.contains(e.target) || (searchToggle && searchToggle.contains(e.target))) return;
    collapseSearch();
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && headerSearch && headerSearch.classList.contains('expanded')) {
      collapseSearch();
    }
  });
});
</script>