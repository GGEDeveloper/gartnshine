<%
  const navPath = typeof currentPath !== 'undefined' ? currentPath : '';
  const isHome = navPath === '/' || navPath === '';
  const isCollections = navPath === '/collections' || navPath.startsWith('/collection/');
  const isCatalog = navPath === '/catalog' || navPath.startsWith('/catalog/');
  const isAbout = navPath === '/about';
  const isCart = navPath === '/cart';
  const isAdmin = navPath.startsWith('/admin');
  const brandFull = typeof siteTitle !== 'undefined' ? siteTitle : "Gonzaga's Art & Shine";
  const brandShort = 'Art&Shine';
  const catalogEnabled = typeof siteSettings !== 'undefined' && siteSettings.catalog_page_enabled;
%>

<header class="main-header">
  <div class="header-container">
    <div class="logo-container">
      <a href="/" class="logo" aria-label="<%= brandShort %> — Início">
        <span class="logo-text logo-text-full"><%= brandFull %></span>
        <span class="logo-text logo-text-short" aria-hidden="true"><%= brandShort %></span>
      </a>
    </div>

    <nav class="main-nav desktop-nav" aria-label="Navegação principal">
      <ul class="nav-menu">
        <li><a href="/" class="<%= isHome ? 'active' : '' %>">Início</a></li>
        <li><a href="/collections" class="<%= isCollections ? 'active' : '' %>">Coleções</a></li>
        <% if (catalogEnabled) { %>
        <li><a href="/catalog" class="<%= isCatalog ? 'active' : '' %>">Catálogo</a></li>
        <% } %>
        <li><a href="/about" class="<%= isAbout ? 'active' : '' %>">Sobre</a></li>

        <% if (typeof user !== 'undefined' && user) { %>
        <li class="dropdown admin-menu">
          <a href="/admin" class="dropdown-toggle<%= isAdmin ? ' active' : '' %>" aria-haspopup="true" aria-expanded="false">Admin</a>
          <ul class="dropdown-menu" role="menu">
            <li role="none"><a href="/admin/dashboard" role="menuitem">Painel</a></li>
            <li role="none"><a href="/admin/products" role="menuitem">Produtos</a></li>
            <li role="none"><a href="/admin/families" role="menuitem">Categorias</a></li>
            <li role="none"><a href="/admin/inventory" role="menuitem">Inventário</a></li>
            <li role="none"><a href="/admin/checkpoints" role="menuitem">Checkpoints</a></li>
            <li role="none"><a href="/admin/settings" role="menuitem">Definições</a></li>
            <li role="none"><a href="/admin/logout" role="menuitem">Sair</a></li>
          </ul>
        </li>
        <% } else { %>
        <li class="admin-link"><a href="/admin/login">Admin</a></li>
        <% } %>
      </ul>
    </nav>

    <div class="header-toolbar">
    <div class="header-search-wrapper">
      <button type="button" class="header-icon-btn mobile-search-toggle" id="mobile-search-toggle" aria-label="Abrir pesquisa" aria-expanded="false">
        <i class="fas fa-search" aria-hidden="true"></i>
      </button>
      <div class="header-search" id="header-search">
        <input type="search" name="search" class="search-input" placeholder="Pesquisar..." autocomplete="off" aria-label="Pesquisar produtos">
        <button type="button" class="header-icon-btn mobile-search-close" id="mobile-search-close" aria-label="Fechar pesquisa">
          <i class="fas fa-times" aria-hidden="true"></i>
        </button>
      </div>
    </div>

    <% if (typeof ecommerceEnabled !== 'undefined' && ecommerceEnabled) { %>
    <a href="/cart" class="header-icon-btn header-cart-link<%= isCart ? ' active' : '' %>" aria-label="Carrinho">
      <i class="fas fa-shopping-cart" aria-hidden="true"></i>
      <span class="header-cart-badge" style="display:none">0</span>
    </a>
    <%- include('_customerAccountNav') %>
    <% } %>

    <button type="button" class="header-icon-btn mobile-nav-toggle" id="mobile-nav-toggle" aria-label="Abrir menu de navegação" aria-expanded="false" aria-controls="mobile-nav">
      <div class="hamburger" aria-hidden="true">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </div>
    </button>
    </div>
  </div>
</header>

<nav class="mobile-nav" id="mobile-nav" aria-label="Menu mobile" aria-hidden="true">
  <div class="mobile-nav-content">
    <div class="mobile-nav-header">
      <a href="/" class="logo" aria-label="<%= brandShort %> — Início">
        <span class="logo-text"><%= brandShort %></span>
      </a>
      <button type="button" class="header-icon-btn mobile-nav-close" id="mobile-nav-close" aria-label="Fechar menu de navegação">
        <i class="fas fa-times" aria-hidden="true"></i>
      </button>
    </div>

    <div class="mobile-nav-links">
      <a href="/" class="mobile-nav-link <%= isHome ? 'active' : '' %>">
        <i class="fas fa-home" aria-hidden="true"></i>
        <span>Início</span>
      </a>

      <a href="/collections" class="mobile-nav-link <%= isCollections ? 'active' : '' %>">
        <i class="fas fa-layer-group" aria-hidden="true"></i>
        <span>Coleções</span>
      </a>

      <% if (catalogEnabled) { %>
      <a href="/catalog" class="mobile-nav-link <%= isCatalog ? 'active' : '' %>">
        <i class="fas fa-gem" aria-hidden="true"></i>
        <span>Catálogo</span>
      </a>
      <% } %>

      <a href="/about" class="mobile-nav-link <%= isAbout ? 'active' : '' %>">
        <i class="fas fa-info-circle" aria-hidden="true"></i>
        <span>Sobre</span>
      </a>

      <% if (typeof ecommerceEnabled !== 'undefined' && ecommerceEnabled) { %>
      <a href="/cart" class="mobile-nav-link <%= isCart ? 'active' : '' %>">
        <i class="fas fa-shopping-cart" aria-hidden="true"></i>
        <span>Carrinho<% if (typeof cartItemCount !== 'undefined' && cartItemCount > 0) { %> (<%= cartItemCount %>)<% } %></span>
      </a>
      <% var accountNavContext = 'mobile'; %>
      <%- include('_customerAccountNav') %>
      <% } %>

      <% if (typeof user !== 'undefined' && user) { %>
      <div class="mobile-nav-divider" role="presentation"></div>
      <div class="mobile-nav-section-label">
        <i class="fas fa-user-shield" aria-hidden="true"></i>
        <span>Admin</span>
      </div>
      <div class="mobile-nav-sublinks">
        <a href="/admin/dashboard" class="mobile-nav-sublink">Painel</a>
        <a href="/admin/products" class="mobile-nav-sublink">Produtos</a>
        <a href="/admin/inventory" class="mobile-nav-sublink">Inventário</a>
        <a href="/admin/settings" class="mobile-nav-sublink">Definições</a>
        <a href="/admin/logout" class="mobile-nav-sublink">Sair</a>
      </div>
      <% } else { %>
      <a href="/admin/login" class="mobile-nav-link">
        <i class="fas fa-user-shield" aria-hidden="true"></i>
        <span>Admin</span>
      </a>
      <% } %>
    </div>

    <div class="mobile-nav-actions">
      <div class="mobile-nav-social">
        <a href="https://www.instagram.com/gonzagaartnshine/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <i class="fab fa-instagram" aria-hidden="true"></i>
        </a>
        <a href="https://www.facebook.com/profile.php?id=61573519807731" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <i class="fab fa-facebook" aria-hidden="true"></i>
        </a>
      </div>
      <div class="mobile-nav-contact">
        <p>Entre em contacto</p>
        <p><a href="mailto:geral@artnshine.pt">geral@artnshine.pt</a></p>
        <p><a href="https://artnshine.pt">artnshine.pt</a></p>
      </div>
    </div>
  </div>
</nav>

<style>
  /* Critical CSS: evita FOUC da gaveta mobile antes de header.css carregar */
  @media (max-width: 768px) {
    .main-header .desktop-nav {
      display: none !important;
    }
    .mobile-nav {
      position: fixed;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100vh;
      height: 100dvh;
      z-index: 1050;
      overflow-y: auto;
    }
    .mobile-nav.frontend-nav-active,
    .mobile-nav.active {
      left: 0 !important;
    }
  }
</style>
