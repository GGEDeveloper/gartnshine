<!-- =============================================
     GONZAGA ART & SHINE - PRODUCT CARD PARTIAL
     Gothic Natural Product Display
     ============================================= -->

<article class="product-card" 
         data-stone="<%= produto.stone_type || 'natural' %>"
         data-product-id="<%= produto.id %>"
         itemscope itemtype="https://schema.org/Product">
    
    <a href="/produto/<%= produto.slug || produto.id %>" 
       class="product-card__link"
       onclick="trackProductClick('<%= produto.id %>', '<%= produto.nome %>', '<%= produto.stone_type %>')">
        
        <!-- Product Image -->
        <div class="product-card__image">
            <img src="<%= produto.imagem_principal || '/images/placeholder-produto-dark.jpg' %>" 
                 alt="<%= produto.nome %> - <%= produto.pedra_nome || 'Pedra natural' %> em <%= produto.metal_nome || 'Prata 925' %>"
                 loading="lazy"
                 class="product-card__img"
                 itemprop="image"
                 onload="this.classList.add('loaded')">
            
            <!-- Stone Badge -->
            <% if (produto.stone_type === 'onix') { %>
                <span class="badge-onyx product-card__badge" title="Coleção Ónix - Força em negro profundo">
                    Ónix
                </span>
            <% } else if (produto.stone_type === 'olho-de-tigre') { %>
                <span class="badge-tiger product-card__badge" title="Coleção Olho-de-tigre - Poder dourado da terra">
                    Olho-de-tigre
                </span>
            <% } else if (produto.stone_type && produto.pedra_nome) { %>
                <span class="product-card__badge" 
                      style="background: var(--earth); color: var(--ivory); padding: var(--space-xs) var(--space-sm); border-radius: var(--radius); font-size: 0.75rem;">
                    <%= produto.pedra_nome %>
                </span>
            <% } %>
            
            <!-- Availability Indicator -->
            <% if (produto.stock_quantity !== undefined) { %>
                <% if (produto.stock_quantity === 0) { %>
                    <span class="product-card__stock product-card__stock--out" 
                          style="position: absolute; bottom: var(--space-md); right: var(--space-md); background: var(--black); color: var(--ivory); padding: var(--space-xs) var(--space-sm); border-radius: var(--radius); font-size: 0.75rem; opacity: 0.9;">
                        Esgotado
                    </span>
                <% } else if (produto.stock_quantity <= 3) { %>
                    <span class="product-card__stock product-card__stock--low" 
                          style="position: absolute; bottom: var(--space-md); right: var(--space-md); background: var(--accent-tiger); color: var(--ivory); padding: var(--space-xs) var(--space-sm); border-radius: var(--radius); font-size: 0.75rem; opacity: 0.9;">
                        Últimas <%= produto.stock_quantity %>
                    </span>
                <% } %>
            <% } %>
        </div>
        
        <!-- Product Content -->
        <div class="product-card__content">
            <h3 class="product-card__title" itemprop="name">
                <%= produto.nome %>
            </h3>
            
            <!-- Product Meta - Stone & Metal -->
            <div class="product-card__meta">
                <span class="product-card__stone">
                    <%= produto.pedra_nome || 'Pedra natural' %>
                </span>
                <span class="meta-separator" aria-hidden="true">•</span>
                <span class="product-card__metal">
                    <%= produto.metal_nome || 'Prata 925' %>
                </span>
            </div>
            
            <!-- Product Description Preview -->
            <% if (produto.descricao_curta || produto.descricao) { %>
                <p class="product-card__description" style="font-size: 0.875rem; color: var(--slate); margin: var(--space-xs) 0 var(--space-sm); line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                    <%= produto.descricao_curta || produto.descricao.substring(0, 80) + '...' %>
                </p>
            <% } %>
            
            <!-- Price -->
            <div class="product-card__price" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                <% if (produto.preco_formatado) { %>
                    <span itemprop="price" content="<%= produto.preco || 0 %>">
                        <%= produto.preco_formatado %>
                    </span>
                    <meta itemprop="priceCurrency" content="EUR">
                <% } else if (produto.preco) { %>
                    <span itemprop="price" content="<%= produto.preco %>">
                        €<%= produto.preco.toFixed(2) %>
                    </span>
                    <meta itemprop="priceCurrency" content="EUR">
                <% } else { %>
                    <span style="color: var(--slate); font-style: italic;">
                        Consultar preço
                    </span>
                <% } %>
                
                <% if (produto.stock_quantity > 0 || produto.stock_quantity === undefined) { %>
                    <meta itemprop="availability" content="https://schema.org/InStock">
                <% } else { %>
                    <meta itemprop="availability" content="https://schema.org/OutOfStock">
                <% } %>
            </div>
            
            <!-- Origin Preview - Storytelling -->
            <% if (produto.stone_origin || produto.artisan_name) { %>
                <div class="product-card__origin" style="margin-top: var(--space-sm); padding-top: var(--space-sm); border-top: 1px solid rgba(255,255,255,0.05);">
                    <% if (produto.stone_origin) { %>
                        <div class="origin-item" style="font-size: 0.75rem; color: var(--slate); margin-bottom: var(--space-xs);">
                            <span style="color: var(--gold-old);">Origem:</span> <%= produto.stone_origin %>
                        </div>
                    <% } %>
                    
                    <% if (produto.artisan_name) { %>
                        <div class="origin-item" style="font-size: 0.75rem; color: var(--slate);">
                            <span style="color: var(--gold-old);">Artesão:</span> <%= produto.artisan_name %>
                        </div>
                    <% } %>
                </div>
            <% } %>
            
            <!-- Quick Action Buttons (opcional) -->
            <% if (locals.showQuickActions) { %>
                <div class="product-card__actions" 
                     style="margin-top: var(--space-md); display: flex; gap: var(--space-xs); justify-content: space-between;">
                    
                    <button class="btn btn--gold btn--small" 
                            onclick="addToCartQuick(event, '<%= produto.id %>', '<%= produto.nome %>');"
                            style="flex: 1;">
                        <span class="btn__text">Adicionar</span>
                        <span class="btn__icon" aria-hidden="true">🛍</span>
                    </button>
                    
                    <button class="btn btn--silver-outline btn--small" 
                            onclick="addToWishlist(event, '<%= produto.id %>');"
                            style="aspect-ratio: 1; padding: var(--space-xs);" 
                            title="Adicionar aos favoritos">
                        <span class="btn__icon" aria-hidden="true">❤️</span>
                    </button>
                </div>
            <% } %>
            
            <!-- Schema.org Additional Data -->
            <div style="display: none;" itemprop="description">
                <%= produto.descricao || produto.nome + ' - Joia artesanal em ' + (produto.metal_nome || 'prata 925') + ' com ' + (produto.pedra_nome || 'pedra natural') %>
            </div>
            
            <% if (produto.categoria) { %>
                <meta itemprop="category" content="<%= produto.categoria %>">
            <% } %>
            
            <% if (produto.marca || 'Gonzaga Art & Shine') { %>
                <div itemprop="brand" itemscope itemtype="https://schema.org/Brand">
                    <meta itemprop="name" content="<%= produto.marca || 'Gonzaga Art & Shine' %>">
                </div>
            <% } %>
        </div>
    </a>
</article>

<!-- JavaScript para Product Card Interactions -->
<script>
// Track product click for analytics
function trackProductClick(productId, productName, stoneType) {
    if (typeof gtag !== 'undefined') {
        gtag('event', 'select_item', {
            item_list_id: 'product_cards',
            item_list_name: 'Product Grid',
            items: [{
                item_id: productId,
                item_name: productName,
                item_category: 'Joias',
                item_category2: stoneType === 'onix' ? 'Ónix' : (stoneType === 'olho-de-tigre' ? 'Olho-de-tigre' : 'Outras'),
                index: Array.from(document.querySelectorAll('.product-card')).findIndex(card => 
                    card.dataset.productId === productId
                ) + 1
            }]
        });
    }
}

// Quick add to cart function
function addToCartQuick(event, productId, productName) {
    event.preventDefault();
    event.stopPropagation();
    
    const button = event.target.closest('button');
    const originalText = button.querySelector('.btn__text').textContent;
    
    // Visual feedback
    button.querySelector('.btn__text').textContent = 'Adicionado!';
    button.style.background = 'var(--forest)';
    button.disabled = true;
    
    // Analytics tracking
    if (typeof gtag !== 'undefined') {
        gtag('event', 'add_to_cart', {
            currency: 'EUR',
            value: 0, // Valor real seria obtido do produto
            items: [{
                item_id: productId,
                item_name: productName,
                quantity: 1
            }]
        });
    }
    
    // Reset button after delay
    setTimeout(() => {
        button.querySelector('.btn__text').textContent = originalText;
        button.style.background = 'var(--gold-old)';
        button.disabled = false;
    }, 2000);
    
    // Aqui seria a integração real com o carrinho
    console.log('Add to cart:', productId, productName);
}

// Add to wishlist function
function addToWishlist(event, productId) {
    event.preventDefault();
    event.stopPropagation();
    
    const button = event.target.closest('button');
    const icon = button.querySelector('.btn__icon');
    
    // Toggle wishlist state
    if (icon.textContent === '❤️') {
        icon.textContent = '🤍'; // Corao branco
        button.style.borderColor = 'var(--slate)';
        console.log('Removed from wishlist:', productId);
    } else {
        icon.textContent = '❤️'; // Coração vermelho
        button.style.borderColor = 'var(--gold-old)';
        console.log('Added to wishlist:', productId);
    }
    
    // Analytics tracking
    if (typeof gtag !== 'undefined') {
        gtag('event', 'add_to_wishlist', {
            currency: 'EUR',
            value: 0,
            items: [{
                item_id: productId,
                quantity: 1
            }]
        });
    }
}

// Image loading optimization
document.addEventListener('DOMContentLoaded', function() {
    // Lazy loading fallback for older browsers
    if ('loading' in HTMLImageElement.prototype === false) {
        const images = document.querySelectorAll('img[loading="lazy"]');
        const imageObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const img = entry.target;
                    img.src = img.src;
                    img.classList.add('loaded');
                    imageObserver.unobserve(img);
                }
            });
        });
        
        images.forEach(img => imageObserver.observe(img));
    }
    
    // Product card hover tracking (opcional)
    document.querySelectorAll('.product-card').forEach(card => {
        let hoverTimer;
        
        card.addEventListener('mouseenter', function() {
            hoverTimer = setTimeout(() => {
                const productId = this.dataset.productId;
                if (typeof gtag !== 'undefined') {
                    gtag('event', 'view_item_hover', {
                        item_id: productId,
                        engagement_time_msec: 1000
                    });
                }
            }, 1000); // Track after 1 second hover
        });
        
        card.addEventListener('mouseleave', function() {
            if (hoverTimer) {
                clearTimeout(hoverTimer);
            }
        });
    });
});
</script>

<!-- =============================================
     CSS INLINE ESPECÍFICO PARA PRODUCT CARD
     (Será movido para components se necessário)
     ============================================= -->
<style>
/* Product card specific styles */
.product-card__badge {
    position: absolute;
    top: var(--space-md);
    left: var(--space-md);
    z-index: var(--z-elevated);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.02em;
}

.product-card__img {
    opacity: 0;
    transition: opacity var(--duration-normal) ease;
}

.product-card__img.loaded {
    opacity: 1;
}

/* Stone-specific hover effects */
.product-card[data-stone="onix"]:hover {
    border-color: rgba(17, 17, 17, 0.3);
}

.product-card[data-stone="olho-de-tigre"]:hover {
    border-color: rgba(107, 74, 27, 0.3);
}

/* Quick actions hover */
.product-card__actions {
    opacity: 0;
    transform: translateY(10px);
    transition: all var(--duration-normal) ease;
}

.product-card:hover .product-card__actions {
    opacity: 1;
    transform: translateY(0);
}

/* Responsive adjustments */
@media (max-width: 720px) {
    .product-card__badge {
        top: var(--space-sm);
        left: var(--space-sm);
        font-size: 0.65rem;
        padding: var(--space-xs) var(--space-xs);
    }
    
    .product-card__actions {
        opacity: 1;
        transform: translateY(0);
        margin-top: var(--space-sm);
    }
    
    .product-card__origin {
        font-size: 0.7rem;
    }
}

/* Loading skeleton (opcional) */
.product-card.loading {
    pointer-events: none;
}

.product-card.loading .product-card__image {
    background: linear-gradient(90deg, var(--slate) 25%, rgba(110,107,101,0.5) 50%, var(--slate) 75%);
    background-size: 200% 100%;
    animation: loading-shimmer 1.5s infinite;
}

@keyframes loading-shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
}
</style>

