<% if (typeof breadcrumbs !== 'undefined' && breadcrumbs && breadcrumbs.length > 0) { %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    <% breadcrumbs.forEach(function(crumb, index) { %>
    {
      "@type": "ListItem",
      "position": <%= index + 1 %>,
      "name": "<%= crumb.name.replace(/"/g, '&quot;') %>",
      "item": "https://artnshine.pt<%= crumb.url %>"
    }<%= index < breadcrumbs.length - 1 ? ',' : '' %>
    <% }); %>
  ]
}
</script>
<% } %>
