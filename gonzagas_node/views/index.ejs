<main>
    <!-- Hero: desktop=video, mobile=imagem (mais leve, sem blur) -->
    <section class="hero">
      <div class="video-background-container">
        <div class="hero-image-backdrop" style="background-image: url('<%= heroImage || "/images/placeholder-image.png" %>');"></div>
        <video autoplay muted loop playsinline class="video-background" 
               poster="<%= heroImage || "/images/placeholder-image.png" %>"
               preload="metadata">
          <source src="/videos/hero-background.mp4" type="video/mp4">
        </video>
      </div>
      <div class="hero-content">
        <h1><%= siteTitle %></h1>
        <p><%= siteDescription %></p>
      </div>
    </section>
    
    <!-- Featured Products -->
    <% if (featured && featured.length > 0) { %>
    <section class="featured-section">
      <div class="section-header">
        <h2>Featured Pieces</h2>
        <div class="geometric-divider">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>

      <!-- Slick Carousel -->
      <div class="featured-carousel">
        <% featured.forEach((product, index) => { %>
          <div class="slick-slide">
            <%- include('partials/_productCardHomepage', {product: product, index: index}) %>
          </div>
        <% }); %>
      </div>

    </section>
    <% } %>
    

</main>