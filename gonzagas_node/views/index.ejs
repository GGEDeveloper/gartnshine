<% var igHome = typeof useInstagramPreviewCssOnHome !== 'undefined' && useInstagramPreviewCssOnHome; %>
    <!-- Hero: vídeo de fundo + texto "Elegância que nasce da terra" encostado ao topo -->
    <section class="hero<%= igHome ? ' ig-hero' : '' %>">
      <div class="hero-video-container">
        <video class="hero-video" autoplay muted loop playsinline>
          <source src="/media/gallery/WhatsApp Video 2025-04-05 at 19.12.38_fdb30c78.mp4" type="video/mp4">
        </video>
        <div class="hero-video-overlay"></div>
      </div>
      <div class="hero-image-backdrop" style="background-image: url('<%= heroImage || "/images/imagem-nao-disponivel.svg" %>');"></div>
      <% if (igHome) { %><div class="ig-hero-noise" aria-hidden="true"></div><% } %>
      <div class="hero-content">
        <h1 class="hero-title visually-hidden">Joias Artesanais em Prata 925 — Gonzaga's Art & Shine</h1>
        <% if (igHome) { %><p class="ig-hero-brand">Gonzaga&apos;s Art &amp; Shine</p><% } %>
        <p class="hero-tagline"><%= siteDescription %></p>
        <% if (igHome) { %><div class="ig-hero-line" aria-hidden="true"></div><% } %>
      </div>
    </section>
    
    <!-- Featured Products -->
    <% if (featured && featured.length > 0) { %>
    <% if (igHome) { %><div class="home-ig-preview-main"><% } %>
    <section class="featured-section<%= igHome ? ' ig-collections' : '' %>">
      <div class="section-header<%= igHome ? ' ig-collections-head' : '' %>">
        <h2<%= igHome ? ' class="ig-collections-title"' : '' %>>Featured Pieces</h2>
        <% if (igHome) { %><p class="ig-collections-sub">Prata &amp; pedras naturais — design alternativo</p><% } %>
        <div class="geometric-divider">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>

      <!-- Slick Carousel -->
      <div class="featured-carousel">
        <% featured.forEach((product, index) => { %>
          <div class="slick-slide">
            <%- include('partials/_productCardHomepage', {product: product, index: index}) %>
          </div>
        <% }); %>
      </div>

    </section>
    <% if (igHome) { %></div><% } %>
    <% } %>

<%- include('partials/_ig-strip', { igPosts: typeof igPosts !== 'undefined' ? igPosts : [] }) %>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://artnshine.pt/#homepage",
  "name": "Gonzaga's Art & Shine — Elegância que nasce da terra",
  "description": "Joias artesanais em prata 925, latão banhado a prata e pedras naturais. Elegância que nasce da terra.",
  "url": "https://artnshine.pt/",
  "isPartOf": { "@id": "https://artnshine.pt/#website" },
  "about": { "@id": "https://artnshine.pt/#organization" },
  "mainEntity": {
    "@type": "ItemList",
    "name": "Coleção Gonzaga's Art & Shine",
    "description": "Joias artesanais em prata 925 e pedras naturais",
    "numberOfItems": "270+",
    "itemListOrder": "https://schema.org/ItemListUnordered"
  }
}
</script>
