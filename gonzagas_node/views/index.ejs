    <!-- Hero: imagem de fundo + tagline -->
    <section class="hero">
      <div class="hero-image-backdrop" style="background-image: url('<%= heroImage || "/images/placeholder-hero.jpg" %>');"></div>
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <h1 class="hero-title visually-hidden">Joias Artesanais em Prata 925 — Gonzaga's Art & Shine</h1>
        <p class="hero-tagline"><%= siteDescription %></p>
      </div>
    </section>

    <!-- Featured Products -->
    <% if (featured && featured.length > 0) { %>
    <section class="featured-section ig-collections">
      <div class="section-header ig-collections-head">
        <h2 class="ig-collections-title">Featured Pieces</h2>
        <p class="ig-collections-sub">Prata &amp; pedras naturais — design alternativo</p>
        <div class="geometric-divider">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>

      <!-- Slick Carousel -->
      <div class="featured-carousel">
        <% featured.forEach((product, index) => { %>
          <div class="slick-slide">
            <%- include('partials/_productCardHomepage', {product: product, index: index}) %>
          </div>
        <% }); %>
      </div>

    </section>
    <% } %>

<%- include('partials/_media-strip', { igPosts: typeof igPosts !== 'undefined' ? igPosts : [] }) %>

<% if (typeof galleryVideos !== 'undefined' && galleryVideos.length > 0) { %>
<section class="brand-videos-section" aria-label="Vídeos da marca">
  <div class="brand-videos-inner">
    <% galleryVideos.forEach(function(v, i) { %>
    <div class="brand-video-wrap" style="<%= galleryVideos.length > 1 ? 'max-width:' + Math.floor(94/galleryVideos.length) + 'vw' : '' %>">
      <video
        autoplay
        muted
        loop
        playsinline
        preload="none"
        class="brand-video"
        aria-label="Gonzaga's Art & Shine"
      >
        <source src="<%= v.path %>" type="video/mp4">
      </video>
    </div>
    <% }); %>
  </div>
</section>

<style>
.brand-videos-section {
  width: 100%;
  overflow: hidden;
  background: #000;
  padding: 0;
  line-height: 0;
}
.brand-videos-inner {
  display: flex;
  justify-content: center;
  gap: 0;
  width: 100%;
}
.brand-video-wrap {
  flex: 1;
  min-width: 0;
  max-width: 100vw;
  position: relative;
  overflow: hidden;
}
.brand-video {
  width: 100%;
  height: 70vh;
  object-fit: cover;
  display: block;
  filter: brightness(0.88) saturate(1.1);
}
@media (max-width: 640px) {
  .brand-video { height: 50vw; min-height: 200px; }
}
</style>
<% } %>

