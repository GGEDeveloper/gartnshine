<main>
    <!-- Hero: vídeo de fundo + texto "Elegância que nasce da terra" encostado ao topo -->
    <section class="hero">
      <div class="hero-video-container">
        <video class="hero-video" autoplay muted loop playsinline>
          <source src="/media/gallery/WhatsApp Video 2025-04-05 at 19.12.38_fdb30c78.mp4" type="video/mp4">
        </video>
        <div class="hero-video-overlay"></div>
      </div>
      <div class="hero-image-backdrop" style="background-image: url('<%= heroImage || "/images/placeholder-image.png" %>');"></div>
      <div class="hero-content">
        <p class="hero-tagline"><%= siteDescription %></p>
      </div>
    </section>
    
    <!-- Featured Products -->
    <% if (featured && featured.length > 0) { %>
    <section class="featured-section">
      <div class="section-header">
        <h2>Featured Pieces</h2>
        <div class="geometric-divider">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>

      <!-- Slick Carousel -->
      <div class="featured-carousel">
        <% featured.forEach((product, index) => { %>
          <div class="slick-slide">
            <%- include('partials/_productCardHomepage', {product: product, index: index}) %>
          </div>
        <% }); %>
      </div>

    </section>
    <% } %>
    

</main>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "OnlineStore",
  "name": "Gonzaga's Art & Shine",
  "alternateName": "Art&Shine",
  "description": "Joias artesanais em prata 925, latão banhado a prata e pedras naturais. Elegância que nasce da terra.",
  "url": "https://artnshine.pt",
  "logo": {
    "@type": "ImageObject",
    "url": "https://artnshine.pt/logo.svg",
    "width": 200,
    "height": 200
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "email": "geral@artnshine.pt",
    "contactType": "Customer Service",
    "availableLanguage": "Portuguese"
  },
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "PT"
  },
  "sameAs": [],
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "EUR",
    "offerCount": "16+"
  }
}
</script>