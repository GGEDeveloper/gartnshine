<main>
    <!-- Hero: só imagem de fundo + texto "Elegância que nasce da terra" encostado ao topo -->
    <section class="hero">
      <div class="hero-image-backdrop" style="background-image: url('<%= heroImage || "/images/placeholder-image.png" %>');"></div>
      <div class="hero-content">
        <p class="hero-tagline"><%= siteDescription %></p>
      </div>
    </section>
    
    <!-- Featured Products -->
    <% if (featured && featured.length > 0) { %>
    <section class="featured-section">
      <div class="section-header">
        <h2>Featured Pieces</h2>
        <div class="geometric-divider">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>

      <!-- Slick Carousel -->
      <div class="featured-carousel">
        <% featured.forEach((product, index) => { %>
          <div class="slick-slide">
            <%- include('partials/_productCardHomepage', {product: product, index: index}) %>
          </div>
        <% }); %>
      </div>

    </section>
    <% } %>
    

</main>