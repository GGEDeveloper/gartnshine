    <!-- Hero: imagem de fundo + marca -->
    <section class="hero">
      <div class="hero-image-backdrop" style="background-image: url('<%= heroImage || "/images/placeholder-hero.jpg" %>');"></div>
      <div class="hero-scrim" aria-hidden="true"></div>
      <div class="hero-content hero-content--brand">
        <p class="hero-eyebrow">Prata 925 &middot; Latão &middot; Pedras Naturais &middot; Macramé</p>
        <h1 class="hero-title"><%= brand.nome %><span>Jewellery</span></h1>
        <div class="geometric-divider hero-divider" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <p class="hero-tagline"><%= siteDescription %></p>
        <div class="hero-actions">
          <a href="/catalog" class="btn-hero btn-hero--solid">Ver catálogo</a>
          <a href="/galeria" class="btn-hero btn-hero--ghost">Galeria de peças</a>
        </div>
      </div>
      <a href="#featured-anchor" class="hero-scroll-cue" aria-label="Descer para as peças em destaque">
        <span></span>
      </a>
    </section>

    <!-- Manifesto: o que define as peças -->
    <section class="brand-manifesto" aria-label="O que define as nossas peças">
      <ul class="manifesto-list">
        <li>
          <span class="manifesto-label">Selecção</span>
          <p class="manifesto-text">Escolhemos peça a peça. Só entra no catálogo o que nos convence.</p>
        </li>
        <li>
          <span class="manifesto-label">Materiais</span>
          <p class="manifesto-text">Prata 925, latão e pedras naturais — ónix, ametista, olho-de-tigre, turquesa.</p>
        </li>
        <li>
          <span class="manifesto-label">Estilo</span>
          <p class="manifesto-text">Inspiração Bali e boho: formas orgânicas e texturas trabalhadas.</p>
        </li>
      </ul>
    </section>

    <span id="featured-anchor" class="anchor-offset" aria-hidden="true"></span>

    <!-- Featured Products -->
    <% if (featured && featured.length > 0) { %>
    <section class="featured-section ig-collections<%= featuredBackground ? ' has-background' : '' %>"
             <% if (featuredBackground) { %>style="background-image: url('<%= encodeURI(featuredBackground) %>'); background-size: cover; background-position: center;"<% } %>>
      <div class="section-header ig-collections-head">
        <p class="section-eyebrow">Selecção</p>
        <h2 class="ig-collections-title">Peças em Destaque</h2>
        <p class="ig-collections-sub">Prata &amp; pedras naturais — design alternativo</p>
        <div class="geometric-divider">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>

      <!-- Slick Carousel -->
      <div class="featured-carousel-wrap">
        <div class="featured-carousel">
          <% featured.forEach((product, index) => { %>
            <div class="slick-slide">
              <%- include('partials/_productCardHomepage', {product: product, index: index}) %>
            </div>
          <% }); %>
        </div>
        <div class="featured-carousel-dots" aria-label="Navegação Featured Pieces"></div>
      </div>

    </section>
    <% } %>

    <!-- Coleções curadas -->
    <% if (typeof showcaseCollections !== 'undefined' && showcaseCollections.length > 0) { %>
    <section class="collections-showcase" aria-labelledby="curated-showcase-title">
      <div class="section-header ig-collections-head">
        <p class="section-eyebrow">Curadoria</p>
        <h2 class="ig-collections-title" id="curated-showcase-title">Coleções</h2>
        <p class="ig-collections-sub">Conjuntos escolhidos peça a peça</p>
        <div class="geometric-divider">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>

      <div class="collections-showcase-grid">
        <% showcaseCollections.forEach(function(col) {
          const tileImage = col.card_image
            || col.hero_image
            || (col.fallback_image ? productImg(col.fallback_image, 'medium').jpg : null);
        %>
          <a class="collection-tile<%= tileImage ? ' has-image' : '' %>"
             href="/colecao/<%= col.slug %>"
             <% if (tileImage) { %>style="background-image: url('<%= encodeURI(tileImage) %>');"<% } %>>
            <span class="collection-tile-body">
              <span class="collection-tile-name"><%= col.name %></span>
              <span class="collection-tile-count"><%= col.product_count %> peça<%= Number(col.product_count) === 1 ? '' : 's' %></span>
            </span>
          </a>
        <% }); %>
      </div>
    </section>
    <% } %>

    <!-- Explorar por material (famílias de topo: Prata, Latão, Macramé…) -->
    <% if (typeof showcaseMaterials !== 'undefined' && showcaseMaterials.length > 0) { %>
    <section class="collections-showcase" aria-labelledby="collections-showcase-title">
      <div class="section-header ig-collections-head">
        <p class="section-eyebrow">Catálogo</p>
        <h2 class="ig-collections-title" id="collections-showcase-title">Explorar por Material</h2>
        <p class="ig-collections-sub">Prata, latão, macramé e pedras naturais</p>
        <div class="geometric-divider">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>

      <div class="collections-showcase-grid">
        <% showcaseMaterials.forEach(function(fam) {
          // Imagem própria do cartão; se não houver, a do cabeçalho; se também
          // não houver, uma foto de peça — para nunca aparecer um bloco preto.
          const tileImage = fam.card_image
            || fam.hero_image
            || (fam.fallback_image ? productImg(fam.fallback_image, 'medium').jpg : null);
        %>
          <a class="collection-tile<%= tileImage ? ' has-image' : '' %>"
             href="/categoria/<%= fam.slug || fam.id %>"
             <% if (tileImage) { %>style="background-image: url('<%= encodeURI(tileImage) %>');"<% } %>>
            <span class="collection-tile-body">
              <span class="collection-tile-name"><%= fam.name %></span>
              <span class="collection-tile-count"><%= fam.product_count %> peça<%= Number(fam.product_count) === 1 ? '' : 's' %></span>
            </span>
          </a>
        <% }); %>
      </div>

      <div class="collections-showcase-cta">
        <a href="/galeria" class="btn-collections-gallery">Ver galeria completa</a>
      </div>
    </section>
    <% } %>

    <!-- Remate: convite final -->
    <section class="closing-band">
      <div class="closing-inner">
        <p class="section-eyebrow">Fale connosco</p>
        <h2 class="closing-title">Elegância que nasce da terra</h2>
        <p class="closing-text">
          Temos poucas unidades de cada modelo. Se alguma peça lhe falar, diga —
          respondemos sempre, e com gosto.
        </p>
        <div class="closing-actions">
          <a href="/catalog" class="btn-hero btn-hero--solid">Ver todas as peças</a>
          <a href="https://wa.me/351939500592" target="_blank" rel="noopener"
             class="btn-hero btn-hero--ghost">Falar por WhatsApp</a>
        </div>
      </div>
    </section>

<%- include('partials/_media-strip', { igPosts: typeof igPosts !== 'undefined' ? igPosts : [] }) %>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://artnshine.pt/#homepage",
  "name": "<%= brand.nomeSeo %> — Elegância que nasce da terra",
  "description": "Joias artesanais em prata 925, latão banhado a prata e pedras naturais. Elegância que nasce da terra.",
  "url": "https://artnshine.pt/",
  "isPartOf": { "@id": "https://artnshine.pt/#website" },
  "about": { "@id": "https://artnshine.pt/#organization" },
  "mainEntity": {
    "@type": "ItemList",
    "name": "Coleção <%= brand.nomeSeo %>",
    "description": "Joias artesanais em prata 925 e pedras naturais",
    "numberOfItems": "270+",
    "itemListOrder": "https://schema.org/ItemListUnordered"
  }
}
</script>
