    <!-- Hero: imagem de fundo + tagline -->
    <section class="hero">
      <div class="hero-image-backdrop" style="background-image: url('<%= heroImage || "/images/placeholder-hero.jpg" %>');"></div>
      <div class="hero-scrim" aria-hidden="true"></div>
      <div class="hero-content">
        <h1 class="hero-title visually-hidden">Joias Artesanais em Prata 925 — Gonzaga's Art & Shine</h1>
        <p class="hero-tagline"><%= siteDescription %></p>
      </div>
    </section>

    <!-- Featured Products -->
    <% if (featured && featured.length > 0) { %>
    <section class="featured-section ig-collections<%= featuredBackground ? ' has-background' : '' %>"
             <% if (featuredBackground) { %>style="background-image: url('<%= encodeURI(featuredBackground) %>'); background-size: cover; background-position: center;"<% } %>>
      <div class="section-header ig-collections-head">
        <h2 class="ig-collections-title">Featured Pieces</h2>
        <p class="ig-collections-sub">Prata &amp; pedras naturais — design alternativo</p>
        <div class="geometric-divider">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>

      <!-- Slick Carousel -->
      <div class="featured-carousel-wrap">
        <div class="featured-carousel">
          <% featured.forEach((product, index) => { %>
            <div class="slick-slide">
              <%- include('partials/_productCardHomepage', {product: product, index: index}) %>
            </div>
          <% }); %>
        </div>
        <div class="featured-carousel-dots" aria-label="Navegação Featured Pieces"></div>
      </div>

    </section>
    <% } %>

    <!-- Coleções curadas -->
    <% if (typeof showcaseCollections !== 'undefined' && showcaseCollections.length > 0) { %>
    <section class="collections-showcase" aria-labelledby="curated-showcase-title">
      <div class="section-header ig-collections-head">
        <h2 class="ig-collections-title" id="curated-showcase-title">Coleções</h2>
        <p class="ig-collections-sub">Conjuntos escolhidos peça a peça</p>
        <div class="geometric-divider">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>

      <div class="collections-showcase-grid">
        <% showcaseCollections.forEach(function(col) {
          const tileImage = col.card_image
            || col.hero_image
            || (col.fallback_image ? productImg(col.fallback_image, 'medium').jpg : null);
        %>
          <a class="collection-tile<%= tileImage ? ' has-image' : '' %>"
             href="/colecao/<%= col.slug %>"
             <% if (tileImage) { %>style="background-image: url('<%= encodeURI(tileImage) %>');"<% } %>>
            <span class="collection-tile-body">
              <span class="collection-tile-name"><%= col.name %></span>
              <span class="collection-tile-count"><%= col.product_count %> peça<%= Number(col.product_count) === 1 ? '' : 's' %></span>
            </span>
          </a>
        <% }); %>
      </div>
    </section>
    <% } %>

    <!-- Explorar por material (categorias) -->
    <% if (typeof showcaseFamilies !== 'undefined' && showcaseFamilies.length > 0) { %>
    <section class="collections-showcase" aria-labelledby="collections-showcase-title">
      <div class="section-header ig-collections-head">
        <h2 class="ig-collections-title" id="collections-showcase-title">Explorar por Material</h2>
        <p class="ig-collections-sub">Prata, latão e pedras naturais — por tipo de peça</p>
        <div class="geometric-divider">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>

      <div class="collections-showcase-grid">
        <% showcaseFamilies.forEach(function(fam) {
          // Imagem própria do cartão; se não houver, a do cabeçalho da coleção;
          // se também não houver, uma foto de peça — para a secção nunca
          // aparecer como blocos pretos.
          const tileImage = fam.card_image
            || fam.hero_image
            || (fam.fallback_image ? productImg(fam.fallback_image, 'medium').jpg : null);
        %>
          <a class="collection-tile<%= tileImage ? ' has-image' : '' %>"
             href="/collection/<%= fam.slug || fam.id %>"
             <% if (tileImage) { %>style="background-image: url('<%= encodeURI(tileImage) %>');"<% } %>>
            <span class="collection-tile-body">
              <span class="collection-tile-name"><%= fam.name %></span>
              <span class="collection-tile-count"><%= fam.product_count %> peça<%= fam.product_count === 1 ? '' : 's' %></span>
            </span>
          </a>
        <% }); %>
      </div>

      <div class="collections-showcase-cta">
        <a href="/collections" class="btn-collections-gallery">Ver galeria completa</a>
      </div>
    </section>
    <% } %>

<%- include('partials/_media-strip', { igPosts: typeof igPosts !== 'undefined' ? igPosts : [] }) %>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://artnshine.pt/#homepage",
  "name": "Gonzaga's Art & Shine — Elegância que nasce da terra",
  "description": "Joias artesanais em prata 925, latão banhado a prata e pedras naturais. Elegância que nasce da terra.",
  "url": "https://artnshine.pt/",
  "isPartOf": { "@id": "https://artnshine.pt/#website" },
  "about": { "@id": "https://artnshine.pt/#organization" },
  "mainEntity": {
    "@type": "ItemList",
    "name": "Coleção Gonzaga's Art & Shine",
    "description": "Joias artesanais em prata 925 e pedras naturais",
    "numberOfItems": "270+",
    "itemListOrder": "https://schema.org/ItemListUnordered"
  }
}
</script>
