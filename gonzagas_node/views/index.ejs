<main>
    <!-- Hero Section with Video Background -->
    <section class="hero">
      <div class="video-background-container"> 
        <video autoplay muted loop playsinline class="video-background" poster="/images/placeholder-hero.jpg" data-poster-mobile="/images/placeholder-hero-mobile.jpg">
          <source src="/videos/hero-background.mp4" type="video/mp4">
          Your browser does not support the video tag.
        </video>
      </div>
      <div class="hero-content">
        <h1><%= siteTitle %></h1>
        <p><%= siteDescription %></p>
      </div>
    </section>
    
    <!-- Featured Products -->
    <% if (typeof siteSettings !== 'undefined' && siteSettings.featured_carousel_enabled) { %>
    <section class="featured-section">
      <div class="section-header">
        <h2>Featured Pieces</h2>
        <div class="geometric-divider">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>

      <!-- Slick Carousel -->
      <div class="featured-carousel">
        <% featured.forEach(product => { %>
          <div class="slick-slide">
            <%- include('partials/_productCard', {product: product, isCatalogPage: false}) %>
          </div>
        <% }); %>
      </div>

      <style>
        .featured-carousel {
          margin: 30px auto;
          max-width: 1200px;
          padding: 0 20px;
        }
        .slick-slide {
          padding: 0 15px;
          box-sizing: border-box;
        }
        .slick-prev:before,
        .slick-next:before {
          color: var(--color-accent);
          font-size: 24px;
        }
        .slick-dots li button:before {
          font-size: 12px;
          color: var(--color-accent);
        }
        .slick-dots li.slick-active button:before {
          color: var(--color-highlight);
        }
      </style>


    </section>
    <% } %>
    

</main>