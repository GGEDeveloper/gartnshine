<main>
    <!-- Hero Section with Video Background -->
    <section class="hero">
      <div class="video-background-container"> 
        <video autoplay muted loop playsinline class="video-background" poster="/images/placeholder-hero.jpg" data-poster-mobile="/images/placeholder-hero-mobile.jpg">
          <source src="/videos/hero-background.mp4" type="video/mp4">
          Your browser does not support the video tag.
        </video>
      </div>
      <div class="hero-overlay"> 
        <div class="hero-content">
          <h1><%= siteTitle %></h1>
          <p><%= siteDescription %></p>
        </div>
      </div>
    </section>
    
    <!-- Featured Products -->
    <section class="featured-section">
      <div class="section-header">
        <h2>Featured Pieces</h2>
        <div class="geometric-divider">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
      <div class="product-grid">
        <% featured.slice(0, 4).forEach(product => { %>
          <div class="product-card">
            <div class="product-image">
              <img src="/media/<%= product.image_filename %>" alt="<%= product.name %>" loading="lazy">
              <div class="product-overlay">
                <a href="/product/<%= product.id %>" class="btn">View Details</a>
              </div>
            </div>
            <div class="product-info">
              <h3><%= product.name %></h3>
              <p class="product-category"><%= product.category %></p>
              <p class="price">
                <% if (product.sale_price) { %>
                  <span class="sale-price">$<%= Number(product.sale_price).toFixed(2) %></span>
                  <span class="original-price">$<%= Number(product.price).toFixed(2) %></span>
                <% } else { %>
                  $<%= Number(product.price).toFixed(2) %>
                <% } %>
              </p>
            </div>
          </div>
        <% }); %>
      </div>
    </section>
    

</main>