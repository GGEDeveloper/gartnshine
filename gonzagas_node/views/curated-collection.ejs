<div class="collection-page">
  <%
    // Imagem escolhida no admin; sem ela, a foto da primeira peça da coleção.
    const first = products.length > 0 ? products[0] : null;
    const headerImage = collection.hero_image
      || (first && first.image_url ? productImg(first.image_url, 'full').jpg : null);
  %>
  <section class="collection-header<%= headerImage ? ' has-background' : '' %>"
           <% if (headerImage) { %>style="background-image: url('<%= encodeURI(headerImage) %>'); background-size: cover; background-position: center;"<% } %>>
    <div class="collection-title">
      <h1><%= collection.name %></h1>
      <div class="geometric-divider">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <% if (collection.description) { %>
        <p class="collection-description"><%= collection.description %></p>
      <% } %>
    </div>
  </section>

  <section class="products-section">
    <div class="products-grid">
      <% if (products && products.length > 0) { %>
        <% products.forEach(product => { %>
          <%- include('partials/_productCard', {product: product}) %>
        <% }); %>
      <% } else { %>
        <div class="no-products">
          <p>Esta coleção ainda não tem peças disponíveis.</p>
          <a href="/catalog" class="btn btn-primary">Ver o catálogo</a>
        </div>
      <% } %>
    </div>
  </section>

  <section class="collection-nav">
    <h3>Continuar a explorar</h3>
    <div class="collections-list">
      <a href="/catalog" class="collection-link">Catálogo completo</a>
      <a href="/collections" class="collection-link">Galeria de Peças</a>
    </div>
  </section>
</div>

<%- include('partials/schema-breadcrumb', {
  breadcrumbs: [
    { name: 'Início', url: '/' },
    { name: collection.name, url: '/colecao/' + collection.slug }
  ]
}) %>
