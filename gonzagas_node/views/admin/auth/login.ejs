<div class="login-wrapper">
  <div class="login-card">
    <div class="login-card-body">
      <div class="text-center mb-4">
        <img src="/logo.svg" alt="Logo" class="login-logo">
        <h3 class="login-title mt-3"><%= typeof title !== 'undefined' ? title : 'Admin Login' %></h3>
      </div>

      <% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
        <div class="alert alert-danger" role="alert">
          <% error_msg.forEach(function(message) { %><%= message %><br><% }); %>
        </div>
      <% } %>
      <% if (typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
        <div class="alert alert-success" role="alert">
          <% success_msg.forEach(function(message) { %><%= message %><br><% }); %>
        </div>
      <% } %>

      <form action="/admin/login" method="POST" class="login-form">
        <div class="mb-3">
          <label for="email" class="form-label">Email</label>
          <input type="email" class="form-control form-control-lg" id="email" name="email" required autofocus 
                 inputmode="email" autocomplete="email" placeholder="email@exemplo.com">
        </div>
        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <input type="password" class="form-control form-control-lg" id="password" name="password" required 
                 autocomplete="current-password" placeholder="••••••••">
        </div>
        <button type="submit" class="btn btn-primary btn-lg w-100 py-3 mt-2">Entrar</button>
      </form>
    </div>
  </div>
</div>

<style>
  .login-wrapper {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    padding-bottom: max(1rem, env(safe-area-inset-bottom));
  }
  .login-card {
    width: 100%;
    max-width: 380px;
    background: var(--color-secondary, #0b1016);
    border: 1px solid var(--border-soft, rgba(255,255,255,0.07));
    border-radius: 12px;
    box-shadow: 0 4px 32px rgba(0,0,0,0.5);
  }
  .login-card-body { padding: 2rem 1.5rem; }
  .login-logo { max-height: 100px; width: auto; }
  .login-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--igp-gold, #c9a84c);
  }
  .login-form .form-label { font-weight: 500; color: var(--color-silver-light, #e8e8e8); }
  .login-form .form-control-lg {
    font-size: 1rem;
    min-height: 48px;
    padding: 0.75rem 1rem;
    background: rgba(255,255,255,0.05);
    border: 1px solid var(--border-soft, rgba(255,255,255,0.15));
    color: var(--color-silver-light, #e8e8e8);
  }
  .login-form .form-control-lg::placeholder { color: rgba(232,232,232,0.4); }
  .login-form .form-control-lg:focus {
    background: rgba(255,255,255,0.08);
    border-color: var(--igp-gold, #c9a84c);
    color: var(--color-silver-light, #e8e8e8);
    box-shadow: 0 0 0 0.2rem rgba(201,168,76,0.25);
  }
  .login-form .btn-lg {
    min-height: 48px;
    font-weight: 600;
    font-size: 1rem;
    background: var(--igp-gold, #c9a84c);
    border-color: var(--igp-gold, #c9a84c);
    color: #05070a;
  }
  .login-form .btn-lg:hover {
    background: #b8973f;
    border-color: #b8973f;
  }
  @media (max-width: 576px) {
    .login-wrapper { padding: 0.75rem; }
    .login-card-body { padding: 1.5rem 1rem; }
    .login-logo { max-height: 80px; }
  }
</style>
