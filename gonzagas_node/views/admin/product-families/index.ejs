<div class="container-fluid px-3 px-md-4 py-3">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
      <i class="fas fa-tags me-2"></i>Categorias e Cores
    </h1>
    <a href="/admin/product-families/create" class="btn btn-primary btn-sm">
      <i class="fas fa-plus"></i> Nova Categoria
    </a>
  </div>

  <%- include('../partials/flash-messages') %>

  <ul class="nav nav-tabs mb-3 mb-md-4" id="mainTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active py-3" id="categories-tab" data-bs-toggle="tab" data-bs-target="#categories" type="button" role="tab">
        <i class="fas fa-folder-open me-1"></i> Categorias
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link py-3" id="colors-tab" data-bs-toggle="tab" data-bs-target="#colors" type="button" role="tab">
        <i class="fas fa-palette me-1"></i> Cores
      </button>
    </li>
  </ul>

  <div class="tab-content" id="mainTabsContent">
    <!-- Categorias (árvore) -->
    <div class="tab-pane fade show active" id="categories" role="tabpanel">
      <div class="card shadow mb-4">
        <div class="card-header py-2">
          <h6 class="m-0 fw-semibold">Categorias (árvore)</h6>
          <small class="text-muted">Suporta subcategorias, sub-subcategorias, etc.</small>
        </div>
        <div class="card-body p-2 p-md-3">
          <% if (familiesTree && familiesTree.length > 0) { %>
            <div class="table-responsive pf-table-wrapper d-none d-md-block">
              <table class="table table-sm table-hover mb-0">
                <thead>
                  <tr>
                    <th>Código / Nome</th>
                    <th>Descrição</th>
                    <th>Produtos</th>
                    <th style="width: 120px;">Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <%- include('_tree-row', { nodes: familiesTree, depth: 0 }) %>
                </tbody>
              </table>
            </div>
            <!-- Mobile: cards em árvore -->
            <div class="pf-mobile-cards d-md-none">
              <%- include('_tree-mobile', { nodes: familiesTree, depth: 0 }) %>
            </div>
          <% } else { %>
            <p class="text-muted mb-0">Nenhuma categoria. <a href="/admin/product-families/create">Criar a primeira</a>.</p>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Cores -->
    <div class="tab-pane fade" id="colors" role="tabpanel">
      <div class="card shadow mb-4">
        <div class="card-header py-2 d-flex justify-content-between align-items-center">
          <h6 class="m-0 fw-semibold">Opções de Cor</h6>
          <button type="button" class="btn btn-sm btn-primary py-2 px-3" data-bs-toggle="modal" data-bs-target="#addColorModal">
            <i class="fas fa-plus"></i> Nova Cor
          </button>
        </div>
        <div class="card-body p-2 p-md-3">
          <% if (colors && colors.length > 0) { %>
            <div class="row g-2">
              <% colors.forEach(c => { %>
                <div class="col-12 col-md-6 col-lg-4">
                  <div class="card border h-100">
                    <div class="card-body p-2 d-flex align-items-center">
                      <% if (c.hex_code) { %>
                        <span class="rounded me-2 d-inline-block" style="width:24px;height:24px;background:<%= c.hex_code %>;border:1px solid #ddd;"></span>
                      <% } else { %>
                        <span class="rounded me-2 d-inline-block img-placeholder" style="width:24px;height:24px;"></span>
                      <% } %>
                      <span class="flex-grow-1"><%= c.name %></span>
                      <div>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#editColorModal<%= c.id %>">
                          <i class="fas fa-edit"></i>
                        </button>
                        <form action="/admin/product-families/colors/delete/<%= c.id %>" method="POST" class="d-inline" onsubmit="return confirm('Eliminar esta cor?');">
                          <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fas fa-trash"></i></button>
                        </form>
                      </div>
                    </div>
                  </div>
                </div>
                <!-- Edit Color Modal -->
                <div class="modal fade" id="editColorModal<%= c.id %>" tabindex="-1">
                  <div class="modal-dialog">
                    <div class="modal-content">
                      <form action="/admin/product-families/colors/edit/<%= c.id %>" method="POST">
                        <div class="modal-header">
                          <h5 class="modal-title">Editar Cor</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                          <div class="mb-2">
                            <label class="form-label">Nome</label>
                            <input type="text" class="form-control form-control-lg" name="name" value="<%= c.name %>" required>
                          </div>
                          <div class="mb-2">
                            <label class="form-label">Código Hex (opcional)</label>
                            <input type="text" class="form-control form-control-lg" name="hex_code" value="<%= c.hex_code || '' %>" placeholder="#C0C0C0">
                          </div>
                          <div class="mb-2">
                            <label class="form-label">Ordem</label>
                            <input type="number" class="form-control form-control-lg" name="sort_order" value="<%= c.sort_order || 0 %>">
                          </div>
                          <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="is_active" value="1" id="active<%= c.id %>" <%= c.is_active ? 'checked' : '' %>>
                            <label class="form-check-label" for="active<%= c.id %>">Ativa</label>
                          </div>
                        </div>
                        <div class="modal-footer">
                          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                          <button type="submit" class="btn btn-primary">Guardar</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <p class="text-muted mb-0">Nenhuma cor definida. Adicione cores para usar nos produtos.</p>
            <p class="small text-muted mt-1">Se a tabela de cores ainda não existir, execute a migração: <code>_dev-info/schema/migration_product_colors_20260211.sql</code></p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Add Color Modal -->
<div class="modal fade" id="addColorModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/admin/product-families/colors/create" method="POST">
        <div class="modal-header">
          <h5 class="modal-title">Nova Cor</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-2">
            <label class="form-label">Nome *</label>
            <input type="text" class="form-control form-control-lg" name="name" required placeholder="Ex: Prata">
          </div>
          <div class="mb-2">
            <label class="form-label">Código Hex (opcional)</label>
            <input type="text" class="form-control" name="hex_code" placeholder="#C0C0C0">
          </div>
          <div class="mb-2">
            <label class="form-label">Ordem</label>
            <input type="number" class="form-control form-control-lg" name="sort_order" value="0">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Adicionar</button>
        </div>
      </form>
    </div>
  </div>
</div>
