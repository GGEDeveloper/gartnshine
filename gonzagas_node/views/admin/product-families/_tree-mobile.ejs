<% if (nodes && nodes.length > 0) { %>
  <% nodes.forEach(function(f) { %>
    <div class="pf-mobile-card card mb-2" style="margin-left: <%= depth * 16 %>px;">
      <div class="card-body py-3">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <code class="me-2"><%= f.code %></code>
            <% if (depth > 0) { %><span class="text-muted">└</span> <% } %>
            <strong><%= f.name %></strong>
            <span class="badge bg-secondary ms-2"><%= f.product_count || 0 %></span>
          </div>
          <div class="d-flex gap-1">
            <a href="/admin/product-families/edit/<%= f.id %>" class="btn btn-outline-primary btn-sm"><i class="fas fa-edit"></i></a>
            <form action="/admin/product-families/delete/<%= f.id %>" method="POST" class="d-inline" onsubmit="return confirm('Eliminar?');">
              <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fas fa-trash"></i></button>
            </form>
          </div>
        </div>
      </div>
    </div>
    <% if (f.children && f.children.length > 0) { %>
      <%- include('_tree-mobile', { nodes: f.children, depth: depth + 1 }) %>
    <% } %>
  <% }); %>
<% } %>
