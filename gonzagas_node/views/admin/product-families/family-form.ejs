<link rel="stylesheet" href="/css/admin-category-images.css?v=<%= app && app.version ? app.version : '1' %>">

<div class="container-fluid px-3 px-md-4 py-3">
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-3">
    <h1 class="h4 mb-0"><%= title %></h1>
    <div class="d-flex gap-2">
      <% if (!isNew && family.slug) { %>
        <a href="/categoria/<%= family.slug %>" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm">
          <i class="fas fa-external-link-alt"></i> Ver página pública
        </a>
      <% } %>
      <a href="/admin/product-families" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left"></i> Voltar
      </a>
    </div>
  </div>

  <%- include('../partials/flash-messages') %>

  <div class="card shadow mb-4">
    <div class="card-header py-3">
      <h6 class="m-0 fw-semibold">Identificação</h6>
    </div>
    <div class="card-body">
      <form action="<%= isNew ? '/admin/product-families/create' : '/admin/product-families/edit/' + family.id %>" method="POST">
        <div class="mb-3">
          <label for="name" class="form-label">Nome *</label>
          <input type="text" class="form-control form-control-lg" id="name" name="name" value="<%= family.name || '' %>" required>
        </div>
        <div class="mb-3">
          <label for="code" class="form-label">Código (indicativo) *</label>
          <input type="text" class="form-control form-control-lg" id="code" name="code" value="<%= family.code || '' %>"
                 placeholder="Ex: PAN, PPB" required <%= (isNew || (typeof canEditCode !== 'undefined' && canEditCode)) ? '' : 'readonly' %>>
          <small class="text-muted">Usado para referências (ex: PAN0001). Pode alterar apenas se não houver produtos nesta categoria.</small>
        </div>
        <div class="mb-3">
          <label for="parent_id" class="form-label">Subcategoria de</label>
          <select class="form-select form-control-lg" id="parent_id" name="parent_id">
            <option value="">— Categoria principal (raiz) —</option>
            <% (parentOptions || []).forEach(function(opt) { %>
              <option value="<%= opt.id %>" <%= family.parent_id == opt.id ? 'selected' : '' %>>
                <%= '　'.repeat(opt.depth || 0) %><%= opt.depth > 0 ? '└ ' : '' %><%= opt.name %> (<%= opt.code %>)
              </option>
            <% }); %>
          </select>
          <small class="text-muted">Pode escolher qualquer nível: categoria, subcategoria, sub-subcategoria, etc.</small>
        </div>
        <div class="mb-3">
          <label for="description" class="form-label">Descrição</label>
          <textarea class="form-control form-control-lg" id="description" name="description" rows="2"><%= family.description || '' %></textarea>
          <small class="text-muted">Aparece por baixo do título na página da categoria.</small>
        </div>

        <% if (!isNew) { %>
          <hr class="my-4">
          <h6 class="fw-semibold mb-3">Página pública</h6>

          <div class="mb-3">
            <label class="form-label">Endereço</label>
            <div class="input-group">
              <span class="input-group-text">artnshine.pt/categoria/</span>
              <input type="text" class="form-control" value="<%= family.slug || '' %>" readonly>
            </div>
            <small class="text-muted">
              O endereço não muda ao renomear a categoria: se mudasse, os links já
              indexados no Google deixavam de funcionar.
            </small>
          </div>

          <div class="mb-3">
            <label for="seo_title" class="form-label">Título para os motores de busca</label>
            <input type="text" class="form-control" id="seo_title" name="seo_title"
                   maxlength="255" value="<%= family.seo_title || '' %>"
                   placeholder="<%= family.name %>">
            <small class="text-muted">
              Vazio = usa o nome da categoria. Cerca de 60 caracteres é o que o
              Google mostra antes de cortar.
            </small>
          </div>

          <div class="mb-3">
            <label for="seo_description" class="form-label">Descrição para os motores de busca</label>
            <textarea class="form-control" id="seo_description" name="seo_description"
                      rows="2" maxlength="320"
                      placeholder="Gerada a partir do conteúdo se deixar vazio."><%= family.seo_description || '' %></textarea>
            <small class="text-muted">
              É a linha que aparece por baixo do título nos resultados de pesquisa.
              Entre 120 e 160 caracteres.
            </small>
          </div>

          <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" role="switch"
                   id="is_active" name="is_active"
                   <%= (family.is_active === undefined || family.is_active) ? 'checked' : '' %>>
            <label class="form-check-label" for="is_active">Categoria activa</label>
            <small class="d-block text-muted">Desactivar esconde-a da navegação pública.</small>
          </div>
        <% } %>

        <div class="d-flex flex-column flex-sm-row gap-2">
          <a href="/admin/product-families" class="btn btn-secondary">Cancelar</a>
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> <%= isNew ? 'Criar' : 'Guardar' %>
          </button>
        </div>
      </form>
    </div>
  </div>

  <% if (!isNew) {
       /* Os dois enquadramentos que a categoria usa. Estão separados de
          propósito: a mesma fotografia raramente funciona bem nas duas
          proporções sem ser reenquadrada. */
       const editores = [
         {
           tipo: 'hero',
           titulo: 'Faixa da página de categoria',
           ratio: 16 / 9,
           proporcao: '16:9',
           onde: 'Fundo do cabeçalho em /categoria/' + (family.slug || family.id) + '.',
           imagem: family.hero_image,
           origem: family.hero_source || family.hero_image,
           crop: family.hero_crop
         },
         {
           tipo: 'card',
           titulo: 'Cartão da loja e da página inicial',
           ratio: 4 / 5,
           proporcao: '4:5',
           onde: 'Cartão "Explorar por material" na loja e na página inicial.',
           imagem: family.card_image,
           origem: family.card_source || family.card_image,
           crop: family.card_crop
         }
       ];
  %>
    <% editores.forEach(function (ed) { %>
      <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
          <h6 class="m-0 fw-semibold"><%= ed.titulo %></h6>
          <span class="badge bg-secondary"><%= ed.proporcao %></span>
        </div>
        <div class="card-body">
          <p class="text-muted small mb-3"><%= ed.onde %></p>

          <form action="/admin/product-families/edit/<%= family.id %>/imagem/<%= ed.tipo %>"
                method="POST" enctype="multipart/form-data">

            <div class="cat-img" data-cropper
                 data-tipo="<%= ed.tipo %>"
                 data-ratio="<%= ed.ratio %>"
                 data-origem="<%= ed.origem || '' %>"
                 data-crop="<%= ed.crop || '' %>"
                 hidden>

              <div class="cat-img__editor">
                <div class="cat-img__palco" data-palco
                     style="aspect-ratio: <%= ed.proporcao.replace(':', ' / ') %>;"
                     role="application"
                     aria-label="Enquadramento da imagem: arraste para mover, use a roda do rato ou as teclas + e - para aproximar">
                  <img data-imagem alt="" draggable="false">
                  <div class="cat-img__grelha" aria-hidden="true"></div>
                </div>

                <div class="cat-img__controlos">
                  <label class="cat-img__zoom">
                    <span>Aproximar</span>
                    <input type="range" data-zoom min="100" max="600" value="100" step="1">
                  </label>
                  <button type="button" class="btn btn-sm btn-outline-secondary" data-centrar>
                    <i class="fas fa-crosshairs"></i> Centrar
                  </button>
                </div>

                <p class="cat-img__aviso" data-aviso hidden>
                  <i class="fas fa-triangle-exclamation"></i>
                  Este recorte é mais pequeno do que o tamanho final — a imagem
                  vai ser esticada e perde nitidez. Aproxime menos, ou use uma
                  fotografia maior.
                </p>
              </div>

              <input type="hidden" name="crop" data-campo-crop value="">
              <input type="hidden" name="origem" data-campo-origem value="<%= ed.origem || '' %>">

              <div class="cat-img__fontes">
                <div class="cat-img__fonte">
                  <p class="fw-semibold small mb-2">Escolher da galeria</p>
                  <% if (typeof galleryImages !== 'undefined' && galleryImages.length > 0) { %>
                    <div class="cat-img__galeria">
                      <% galleryImages.forEach(function (img) { %>
                        <button type="button"
                                class="cat-img__miniatura<%= ed.origem === img.path ? ' is-activo' : '' %>"
                                data-escolher="<%= img.path %>"
                                title="<%= img.filename %>">
                          <img src="<%= img.path %>" alt="<%= img.filename %>" loading="lazy">
                        </button>
                      <% }); %>
                    </div>
                  <% } else { %>
                    <p class="text-muted small mb-0">Ainda não há imagens em <code>public/media/gallery</code>.</p>
                  <% } %>
                </div>

                <div class="cat-img__fonte">
                  <p class="fw-semibold small mb-2">Ou enviar uma nova</p>
                  <input type="file" name="ficheiro" data-ficheiro
                         accept="image/jpeg,image/png,image/gif,image/webp"
                         class="form-control form-control-sm">
                  <small class="d-block text-muted mt-2">
                    JPG, PNG, GIF ou WebP, até 8MB. Fica também disponível na galeria.
                  </small>
                </div>
              </div>
            </div>

            <noscript>
              <p class="text-muted small">
                O ajuste de enquadramento precisa de JavaScript. Sem ele, a imagem
                enviada é recortada pelo centro.
              </p>
              <input type="file" name="ficheiro" accept="image/jpeg,image/png,image/gif,image/webp" class="form-control mb-2">
            </noscript>

            <div class="d-flex flex-wrap gap-2 mt-3">
              <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Guardar enquadramento
              </button>
              <% if (ed.imagem) { %>
                <button type="submit" name="remover" value="1"
                        class="btn btn-outline-danger"
                        formnovalidate>
                  <i class="fas fa-trash"></i> Remover imagem
                </button>
              <% } %>
            </div>
          </form>

          <% if (ed.imagem) { %>
            <div class="cat-img__actual mt-3">
              <p class="fw-semibold small mb-2">Em uso agora:</p>
              <img src="<%= ed.imagem %>" alt="Imagem actual de <%= family.name %>"
                   style="aspect-ratio: <%= ed.proporcao.replace(':', ' / ') %>;">
              <code class="small d-block mt-1 text-muted"><%= ed.imagem %></code>
            </div>
          <% } %>
        </div>
      </div>
    <% }); %>

    <script src="/admin/js/category-cropper.js?v=<%= app && app.version ? app.version : '1' %>" defer></script>
  <% } %>
</div>
