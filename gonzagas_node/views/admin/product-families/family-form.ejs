<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0 text-gray-800"><%= title %></h1>
    <a href="/admin/product-families" class="btn btn-outline-secondary btn-sm">
      <i class="fas fa-arrow-left"></i> Voltar
    </a>
  </div>

  <%- include('../partials/flash-messages') %>

  <div class="card shadow mb-4">
    <div class="card-body">
      <form action="<%= isNew ? '/admin/product-families/create' : '/admin/product-families/edit/' + family.id %>" method="POST">
        <div class="mb-3">
          <label for="name" class="form-label">Nome *</label>
          <input type="text" class="form-control" id="name" name="name" value="<%= family.name || '' %>" required>
        </div>
        <div class="mb-3">
          <label for="code" class="form-label">Código (indicativo) *</label>
          <input type="text" class="form-control" id="code" name="code" value="<%= family.code || '' %>" 
                 placeholder="Ex: PAN, PPB" required <%= (isNew || (typeof canEditCode !== 'undefined' && canEditCode)) ? '' : 'readonly' %>>
          <small class="text-muted">Usado para referências (ex: PAN0001). Pode alterar apenas se não houver produtos nesta categoria.</small>
        </div>
        <div class="mb-3">
          <label for="parent_id" class="form-label">Subcategoria de</label>
          <select class="form-select" id="parent_id" name="parent_id">
            <option value="">— Categoria principal —</option>
            <% (categories || []).forEach(c => { %>
              <option value="<%= c.id %>" <%= family.parent_id == c.id ? 'selected' : '' %>><%= c.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="mb-3">
          <label for="description" class="form-label">Descrição</label>
          <textarea class="form-control" id="description" name="description" rows="2"><%= family.description || '' %></textarea>
        </div>
        <div class="d-flex gap-2">
          <a href="/admin/product-families" class="btn btn-secondary">Cancelar</a>
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> <%= isNew ? 'Criar' : 'Guardar' %>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
