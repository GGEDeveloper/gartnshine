<div class="container-fluid px-3 px-md-4 py-3">
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-3">
    <h1 class="h4 mb-0"><%= title %></h1>
    <a href="/admin/product-families" class="btn btn-outline-secondary btn-sm">
      <i class="fas fa-arrow-left"></i> Voltar
    </a>
  </div>

  <%- include('../partials/flash-messages') %>

  <div class="card shadow mb-4">
    <div class="card-body">
      <form action="<%= isNew ? '/admin/product-families/create' : '/admin/product-families/edit/' + family.id %>" method="POST">
        <div class="mb-3">
          <label for="name" class="form-label">Nome *</label>
          <input type="text" class="form-control form-control-lg" id="name" name="name" value="<%= family.name || '' %>" required>
        </div>
        <div class="mb-3">
          <label for="code" class="form-label">Código (indicativo) *</label>
          <input type="text" class="form-control form-control-lg" id="code" name="code" value="<%= family.code || '' %>" 
                 placeholder="Ex: PAN, PPB" required <%= (isNew || (typeof canEditCode !== 'undefined' && canEditCode)) ? '' : 'readonly' %>>
          <small class="text-muted">Usado para referências (ex: PAN0001). Pode alterar apenas se não houver produtos nesta categoria.</small>
        </div>
        <div class="mb-3">
          <label for="parent_id" class="form-label">Subcategoria de</label>
          <select class="form-select form-control-lg" id="parent_id" name="parent_id">
            <option value="">— Categoria principal (raiz) —</option>
            <% (parentOptions || []).forEach(function(opt) { %>
              <option value="<%= opt.id %>" <%= family.parent_id == opt.id ? 'selected' : '' %>>
                <%= '　'.repeat(opt.depth || 0) %><%= opt.depth > 0 ? '└ ' : '' %><%= opt.name %> (<%= opt.code %>)
              </option>
            <% }); %>
          </select>
          <small class="text-muted">Pode escolher qualquer nível: categoria, subcategoria, sub-subcategoria, etc.</small>
        </div>
        <div class="mb-3">
          <label for="description" class="form-label">Descrição</label>
          <textarea class="form-control form-control-lg" id="description" name="description" rows="2"><%= family.description || '' %></textarea>
        </div>
        <div class="d-flex flex-column flex-sm-row gap-2">
          <a href="/admin/product-families" class="btn btn-secondary">Cancelar</a>
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> <%= isNew ? 'Criar' : 'Guardar' %>
          </button>
        </div>
      </form>
    </div>
  </div>

  <% if (!isNew) { %>
    <div class="card shadow mb-4">
      <div class="card-header py-3">
        <h6 class="m-0 fw-semibold">Imagem de destaque da coleção</h6>
      </div>
      <div class="card-body">
        <p class="text-muted mb-3">
          Usada como fundo do cabeçalho da página pública desta coleção
          (<code>/categoria/<%= family.slug || family.id %></code>) e nos cartões de coleções da
          página inicial. Sem imagem escolhida, a página mostra apenas o título em texto.
        </p>

        <div class="mb-4">
          <p class="fw-semibold mb-2">Em uso atualmente:</p>
          <% if (family.hero_image) { %>
            <div class="d-flex align-items-center gap-3 flex-wrap">
              <img src="<%= family.hero_image %>" alt="Imagem de destaque de <%= family.name %>"
                   style="width: 220px; height: 90px; object-fit: cover; border-radius: 8px; border: 1px solid #dee2e6;">
              <div>
                <code class="d-block"><%= family.hero_image %></code>
                <form action="/admin/product-families/edit/<%= family.id %>/hero-image" method="POST" class="mt-2">
                  <input type="hidden" name="remove_hero_image" value="1">
                  <button type="submit" class="btn btn-sm btn-outline-secondary">Remover imagem</button>
                </form>
              </div>
            </div>
          <% } else { %>
            <p class="text-muted mb-0">Nenhuma imagem escolhida — o cabeçalho mostra apenas o título.</p>
          <% } %>
        </div>

        <hr>

        <div class="row g-4">
          <div class="col-12 col-lg-7">
            <p class="fw-semibold mb-2">Escolher uma imagem já existente na galeria</p>
            <% if (typeof galleryImages !== 'undefined' && galleryImages.length > 0) { %>
              <form action="/admin/product-families/edit/<%= family.id %>/hero-image" method="POST">
                <div class="d-flex flex-wrap gap-2 mb-3" style="max-height: 320px; overflow-y: auto;">
                  <% galleryImages.forEach(function(img) { %>
                    <label style="cursor: pointer;" title="<%= img.filename %>">
                      <input type="radio" name="hero_image_existing" value="<%= img.path %>" class="visually-hidden"
                             <%= family.hero_image === img.path ? 'checked' : '' %>>
                      <img src="<%= img.path %>" alt="<%= img.filename %>"
                           style="width: 110px; height: 70px; object-fit: cover; border-radius: 6px; border: 3px solid <%= family.hero_image === img.path ? '#0d6efd' : 'transparent' %>;">
                    </label>
                  <% }); %>
                </div>
                <button type="submit" class="btn btn-primary">Usar imagem selecionada</button>
              </form>
              <script>
                document.querySelectorAll('input[name="hero_image_existing"]').forEach(function (radio) {
                  radio.addEventListener('change', function () {
                    document.querySelectorAll('input[name="hero_image_existing"]').forEach(function (r) {
                      r.nextElementSibling.style.borderColor = r.checked ? '#0d6efd' : 'transparent';
                    });
                  });
                });
              </script>
            <% } else { %>
              <p class="text-muted">Ainda não há imagens em <code>public/media/gallery</code>.</p>
            <% } %>
          </div>

          <div class="col-12 col-lg-5">
            <p class="fw-semibold mb-2">Ou enviar uma imagem nova</p>
            <form action="/admin/product-families/edit/<%= family.id %>/hero-image" method="POST" enctype="multipart/form-data">
              <input type="file" name="hero_image_file" accept="image/jpeg,image/png,image/gif,image/webp" class="form-control mb-3" required>
              <button type="submit" class="btn btn-primary">Enviar e usar nesta coleção</button>
              <small class="d-block form-text text-muted mt-2">JPG, PNG, GIF ou WebP, até 8MB. Fica também disponível na galeria geral.</small>
            </form>
          </div>
        </div>
      </div>
    </div>
  <% } %>
</div>
