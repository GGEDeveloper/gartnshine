<div class="container-fluid px-3 px-md-4 py-3">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="fas fa-gem me-2"></i>Coleções</h1>
  </div>

  <%- include('../partials/flash-messages') %>

  <div class="alert alert-dark border">
    <p class="mb-1">
      Uma <strong>coleção</strong> é um conjunto de peças escolhidas à mão — por exemplo
      &laquo;Verão&raquo; ou &laquo;Pedras Naturais&raquo;.
    </p>
    <p class="mb-0 small text-muted">
      Cada peça mantém a sua categoria (Anéis&nbsp;-&nbsp;Prata, etc.) e pode entrar em
      várias coleções. As categorias continuam a gerir-se em
      <a href="/admin/product-families">Categorias e Cores</a> e as imagens do site em
      <a href="/admin/site-appearance">Aspeto do Site</a>.
    </p>
  </div>

  <!-- Criar -->
  <div class="card shadow mb-4">
    <div class="card-header py-2">
      <h6 class="m-0 fw-semibold">Nova coleção</h6>
    </div>
    <div class="card-body">
      <form action="/admin/collections/create" method="POST" class="row g-2 align-items-end">
        <div class="col-12 col-md-8">
          <label for="new-name" class="form-label small mb-1">Nome</label>
          <input type="text" class="form-control" id="new-name" name="name" required maxlength="150"
                 placeholder="Ex: Coleção Verão">
        </div>
        <div class="col-12 col-md-4">
          <button type="submit" class="btn btn-primary w-100">
            <i class="fas fa-plus"></i> Criar e escolher peças
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Lista -->
  <% if (collections.length === 0) { %>
    <p class="text-muted">Ainda não há coleções. Crie a primeira acima.</p>
  <% } else { %>
    <div class="row g-3">
      <% collections.forEach(function(c) { %>
        <div class="col-12 col-lg-6 col-xxl-4">
          <div class="card h-100 <%= c.is_active ? '' : 'opacity-75' %>">
            <div class="card-body p-3">
              <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                <div style="min-width: 0;">
                  <h6 class="mb-1 text-truncate"><%= c.name %></h6>
                  <small class="text-muted d-block">
                    <%= c.product_count %> peça<%= Number(c.product_count) === 1 ? '' : 's' %>
                    <% if (!c.is_active) { %>· <span class="text-warning">oculta</span><% } %>
                  </small>
                  <small class="text-muted">/colecao/<%= c.slug %></small>
                </div>
                <% if (c.card_image || c.hero_image) { %>
                  <img src="<%= encodeURI(c.card_image || c.hero_image) %>" alt=""
                       onerror="this.onerror=null;this.src='/images/imagem-nao-disponivel.svg'"
                       style="width: 76px; height: 52px; object-fit: cover; border-radius: 5px; flex-shrink: 0;">
                <% } %>
              </div>

              <div class="d-flex gap-2 flex-wrap">
                <a href="/admin/collections/<%= c.id %>" class="btn btn-sm btn-primary">
                  <i class="fas fa-sliders"></i> Parametrizar
                </a>
                <% if (Number(c.product_count) > 0 && c.is_active) { %>
                  <a href="/colecao/<%= c.slug %>" target="_blank" rel="noopener"
                     class="btn btn-sm btn-outline-secondary">
                    <i class="fas fa-external-link-alt"></i> Ver
                  </a>
                <% } %>
                <form action="/admin/collections/<%= c.id %>/delete" method="POST" class="ms-auto"
                      onsubmit="return confirm('Apagar a coleção &laquo;<%= c.name %>&raquo;? As peças não são apagadas.');">
                  <button type="submit" class="btn btn-sm btn-outline-danger" title="Apagar coleção">
                    <i class="fas fa-trash"></i>
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>
