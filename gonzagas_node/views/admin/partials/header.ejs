<header class="header">
  <div class="d-flex align-items-center">
    <button class="btn btn-link text-dark d-lg-none me-3" type="button" id="sidebarToggle">
      <i class="fas fa-bars"></i>
    </button>
    <h5 class="mb-0 d-none d-md-block"><%= title %></h5>
  </div>
  
  <div class="d-flex align-items-center">
    <!-- View Frontend Button -->
    <a href="/" target="_blank" class="btn btn-outline-primary btn-sm me-3">
      <i class="fas fa-eye me-1"></i> Ver Site
    </a>

    <!-- User Dropdown -->
    <div class="dropdown">
      <button class="btn btn-link text-dark p-0 d-flex align-items-center" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
        <img src="https://ui-avatars.com/api/?name=Admin&background=4e73df&color=fff" alt="User" class="rounded-circle me-2" width="32" height="32">
        <span class="d-none d-md-inline">Admin</span>
      </button>
      <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
        <li><a class="dropdown-item" href="/admin/profile"><i class="fas fa-user me-2"></i> Perfil</a></li>
        <li><a class="dropdown-item" href="/admin/settings"><i class="fas fa-cog me-2"></i> Configurações</a></li>
        <li><hr class="dropdown-divider"></li>
        <li><a class="dropdown-item text-danger" href="/admin/logout"><i class="fas fa-sign-out-alt me-2"></i> Sair</a></li>
      </ul>
    </div>
  </div>
</header>
