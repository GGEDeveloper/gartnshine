<aside class="sidebar">
  <!-- Sidebar Brand -->
  <div class="sidebar-brand">
    <a href="/admin">
      <img src="/logo.svg" alt="Gonzaga's Art & Shine" class="img-fluid" style="max-height: 80px;">
    </a>
  </div>
  
  <!-- Sidebar Nav -->
  <nav class="sidebar-nav">
    <ul class="nav flex-column">
      <li class="nav-item">
        <a class="nav-link <%= (!currentPath || currentPath === '/' || currentPath === '/dashboard') ? 'active' : '' %>" href="/admin/dashboard">
          <i class="fas fa-fw fa-tachometer-alt"></i>
          <span>Dashboard</span>
        </a>
      </li>
      
      <li class="nav-item">
        <a class="nav-link <%= (currentPath && currentPath.startsWith('/products')) ? 'active' : '' %>" href="/admin/products">
          <i class="fas fa-fw fa-box"></i>
          <span>Products</span>
        </a>
      </li>
      
      <li class="nav-item">
        <a class="nav-link <%= (currentPath && currentPath.startsWith('/quick-product')) ? 'active' : '' %>" href="/admin/quick-product">
          <i class="fas fa-fw fa-bolt"></i>
          <span>Criar Rápido</span>
        </a>
      </li>
      
      <li class="nav-item">
        <a class="nav-link <%= (currentPath && currentPath.startsWith('/product-families')) ? 'active' : '' %>" href="/admin/product-families">
          <i class="fas fa-fw fa-tags"></i>
          <span>Categorias e Cores</span>
        </a>
      </li>
      
      <li class="nav-item">
        <a class="nav-link <%= (currentPath && currentPath.startsWith('/inventory')) ? 'active' : '' %>" href="/admin/inventory">
          <i class="fas fa-fw fa-warehouse"></i>
          <span>Inventory</span>
        </a>
      </li>
      
      <li class="nav-item">
        <a class="nav-link <%= (currentPath && currentPath.startsWith('/checkpoints')) ? 'active' : '' %>" href="/admin/checkpoints">
          <i class="fas fa-fw fa-clipboard-check"></i>
          <span>Checkpoints</span>
        </a>
      </li>
      
      <li class="nav-item mt-auto">
        <a class="nav-link text-danger" href="/admin/logout">
          <i class="fas fa-fw fa-sign-out-alt"></i>
          <span>Logout</span>
        </a>
      </li>
    </ul>
  </nav>
</aside>
