<aside class="sidebar">
  <!-- Sidebar Brand -->
  <div class="sidebar-brand">
    <a href="/admin">
      <img src="/img/logo.png" alt="Gonzaga's Art & Shine" class="img-fluid" style="max-height: 40px;">
    </a>
  </div>
  
  <!-- Sidebar Nav -->
  <nav class="sidebar-nav">
    <ul class="nav flex-column">
      <li class="nav-item">
        <a class="nav-link <%= currentPath === '/admin' || currentPath === '/admin/dashboard' ? 'active' : '' %>" href="/admin/dashboard">
          <i class="fas fa-fw fa-tachometer-alt"></i>
          <span>Dashboard</span>
        </a>
      </li>
      
      <li class="nav-item">
        <a class="nav-link <%= currentPath.startsWith('/admin/products') ? 'active' : '' %>" href="/admin/products">
          <i class="fas fa-fw fa-box"></i>
          <span>Products</span>
        </a>
      </li>
      
      <li class="nav-item">
        <a class="nav-link <%= currentPath.startsWith('/admin/product-families') ? 'active' : '' %>" href="/admin/product-families">
          <i class="fas fa-fw fa-tags"></i>
          <span>Product Families</span>
        </a>
      </li>
      
      <li class="nav-item">
        <a class="nav-link <%= currentPath.startsWith('/admin/inventory') ? 'active' : '' %>" href="/admin/inventory">
          <i class="fas fa-fw fa-warehouse"></i>
          <span>Inventory</span>
        </a>
      </li>
      
      <li class="nav-item">
        <a class="nav-link <%= currentPath.startsWith('/admin/checkpoints') ? 'active' : '' %>" href="/admin/checkpoints">
          <i class="fas fa-fw fa-clipboard-check"></i>
          <span>Checkpoints</span>
        </a>
      </li>
      
      <li class="nav-item mt-auto">
        <a class="nav-link text-danger" href="/admin/logout">
          <i class="fas fa-fw fa-sign-out-alt"></i>
          <span>Logout</span>
        </a>
      </li>
    </ul>
  </nav>
</aside>
