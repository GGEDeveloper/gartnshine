<div class="container-fluid px-3 px-md-4 py-3">
  <style>
    /* Layout base - admin-dark-luxe.css aplica tema escuro */
    .filter-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      align-items: flex-end;
    }
    
    .filter-group {
      flex: 1;
      min-width: 150px;
      margin-bottom: 0;
    }
    
    .filter-group.compact {
      max-width: 120px;
    }
    
    .filter-group.actions {
      flex: 0 0 auto;
      display: flex;
      gap: 0.5rem;
      margin-left: auto;
    }
    
    .filter-group label {
      display: block;
      margin-bottom: 0.25rem;
      font-weight: 600;
      font-size: 0.875rem;
    }
    
    .filter-group .form-control,
    .filter-group .form-select {
      border-radius: 0.25rem;
      padding: 0.375rem 0.75rem;
      font-size: 0.875rem;
    }
    
    .filter-group .btn {
      padding: 0.375rem 0.75rem;
      font-size: 0.875rem;
    }
    
    .column-modal .modal-body .form-check {
      margin-bottom: 0.5rem;
    }

    .table-responsive {
      overflow-x: auto;
    }
  </style>

  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-body">
          <div class="table-filters">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h6 class="mb-0">Filtros</h6>
              <div class="btn-group">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="toggle-columns-btn" data-bs-toggle="modal" data-bs-target="#columnsModal">
                  <i class="fas fa-table me-1"></i> Colunas
                </button>
              </div>
            </div>
            <form id="inventory-filters" class="row g-2" method="GET" action="/admin/inventory">
              <div class="filter-row">
              <div class="filter-group">
                <label for="filter-reference">Referência</label>
                <input type="text" id="filter-reference" name="reference" class="form-control" placeholder="Código de Referência" value="<%= typeof queryParams !== 'undefined' && queryParams.reference ? queryParams.reference : '' %>">
              </div>
              
              <div class="filter-group">
                <label for="filter-category">Categoria</label>
                <select id="filter-category" name="category" class="form-select">
                  <option value="">Todas</option>
                  <% productFamilies.forEach(family => { %>
                    <option value="<%= family.name %>" <%= typeof queryParams !== 'undefined' && queryParams.category === family.name ? 'selected' : '' %>><%= family.name %></option>
                  <% }); %>
                </select>
              </div>
              
              <div class="filter-group">
                <label for="filter-status">Status do Produto</label>
                <select id="filter-status" name="status" class="form-select">
                  <option value="">Todos</option>
                  <option value="active" <%= typeof queryParams !== 'undefined' && queryParams.status === 'active' ? 'selected' : '' %>>Ativo</option>
                  <option value="inactive" <%= typeof queryParams !== 'undefined' && queryParams.status === 'inactive' ? 'selected' : '' %>>Inativo</option>
                </select>
              </div>

              <div class="filter-group">
                <label for="filter-stock">Status do Stock</label>
                <select id="filter-stock" name="stock_status" class="form-select">
                  <option value="">Todos</option>
                  <option value="in_stock" <%= typeof queryParams !== 'undefined' && queryParams.stock_status === 'in_stock' ? 'selected' : '' %>>Em Stock</option>
                  <option value="low_stock" <%= typeof queryParams !== 'undefined' && queryParams.stock_status === 'low_stock' ? 'selected' : '' %>>Stock Baixo</option>
                  <option value="out_of_stock" <%= typeof queryParams !== 'undefined' && queryParams.stock_status === 'out_of_stock' ? 'selected' : '' %>>Fora de Stock</option>
                </select>
              </div>
              
              <div class="filter-group actions">
                <button type="submit" class="btn btn-primary">Aplicar Filtros</button>
                <a href="/admin/inventory" class="btn btn-outline-secondary">Limpar Filtros</a>
              </div>
            </div>
            </form>
          </div>
          
          <!-- Mobile Cards -->
          <div class="inventory-mobile-cards">
            <% products.forEach(product => { %>
              <div class="inventory-mobile-card">
                <div class="card-top">
                  <% if (product.image_url) { %>
                    <img src="/media/products/<%= product.image_url %>" alt="<%= product.name %>" class="card-img">
                  <% } else { %>
                    <div class="card-img img-placeholder d-flex align-items-center justify-content-center"><i class="fas fa-gem text-muted"></i></div>
                  <% } %>
                  <div class="card-info">
                    <div class="ref"><%= product.reference %></div>
                    <div class="cat"><%= product.family_name || '-' %></div>
                  </div>
                </div>
                <div class="card-badges">
                  <% if (product.current_stock > 10) { %>
                    <span class="badge badge-stock-in-stock">Em Stock (<%= product.current_stock %>)</span>
                  <% } else if (product.current_stock > 0) { %>
                    <span class="badge badge-stock-low-stock">Stock Baixo (<%= product.current_stock %>)</span>
                  <% } else { %>
                    <span class="badge badge-stock-out-of-stock">Sem Stock</span>
                  <% } %>
                  <% if (product.is_active) { %>
                    <span class="badge badge-product-active">Ativo</span>
                  <% } else { %>
                    <span class="badge badge-product-inactive">Inativo</span>
                  <% } %>
                </div>
                <div class="card-actions">
                  <a href="/admin/inventory/history/<%= product.id %>" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-history"></i>
                  </a>
                  <a href="/admin/products/edit/<%= product.id %>" class="btn btn-primary btn-sm">
                    <i class="fas fa-edit"></i>
                  </a>
                </div>
              </div>
            <% }); %>
          </div>

          <div class="table-responsive">
            <table class="table table-hover mb-0" id="product-table">
              <thead>
                <tr>
                  <th data-column-name="id">ID</th>
                  <th data-column-name="image">Imagem</th>
                  <th data-column-name="reference">Referência</th>

                  <th data-column-name="category">Categoria</th>
                  <th data-column-name="stock">Stock Atual</th>
                  <th data-column-name="status">Status</th>
                  <th data-column-name="actions">Ações</th>
                </tr>
              </thead>
              <tbody>
                <% products.forEach(product => { %>
                  <tr data-reference="<%= product.reference %>" data-family-name="<%= product.family_name %>" data-is-active="<%= product.is_active ? 'active' : 'inactive' %>" data-stock-quantity="<%= product.current_stock %>">
                    <td><%= product.id %></td>
                    <td class="column-image">
                      <% if (product.image_url) { %>
                        <img src="/media/products/<%= product.image_url %>" alt="<%= product.name %>" class="img-thumbnail" style="width: 50px; height: 50px; object-fit: cover;">
                      <% } else { %>
                        <div class="img-placeholder d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; border-radius: 4px;">
                          <i class="fas fa-gem text-muted"></i>
                        </div>
                      <% } %>
                    </td>
                    <td><%= product.reference %></td>

                    <td><%= product.family_name %></td>
                    <td>
                      <% if (product.current_stock > 10) { %>
                        <span class="badge badge-stock-in-stock">Em Stock (<%= product.current_stock %>)</span>
                      <% } else if (product.current_stock > 0 && product.current_stock <= 10) { %>
                        <span class="badge badge-stock-low-stock">Stock Baixo (<%= product.current_stock %>)</span>
                      <% } else { %>
                        <span class="badge badge-stock-out-of-stock">Fora de Stock (<%= product.current_stock %>)</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (product.is_active) { %>
                        <span class="badge badge-product-active">Ativo</span>
                      <% } else { %>
                        <span class="badge badge-product-inactive">Inativo</span>
                      <% } %>
                    </td>
                    <td>
                      <a href="/admin/inventory/history/<%= product.id %>" class="btn btn-outline-secondary btn-sm me-1" title="Ver Histórico">
                        <i class="fas fa-history"></i>
                      </a>
                      <a href="/admin/products/edit/<%= product.id %>" class="btn btn-primary btn-sm me-1" title="Editar Produto">
                        <i class="fas fa-edit"></i>
                      </a>
                      <button type="button" class="btn btn-danger btn-sm delete-product-btn" data-id="<%= product.id %>" title="Eliminar Produto">
                        <i class="fas fa-trash-alt"></i>
                      </button>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

          <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
            <%
              function buildInvQueryString(page, limit, queryParams) {
                const params = ['page=' + page, 'limit=' + limit];
                if (queryParams && queryParams.reference) params.push('reference=' + encodeURIComponent(queryParams.reference));
                if (queryParams && queryParams.category) params.push('category=' + encodeURIComponent(queryParams.category));
                if (queryParams && queryParams.status) params.push('status=' + encodeURIComponent(queryParams.status));
                if (queryParams && queryParams.stock_status) params.push('stock_status=' + encodeURIComponent(queryParams.stock_status));
                return params.join('&');
              }
              const invPage = typeof currentPage !== 'undefined' ? currentPage : 1;
              const invLimit = typeof limit !== 'undefined' ? limit : 20;
              const invQp = typeof queryParams !== 'undefined' ? queryParams : {};
            %>
            <nav class="mt-3" aria-label="Paginação de inventário">
              <ul class="pagination justify-content-center flex-wrap">
                <li class="page-item <%= invPage <= 1 ? 'disabled' : '' %>">
                  <a class="page-link" href="?<%= buildInvQueryString(invPage - 1, invLimit, invQp) %>">
                    <i class="fas fa-chevron-left"></i>
                  </a>
                </li>
                <% for (let i = 1; i <= totalPages; i++) { %>
                  <% if (totalPages <= 7 || i === 1 || i === totalPages || (i >= invPage - 2 && i <= invPage + 2)) { %>
                    <li class="page-item <%= i === invPage ? 'active' : '' %>">
                      <a class="page-link" href="?<%= buildInvQueryString(i, invLimit, invQp) %>"><%= i %></a>
                    </li>
                  <% } else if (i === invPage - 3 || i === invPage + 3) { %>
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                  <% } %>
                <% } %>
                <li class="page-item <%= invPage >= totalPages ? 'disabled' : '' %>">
                  <a class="page-link" href="?<%= buildInvQueryString(invPage + 1, invLimit, invQp) %>">
                    <i class="fas fa-chevron-right"></i>
                  </a>
                </li>
              </ul>
              <p class="text-center text-muted small mt-1">
                Página <%= invPage %> de <%= totalPages %> · <%= typeof totalProducts !== 'undefined' ? totalProducts : '' %> produtos
              </p>
            </nav>
          <% } %>

        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal de Seleção de Colunas -->
<div class="modal fade column-modal" id="columnsModal" tabindex="-1" aria-labelledby="columnsModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="columnsModalLabel">Selecionar Colunas</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="form-check">
          <input class="form-check-input column-toggle" type="checkbox" value="id" id="toggleId" checked>
          <label class="form-check-label" for="toggleId">ID</label>
        </div>
        <div class="form-check">
          <input class="form-check-input column-toggle" type="checkbox" value="image" id="toggleImage" checked>
          <label class="form-check-label" for="toggleImage">Imagem</label>
        </div>
        <div class="form-check">
          <input class="form-check-input column-toggle" type="checkbox" value="reference" id="toggleReference" checked>
          <label class="form-check-label" for="toggleReference">Referência</label>
        </div>

        <div class="form-check">
          <input class="form-check-input column-toggle" type="checkbox" value="category" id="toggleCategory" checked>
          <label class="form-check-label" for="toggleCategory">Categoria</label>
        </div>
        <div class="form-check">
          <input class="form-check-input column-toggle" type="checkbox" value="stock" id="toggleStock" checked>
          <label class="form-check-label" for="toggleStock">Stock Atual</label>
        </div>
        <div class="form-check">
          <input class="form-check-input column-toggle" type="checkbox" value="status" id="toggleStatus" checked>
          <label class="form-check-label" for="toggleStatus">Status</label>
        </div>
        <div class="form-check">
          <input class="form-check-input column-toggle" type="checkbox" value="actions" id="toggleActions" checked>
          <label class="form-check-label" for="toggleActions">Ações</label>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
        <button type="button" class="btn btn-primary" id="apply-columns-btn">Aplicar</button>
      </div>
    </div>
  </div>
</div>

<% locals.scripts = '<script src="/js/admin-inventory.js"></script>'; %>
