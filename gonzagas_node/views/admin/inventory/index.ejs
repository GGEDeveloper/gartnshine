// Função para obter o índice da coluna com base no texto do cabeçalho
function getColumnIndex(headerText) {
  const headers = document.querySelectorAll('.table-inventory th');
  for (let i = 0; i < headers.length; i++) {
    if (headers[i].textContent.trim() === headerText) {
      return i;
    }
  }
  return -1;
}

// Função para mostrar/esconder coluna
function toggleColumn(columnIndex, show) {
  const table = document.querySelector('.table-inventory');
  if (!table) return;
  
  // Esconder/mostrar cabeçalho
  const header = table.querySelector(`th:nth-child(${columnIndex + 1})`);
  if (header) header.style.display = show ? '' : 'none';
  
  // Esconder/mostrar células da coluna
  const cells = table.querySelectorAll(`td:nth-child(${columnIndex + 1})`);
  cells.forEach(cell => {
    cell.style.display = show ? '' : 'none';
  });
}

// Função para salvar as preferências de colunas
function saveColumnPreferences() {
  const checkboxes = document.querySelectorAll('.column-toggle');
  const preferences = {};
  
  checkboxes.forEach(checkbox => {
    preferences[checkbox.value] = checkbox.checked;
  });
  
  localStorage.setItem('columnPreferences', JSON.stringify(preferences));
}

// Função para carregar as preferências de colunas
function loadColumnPreferences() {
  const saved = localStorage.getItem('columnPreferences');
  if (!saved) return null;
  
  try {
    return JSON.parse(saved);
  } catch (e) {
    console.error('Erro ao carregar preferências:', e);
    return null;
  }
}

// Inicializar a aplicação quando o DOM estiver pronto
document.addEventListener('DOMContentLoaded', function() {
  console.log('DOM carregado, inicializando aplicação...');
  
  // Referências aos elementos
  const columnsBtn = document.getElementById('toggle-columns-btn');
  const columnsPanel = document.getElementById('columnsPanel');
  const applyBtn = document.getElementById('apply-columns');
  const closeBtn = document.getElementById('close-columns-panel');
  
  if (!columnsBtn || !columnsPanel || !applyBtn || !closeBtn) {
    console.error('Elementos necessários não encontrados');
    return;
  }
  
  // Carregar preferências salvas
  const savedPrefs = loadColumnPreferences();
  if (savedPrefs) {
    Object.entries(savedPrefs).forEach(([colName, isVisible]) => {
      const checkbox = document.querySelector(`.column-toggle[value="${colName}"]`);
      if (checkbox) {
        checkbox.checked = isVisible;
        
        // Aplicar visibilidade inicial
        const colIndex = getColumnIndex(colName);
        if (colIndex !== -1) {
          toggleColumn(colIndex, isVisible);
        }
      }
    });
  }
  
  // Mostrar/ocultar painel ao clicar no botão de colunas
  columnsBtn.addEventListener('click', function(e) {
    e.preventDefault();
    e.stopPropagation();
    columnsPanel.style.display = columnsPanel.style.display === 'none' ? 'block' : 'none';
  });
  
  // Fechar painel ao clicar fora
  document.addEventListener('click', function(e) {
    if (!columnsPanel.contains(e.target) && e.target !== columnsBtn) {
      columnsPanel.style.display = 'none';
    }
  });
  
  // Fechar painel ao clicar no botão Fechar
  closeBtn.addEventListener('click', function() {
    columnsPanel.style.display = 'none';
  });
  
  // Aplicar seleção de colunas
  applyBtn.addEventListener('click', function() {
    console.log('Aplicando seleção de colunas...');
    
    // Obter todas as checkboxes
    const checkboxes = document.querySelectorAll('.column-toggle');
    
    // Atualizar visibilidade das colunas
    checkboxes.forEach(checkbox => {
      const colIndex = getColumnIndex(checkbox.value);
      if (colIndex !== -1) {
        toggleColumn(colIndex, checkbox.checked);
      }
    });
    
    // Salvar preferências
    saveColumnPreferences();
    
    // Fechar o painel
    columnsPanel.style.display = 'none';
    
    console.log('Seleção de colunas aplicada com sucesso');
  });
  
  console.log('Aplicação inicializada com sucesso');
});
</script>
