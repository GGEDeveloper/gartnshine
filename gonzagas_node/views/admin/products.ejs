<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Produtos V2 - Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/admin-v2.css">
    <link rel="stylesheet" href="/css/admin-products-v2.css">
</head>
<body>
<div class="admin-container-v2">
    <header class="admin-topbar">
        <div class="topbar-left">
            <h1 class="brand-title">
                <span class="brand-icon">💎</span>
                Produtos
            </h1>
        </div>
        <div class="topbar-right">
            <a href="/admin/products/new" class="btn-primary">
                <i class="fas fa-plus"></i>
                Novo Produto
            </a>
        </div>
    </header>
    
    <div class="admin-main-simple">
        <main class="products-v2-content">
            <div class="products-toolbar">
                <div class="toolbar-left">
                    <input type="text" class="search-products" placeholder="Pesquisar produtos..." 
                           value="<%= searchQuery || '' %>">
                    <select class="filter-select" id="categoryFilter">
                        <option value="">Todas Categorias</option>
                        <% if (typeof categories !== 'undefined') { %>
                            <% categories.forEach(cat => { %>
                            <option value="<%= cat.id %>"><%= cat.name %></option>
                            <% }); %>
                        <% } %>
                    </select>
                    <select class="filter-select" id="stockFilter">
                        <option value="">Todos</option>
                        <option value="in_stock">Em Stock</option>
                        <option value="low_stock">Stock Baixo</option>
                        <option value="out_of_stock">Esgotado</option>
                    </select>
                </div>
                <div class="toolbar-right">
                    <button class="btn-icon" title="Grid View">
                        <i class="fas fa-th"></i>
                    </button>
                    <button class="btn-icon" title="List View">
                        <i class="fas fa-list"></i>
                    </button>
                </div>
            </div>
            
            <div class="products-grid-v2">
                <% if (products && products.length > 0) { %>
                    <% products.forEach(product => { %>
                    <div class="product-card-admin">
                        <div class="card-image">
                            <img src="<%= product.main_image ? '/uploads/products/' + product.main_image : '/images/placeholder.jpg' %>" 
                                 alt="<%= product.name %>">
                            <div class="card-actions">
                                <a href="/admin/products/edit/<%= product.id %>" class="btn-action" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button class="btn-action" title="Eliminar" onclick="deleteProduct(<%= product.id %>)">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <h3 class="card-title"><%= product.name %></h3>
                            <p class="card-ref">REF: <%= product.reference %></p>
                            <div class="card-meta">
                                <span class="card-price">€<%= parseFloat(product.sale_price || 0).toFixed(2) %></span>
                                <span class="card-stock <%= product.current_stock > 0 ? 'in-stock' : 'out-stock' %>">
                                    <i class="fas fa-box"></i>
                                    <%= product.current_stock || 0 %>
                                </span>
                            </div>
                            <% if (product.family_name) { %>
                            <span class="card-category">
                                <i class="fas fa-tag"></i>
                                <%= product.family_name %>
                            </span>
                            <% } %>
                        </div>
                    </div>
                    <% }); %>
                <% } else { %>
                    <div class="no-products">
                        <i class="fas fa-box-open"></i>
                        <p>Nenhum produto encontrado</p>
                    </div>
                <% } %>
            </div>
        </main>
    </div>
</div>
<script>
function deleteProduct(id) {
    if (confirm('Eliminar este produto?')) {
        fetch(`/admin/products/${id}/delete`, { method: 'POST' })
            .then(() => location.reload());
    }
}
</script>
</body>
</html>
