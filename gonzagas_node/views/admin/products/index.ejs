<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="page-title-box">
        <h4 class="page-title"><%= title %></h4>
        <div class="page-title-right">
          <a href="/admin/products/add" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Adicionar Produto
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-body">
          <% if (products && products.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Imagem</th>
                    <th>Referência</th>
                    <th>Nome</th>
                    <th>Preço</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th class="text-end">Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <% products.forEach(product => { %>
                    <tr 
                      data-family-name="<%= product.family_name || '' %>" 
                      data-is-active="<%= product.is_active %>" 
                      data-stock-quantity="<%= product.current_stock || 0 %>"
                      data-reference="<%= product.reference || '' %>"
                    >
                      <td><%= product.id %></td>
                      <td>
                        <% if (product.image_url) { %>
                          <img src="/media/products/<%= product.image_url %>" alt="<%= product.name %>" class="img-thumbnail" style="width: 50px; height: 50px; object-fit: cover;">
                        <% } else { %>
                          <div class="bg-light d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="fas fa-box text-muted"></i>
                          </div>
                        <% } %>
                      </td>
                      <td><%= product.reference || 'N/A' %></td>
                      <td><%= product.name %></td>
                      <td><%= parseFloat(product.price || 0).toLocaleString('pt-PT', {style: 'currency', currency: 'EUR'}) %></td>
                      <td>
                        <span class="badge bg-<%= product.current_stock > 10 ? 'success' : product.current_stock > 0 ? 'warning' : 'danger' %>">
                          <%= product.current_stock || 0 %>
                        </span>
                      </td>
                      <td>
                        <span class="badge bg-<%= product.is_active ? 'success' : 'secondary' %>">
                          <%= product.is_active ? 'Ativo' : 'Inativo' %>
                        </span>
                      </td>
                      <td class="text-end">
                        <div class="btn-group">
                          <a href="/admin/products/edit/<%= product.id %>" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-edit"></i>
                          </a>
                          <a href="/admin/products/delete/<%= product.id %>" 
                             class="btn btn-sm btn-outline-danger"
                             onclick="return confirm('Tem certeza que deseja excluir este produto?')">
                            <i class="fas fa-trash"></i>
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
              <nav class="mt-3">
                <ul class="pagination justify-content-center">
                  <% if (currentPage > 1) { %>
                    <li class="page-item">
                      <a class="page-link" href="?page=<%= currentPage - 1 %>&limit=<%= limit %>">Anterior</a>
                    </li>
                  <% } %>
                  
                  <% for (let i = 1; i <= totalPages; i++) { %>
                    <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                      <a class="page-link" href="?page=<%= i %>&limit=<%= limit %>"><%= i %></a>
                    </li>
                  <% } %>
                  
                  <% if (currentPage < totalPages) { %>
                    <li class="page-item">
                      <a class="page-link" href="?page=<%= currentPage + 1 %>&limit=<%= limit %>">Próximo</a>
                    </li>
                  <% } %>
                </ul>
              </nav>
            <% } %>
          <% } else { %>
            <div class="alert alert-info mb-0">
              Nenhum produto encontrado. <a href="/admin/products/add">Adicionar um novo produto</a>.
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Filter Section -->
  <div class="card mb-3">
    <div class="card-header">
      <h5 class="card-title mb-0">Filtros</h5>
    </div>
    <div class="card-body">
      <div class="filter-row">
        <div class="filter-group">
          <label for="filter-product-reference">Referência</label>
          <input type="text" id="filter-product-reference" class="form-control form-control-sm" placeholder="Código da Ref.">
        </div>
        
        <div class="filter-group">
          <label for="filter-product-category">Categoria</label>
          <select id="filter-product-category" class="form-select form-select-sm">
            <option value="">Todas as Categorias</option>
            <% if (typeof productFamilies !== 'undefined' && productFamilies.length > 0) { %>
              <% productFamilies.forEach(family => { %>
                <option value="<%= family.name %>"><%= family.name %></option> <% /* Using family.name for filtering for now, can switch to family.id if needed */ %>
              <% }); %>
            <% } %>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-product-status">Status do Produto</label>
          <select id="filter-product-status" class="form-select form-select-sm">
            <option value="">Todos os Status</option>
            <!-- TODO: Define product statuses, e.g.: -->
            <option value="active">Ativo</option>
            <option value="inactive">Inativo</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-product-stock">Status do Stock</label>
          <select id="filter-product-stock" class="form-select form-select-sm">
            <option value="">Todos</option>
            <option value="in_stock">Em Stock</option>
            <option value="low_stock">Stock Baixo</option>
            <option value="out_of_stock">Fora de Stock</option>
          </select>
        </div>
        
        <div class="filter-group actions">
          <button id="reset-product-filters" class="btn btn-outline-secondary btn-sm" title="Limpar filtros">
            <i class="fas fa-undo"></i> Limpar
          </button>
        </div>
      </div>
    </div>
  </div>
  <!-- End Filter Section -->

  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-body">
          <% if (products && products.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Imagem</th>
                    <th>Referência</th>
                    <th>Nome</th>
                    <th>Preço</th>
                    <th>stock</th>
                    <th>Status</th>
                    <th class="text-end">Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <% products.forEach(product => { %>
                    <tr 
                      data-family-name="<%= product.family_name || '' %>" 
                      data-is-active="<%= product.is_active %>" 
                      data-stock-quantity="<%= product.stock_quantity || 0 %>"
                      data-reference="<%= product.reference || '' %>"
                    >
                      <td><%= product.id %></td>
                      <td>
                        <% if (product.image_url) { %>
                          <img src="/media/<%= product.image_url %>" alt="<%= product.name %>" class="img-thumbnail" style="width: 50px; height: 50px; object-fit: cover;">
                        <% } else { %>
                          <div class="bg-light d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="fas fa-box text-muted"></i>
                          </div>
                        <% } %>
                      </td>
                      <td><%= product.reference || 'N/A' %></td>
                      <td><%= product.name %></td>
                      <td><%= parseFloat(product.price || 0).toLocaleString('pt-PT', {style: 'currency', currency: 'EUR'}) %></td>
                      <td>
                        <span class="badge bg-<%= product.stock_quantity > 10 ? 'success' : product.stock_quantity > 0 ? 'warning' : 'danger' %>">
                          <%= product.stock_quantity || 0 %>
                        </span>
                      </td>
                      <td>
                        <span class="badge bg-<%= product.is_active ? 'success' : 'secondary' %>">
                          <%= product.is_active ? 'Ativo' : 'Inativo' %>
                        </span>
                      </td>
                      <td class="text-end">
                        <div class="btn-group">
                          <a href="/admin/products/edit/<%= product.id %>" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-edit"></i>
                          </a>
                          <a href="/admin/products/delete/<%= product.id %>" 
                             class="btn btn-sm btn-outline-danger"
                             onclick="return confirm('Tem certeza que deseja excluir este produto?')">
                            <i class="fas fa-trash"></i>
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
              <nav class="mt-3">
                <ul class="pagination justify-content-center">
                  <% if (currentPage > 1) { %>
                    <li class="page-item">
                      <a class="page-link" href="?page=<%= currentPage - 1 %>&limit=<%= limit %>">Anterior</a>
                    </li>
                  <% } %>
                  
                  <% for (let i = 1; i <= totalPages; i++) { %>
                    <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                      <a class="page-link" href="?page=<%= i %>&limit=<%= limit %>"><%= i %></a>
                    </li>
                  <% } %>
                  
                  <% if (currentPage < totalPages) { %>
                    <li class="page-item">
                      <a class="page-link" href="?page=<%= currentPage + 1 %>&limit=<%= limit %>">Próximo</a>
                    </li>
                  <% } %>
                </ul>
              </nav>
            <% } %>
          <% } else { %>
            <div class="alert alert-info mb-0">
              Nenhum produto encontrado. <a href="/admin/products/add">Adicionar um novo produto</a>.
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<% locals.styles = locals.styles || []; %>
<% locals.styles.push(`
<style>
.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem; /* Space between filter groups */
  align-items: flex-end; /* Align items to the bottom */
}

.filter-group {
  flex: 1; /* Allow groups to grow */
  min-width: 150px; /* Minimum width for each filter group */
