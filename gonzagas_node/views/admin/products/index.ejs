}

.filter-group.compact { 
  flex: 0 1 120px; /* Don't grow, basis of 120px */
  max-width: 120px;
}

.filter-group.actions {
  flex: 0 0 auto; /* Don't grow or shrink */
  display: flex;
  gap: 0.5rem; /* Space between action buttons */
  /* margin-left: auto; /* Pushes actions to the right if using a fixed-width container */
}

.filter-group label {
  display: block;
  margin-bottom: 0.25rem;
  font-size: 0.8rem;
  font-weight: 500;
  white-space: nowrap; /* Prevent labels from wrapping */
}
</style>
`); %>

<% locals.scripts = locals.scripts || []; %>
<% locals.scripts.push('/js/admin/product-filters.js'); // Placeholder if we move to external file %>
<script>
document.addEventListener('DOMContentLoaded', () => {
    const referenceFilter = document.getElementById('filter-product-reference');
    const categoryFilter = document.getElementById('filter-product-category');
    const statusFilter = document.getElementById('filter-product-status');
    const stockFilter = document.getElementById('filter-product-stock');
    const resetFiltersButton = document.getElementById('reset-product-filters');
    const productTableBody = document.querySelector('.table tbody'); // Target tbody directly

    // Ensure productTableBody exists before proceeding
    if (!productTableBody) {
        console.warn('Product table body not found. Filtering will not work.');
        return;
    }
    const productRows = Array.from(productTableBody.querySelectorAll('tr'));

    function applyFilters() {
        const referenceValue = referenceFilter ? referenceFilter.value.toLowerCase().trim() : '';
        const categoryValue = categoryFilter ? categoryFilter.value : '';
        const statusValue = statusFilter ? statusFilter.value : '';
        const stockValue = stockFilter ? stockFilter.value : '';

        // Debug: Log selected stock filter value
        if (stockValue) { // Log only when a stock filter is active
            console.log(`Selected stock filter: ${stockValue}`);
        }

        productRows.forEach(row => {
            const rowReference = (row.dataset.reference || '').toLowerCase();
            const rowFamilyName = row.dataset.familyName || '';
            // product.is_active is boolean in DB, comes as string 'true'/'false' in dataset
            const rowIsActive = row.dataset.isActive === 'true'; 
            const rowStockQuantity = parseInt(row.dataset.stockQuantity || 0, 10);

            let matchesReference = true;
            let matchesCategory = true;
            let matchesStatus = true;
            let matchesStock = true;

            if (referenceValue) {
                matchesReference = rowReference.includes(referenceValue);
            }

            if (categoryValue) {
                matchesCategory = (rowFamilyName || '').trim().toLowerCase() === (categoryValue || '').trim().toLowerCase();
            }

            if (statusValue) {
                if (statusValue === 'active') {
                    matchesStatus = rowIsActive;
                } else if (statusValue === 'inactive') {
                    matchesStatus = !rowIsActive;
                }
            }
            
            if (stockValue) {
                if (stockValue === 'in_stock') {
                    matchesStock = rowStockQuantity > 0;
                } else if (stockValue === 'low_stock') {
                    const isGreaterThanZero = rowStockQuantity > 0;
                    const isLessThanOrEqualToTen = rowStockQuantity <= 10;
                    const combinedCondition = isGreaterThanZero && isLessThanOrEqualToTen;
                    console.log(`Product Ref: ${rowReference}, Stock Qty: ${rowStockQuantity}, >0: ${isGreaterThanZero}, <=10: ${isLessThanOrEqualToTen}, Combined: ${combinedCondition}`);
                    matchesStock = combinedCondition;
                } else if (stockValue === 'out_of_stock') {
                    matchesStock = rowStockQuantity <= 0;
                }
            }

            // Debug: Log final match status for a specific product if needed
            // if (rowReference === 'some-specific-reference-to-debug') {
            //     console.log(`Ref: ${rowReference}, matchesReference: ${matchesReference}, matchesCategory: ${matchesCategory}, matchesStatus: ${matchesStatus}, matchesStock: ${matchesStock}`);
            // }

            if (matchesReference && matchesCategory && matchesStatus && matchesStock) {
                row.style.display = ''; // Show row
            } else {
                row.style.display = 'none'; // Hide row
            }
        });
    }

    // Attach event listeners if elements exist
    if (referenceFilter) referenceFilter.addEventListener('input', applyFilters);
    if (categoryFilter) categoryFilter.addEventListener('change', applyFilters);
    if (statusFilter) statusFilter.addEventListener('change', applyFilters);
    if (stockFilter) stockFilter.addEventListener('change', applyFilters);

    if (resetFiltersButton) {
        resetFiltersButton.addEventListener('click', () => {
            if (referenceFilter) referenceFilter.value = '';
            if (categoryFilter) categoryFilter.value = '';
            if (statusFilter) statusFilter.value = '';
            if (stockFilter) stockFilter.value = '';
            applyFilters(); // Re-apply to show all rows
        });
    }

    // Initial filter application in case of pre-filled values (e.g., from query params in future)
    // applyFilters(); // Uncomment if needed for initial load filtering
});
</script>
