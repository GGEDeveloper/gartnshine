<div class="container-fluid px-3 px-md-4 py-3">
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-3">
    <h1 class="h4 mb-0 text-gray-800"><%= title %></h1>
    <a href="/admin/products/add" class="btn btn-primary">
      <i class="fas fa-plus me-1"></i> Adicionar Produto
    </a>
  </div>

  <%- include('../partials/flash-messages') %>

  <div class="card mb-3">
    <div class="card-header">
      <h5 class="card-title mb-0">Filtros</h5>
    </div>
    <div class="card-body">
      <form id="product-filters" class="table-filters" method="GET" action="/admin/products">
        <div class="filter-row">
          <div class="filter-group">
            <label for="filter-reference">Referência</label>
            <input type="text" id="filter-reference" name="reference" class="form-control form-control-lg" placeholder="Referência" value="<%= typeof queryParams !== 'undefined' && queryParams.reference ? queryParams.reference : '' %>">
          </div>
          <div class="filter-group">
            <label for="filter-category">Categoria</label>
            <select id="filter-category" name="category" class="form-select form-select-lg">
              <option value="">Todas</option>
              <% if (typeof productFamilies !== 'undefined' && productFamilies.length > 0) { %>
                <% productFamilies.forEach(family => { %>
                  <option value="<%= family.name %>" <%= typeof queryParams !== 'undefined' && queryParams.category === family.name ? 'selected' : '' %>><%= family.name %></option>
                <% }); %>
              <% } %>
            </select>
          </div>
          <div class="filter-group">
            <label for="filter-status">Status</label>
            <select id="filter-status" name="status" class="form-select form-select-lg">
              <option value="">Todos</option>
              <option value="Ativo" <%= typeof queryParams !== 'undefined' && queryParams.status === 'Ativo' ? 'selected' : '' %>>Ativo</option>
              <option value="Inativo" <%= typeof queryParams !== 'undefined' && queryParams.status === 'Inativo' ? 'selected' : '' %>>Inativo</option>
            </select>
          </div>
          <div class="filter-group">
            <label for="filter-stock">Stock</label>
            <select id="filter-stock" name="stock_status" class="form-select form-select-lg">
              <option value="">Todos</option>
              <option value="in_stock" <%= typeof queryParams !== 'undefined' && queryParams.stock_status === 'in_stock' ? 'selected' : '' %>>Em Stock</option>
              <option value="low_stock" <%= typeof queryParams !== 'undefined' && queryParams.stock_status === 'low_stock' ? 'selected' : '' %>>Stock Baixo</option>
              <option value="out_of_stock" <%= typeof queryParams !== 'undefined' && queryParams.stock_status === 'out_of_stock' ? 'selected' : '' %>>Fora de Stock</option>
            </select>
          </div>
          <div class="filter-group actions">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a href="/admin/products" class="btn btn-outline-secondary">Limpar</a>
          </div>
        </div>
      </form>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <% if (products && products.length > 0) { %>
        <!-- Mobile Cards -->
        <div class="products-mobile-cards">
          <% products.forEach(product => { %>
            <div class="products-mobile-card">
              <div class="card-top">
                <% if (product.image_url) { %>
                  <img src="/media/products/<%= product.image_url %>" alt="<%= product.name %>" class="card-img">
                <% } else { %>
                  <div class="card-img bg-light d-flex align-items-center justify-content-center"><i class="fas fa-box text-muted"></i></div>
                <% } %>
                <div class="card-info">
                  <div class="ref"><%= product.reference %></div>
                  <div class="cat"><%= product.family_name || '-' %></div>
                  <div class="name text-truncate"><%= product.name %></div>
                </div>
              </div>
              <div class="card-badges">
                <span class="badge bg-<%= product.current_stock > 10 ? 'success' : product.current_stock > 0 ? 'warning' : 'danger' %>"><%= product.current_stock || 0 %> un</span>
                <span class="badge bg-<%= product.is_active ? 'success' : 'secondary' %>"><%= product.is_active ? 'Ativo' : 'Inativo' %></span>
                <span class="badge bg-info"><%= parseFloat(product.price || 0).toLocaleString('pt-PT', {style: 'currency', currency: 'EUR'}) %></span>
              </div>
              <div class="card-actions">
                <% let editUrl = '/admin/products/edit/' + product.id; if (typeof queryParams !== 'undefined' && queryParams && Object.keys(queryParams).length) { const params = []; if (queryParams.reference) params.push('reference=' + encodeURIComponent(queryParams.reference)); if (queryParams.category) params.push('category=' + encodeURIComponent(queryParams.category)); if (queryParams.status) params.push('status=' + encodeURIComponent(queryParams.status)); if (queryParams.stock_status) params.push('stock_status=' + encodeURIComponent(queryParams.stock_status)); if (queryParams.sort_by) params.push('sort_by=' + encodeURIComponent(queryParams.sort_by)); if (queryParams.sort_order) params.push('sort_order=' + encodeURIComponent(queryParams.sort_order)); if (params.length) editUrl += '?returnUrl=' + encodeURIComponent('/admin/products?' + params.join('&')); } %>
                <a href="<%= editUrl %>" class="btn btn-primary btn-sm flex-grow-1"><i class="fas fa-edit"></i> Editar</a>
                <a href="/admin/inventory/history/<%= product.id %>" class="btn btn-outline-secondary btn-sm"><i class="fas fa-history"></i></a>
                <form action="/admin/products/delete/<%= product.id %>" method="POST" class="d-inline" onsubmit="return confirm('Excluir este produto?')">
                  <% if (typeof csrfToken !== 'undefined' && csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
                  <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fas fa-trash"></i></button>
                </form>
              </div>
            </div>
          <% }); %>
        </div>

        <!-- Desktop Table -->
        <% 
          function buildSortUrl(col, defaultOrder, qp) {
            const params = qp ? { ...qp } : {};
            params.sort_by = col;
            params.sort_order = (params.sort_by === col && params.sort_order === defaultOrder) ? (defaultOrder === 'asc' ? 'desc' : 'asc') : defaultOrder;
            return Object.keys(params).filter(k => params[k]).map(k => encodeURIComponent(k) + '=' + encodeURIComponent(params[k])).join('&');
          }
          const qp = typeof queryParams !== 'undefined' ? queryParams : {};
        %>
        <div class="table-responsive products-table-wrapper">
              <table class="table table-hover mb-0 datatable" style="width:100%">
                <thead>
                  <tr>
                    <th><a href="?<%= buildSortUrl('id','asc',qp) %>" class="text-decoration-none text-dark sortable-th">ID <i class="fas fa-sort<%= qp.sort_by === 'id' ? (qp.sort_order === 'asc' ? '-up' : '-down') : '' %>"></i></a></th>
                    <th>Imagem</th>
                    <th><a href="?<%= buildSortUrl('reference','asc',qp) %>" class="text-decoration-none text-dark sortable-th">Referência <i class="fas fa-sort<%= qp.sort_by === 'reference' ? (qp.sort_order === 'asc' ? '-up' : '-down') : '-up' %>"></i></a></th>
                    <th><a href="?<%= buildSortUrl('family_name','asc',qp) %>" class="text-decoration-none text-dark sortable-th">Categoria <i class="fas fa-sort<%= qp.sort_by === 'family_name' ? (qp.sort_order === 'asc' ? '-up' : '-down') : '' %>"></i></a></th>
                    <th><a href="?<%= buildSortUrl('name','asc',qp) %>" class="text-decoration-none text-dark sortable-th">Nome <i class="fas fa-sort<%= qp.sort_by === 'name' ? (qp.sort_order === 'asc' ? '-up' : '-down') : '' %>"></i></a></th>
                    <th><a href="?<%= buildSortUrl('sale_price','asc',qp) %>" class="text-decoration-none text-dark sortable-th">Preço <i class="fas fa-sort<%= qp.sort_by === 'sale_price' ? (qp.sort_order === 'asc' ? '-up' : '-down') : '' %>"></i></a></th>
                    <th><a href="?<%= buildSortUrl('current_stock','desc',qp) %>" class="text-decoration-none text-dark sortable-th">Stock <i class="fas fa-sort<%= qp.sort_by === 'current_stock' ? (qp.sort_order === 'asc' ? '-up' : '-down') : '-down' %>"></i></a></th>
                    <th><a href="?<%= buildSortUrl('is_active','desc',qp) %>" class="text-decoration-none text-dark sortable-th">Status <i class="fas fa-sort<%= qp.sort_by === 'is_active' ? (qp.sort_order === 'asc' ? '-up' : '-down') : '' %>"></i></a></th>
                    <th class="text-end">Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <% products.forEach(product => { %>
                    <tr 
                      data-family-name="<%= product.family_name || '' %>" 
                      data-is-active="<%= product.is_active %>" 
                      data-stock-quantity="<%= product.current_stock || 0 %>"
                      data-reference="<%= product.reference || '' %>"
                    >
                      <td><%= product.id %></td>
                      <td>
                        <% if (product.image_url) { %>
                          <a href="/media/products/<%= product.image_url %>" 
                             class="glightbox product-image-link" 
                             data-glightbox="type: image; title: <%= product.name %>"
                             data-gallery="product-gallery"
                             style="display: inline-block; position: relative; width: 50px; height: 50px; cursor: pointer;">
                            <img src="/media/products/<%= product.image_url %>" 
                                 alt="<%= product.name %>" 
                                 class="img-thumbnail" 
                                 style="width: 50px; height: 50px; object-fit: cover; transition: transform 0.3s ease;"
                                 loading="lazy">
                            <div class="zoom-overlay" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.3); opacity: 0; transition: opacity 0.3s ease; display: flex; align-items: center; justify-content: center; border-radius: 0.25rem; pointer-events: none;">
                              <i class="fas fa-search-plus text-white" style="font-size: 16px;"></i>
                            </div>
                          </a>
                        <% } else { %>
                          <div class="bg-light d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="fas fa-box text-muted"></i>
                          </div>
                        <% } %>
                      </td>
                      <td><%= product.reference || 'N/A' %></td>
<td><%= product.family_name || '' %></td>
<td><%= product.name %></td>
                      <td><%= parseFloat(product.price || 0).toLocaleString('pt-PT', {style: 'currency', currency: 'EUR'}) %></td>
                      <td>
                        <span class="badge bg-<%= product.current_stock > 10 ? 'success' : product.current_stock > 0 ? 'warning' : 'danger' %>">
                          <%= product.current_stock || 0 %>
                        </span>
                      </td>
                      <td>
                        <span class="badge bg-<%= product.is_active ? 'success' : 'secondary' %>">
                          <%= product.is_active ? 'Ativo' : 'Inativo' %>
                        </span>
                      </td>
                      <td class="text-end">
                        <div class="btn-group">
                          <% 
                            // Preservar query params no link de editar
                            let editUrl = '/admin/products/edit/' + product.id;
                            if (typeof queryParams !== 'undefined' && queryParams) {
                              const params = [];
                              if (queryParams.reference) params.push('reference=' + encodeURIComponent(queryParams.reference));
                              if (queryParams.category) params.push('category=' + encodeURIComponent(queryParams.category));
                              if (queryParams.status) params.push('status=' + encodeURIComponent(queryParams.status));
                              if (queryParams.stock_status) params.push('stock_status=' + encodeURIComponent(queryParams.stock_status));
                              if (queryParams.page) params.push('page=' + encodeURIComponent(queryParams.page));
                              if (queryParams.limit) params.push('limit=' + encodeURIComponent(queryParams.limit));
                              if (queryParams.sort_by) params.push('sort_by=' + encodeURIComponent(queryParams.sort_by));
                              if (queryParams.sort_order) params.push('sort_order=' + encodeURIComponent(queryParams.sort_order));
                              if (params.length > 0) {
                                editUrl += '?returnUrl=' + encodeURIComponent('/admin/products?' + params.join('&'));
                              }
                            }
                          %>
                          <a href="<%= editUrl %>" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-edit"></i>
                          </a>
                          <form action="/admin/products/delete/<%= product.id %>" method="POST" class="d-inline" onsubmit="return confirm('Tem certeza que deseja excluir este produto?')">
                            <% if (typeof csrfToken !== 'undefined' && csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
              <% 
                // Helper function to build query string preserving filters and sort
                function buildQueryString(page, limit, queryParams) {
                  const params = [];
                  params.push('page=' + encodeURIComponent(page));
                  params.push('limit=' + encodeURIComponent(limit));
                  if (queryParams && queryParams.reference) params.push('reference=' + encodeURIComponent(queryParams.reference));
                  if (queryParams && queryParams.category) params.push('category=' + encodeURIComponent(queryParams.category));
                  if (queryParams && queryParams.status) params.push('status=' + encodeURIComponent(queryParams.status));
                  if (queryParams && queryParams.stock_status) params.push('stock_status=' + encodeURIComponent(queryParams.stock_status));
                  if (queryParams && queryParams.sort_by) params.push('sort_by=' + encodeURIComponent(queryParams.sort_by));
                  if (queryParams && queryParams.sort_order) params.push('sort_order=' + encodeURIComponent(queryParams.sort_order));
                  return params.join('&');
                }
              %>
              <nav class="mt-3">
                <ul class="pagination justify-content-center">
                  <% if (currentPage > 1) { %>
                    <li class="page-item">
                      <a class="page-link" href="?<%= buildQueryString(currentPage - 1, limit, queryParams) %>">Anterior</a>
                    </li>
                  <% } %>
                  
                  <% for (let i = 1; i <= totalPages; i++) { %>
                    <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                      <a class="page-link" href="?<%= buildQueryString(i, limit, queryParams) %>"><%= i %></a>
                    </li>
                  <% } %>
                  
                  <% if (currentPage < totalPages) { %>
                    <li class="page-item">
                      <a class="page-link" href="?<%= buildQueryString(currentPage + 1, limit, queryParams) %>">Próximo</a>
                    </li>
                  <% } %>
                </ul>
              </nav>
            <% } %>
          <% } else { %>
            <div class="alert alert-info mb-0">
              Nenhum produto encontrado. <a href="/admin/products/add">Adicionar um novo produto</a>.
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

<% locals.styles = locals.styles || []; %>
<% locals.styles.push(`
<style>
.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem; /* Space between filter groups */
  align-items: flex-end; /* Align items to the bottom */
}

.filter-group {
  flex: 1; /* Allow groups to grow */
  min-width: 150px; /* Minimum width for each filter group */
  /* margin-bottom: 0.5rem; /* Add some bottom margin if flex-wrap causes multiple lines */
}

.filter-group.compact { 
  flex: 0 1 120px; /* Don't grow, basis of 120px */
  max-width: 120px;
}

.filter-group.actions {
  flex: 0 0 auto; /* Don't grow or shrink */
  display: flex;
  gap: 0.5rem; /* Space between action buttons */
  /* margin-left: auto; /* Pushes actions to the right if using a fixed-width container */
}

.filter-group label {
  display: block;
  margin-bottom: 0.25rem;
  font-size: 0.8rem;
  font-weight: 500;
  white-space: nowrap; /* Prevent labels from wrapping */
}

/* Product Image Zoom Styles - Using GLightbox */
.product-image-link {
  position: relative;
  overflow: visible;
  z-index: 1;
  text-decoration: none;
  display: inline-block;
}

.product-image-link:hover .zoom-overlay {
  opacity: 1;
}

.product-image-link:hover img {
  transform: scale(1.1);
  box-shadow: 0 4px 20px rgba(0,0,0,0.3);
}

.zoom-overlay {
  pointer-events: none;
}

/* GLightbox customizations */
.glightbox-container img {
  max-width: 95vw !important;
  max-height: 90vh !important;
  object-fit: contain !important;
}

/* Esconder completamente qualquer paginação do DataTables */
.dataTables_wrapper .dataTables_paginate,
.dataTables_wrapper .dataTables_info,
.dataTables_wrapper .dataTables_length,
.dataTables_wrapper .dataTables_filter,
.dataTables_wrapper .dataTables_paginate *,
.dataTables_wrapper .dataTables_info * {
  display: none !important;
  visibility: hidden !important;
  opacity: 0 !important;
  height: 0 !important;
  width: 0 !important;
  overflow: hidden !important;
}

/* Remover espaçamento que pode ficar */
.dataTables_wrapper .dataTables_paginate,
.dataTables_wrapper .dataTables_info {
  margin: 0 !important;
  padding: 0 !important;
  line-height: 0 !important;
}

/* Garantir que apenas nossa paginação server-side seja visível */
.pagination {
  display: flex !important;
}
</style>
`); %>

<script>
(function() {
  'use strict';
  
  // Ensure filters persist when form is submitted
  function setupFilterPersistence() {
    const filterForm = document.getElementById('product-filters');
    if (!filterForm) return;
    
    // When form is submitted, ensure page is reset to 1 but filters are preserved
    filterForm.addEventListener('submit', function(e) {
      // Add hidden input for page=1 to ensure we start from page 1 when filters change
      // Remove any existing page input first
      const existingPageInput = filterForm.querySelector('input[name="page"]');
      if (existingPageInput) {
        existingPageInput.remove();
      }
      
      // Add page=1 input
      const pageInput = document.createElement('input');
      pageInput.type = 'hidden';
      pageInput.name = 'page';
      pageInput.value = '1';
      filterForm.appendChild(pageInput);
      
      // Form will submit normally with all fields including page=1
    });
  }
  
  // Initialize GLightbox for product images
  console.log('Setting up GLightbox for product images...');
  
  function initProductImageLightbox() {
    if (typeof GLightbox === 'undefined') {
      console.error('GLightbox is not loaded');
      return;
    }
    
    // Initialize GLightbox with custom configuration
    var lightbox = GLightbox({
      selector: '.product-image-link',
      touchNavigation: true,
      loop: true,
      autoplayVideos: false,
      zoomable: true,
      draggable: true,
      openEffect: 'zoom',
      closeEffect: 'zoom',
      slideEffect: 'slide',
      moreText: 'Ver mais imagens',
      moreLength: 60,
      closeButton: true,
      touchFollowAxis: true,
      keyboardNavigation: true,
      closeOnOutsideClick: true,
      width: '90vw',
      height: '90vh'
    });
    
    console.log('GLightbox initialized successfully for product images');
    
    // Initialize DataTables with server-side pagination disabled
    // Since we're using server-side pagination, DataTables should only handle sorting/searching on current page
    if (typeof jQuery !== 'undefined' && typeof jQuery.fn.DataTable !== 'undefined') {
      var $table = jQuery('.datatable');
      if ($table.length) {
        // Function to remove DataTables pagination/info
        function removeDataTablesPagination() {
          jQuery('.dataTables_wrapper .dataTables_paginate, .dataTables_wrapper .dataTables_info').each(function() {
            jQuery(this).remove();
          });
          // Also remove by class directly
          jQuery('.dataTables_paginate, .dataTables_info').remove();
        }
        
        // Check if DataTable is already initialized (by admin.js or datatables-config.js)
        // Wait a bit to ensure admin.js has finished initializing
        setTimeout(function() {
          if (jQuery.fn.DataTable.isDataTable('.datatable')) {
            // Destroy existing DataTable instance
            console.log('Destroying existing DataTable instance to reconfigure...');
            try {
              var dt = $table.DataTable();
              // Don't clear data, just destroy to preserve table rows
              dt.destroy(false); // false = keep table in DOM, just remove DataTable functionality
              $table.removeClass('dataTable');
              // Remove any existing pagination/info elements
              removeDataTablesPagination();
            } catch(e) {
              console.error('Error destroying DataTable:', e);
              // Force remove wrapper if it exists, but keep table content
              var wrapper = $table.closest('.dataTables_wrapper');
              if (wrapper.length) {
                // Unwrap but keep table content
                wrapper.contents().unwrap();
              }
            }
          }
          
          // Re-initialize with correct settings (always re-initialize after destroy)
          console.log('Re-initializing DataTable with correct settings...');
          // Get fresh reference to table after potential DOM changes
          $table = jQuery('.datatable');
          // Check if table has rows before initializing
          var rowCount = $table.find('tbody tr').length;
          console.log('Table rows before DataTable init:', rowCount);
          
          if ($table.length && !jQuery.fn.DataTable.isDataTable('.datatable')) {
            // Only initialize if table has data
            if (rowCount > 0) {
              initializeDataTable();
            } else {
              console.warn('Table has no rows, skipping DataTable initialization');
            }
          }
        }, 100);
        
        function initializeDataTable() {
          // Initialize with correct settings
          $table.DataTable({
            responsive: true,
            language: {
              url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/pt-BR.json'
            },
            searching: true,
            ordering: false,   // Server-side ordering via column header links
            paging: false,     // Disable DataTables pagination - we use server-side pagination
            info: false,       // Disable DataTables info - we have our own pagination
            dom: "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                 "<'row'<'col-sm-12'tr>>",  // Remove 'i' (info) and 'p' (pagination) from DOM
            initComplete: function(settings, json) {
              // Remove immediately after initialization
              removeDataTablesPagination();
            },
            drawCallback: function(settings) {
              console.log('DataTables drawCallback - GLightbox should auto-detect new images');
              
              // Force remove any DataTables pagination/info elements that might appear
              removeDataTablesPagination();
              
              // Re-initialize GLightbox after table redraw
              if (typeof GLightbox !== 'undefined') {
                GLightbox();
              }
            }
          });
          
          // Remove pagination/info elements immediately after initialization (multiple attempts)
          setTimeout(function() {
            removeDataTablesPagination();
          }, 50);
          
          setTimeout(function() {
            removeDataTablesPagination();
          }, 100);
          
          setTimeout(function() {
            removeDataTablesPagination();
          }, 200);
          
          setTimeout(function() {
            removeDataTablesPagination();
          }, 500);
          
          // Use MutationObserver to remove any DataTables pagination/info elements that appear dynamically
          if (typeof MutationObserver !== 'undefined') {
            const observer = new MutationObserver(function(mutations) {
              removeDataTablesPagination();
            });
            
            const tableWrapper = $table.closest('.dataTables_wrapper')[0];
            if (tableWrapper) {
              observer.observe(tableWrapper, {
                childList: true,
                subtree: true
              });
            }
            
            // Also observe the document body in case elements are added elsewhere
            observer.observe(document.body, {
              childList: true,
              subtree: true
            });
          }
        }
      }
    }
  }
  
  // Initialize when DOM is ready
  function init() {
    setupFilterPersistence();
    initProductImageLightbox();
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
    } else {
    init();
    }
})();
</script>
