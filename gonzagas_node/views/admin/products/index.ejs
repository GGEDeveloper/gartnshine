  <div class="row">
    <div class="col-12">
      <div class="page-title-box">
        <h4 class="page-title"><%= title %></h4>
        <div class="page-title-right">
          <a href="/admin/products/add" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Adicionar Produto
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-header">
      <h5 class="card-title mb-0">Filtros</h5>
    </div>
    <div class="card-body">
      <form id="product-filters" class="row g-2" method="GET" action="/admin/products">
        <div class="col-md-3">
          <input type="text" id="filter-reference" name="reference" class="form-control form-control-sm" placeholder="Referência" value="<%= typeof queryParams !== 'undefined' && queryParams.reference ? queryParams.reference : '' %>">
        </div>
        <div class="col-md-3">
          <select id="filter-category" name="category" class="form-select form-select-sm">
            <option value="">Todas as Categorias</option>
            <% if (typeof productFamilies !== 'undefined' && productFamilies.length > 0) { %>
              <% productFamilies.forEach(family => { %>
                <option value="<%= family.name %>" <%= typeof queryParams !== 'undefined' && queryParams.category === family.name ? 'selected' : '' %>><%= family.name %></option>
              <% }); %>
            <% } %>
          </select>
        </div>
        <div class="col-md-2">
          <select id="filter-status" name="status" class="form-select form-select-sm">
            <option value="">Todos os Status</option>
            <option value="Ativo" <%= typeof queryParams !== 'undefined' && queryParams.status === 'Ativo' ? 'selected' : '' %>>Ativo</option>
            <option value="Inativo" <%= typeof queryParams !== 'undefined' && queryParams.status === 'Inativo' ? 'selected' : '' %>>Inativo</option>
          </select>
        </div>
        <div class="col-md-2">
          <select id="filter-stock" name="stock_status" class="form-select form-select-sm">
            <option value="">Todos</option>
            <option value="in_stock" <%= typeof queryParams !== 'undefined' && queryParams.stock_status === 'in_stock' ? 'selected' : '' %>>Em Stock</option>
            <option value="low_stock" <%= typeof queryParams !== 'undefined' && queryParams.stock_status === 'low_stock' ? 'selected' : '' %>>Stock Baixo</option>
            <option value="out_of_stock" <%= typeof queryParams !== 'undefined' && queryParams.stock_status === 'out_of_stock' ? 'selected' : '' %>>Fora de Stock</option>
          </select>
        </div>
        <div class="col-md-1">
          <button type="submit" class="btn btn-primary btn-sm w-100">Filtrar</button>
        </div>
        <div class="col-md-1">
          <a href="/admin/products" id="reset-filters" class="btn btn-outline-secondary btn-sm w-100">Limpar</a>
        </div>
      </form>
    </div>
  </div>

  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-body">
          <% if (products && products.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-hover mb-0 datatable" style="width:100%">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Imagem</th>
                    <th>Referência</th>
<th>Categoria</th>
<th>Nome</th>
                    <th>Preço</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th class="text-end">Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <% products.forEach(product => { %>
                    <tr 
                      data-family-name="<%= product.family_name || '' %>" 
                      data-is-active="<%= product.is_active %>" 
                      data-stock-quantity="<%= product.current_stock || 0 %>"
                      data-reference="<%= product.reference || '' %>"
                    >
                      <td><%= product.id %></td>
                      <td>
                        <% if (product.image_url) { %>
                          <div class="product-image-zoom-wrapper" style="position: relative; width: 50px; height: 50px; cursor: pointer;">
                            <img src="/media/products/<%= product.image_url %>" 
                                 alt="<%= product.name %>" 
                                 class="img-thumbnail product-zoom-image" 
                                 style="width: 50px; height: 50px; object-fit: cover; transition: transform 0.3s ease;"
                                 data-zoom-src="/media/products/<%= product.image_url %>?quality=100&original=true"
                                 data-product-name="<%= product.name %>"
                                 loading="lazy">
                            <div class="zoom-overlay" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.3); opacity: 0; transition: opacity 0.3s ease; display: flex; align-items: center; justify-content: center; border-radius: 0.25rem;">
                              <i class="fas fa-search-plus text-white" style="font-size: 16px;"></i>
                            </div>
                          </div>
                        <% } else { %>
                          <div class="bg-light d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="fas fa-box text-muted"></i>
                          </div>
                        <% } %>
                      </td>
                      <td><%= product.reference || 'N/A' %></td>
<td><%= product.family_name || '' %></td>
<td><%= product.name %></td>
                      <td><%= parseFloat(product.price || 0).toLocaleString('pt-PT', {style: 'currency', currency: 'EUR'}) %></td>
                      <td>
                        <span class="badge bg-<%= product.current_stock > 10 ? 'success' : product.current_stock > 0 ? 'warning' : 'danger' %>">
                          <%= product.current_stock || 0 %>
                        </span>
                      </td>
                      <td>
                        <span class="badge bg-<%= product.is_active ? 'success' : 'secondary' %>">
                          <%= product.is_active ? 'Ativo' : 'Inativo' %>
                        </span>
                      </td>
                      <td class="text-end">
                        <div class="btn-group">
                          <a href="/admin/products/edit/<%= product.id %>" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-edit"></i>
                          </a>
                          <a href="/admin/products/delete/<%= product.id %>" 
                             class="btn btn-sm btn-outline-danger"
                             onclick="return confirm('Tem certeza que deseja excluir este produto?')">
                            <i class="fas fa-trash"></i>
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
              <nav class="mt-3">
                <ul class="pagination justify-content-center">
                  <% if (currentPage > 1) { %>
                    <li class="page-item">
                      <a class="page-link" href="?page=<%= currentPage - 1 %>&limit=<%= limit %>">Anterior</a>
                    </li>
                  <% } %>
                  
                  <% for (let i = 1; i <= totalPages; i++) { %>
                    <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                      <a class="page-link" href="?page=<%= i %>&limit=<%= limit %>"><%= i %></a>
                    </li>
                  <% } %>
                  
                  <% if (currentPage < totalPages) { %>
                    <li class="page-item">
                      <a class="page-link" href="?page=<%= currentPage + 1 %>&limit=<%= limit %>">Próximo</a>
                    </li>
                  <% } %>
                </ul>
              </nav>
            <% } %>
          <% } else { %>
            <div class="alert alert-info mb-0">
              Nenhum produto encontrado. <a href="/admin/products/add">Adicionar um novo produto</a>.
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

<% locals.styles = locals.styles || []; %>
<% locals.styles.push(`
<style>
.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem; /* Space between filter groups */
  align-items: flex-end; /* Align items to the bottom */
}

.filter-group {
  flex: 1; /* Allow groups to grow */
  min-width: 150px; /* Minimum width for each filter group */
  /* margin-bottom: 0.5rem; /* Add some bottom margin if flex-wrap causes multiple lines */
}

.filter-group.compact { 
  flex: 0 1 120px; /* Don't grow, basis of 120px */
  max-width: 120px;
}

.filter-group.actions {
  flex: 0 0 auto; /* Don't grow or shrink */
  display: flex;
  gap: 0.5rem; /* Space between action buttons */
  /* margin-left: auto; /* Pushes actions to the right if using a fixed-width container */
}

.filter-group label {
  display: block;
  margin-bottom: 0.25rem;
  font-size: 0.8rem;
  font-weight: 500;
  white-space: nowrap; /* Prevent labels from wrapping */
}

/* Product Image Zoom Styles */
.product-image-zoom-wrapper {
  position: relative;
  overflow: visible;
  z-index: 1;
}

.product-image-zoom-wrapper:hover .product-zoom-image {
  transform: scale(2.5);
  z-index: 1000;
  box-shadow: 0 4px 20px rgba(0,0,0,0.3);
}

.product-image-zoom-wrapper:hover .zoom-overlay {
  opacity: 1;
}

/* Image Zoom Modal */
.image-zoom-modal {
  display: none !important;
  position: fixed;
  z-index: 99999;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0,0,0,0.9);
  animation: fadeIn 0.3s ease;
}

.image-zoom-modal.active {
  display: flex !important;
  align-items: center;
  justify-content: center;
}

.image-zoom-modal-content {
  position: relative;
  max-width: 90%;
  max-height: 90%;
  margin: auto;
  animation: zoomIn 0.3s ease;
}

.image-zoom-modal-content img {
  width: auto;
  height: auto;
  max-width: 95vw;
  max-height: 90vh;
  object-fit: contain;
  border-radius: 8px;
  box-shadow: 0 4px 30px rgba(0,0,0,0.5);
  image-rendering: -webkit-optimize-contrast;
  image-rendering: crisp-edges;
  image-rendering: high-quality;
}

.image-zoom-modal-close {
  position: absolute;
  top: 20px;
  right: 35px;
  color: #f1f1f1;
  font-size: 40px;
  font-weight: bold;
  cursor: pointer;
  transition: color 0.3s ease;
  z-index: 10001;
}

.image-zoom-modal-close:hover {
  color: #fff;
  transform: scale(1.1);
}

.image-zoom-modal-title {
  position: absolute;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  color: #f1f1f1;
  font-size: 18px;
  text-align: center;
  background: rgba(0,0,0,0.7);
  padding: 10px 20px;
  border-radius: 4px;
  max-width: 80%;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes zoomIn {
  from { transform: scale(0.8); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

/* Prevent table overflow issues with zoom */
.table-responsive {
  overflow-x: auto;
  overflow-y: visible;
}

/* Ensure zoomed images don't break table layout */
.product-image-zoom-wrapper:hover {
  position: relative;
}
</style>
`); %>

<script>
(function() {
  'use strict';
  
  // Image Zoom Modal Functionality
  console.log('Setting up image zoom modal...');
  
  // Create modal HTML immediately
  function createImageZoomModal() {
    if (document.getElementById('imageZoomModal') === null) {
      var modalHtml = '<div id="imageZoomModal" class="image-zoom-modal">' +
        '<span class="image-zoom-modal-close">&times;</span>' +
        '<div class="image-zoom-modal-content">' +
        '<img id="zoomedImage" src="" alt="">' +
        '<div class="image-zoom-modal-title" id="zoomedImageTitle"></div>' +
        '</div>' +
        '</div>';
      document.body.insertAdjacentHTML('beforeend', modalHtml);
      console.log('Image zoom modal created');
    }
  }
  
  // Global click handler - only register once
  var imageZoomClickHandler = function(e) {
    var wrapper = e.target.closest('.product-image-zoom-wrapper');
    if (wrapper) {
      console.log('Image clicked!');
      e.preventDefault();
      e.stopPropagation();
      
      var img = wrapper.querySelector('.product-zoom-image');
      if (!img) {
        console.error('Image not found in wrapper');
        return;
      }
      
      var imageSrc = img.getAttribute('data-zoom-src') || img.dataset.zoomSrc;
      var productName = img.getAttribute('data-product-name') || img.dataset.productName;
      
      console.log('Image src:', imageSrc, 'Product name:', productName);
      
      if (imageSrc) {
        // Remove query parameters to get original image
        var originalSrc = imageSrc.split('?')[0];
        console.log('Loading image:', originalSrc);
        
        // Set image source directly and show modal
        var zoomedImg = document.getElementById('zoomedImage');
        var zoomedTitle = document.getElementById('zoomedImageTitle');
        var modal = document.getElementById('imageZoomModal');
        
        if (zoomedImg && modal) {
          zoomedImg.src = originalSrc;
          if (zoomedTitle) zoomedTitle.textContent = productName || '';
          modal.classList.add('active');
          document.body.style.overflow = 'hidden';
          console.log('Modal opened');
        } else {
          console.error('Modal elements not found');
        }
      } else {
        console.error('No image source found. Image element:', img);
      }
      return false;
    }
    
    // Close modal
    if (e.target.classList.contains('image-zoom-modal-close') || e.target.id === 'imageZoomModal') {
      var modal = document.getElementById('imageZoomModal');
      if (modal) {
        modal.classList.remove('active');
        document.body.style.overflow = '';
        console.log('Modal closed');
      }
    }
    
    // Don't close when clicking on the image itself
    if (e.target.closest('.image-zoom-modal-content')) {
      e.stopPropagation();
    }
  };
  
  // Global ESC key handler - only register once
  var imageZoomKeyHandler = function(e) {
    if (e.key === 'Escape') {
      var modal = document.getElementById('imageZoomModal');
      if (modal && modal.classList.contains('active')) {
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }
    }
  };
  
  // Register event handlers - use vanilla JS for better compatibility
  function setupImageZoomHandlers() {
    // Remove old listeners and add new ones
    document.removeEventListener('click', imageZoomClickHandler);
    document.addEventListener('click', imageZoomClickHandler, true);
    
    document.removeEventListener('keydown', imageZoomKeyHandler);
    document.addEventListener('keydown', imageZoomKeyHandler);
    
    console.log('Image zoom handlers registered');
  }
  
  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      console.log('DOM ready. Setting up image zoom...');
      createImageZoomModal();
      setupImageZoomHandlers();
      
      // Try to initialize DataTables if available and not already initialized
      if (typeof jQuery !== 'undefined' && typeof jQuery.fn.DataTable !== 'undefined') {
        try {
          var $table = jQuery('.datatable');
          if ($table.length && !jQuery.fn.DataTable.isDataTable('.datatable')) {
            var table = $table.DataTable({
              responsive: true,
              language: {
                url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/pt-BR.json'
              },
              searching: true,
              ordering: true,
              drawCallback: function(settings) {
                console.log('DataTables drawCallback - re-setting up image zoom handlers');
                setupImageZoomHandlers();
              }
            });
            console.log('DataTables initialized successfully');
          } else {
            console.log('DataTables already initialized or table not found');
            setupImageZoomHandlers();
          }
        } catch (err) {
          console.warn('DataTables initialization failed:', err);
        }
      } else {
        console.warn('DataTables not available, continuing without it');
      }
    });
  } else {
    // DOM already loaded
    console.log('DOM already loaded. Setting up image zoom...');
    createImageZoomModal();
    setupImageZoomHandlers();
    
    if (typeof jQuery !== 'undefined' && typeof jQuery.fn.DataTable !== 'undefined') {
      try {
        var $table = jQuery('.datatable');
        if ($table.length && !jQuery.fn.DataTable.isDataTable('.datatable')) {
          var table = $table.DataTable({
            responsive: true,
            language: {
              url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/pt-BR.json'
            },
            searching: true,
            ordering: true
          });
          console.log('DataTables initialized successfully');
        } else {
          console.log('DataTables already initialized or table not found');
        }
      } catch (err) {
        console.warn('DataTables initialization failed:', err);
      }
    }
  }
})();
</script>
