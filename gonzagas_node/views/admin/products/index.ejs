  <div class="row">
    <div class="col-12">
      <div class="page-title-box">
        <h4 class="page-title"><%= title %></h4>
        <div class="page-title-right">
          <a href="/admin/products/add" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Adicionar Produto
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-header">
      <h5 class="card-title mb-0">Filtros</h5>
    </div>
    <div class="card-body">
      <form id="product-filters" class="row g-2" method="GET" action="/admin/products">
        <div class="col-md-3">
          <input type="text" id="filter-reference" name="reference" class="form-control form-control-sm" placeholder="Referência" value="<%= typeof queryParams !== 'undefined' && queryParams.reference ? queryParams.reference : '' %>">
        </div>
        <div class="col-md-3">
          <select id="filter-category" name="category" class="form-select form-select-sm">
            <option value="">Todas as Categorias</option>
            <% if (typeof productFamilies !== 'undefined' && productFamilies.length > 0) { %>
              <% productFamilies.forEach(family => { %>
                <option value="<%= family.name %>" <%= typeof queryParams !== 'undefined' && queryParams.category === family.name ? 'selected' : '' %>><%= family.name %></option>
              <% }); %>
            <% } %>
          </select>
        </div>
        <div class="col-md-2">
          <select id="filter-status" name="status" class="form-select form-select-sm">
            <option value="">Todos os Status</option>
            <option value="Ativo" <%= typeof queryParams !== 'undefined' && queryParams.status === 'Ativo' ? 'selected' : '' %>>Ativo</option>
            <option value="Inativo" <%= typeof queryParams !== 'undefined' && queryParams.status === 'Inativo' ? 'selected' : '' %>>Inativo</option>
          </select>
        </div>
        <div class="col-md-2">
          <select id="filter-stock" name="stock_status" class="form-select form-select-sm">
            <option value="">Todos</option>
            <option value="in_stock" <%= typeof queryParams !== 'undefined' && queryParams.stock_status === 'in_stock' ? 'selected' : '' %>>Em Stock</option>
            <option value="low_stock" <%= typeof queryParams !== 'undefined' && queryParams.stock_status === 'low_stock' ? 'selected' : '' %>>Stock Baixo</option>
            <option value="out_of_stock" <%= typeof queryParams !== 'undefined' && queryParams.stock_status === 'out_of_stock' ? 'selected' : '' %>>Fora de Stock</option>
          </select>
        </div>
        <div class="col-md-1">
          <button type="submit" class="btn btn-primary btn-sm w-100">Filtrar</button>
        </div>
        <div class="col-md-1">
          <a href="/admin/products" id="reset-filters" class="btn btn-outline-secondary btn-sm w-100">Limpar</a>
        </div>
      </form>
    </div>
  </div>

  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-body">
          <% if (products && products.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-hover mb-0 datatable" style="width:100%">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Imagem</th>
                    <th>Referência</th>
<th>Categoria</th>
<th>Nome</th>
                    <th>Preço</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th class="text-end">Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <% products.forEach(product => { %>
                    <tr 
                      data-family-name="<%= product.family_name || '' %>" 
                      data-is-active="<%= product.is_active %>" 
                      data-stock-quantity="<%= product.current_stock || 0 %>"
                      data-reference="<%= product.reference || '' %>"
                    >
                      <td><%= product.id %></td>
                      <td>
                        <% if (product.image_url) { %>
                          <a href="/media/products/<%= product.image_url %>" 
                             class="glightbox product-image-link" 
                             data-glightbox="type: image; title: <%= product.name %>"
                             data-gallery="product-gallery"
                             style="display: inline-block; position: relative; width: 50px; height: 50px; cursor: pointer;">
                            <img src="/media/products/<%= product.image_url %>" 
                                 alt="<%= product.name %>" 
                                 class="img-thumbnail" 
                                 style="width: 50px; height: 50px; object-fit: cover; transition: transform 0.3s ease;"
                                 loading="lazy">
                            <div class="zoom-overlay" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.3); opacity: 0; transition: opacity 0.3s ease; display: flex; align-items: center; justify-content: center; border-radius: 0.25rem; pointer-events: none;">
                              <i class="fas fa-search-plus text-white" style="font-size: 16px;"></i>
                            </div>
                          </a>
                        <% } else { %>
                          <div class="bg-light d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="fas fa-box text-muted"></i>
                          </div>
                        <% } %>
                      </td>
                      <td><%= product.reference || 'N/A' %></td>
<td><%= product.family_name || '' %></td>
<td><%= product.name %></td>
                      <td><%= parseFloat(product.price || 0).toLocaleString('pt-PT', {style: 'currency', currency: 'EUR'}) %></td>
                      <td>
                        <span class="badge bg-<%= product.current_stock > 10 ? 'success' : product.current_stock > 0 ? 'warning' : 'danger' %>">
                          <%= product.current_stock || 0 %>
                        </span>
                      </td>
                      <td>
                        <span class="badge bg-<%= product.is_active ? 'success' : 'secondary' %>">
                          <%= product.is_active ? 'Ativo' : 'Inativo' %>
                        </span>
                      </td>
                      <td class="text-end">
                        <div class="btn-group">
                          <a href="/admin/products/edit/<%= product.id %>" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-edit"></i>
                          </a>
                          <a href="/admin/products/delete/<%= product.id %>" 
                             class="btn btn-sm btn-outline-danger"
                             onclick="return confirm('Tem certeza que deseja excluir este produto?')">
                            <i class="fas fa-trash"></i>
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
              <nav class="mt-3">
                <ul class="pagination justify-content-center">
                  <% if (currentPage > 1) { %>
                    <li class="page-item">
                      <a class="page-link" href="?page=<%= currentPage - 1 %>&limit=<%= limit %>">Anterior</a>
                    </li>
                  <% } %>
                  
                  <% for (let i = 1; i <= totalPages; i++) { %>
                    <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                      <a class="page-link" href="?page=<%= i %>&limit=<%= limit %>"><%= i %></a>
                    </li>
                  <% } %>
                  
                  <% if (currentPage < totalPages) { %>
                    <li class="page-item">
                      <a class="page-link" href="?page=<%= currentPage + 1 %>&limit=<%= limit %>">Próximo</a>
                    </li>
                  <% } %>
                </ul>
              </nav>
            <% } %>
          <% } else { %>
            <div class="alert alert-info mb-0">
              Nenhum produto encontrado. <a href="/admin/products/add">Adicionar um novo produto</a>.
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

<% locals.styles = locals.styles || []; %>
<% locals.styles.push(`
<style>
.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem; /* Space between filter groups */
  align-items: flex-end; /* Align items to the bottom */
}

.filter-group {
  flex: 1; /* Allow groups to grow */
  min-width: 150px; /* Minimum width for each filter group */
  /* margin-bottom: 0.5rem; /* Add some bottom margin if flex-wrap causes multiple lines */
}

.filter-group.compact { 
  flex: 0 1 120px; /* Don't grow, basis of 120px */
  max-width: 120px;
}

.filter-group.actions {
  flex: 0 0 auto; /* Don't grow or shrink */
  display: flex;
  gap: 0.5rem; /* Space between action buttons */
  /* margin-left: auto; /* Pushes actions to the right if using a fixed-width container */
}

.filter-group label {
  display: block;
  margin-bottom: 0.25rem;
  font-size: 0.8rem;
  font-weight: 500;
  white-space: nowrap; /* Prevent labels from wrapping */
}

/* Product Image Zoom Styles - Using GLightbox */
.product-image-link {
  position: relative;
  overflow: visible;
  z-index: 1;
  text-decoration: none;
  display: inline-block;
}

.product-image-link:hover .zoom-overlay {
  opacity: 1;
}

.product-image-link:hover img {
  transform: scale(1.1);
  box-shadow: 0 4px 20px rgba(0,0,0,0.3);
}

.zoom-overlay {
  pointer-events: none;
}

/* GLightbox customizations */
.glightbox-container img {
  max-width: 95vw !important;
  max-height: 90vh !important;
  object-fit: contain !important;
}
</style>
`); %>

<script>
(function() {
  'use strict';
  
  // Initialize GLightbox for product images
  console.log('Setting up GLightbox for product images...');
  
  function initProductImageLightbox() {
    if (typeof GLightbox === 'undefined') {
      console.error('GLightbox is not loaded');
      return;
    }
    
    // Initialize GLightbox with custom configuration
    var lightbox = GLightbox({
      selector: '.product-image-link',
      touchNavigation: true,
      loop: true,
      autoplayVideos: false,
      zoomable: true,
      draggable: true,
      openEffect: 'zoom',
      closeEffect: 'zoom',
      slideEffect: 'slide',
      moreText: 'Ver mais imagens',
      moreLength: 60,
      closeButton: true,
      touchFollowAxis: true,
      keyboardNavigation: true,
      closeOnOutsideClick: true,
      width: '90vw',
      height: '90vh'
    });
    
    console.log('GLightbox initialized successfully for product images');
    
    // Re-initialize after DataTables redraws
    if (typeof jQuery !== 'undefined' && typeof jQuery.fn.DataTable !== 'undefined') {
      var $table = jQuery('.datatable');
      if ($table.length) {
        if (!jQuery.fn.DataTable.isDataTable('.datatable')) {
          $table.DataTable({
            responsive: true,
            language: {
              url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/pt-BR.json'
            },
            searching: true,
            ordering: true,
            drawCallback: function(settings) {
              console.log('DataTables drawCallback - GLightbox should auto-detect new images');
            }
          });
        }
      }
    }
  }
  
  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProductImageLightbox);
  } else {
    initProductImageLightbox();
  }
})();
</script>
