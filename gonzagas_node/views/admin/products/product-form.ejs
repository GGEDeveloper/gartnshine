<link rel="stylesheet" href="/css/camera-capture.css">
<script src="/js/camera-capture.js"></script>
<script>document.addEventListener("DOMContentLoaded",function(){var f=document.getElementById("productForm");if(f&&window.initCameraForForm)initCameraForForm(f,{imageInputName:"images",multiple:true,mobileOnly:false});});</script>
<div class="container-fluid">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><%= title %></h1>
        <% if (product && product.id) { %>
            <a href="/admin/products/<%= product.id %>" class="btn btn-outline-primary btn-sm">
                <i class="fas fa-eye"></i> Visualizar
            </a>
        <% } %>
          </div>

    <%- include('../partials/flash-messages') %>

<% const formAction = isNew ? '/admin/products/create' : `/admin/products/edit/${product.id}`; %>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                <%= product && product.id ? 'Editar' : 'Novo' %> Produto
            </h6>
        </div>
        <div class="card-body">
            <form 
                id="productForm"
                action="<%= formAction %>" 
                method="POST" 
                enctype="multipart/form-data"
                class="needs-validation"
                novalidate
                data-notification="Salvando produto..."
                data-notification-type="info"
            >
                <% if (product && product.id) { %>
                    <input type="hidden" name="_method" value="PUT">
                <% } %>

            <div class="row">
                    <!-- Coluna Esquerda -->
                    <div class="col-md-6">
                        <!-- Informações Básicas -->
                        <div class="form-group mb-3">
                            <label for="name" class="form-label">Nome do Produto *</label>
                            <input 
                                type="text" 
                                class="form-control" 
                                id="name" 
                                name="name" 
                                value="<%= product ? product.name : '' %>"
                                required
                            >
                            <div class="invalid-feedback">
                                Nome é obrigatório
                            </div>
                        </div>

                <div class="form-group mb-3">
                            <label for="reference" class="form-label">Referência</label>
                            <input 
                                type="text" 
                                class="form-control" 
                                id="reference" 
                                name="reference" 
                                value="<%= product ? product.reference : '' %>"
                            >
                </div>
                
                <div class="form-group mb-3">
                            <label for="barcode" class="form-label">Código de Barras</label>
                            <input 
                                type="text" 
                                class="form-control" 
                                id="barcode" 
                                name="barcode" 
                                value="<%= product ? product.barcode : '' %>"
                            >
                </div>
                
                    <div class="form-group mb-3">
                            <label for="family_id" class="form-label">Família de Produtos</label>
                            <select class="form-control" id="family_id" name="family_id">
                        <option value="">Selecione uma família</option>
                                <% if (productFamilies && productFamilies.length > 0) { %>
                          <% productFamilies.forEach(family => { %>
                                        <option 
                                            value="<%= family.id %>" 
                                            <%= product && product.family_id == family.id ? 'selected' : '' %>
                                        >
                              <%= family.name %>
                            </option>
                          <% }); %>
                        <% } %>
                      </select>
                    </div>

                        <!-- Preços -->
                    <div class="form-group mb-3">
                            <label for="purchase_price" class="form-label">Preço de Compra (€)</label>
                            <input 
                                type="number" 
                                class="form-control" 
                                id="purchase_price" 
                                name="purchase_price" 
                                step="0.01" 
                                min="0"
                                value="<%= product ? product.purchase_price : '' %>"
                            >
                </div>

                    <div class="form-group mb-3">
                            <label for="sale_price" class="form-label">Preço de Venda (€)</label>
                            <input 
                                type="number" 
                                class="form-control" 
                                id="sale_price" 
                                name="sale_price" 
                                step="0.01" 
                                min="0"
                                value="<%= product ? product.sale_price : '' %>"
                            >
                      </div>
                    </div>

                    <!-- Coluna Direita -->
                    <div class="col-md-6">
                        <!-- Estoque -->
                    <div class="form-group mb-3">
                            <label for="current_stock" class="form-label">Estoque Atual</label>
                            <input 
                                type="number" 
                                class="form-control" 
                                id="current_stock" 
                                name="current_stock" 
                                min="0"
                                value="<%= product ? product.current_stock : '0' %>"
                            >
                      </div>

                    <div class="form-group mb-3">
                            <label for="min_stock" class="form-label">Estoque Mínimo</label>
                            <input 
                                type="number" 
                                class="form-control" 
                                id="min_stock" 
                                name="min_stock" 
                                min="0"
                                value="<%= product ? product.min_stock : '0' %>"
                            >
                </div>

                        <!-- Características Físicas -->
                    <div class="form-group mb-3">
                            <label for="weight" class="form-label">Peso</label>
                            <div class="input-group">
                                <input 
                                    type="number" 
                                    class="form-control" 
                                    id="weight" 
                                    name="weight" 
                                    step="0.001" 
                                    min="0"
                                    value="<%= product ? product.weight : '' %>"
                                >
                                <select class="form-select" name="weight_unit" style="max-width: 80px;">
                                    <option value="g" <%= product && product.weight_unit === 'g' ? 'selected' : '' %>>g</option>
                                    <option value="kg" <%= product && product.weight_unit === 'kg' ? 'selected' : '' %>>kg</option>
                                </select>
                  </div>
                </div>
                
                <div class="form-group mb-3">
                            <label for="dimensions" class="form-label">Dimensões</label>
                            <input 
                                type="text" 
                                class="form-control" 
                                id="dimensions" 
                                name="dimensions" 
                                placeholder="Ex: 10x5x2 cm"
                                value="<%= product ? product.dimensions : '' %>"
                            >
                </div>

                        <!-- Materiais e Estilo -->
                <div class="form-group mb-3">
                            <label for="material" class="form-label">Material</label>
                            <input 
                                type="text" 
                                class="form-control" 
                                id="material" 
                                name="material" 
                                value="<%= product ? product.material : 'Prata 925' %>"
                            >
                </div>

                <div class="form-group mb-3">
                            <label for="color" class="form-label">Cor</label>
                            <% if (colors && colors.length > 0) { %>
                              <select class="form-select" id="color" name="color">
                                <option value="">— Selecionar —</option>
                                <% colors.forEach(c => { %>
                                  <option value="<%= c.name %>" <%= product && product.color === c.name ? 'selected' : '' %>><%= c.name %></option>
                                <% }); %>
                              </select>
                            <% } else { %>
                              <input type="text" class="form-control" id="color" name="color" value="<%= product ? product.color : '' %>" placeholder="Ex: Prata">
                            <% } %>
                </div>

                <div class="form-group mb-3">
                            <label for="style" class="form-label">Estilo</label>
                            <input 
                                type="text" 
                                class="form-control" 
                                id="style" 
                                name="style" 
                                value="<%= product ? product.style : '' %>"
                            >
                </div>
                </div>
                </div>
                
                <!-- Descrição -->
                <div class="form-group mb-3">
                    <label for="description" class="form-label">Descrição</label>
                    <textarea 
                        class="form-control" 
                        id="description" 
                        name="description" 
                        rows="3"
                    ><%= product ? product.description : '' %></textarea>
                </div>

                <!-- Notas -->
                <div class="form-group mb-3">
                    <label for="notes" class="form-label">Notas Internas</label>
                    <textarea 
                        class="form-control" 
                        id="notes" 
                        name="notes" 
                        rows="2"
                    ><%= product ? product.notes : '' %></textarea>
                </div>

                <!-- Configurações -->
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-check mb-3">
                            <input 
                                class="form-check-input" 
                                type="checkbox" 
                                id="is_active" 
                                name="is_active"
                                value="1"
                                <%= !product || product.is_active ? 'checked' : '' %>
                            >
                            <label class="form-check-label" for="is_active">
                                Produto Ativo
                            </label>
                </div>
                  </div>
                    <div class="col-md-4">
                        <div class="form-check mb-3">
                            <input 
                                class="form-check-input" 
                                type="checkbox" 
                                id="is_catalog_visible" 
                                name="is_catalog_visible"
                                value="1"
                                <%= !product || product.is_catalog_visible ? 'checked' : '' %>
                            >
                            <label class="form-check-label" for="is_catalog_visible">
                                Visível no Catálogo
                            </label>
                              </div>
                            </div>
                    <div class="col-md-4">
                        <div class="form-check mb-3">
                            <input 
                                class="form-check-input" 
                                type="checkbox" 
                                id="featured" 
                                name="featured"
                                value="1"
                                <%= product && product.featured ? 'checked' : '' %>
                            >
                            <label class="form-check-label" for="featured">
                                Produto em Destaque
                            </label>
                    </div>
                  </div>
                </div>

                <!-- Gestão de Imagens -->
                <div class="form-group mb-4">
                    <label class="form-label">Gestão de Imagens do Produto</label>
                    
                    <!-- Imagens Existentes -->
                    <% if (product && product.images && product.images.length > 0) { %>
                        <div class="mb-3">
                            <h6 class="mb-2">Imagens Existentes</h6>
                            <div class="row g-3" id="existingImagesContainer">
                                <% product.images.forEach((img, index) => { %>
                                    <div class="col-md-3 col-sm-4 col-6">
                                        <div class="card h-100 <%= img.is_primary ? 'border-primary border-2' : '' %>" style="position: relative;">
                                            <img src="/media/products/<%= img.image_filename %>" 
                                                 class="card-img-top" 
                                                 alt="Imagem <%= index + 1 %>" 
                                                 style="height: 150px; object-fit: cover; cursor: pointer;"
                                                 onclick="openImageModal('/media/products/<%= img.image_filename %>')">
                                            <div class="card-body p-2">
                                                <% if (img.is_primary) { %>
                                                    <span class="badge bg-primary mb-2">
                                                        <i class="fas fa-star"></i> Imagem Principal
                                                    </span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary mb-2">Secundária</span>
                                                <% } %>
                                                <div class="form-check">
                                                    <input 
                                                        class="form-check-input" 
                                                        type="radio" 
                                                        name="primary_image_id" 
                                                        id="primaryImage<%= img.id %>" 
                                                        value="<%= img.id %>"
                                                        <%= img.is_primary ? 'checked' : '' %>
                                                    >
                                                    <label class="form-check-label small" for="primaryImage<%= img.id %>">
                                                        Definir como Principal
                                                    </label>
                                                </div>
                                                <button 
                                                    type="button" 
                                                    class="btn btn-danger btn-sm mt-2 w-100"
                                                    onclick="markImageForDeletion(<%= img.id %>, this)"
                                                    title="Marcar para exclusão"
                                                >
                                                    <i class="fas fa-trash"></i> Remover
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                            <input type="hidden" name="imagesToDelete" id="imagesToDelete" value="">
                        </div>
                    <% } else if (product && product.image_url) { %>
                        <!-- Fallback para produtos antigos que só têm image_url -->
                        <div class="mb-3">
                            <h6 class="mb-2">Imagem Atual</h6>
                            <div class="card" style="max-width: 200px;">
                                <img src="/media/products/<%= product.image_url %>" 
                                     class="card-img-top" 
                                     alt="<%= product.name %>" 
                                     style="height: 150px; object-fit: cover; cursor: pointer;"
                                     onclick="openImageModal('/media/products/<%= product.image_url %>')">
                                <div class="card-body p-2">
                                    <span class="badge bg-primary">
                                        <i class="fas fa-star"></i> Imagem Principal
                                    </span>
                                    <p class="text-muted small mt-2 mb-0">Imagem atual: <%= product.image_url %></p>
                                </div>
                            </div>
                        </div>
                    <% } %>
                    
                    <!-- Upload de Novas Imagens -->
                    <div class="mb-3">
                        <label for="images" class="form-label">Adicionar Novas Imagens</label>
                        <div class="d-flex flex-column flex-sm-row gap-2 mb-2">
                            <button type="button" class="btn btn-camera-capture" data-action="open-camera">
                                <i class="fas fa-camera"></i>
                                <span>Tirar foto</span>
                            </button>
                            <div class="flex-grow-1">
                                <input 
                                    type="file" 
                                    class="form-control" 
                                    id="images" 
                                    name="images" 
                                    accept="image/*"
                                    multiple
                                >
                            </div>
                        </div>
                        <small class="form-text text-muted">Câmara ou ficheiro. Múltiplas imagens. A primeira será principal por padrão.</small>
                    </div>
                    
                    <!-- Preview de Novas Imagens -->
                    <div id="newImagePreviews" class="row g-3 mb-3" style="display: none;"></div>
                    
                    <!-- Campo legado para compatibilidade -->
                    <input 
                        type="file" 
                        class="form-control d-none" 
                        id="image" 
                        name="image" 
                        accept="image/*"
                    >
          </div>
          
                <!-- Botões -->
                <div class="form-group d-flex justify-content-between">
                    <a href="<%= typeof backUrl !== 'undefined' ? backUrl : '/admin/products' %>" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Voltar
                    </a>
                    <div>
                        <% if (product && product.id) { %>
                            <button 
                                type="button" 
                                class="btn btn-danger me-2"
                                data-notification="Produto excluído com sucesso!"
                                data-notification-type="success"
                                onclick="confirmDelete(<%= product.id %>)"
                            >
                <i class="fas fa-trash"></i> Excluir
              </button>
            <% } %>
                        <button 
                            type="submit" 
                            class="btn btn-primary"
                            data-notification="Produto salvo com sucesso!"
                            data-notification-type="success"
                        >
              <i class="fas fa-save"></i> Salvar
            </button>
                    </div>
          </div>
        </form>
      </div>
    </div>
  </div>

<script>
// Preview de novas imagens (incl. captura de câmara)
(function() {
  const inp = document.getElementById('images');
  const container = document.getElementById('newImagePreviews');
  if (!inp || !container) return;
  inp.addEventListener('change', function() {
    container.innerHTML = '';
    const files = this.files;
    if (files.length === 0) {
      container.style.display = 'none';
      return;
    }
    container.style.display = '';
    for (let i = 0; i < files.length; i++) {
      const f = files[i];
      if (!f.type.startsWith('image/')) continue;
      const reader = new FileReader();
      reader.onload = function(e) {
        const col = document.createElement('div');
        col.className = 'col-md-3 mb-3';
        col.innerHTML = '<div class="card h-100"><img src="' + e.target.result + '" class="card-img-top" style="height:150px;object-fit:cover" alt=""><div class="card-body p-2"><small class="text-muted">' + f.name + '</small></div></div>';
        container.appendChild(col);
      };
      reader.readAsDataURL(f);
    }
  });
})();
</script>
<% if (product && product.id) { %>
<script>
// Array para armazenar IDs de imagens marcadas para exclusão
let imagesToDelete = [];

function markImageForDeletion(imageId, button) {
    const index = imagesToDelete.indexOf(imageId);
    const card = button.closest('.card');
    
    if (index > -1) {
        // Remover da lista (desfazer)
        imagesToDelete.splice(index, 1);
        button.classList.remove('btn-danger');
        button.classList.add('btn-outline-danger');
        button.innerHTML = '<i class="fas fa-trash"></i> Remover';
        card.style.opacity = '1';
        card.style.border = '';
    } else {
        // Adicionar à lista (marcar para exclusão)
        imagesToDelete.push(imageId);
        button.classList.remove('btn-outline-danger');
        button.classList.add('btn-danger');
        button.innerHTML = '<i class="fas fa-undo"></i> Desfazer';
        card.style.opacity = '0.5';
        card.style.border = '2px dashed #dc3545';
    }
    
    // Atualizar campo hidden
    document.getElementById('imagesToDelete').value = imagesToDelete.join(',');
}

function openImageModal(imageSrc) {
    // Criar modal se não existir
    let modal = document.getElementById('imageViewModal');
    if (!modal) {
        modal = document.createElement('div');
        modal.id = 'imageViewModal';
        modal.className = 'modal fade';
        modal.innerHTML = `
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Visualizar Imagem</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body text-center p-0">
                        <img id="modalImage" src="" alt="Imagem do produto" class="img-fluid" style="max-height: 70vh;">
                    </div>
                </div>
            </div>
        `;
        document.body.appendChild(modal);
    }
    
    // Definir imagem e abrir modal
    document.getElementById('modalImage').src = imageSrc;
    const bsModal = new bootstrap.Modal(modal);
    bsModal.show();
}

function confirmDelete(productId) {
    if (confirm('Tem certeza que deseja excluir este produto? Esta ação não pode ser desfeita.')) {
        // Mostrar notificação de carregamento
        notifications.warning('Excluindo produto...', 2000);
        
        // Criar formulário para DELETE
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `/admin/products/${productId}`;
        
        const methodInput = document.createElement('input');
        methodInput.type = 'hidden';
        methodInput.name = '_method';
        methodInput.value = 'DELETE';
        
        form.appendChild(methodInput);
        document.body.appendChild(form);
        form.submit();
    }
}

// Validação de formulário
(function() {
    'use strict';
    window.addEventListener('load', function() {
        const forms = document.getElementsByClassName('needs-validation');
        Array.prototype.filter.call(forms, function(form) {
            form.addEventListener('submit', function(event) {
                if (form.checkValidity() === false) {
                    event.preventDefault();
                    event.stopPropagation();
                    notifications.error('Por favor, corrija os erros no formulário antes de continuar.', 5000);
                }
                form.classList.add('was-validated');
            }, false);
        });
    }, false);
})();
</script>
<% } %>
