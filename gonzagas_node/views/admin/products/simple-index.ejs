<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="page-title-box">
        <h4 class="page-title"><%= title %></h4>
        <div class="page-title-right">
          <a href="/admin/products/add" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Adicionar Produto
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-body">
          <% if (products && products.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Imagem</th>
                    <th>Referência</th>
                    <th>Nome</th>
                    <th>Preço</th>
                    <th>Estoque</th>
                    <th>Status</th>
                    <th class="text-end">Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <% products.forEach(product => { %>
                    <tr>
                      <td><%= product.id %></td>
                      <td>
                        <% if (product.image_url) { %>
                          <img src="<%= product.image_url %>" alt="<%= product.name %>" class="img-thumbnail" style="width: 50px; height: 50px; object-fit: cover;">
                        <% } else { %>
                          <div class="bg-light d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="fas fa-box text-muted"></i>
                          </div>
                        <% } %>
                      </td>
                      <td><%= product.reference || 'N/A' %></td>
                      <td><%= product.name %></td>
                      <td><%= parseFloat(product.sale_price || 0).toLocaleString('pt-BR', {style: 'currency', currency: 'BRL'}) %></td>
                      <td>
                        <span class="badge bg-<%= product.stock_quantity > 10 ? 'success' : product.stock_quantity > 0 ? 'warning' : 'danger' %>">
                          <%= product.stock_quantity || 0 %>
                        </span>
                      </td>
                      <td>
                        <span class="badge bg-<%= product.is_active ? 'success' : 'secondary' %>">
                          <%= product.is_active ? 'Ativo' : 'Inativo' %>
                        </span>
                      </td>
                      <td class="text-end">
                        <div class="btn-group">
                          <a href="/admin/products/edit/<%= product.id %>" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-edit"></i>
                          </a>
                          <a href="/admin/products/delete/<%= product.id %>" 
                             class="btn btn-sm btn-outline-danger"
                             onclick="return confirm('Tem certeza que deseja excluir este produto?')">
                            <i class="fas fa-trash"></i>
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

            <% if (pagination && pagination.totalPages > 1) { %>
              <nav class="mt-3">
                <ul class="pagination justify-content-center">
                  <% if (pagination.currentPage > 1) { %>
                    <li class="page-item">
                      <a class="page-link" href="?page=<%= pagination.currentPage - 1 %>&limit=<%= limit %>">Anterior</a>
                    </li>
                  <% } %>
                  
                  <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                    <li class="page-item <%= i === pagination.currentPage ? 'active' : '' %>">
                      <a class="page-link" href="?page=<%= i %>&limit=<%= limit %>"><%= i %></a>
                    </li>
                  <% } %>
                  
                  <% if (pagination.currentPage < pagination.totalPages) { %>
                    <li class="page-item">
                      <a class="page-link" href="?page=<%= pagination.currentPage + 1 %>&limit=<%= limit %>">Próximo</a>
                    </li>
                  <% } %>
                </ul>
              </nav>
            <% } %>
          <% } else { %>
            <div class="alert alert-info mb-0">
              Nenhum produto encontrado. <a href="/admin/products/add">Adicionar um novo produto</a>.
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
