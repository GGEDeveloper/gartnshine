<div class="container-fluid px-3 px-md-4 py-3">
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-3">
    <h1 class="h4 mb-0">Checkpoints</h1>
  </div>

  <%- include('../partials/flash-messages') %>

  <div class="card mb-3">
    <div class="card-header">
      <h5 class="card-title mb-0">Criar novo checkpoint</h5>
    </div>
    <div class="card-body">
      <form action="/admin/checkpoints/create" method="POST" class="checkpoint-form">
        <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% } %>
        <div class="row g-3">
          <div class="col-12 col-md-6">
            <label for="checkpoint_name" class="form-label">Nome do checkpoint</label>
            <input type="text" class="form-control form-control-lg" id="checkpoint_name" name="checkpoint_name" placeholder="Ex: Antes da migração" required>
          </div>
          <div class="col-12 col-md-6">
            <label for="description" class="form-label">Descrição</label>
            <input type="text" class="form-control form-control-lg" id="description" name="description" placeholder="Breve descrição">
          </div>
          <div class="col-12">
            <button type="submit" class="btn btn-primary">
              <i class="fas fa-save me-1"></i> Criar checkpoint
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h5 class="card-title mb-0">Checkpoints existentes</h5>
    </div>
    <div class="card-body">
      <% if (checkpoints && checkpoints.length > 0) { %>
        <div class="checkpoints-list">
          <% checkpoints.forEach(cp => { %>
            <div class="checkpoint-item card mb-2">
              <div class="card-body py-3">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-2">
                  <div>
                    <h6 class="mb-1"><%= cp.checkpoint_name %></h6>
                    <% if (cp.description) { %>
                      <p class="text-muted small mb-1"><%= cp.description %></p>
                    <% } %>
                    <small class="text-muted">
                      <%= cp.created_at ? new Date(cp.created_at).toLocaleString('pt-PT') : '-' %>
                      <% if (cp.created_by) { %> • <%= cp.created_by %><% } %>
                    </small>
                  </div>
                  <div class="d-flex gap-2 flex-shrink-0">
                    <form action="/admin/checkpoints/restore/<%= cp.id %>" method="POST" class="d-inline" onsubmit="return confirm('Restaurar este checkpoint? Todos os dados atuais serão substituídos.')">
                      <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <% } %>
                      <button type="submit" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-undo"></i> Restaurar
                      </button>
                    </form>
                    <form action="/admin/checkpoints/delete/<%= cp.id %>" method="POST" class="d-inline" onsubmit="return confirm('Eliminar este checkpoint?')">
                      <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <% } %>
                      <button type="submit" class="btn btn-outline-danger btn-sm">
                        <i class="fas fa-trash"></i> Eliminar
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <p class="text-muted mb-0">Nenhum checkpoint criado ainda.</p>
      <% } %>
    </div>
  </div>
</div>
