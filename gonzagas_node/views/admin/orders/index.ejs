<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Pedidos</h1>
    <a href="/admin/settings/ecommerce" class="btn btn-outline-secondary btn-sm">Config. E-commerce</a>
  </div>

  <form method="get" class="row g-2 mb-4">
    <div class="col-md-3">
      <input type="search" name="search" class="form-control" placeholder="Pesquisar..." value="<%= filters.search || '' %>">
    </div>
    <div class="col-md-2">
      <select name="status" class="form-select">
        <option value="">Estado</option>
        <% ['pending','confirmed','processing','shipped','delivered','cancelled'].forEach(function(s) { %>
          <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
        <% }); %>
      </select>
    </div>
    <div class="col-md-2">
      <button type="submit" class="btn btn-primary">Filtrar</button>
    </div>
  </form>

  <div class="table-responsive">
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Nº</th>
          <th>Cliente</th>
          <th>Total</th>
          <th>Estado</th>
          <th>Pagamento</th>
          <th>Data</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (!orders.length) { %>
          <tr><td colspan="7" class="text-muted">Sem pedidos.</td></tr>
        <% } %>
        <% orders.forEach(function(o) { %>
          <tr>
            <td><%= o.order_number %></td>
            <td><%= o.customer_name %><br><small><%= o.customer_email %></small></td>
            <td>€<%= parseFloat(o.total_amount).toFixed(2) %></td>
            <td><span class="badge bg-secondary"><%= o.status %></span></td>
            <td><span class="badge bg-info text-dark"><%= o.payment_status %></span></td>
            <td><%= new Date(o.created_at).toLocaleString('pt-PT') %></td>
            <td><a href="/admin/orders/<%= o.id %>" class="btn btn-sm btn-outline-primary">Ver</a></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <p class="text-muted small">Total: <%= total %> pedido(s)</p>
</div>
