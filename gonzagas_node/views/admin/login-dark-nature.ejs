<!DOCTYPE html>
<html lang="pt" data-theme="dark-nature-admin">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login - Gonzaga Art & Shine</title>
    
    <!-- Admin CSS -->
    <link rel="stylesheet" href="/css/tokens-dark-nature.css">
    <link rel="stylesheet" href="/css/base-dark-nature.css">
    <link rel="stylesheet" href="/css/admin-login-dark-nature.css">
    
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Source+Sans+3:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>
<body class="admin-login-page">
    
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <div class="login-brand">
                    <h1 class="brand-name">Gonzaga</h1>
                    <span class="brand-accent">Admin Portal</span>
                </div>
                <p class="login-subtitle">Painel de Gestão das Pedras Sagradas</p>
            </div>
            
            <form id="admin-login-form" class="login-form">
                <div class="form-group">
                    <label for="username" class="form-label">
                        <span class="label-icon">👤</span>
                        <span class="label-text">Username</span>
                    </label>
                    <input type="text" 
                           id="username" 
                           name="username" 
                           class="form-input" 
                           placeholder="gonzaga"
                           required 
                           autocomplete="username">
                </div>
                
                <div class="form-group">
                    <label for="password" class="form-label">
                        <span class="label-icon">🔐</span>
                        <span class="label-text">Password</span>
                    </label>
                    <input type="password" 
                           id="password" 
                           name="password" 
                           class="form-input" 
                           placeholder="••••••••"
                           required 
                           autocomplete="current-password">
                </div>
                
                <div class="form-actions">
                    <button type="submit" class="btn btn--admin-primary btn--large" id="login-btn">
                        <span class="btn-text">Entrar no Portal Sagrado</span>
                        <span class="btn-icon">🚪</span>
                    </button>
                </div>
                
                <div class="login-error" id="login-error" style="display: none;">
                    <span class="error-icon">⚠️</span>
                    <span class="error-message"></span>
                </div>
            </form>
            
            <div class="login-footer">
                <div class="security-note">
                    <span class="security-icon">🔒</span>
                    <span class="security-text">Acesso seguro e encriptado</span>
                </div>
                <div class="login-hint">
                    <p>Login: <code>gonzaga</code> / <code>covil</code></p>
                </div>
            </div>
        </div>
        
        <div class="login-background">
            <div class="bg-overlay"></div>
        </div>
    </div>
    
    <script>
        document.getElementById('admin-login-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const loginBtn = document.getElementById('login-btn');
            const errorDiv = document.getElementById('login-error');
            const formData = new FormData(e.target);
            
            // Show loading state
            loginBtn.disabled = true;
            loginBtn.innerHTML = '<span class="btn-text">Verificando...</span><span class="btn-icon">⏳</span>';
            errorDiv.style.display = 'none';
            
            try {
                const response = await fetch('/admin/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        username: formData.get('username'),
                        password: formData.get('password')
                    })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    loginBtn.innerHTML = '<span class="btn-text">Sucesso! Redirecionando...</span><span class="btn-icon">✅</span>';
                    setTimeout(() => {
                        window.location.href = result.redirectUrl || '/admin';
                    }, 500);
                } else {
                    throw new Error(result.error || 'Erro de login');
                }
                
            } catch (error) {
                errorDiv.querySelector('.error-message').textContent = error.message;
                errorDiv.style.display = 'flex';
                
                loginBtn.disabled = false;
                loginBtn.innerHTML = '<span class="btn-text">Entrar no Portal Sagrado</span><span class="btn-icon">🚪</span>';
            }
        });
    </script>
</body>
</html>

