<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Analytics Dashboard' %> - Admin</title>
    
    <!-- Existing Admin CSS -->
    <link rel="stylesheet" href="/css/admin-v2.css">
    <link rel="stylesheet" href="/css/analytics-dashboard.css">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/date-fns@2.29.3/index.min.js"></script>
</head>
<body class="admin-layout">
    
    <%- include('../partials/admin-header') %>
    
    <main class="admin-main">
        <%- include('../partials/admin-sidebar') %>
        
        <div class="admin-content">
            
            <!-- Header -->
            <div class="analytics-header">
                <div>
                    <h1><i class="fas fa-chart-line"></i> Analytics Dashboard</h1>
                    <p class="subtitle">Métricas e performance do site</p>
                </div>
                
                <div class="header-actions">
                    <!-- Date Range Selector -->
                    <select id="dateRange" class="date-range-select">
                        <option value="7">Últimos 7 dias</option>
                        <option value="30" selected>Últimos 30 dias</option>
                        <option value="90">Últimos 90 dias</option>
                    </select>
                    
                    <!-- Export Button -->
                    <button class="btn-export" onclick="window.analytics.exportReport()">
                        <i class="fas fa-download"></i> Exportar CSV
                    </button>
                </div>
            </div>
            
            <!-- Metrics Grid -->
            <div class="metrics-grid">
                <div class="metric-card">
                    <div class="metric-icon sessions">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="metric-content">
                        <div class="metric-value" id="totalSessions">-</div>
                        <div class="metric-label">Sessões</div>
                        <div class="metric-change positive" id="sessionsChange">-</div>
                    </div>
                </div>
                
                <div class="metric-card">
                    <div class="metric-icon visitors">
                        <i class="fas fa-user-friends"></i>
                    </div>
                    <div class="metric-content">
                        <div class="metric-value" id="uniqueVisitors">-</div>
                        <div class="metric-label">Visitantes Únicos</div>
                        <div class="metric-change positive" id="visitorsChange">-</div>
                    </div>
                </div>
                
                <div class="metric-card">
                    <div class="metric-icon pageviews">
                        <i class="fas fa-eye"></i>
                    </div>
                    <div class="metric-content">
                        <div class="metric-value" id="pageViews">-</div>
                        <div class="metric-label">Page Views</div>
                        <div class="metric-change positive" id="pageViewsChange">-</div>
                    </div>
                </div>
                
                <div class="metric-card">
                    <div class="metric-icon whatsapp">
                        <i class="fab fa-whatsapp"></i>
                    </div>
                    <div class="metric-content">
                        <div class="metric-value" id="whatsappClicks">-</div>
                        <div class="metric-label">WhatsApp Clicks</div>
                        <div class="metric-change positive" id="whatsappChange">-</div>
                    </div>
                </div>
            </div>
            
            <!-- Charts Grid -->
            <div class="charts-grid">
                <!-- Traffic Chart -->
                <div class="chart-card">
                    <div class="chart-header">
                        <h3><i class="fas fa-chart-area"></i> Tráfego ao Longo do Tempo</h3>
                    </div>
                    <div class="chart-body">
                        <canvas id="trafficChart"></canvas>
                    </div>
                </div>
                
                <!-- Device Breakdown -->
                <div class="chart-card">
                    <div class="chart-header">
                        <h3><i class="fas fa-mobile-alt"></i> Dispositivos</h3>
                    </div>
                    <div class="chart-body">
                        <canvas id="deviceChart"></canvas>
                    </div>
                </div>
                
                <!-- Traffic Sources -->
                <div class="chart-card">
                    <div class="chart-header">
                        <h3><i class="fas fa-share-alt"></i> Fontes de Tráfego</h3>
                    </div>
                    <div class="chart-body">
                        <canvas id="sourceChart"></canvas>
                    </div>
                </div>
            </div>
            
            <!-- Data Tables -->
            <div class="data-grid">
                <!-- Top Pages -->
                <div class="data-table-card">
                    <div class="table-header">
                        <h3><i class="fas fa-file-alt"></i> Páginas Mais Visitadas</h3>
                    </div>
                    <div class="table-body">
                        <table class="analytics-table">
                            <thead>
                                <tr>
                                    <th>Página</th>
                                    <th>Visitas</th>
                                    <th>Tempo Médio</th>
                                </tr>
                            </thead>
                            <tbody id="topPagesTable">
                                <tr>
                                    <td colspan="3" class="loading">Carregando...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                
                <!-- Top Products -->
                <div class="data-table-card">
                    <div class="table-header">
                        <h3><i class="fas fa-star"></i> Produtos Mais Vistos</h3>
                    </div>
                    <div class="table-body">
                        <table class="analytics-table">
                            <thead>
                                <tr>
                                    <th>Produto</th>
                                    <th>Visitas</th>
                                    <th>WhatsApp</th>
                                </tr>
                            </thead>
                            <tbody id="topProductsTable">
                                <tr>
                                    <td colspan="3" class="loading">Carregando...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
            <!-- Conversion Funnel -->
            <div class="funnel-card">
                <div class="funnel-header">
                    <h3><i class="fas fa-filter"></i> Funil de Conversão</h3>
                    <p class="subtitle">Da visita ao contacto WhatsApp</p>
                </div>
                <div class="funnel-body" id="conversionFunnel">
                    <!-- Will be populated by JavaScript -->
                </div>
            </div>
            
        </div>
    </main>
    
    <!-- Loading Overlay -->
    <div class="loading-overlay" id="loadingOverlay" style="display: none;">
        <div class="spinner"></div>
        <p>Carregando dados...</p>
    </div>
    
    <!-- Analytics Dashboard Script -->
    <script src="/js/analytics-dashboard.js"></script>
    <script>
        // Initialize analytics dashboard
        document.addEventListener('DOMContentLoaded', () => {
            window.analytics = new AnalyticsDashboard({
                apiEndpoint: '/admin/api/analytics/dashboard',
                refreshInterval: 300000 // 5 minutes
            });
        });
    </script>
</body>
</html>

