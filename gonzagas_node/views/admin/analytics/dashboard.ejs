<div class="container-fluid px-3 px-md-4 py-3">
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-3">
    <h1 class="h4 mb-0">Analytics</h1>
  </div>

  <div class="card">
    <div class="card-header">
      <h5 class="card-title mb-0">Painel de Estatísticas</h5>
    </div>
    <div class="card-body">
      <p class="text-muted">Visualize e analise o desempenho do catálogo e das páginas.</p>
      <div id="analyticsDashboard">
        <div class="text-center py-4" id="analyticsLoading">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">A carregar...</span>
          </div>
          <p class="mt-2 text-muted">A carregar dados...</p>
        </div>
        <div id="analyticsContent" style="display:none;">
          <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
              <div class="card stat-card">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <h6 class="text-muted mb-2">Sessões</h6>
                      <h3 class="mb-0" id="statSessions">—</h3>
                    </div>
                    <div class="stat-icon bg-primary"><i class="fas fa-users"></i></div>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
              <div class="card stat-card">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <h6 class="text-muted mb-2">Visualizações</h6>
                      <h3 class="mb-0" id="statPageViews">—</h3>
                    </div>
                    <div class="stat-icon bg-primary"><i class="fas fa-eye"></i></div>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
              <div class="card stat-card">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <h6 class="text-muted mb-2">Conversões</h6>
                      <h3 class="mb-0" id="statConversions">—</h3>
                    </div>
                    <div class="stat-icon bg-success"><i class="fas fa-shopping-bag"></i></div>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
              <div class="card stat-card">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <h6 class="text-muted mb-2">Taxa de Conversão</h6>
                      <h3 class="mb-0" id="statConvRate">—</h3>
                    </div>
                    <div class="stat-icon bg-warning"><i class="fas fa-percentage"></i></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="text-muted small">Se não houver dados, as tabelas de analytics podem não estar configuradas.</p>
        </div>
        <div id="analyticsError" class="alert alert-warning" style="display:none;">
          <i class="fas fa-exclamation-triangle me-2"></i>
          <span id="analyticsErrorMsg">Erro ao carregar dados.</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  fetch('/admin/api/analytics/dashboard?days=30')
    .then(r => r.json())
    .then(data => {
      document.getElementById('analyticsLoading').style.display = 'none';
      if (data.success && data.data) {
        document.getElementById('analyticsContent').style.display = 'block';
        var o = data.data.overview || {};
        document.getElementById('statSessions').textContent = o.total_sessions || 0;
        document.getElementById('statPageViews').textContent = o.total_page_views || 0;
        document.getElementById('statConversions').textContent = o.total_conversions || 0;
        document.getElementById('statConvRate').textContent = (o.conversion_rate || 0).toFixed(1) + '%';
      } else {
        document.getElementById('analyticsError').style.display = 'block';
        document.getElementById('analyticsErrorMsg').textContent = data.message || 'Sem dados disponíveis.';
      }
    })
    .catch(err => {
      document.getElementById('analyticsLoading').style.display = 'none';
      document.getElementById('analyticsError').style.display = 'block';
      document.getElementById('analyticsErrorMsg').textContent = 'Erro ao carregar dados de analytics.';
    });
});
</script>
