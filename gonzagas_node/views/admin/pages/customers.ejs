<%- include('../../partials/header') %>

<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="page-title-box">
        <h4 class="page-title">Clientes</h4>
        <div class="page-title-right">
          <%- include('../../partials/breadcrumb', { items: [
            { title: 'Dashboard', url: '/admin' },
            { title: 'Clientes', active: true }
          ]}) %>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-body">
          <div class="row mb-3">
            <div class="col-md-6">
              <h4 class="header-title">Lista de Clientes</h4>
              <p class="text-muted mb-0">Visualize e gerencie os clientes cadastrados.</p>
            </div>
            <div class="col-md-6 text-end">
              <button class="btn btn-primary">
                <i class="fas fa-plus me-1"></i> Adicionar Cliente
              </button>
            </div>
          </div>

          <div class="table-responsive">
            <table class="table table-centered table-striped dt-responsive nowrap w-100" id="customers-datatable">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Nome</th>
                  <th>Email</th>
                  <th>Telefone</th>
                  <th>Data de Cadastro</th>
                  <th>Status</th>
                  <th style="width: 85px;">Ações</th>
                </tr>
              </thead>
              <tbody>
                <% if (customers && customers.length > 0) { %>
                  <% customers.forEach(customer => { %>
                    <tr>
                      <td><%= customer.id %></td>
                      <td>
                        <div class="d-flex align-items-center">
                          <div class="avatar-sm me-2">
                            <div class="avatar-title bg-soft-primary text-primary rounded-circle">
                              <%= customer.name ? customer.name.charAt(0).toUpperCase() : 'U' %>
                            </div>
                          </div>
                          <div>
                            <h5 class="font-14 my-0"><%= customer.name || 'Cliente sem nome' %></h5>
                            <span class="text-muted font-12">ID: <%= customer.id %></span>
                          </div>
                        </div>
                      </td>
                      <td><%= customer.email || '-' %></td>
                      <td><%= customer.phone || '-' %></td>
                      <td><%= new Date(customer.created_at).toLocaleDateString('pt-BR') %></td>
                      <td>
                        <% if (customer.is_active) { %>
                          <span class="badge bg-success">Ativo</span>
                        <% } else { %>
                          <span class="badge bg-danger">Inativo</span>
                        <% } %>
                      </td>
                      <td>
                        <div class="btn-group">
                          <button type="button" class="btn btn-sm btn-light" data-bs-toggle="tooltip" title="Visualizar">
                            <i class="fas fa-eye"></i>
                          </button>
                          <button type="button" class="btn btn-sm btn-light" data-bs-toggle="tooltip" title="Editar">
                            <i class="fas fa-edit"></i>
                          </button>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="7" class="text-center py-4">
                      <div class="text-muted">Nenhum cliente encontrado</div>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <!-- Pagination -->
          <% if (pagination.totalPages > 1) { %>
            <div class="row mt-3">
              <div class="col-12">
                <ul class="pagination pagination-rounded justify-content-center">
                  <% if (pagination.currentPage > 1) { %>
                    <li class="page-item">
                      <a href="?page=<%= pagination.currentPage - 1 %>" class="page-link">
                        <i class="mdi mdi-chevron-left"></i>
                      </a>
                    </li>
                  <% } %>
                  
                  <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                    <li class="page-item <%= i === pagination.currentPage ? 'active' : '' %>">
                      <a href="?page=<%= i %>" class="page-link"><%= i %></a>
                    </li>
                  <% } %>
                  
                  <% if (pagination.currentPage < pagination.totalPages) { %>
                    <li class="page-item">
                      <a href="?page=<%= pagination.currentPage + 1 %>" class="page-link">
                        <i class="mdi mdi-chevron-right"></i>
                      </a>
                    </li>
                  <% } %>
                </ul>
              </div>
            </div>
          <% } %>
          <!-- End Pagination -->
          
          <div class="row mt-3">
            <div class="col-md-6">
              <div class="text-muted">
                Mostrando <b><%= pagination.startItem %> - <%= pagination.endItem %></b> de <b><%= pagination.totalItems %></b> clientes
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>

<%- block('scripts') %>
<script>
  // Inicializar tooltips
  document.addEventListener('DOMContentLoaded', function() {
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
      return new bootstrap.Tooltip(tooltipTriggerEl);
    });
  });
</script>
<%- endblock %>
