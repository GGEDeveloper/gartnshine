<!-- Page Content -->
<div class="container-fluid py-3 py-md-4 px-3 px-md-4">
  <!-- Stats Cards — linha 1: catálogo -->
  <div class="row g-3 g-md-4">
    <!-- Total Products -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card stat-card">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-2">Produtos</h6>
              <h3 class="mb-0"><%= stats.products %></h3>
            </div>
            <div class="stat-icon bg-primary">
              <i class="fas fa-gem"></i>
            </div>
          </div>
          <div class="mt-3">
            <a href="/admin/products" class="btn btn-sm btn-outline-primary">Ver Produtos</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Total Families -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card stat-card">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-2">Famílias</h6>
              <h3 class="mb-0"><%= stats.families %></h3>
            </div>
            <div class="stat-icon bg-success">
              <i class="fas fa-tags"></i>
            </div>
          </div>
          <div class="mt-3">
            <a href="/admin/product-families" class="btn btn-sm btn-outline-success">Ver Famílias</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Low Stock -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card stat-card">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-2">Baixo stock</h6>
              <h3 class="mb-0"><%= stats.lowStock %></h3>
            </div>
            <div class="stat-icon bg-warning">
              <i class="fas fa-exclamation-triangle"></i>
            </div>
          </div>
          <div class="mt-3">
            <a href="/admin/inventory?filter=low_stock" class="btn btn-sm btn-outline-warning">Ver Stock</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Out of Stock -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card stat-card">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-2">Sem stock</h6>
              <h3 class="mb-0"><%= stats.outOfStock %></h3>
            </div>
            <div class="stat-icon bg-danger">
              <i class="fas fa-ban"></i>
            </div>
          </div>
          <div class="mt-3">
            <a href="/admin/inventory?filter=out_of_stock" class="btn btn-sm btn-outline-danger">Ver Stock</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats Cards — linha 2: loja + inventário -->
  <div class="row g-3 g-md-4 mt-1">
    <!-- Pedidos -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card stat-card">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-2">Pedidos</h6>
              <h3 class="mb-0"><%= stats.orders != null ? stats.orders : '—' %></h3>
            </div>
            <div class="stat-icon" style="background: var(--color-primary); border: 1px solid rgba(192,192,192,0.3); color: #C0C0C0;">
              <i class="fas fa-shopping-bag"></i>
            </div>
          </div>
          <div class="mt-3">
            <a href="/admin/orders" class="btn btn-sm btn-outline-primary">Ver Pedidos</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Receita -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card stat-card">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-2">Receita</h6>
              <h3 class="mb-0">
                <% if (stats.revenue != null && stats.revenue !== 'N/A') { %>
                  €<%= parseFloat(stats.revenue).toLocaleString('pt-PT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                <% } else { %>
                  —
                <% } %>
              </h3>
            </div>
            <div class="stat-icon" style="background: var(--color-primary); border: 1px solid rgba(184,115,51,0.4); color: #D4B85C;">
              <i class="fas fa-euro-sign"></i>
            </div>
          </div>
          <div class="mt-3">
            <a href="/admin/reports" class="btn btn-sm btn-outline-primary">Rentabilidade</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Valor potencial de inventário -->
    <div class="col-12 col-xl-6">
      <div class="card stat-card h-100">
        <div class="card-body">
          <div class="row align-items-center h-100">
            <div class="col-md-8">
              <h6 class="text-muted mb-2">Valor potencial de inventário</h6>
              <h3 class="mb-1">
                <% if (stats.inventoryPotentialRevenue != null && typeof stats.inventoryPotentialRevenue === 'number') { %>
                  <%= Number(stats.inventoryPotentialRevenue).toLocaleString('pt-PT', { style: 'currency', currency: 'EUR' }) %>
                <% } else { %>
                  —
                <% } %>
              </h3>
              <p class="text-muted mb-0 small">
                Unidades em stock:
                <% if (stats.inventoryTotalUnits != null && typeof stats.inventoryTotalUnits === 'number') { %>
                  <%= stats.inventoryTotalUnits.toLocaleString('pt-PT') %>
                <% } else { %>
                  —
                <% } %>
              </p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
              <a href="/admin/export/inventory-stock.xlsx" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-file-excel me-1"></i>Exportar XLSX
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Actions Mobile -->
  <div class="d-flex gap-2 mt-3 mb-3 d-md-none flex-wrap">
    <a href="/admin/quick-product" class="btn btn-primary flex-grow-1 py-3">
      <i class="fas fa-bolt me-2"></i>Criar Produto Rápido
    </a>
    <a href="/admin/products" class="btn btn-outline-primary py-3">
      <i class="fas fa-box me-2"></i>Produtos
    </a>
  </div>

  <!-- Produtos Recentes + Movimentos de Inventário -->
  <div class="row mt-3 mt-md-4 g-3 g-md-4">
    <!-- Recent Products -->
    <div class="col-xl-6">
      <div class="card mb-4">
        <div class="card-header">
          <h6 class="card-title mb-0">Produtos Recentes</h6>
        </div>
        <div class="card-body">
          <% if (stats.recentProducts && stats.recentProducts.length > 0) { %>
            <ul class="list-group list-group-flush">
              <% stats.recentProducts.forEach(product => { %>
                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                  <a href="/admin/products/edit/<%= product.id %>" class="d-flex align-items-center text-decoration-none flex-grow-1">
                    <% if (product.image_url) { %>
                      <img src="/media/products/<%= product.image_url %>" alt="<%= product.name %>" class="rounded me-3" style="width: 48px; height: 48px; object-fit: cover;">
                    <% } else { %>
                      <div class="rounded d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; background: rgba(0,0,0,0.6); border: 1px solid rgba(192,192,192,0.15);">
                        <i class="fas fa-gem text-muted"></i>
                      </div>
                    <% } %>
                    <div>
                      <h6 class="mb-0"><%= product.name %></h6>
                      <small class="text-muted">Ref: <%= product.reference %></small>
                    </div>
                  </a>
                  <span class="badge rounded-pill ms-2"><%= product.current_stock ?? 0 %></span>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <div class="text-center py-4">
              <i class="fas fa-gem fa-3x text-muted mb-3"></i>
              <p class="text-muted mb-0">Nenhum produto adicionado recentemente</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Movimentos de Inventário Recentes -->
    <div class="col-xl-6">
      <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h6 class="card-title mb-0">Movimentos de Inventário Recentes</h6>
          <a href="/admin/inventory" class="btn btn-sm btn-outline-secondary">Ver tudo</a>
        </div>
        <div class="card-body p-0">
          <% if (stats.recentTransactions && stats.recentTransactions.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead>
                  <tr>
                    <th>Produto</th>
                    <th>Tipo</th>
                    <th class="text-end">Qtd</th>
                    <th>Data</th>
                  </tr>
                </thead>
                <tbody>
                  <% stats.recentTransactions.forEach(function(t) { %>
                    <tr>
                      <td>
                        <div class="fw-semibold" style="font-size: 0.85rem;"><%= t.product_name %></div>
                        <small class="text-muted">Ref: <%= t.product_reference %></small>
                      </td>
                      <td>
                        <% if (t.movement_type === 'in' || t.type === 'in') { %>
                          <span class="badge badge-stock-in-stock">Entrada</span>
                        <% } else if (t.movement_type === 'out' || t.type === 'out') { %>
                          <span class="badge badge-stock-out-of-stock">Saída</span>
                        <% } else { %>
                          <span class="badge badge-product-inactive"><%= t.movement_type || t.type %></span>
                        <% } %>
                      </td>
                      <td class="text-end fw-semibold"><%= t.quantity %></td>
                      <td><small class="text-muted"><%= new Date(t.created_at).toLocaleDateString('pt-PT') %></small></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="text-center py-4">
              <i class="fas fa-exchange-alt fa-3x text-muted mb-3"></i>
              <p class="text-muted mb-0">Nenhum movimento de inventário recente</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
