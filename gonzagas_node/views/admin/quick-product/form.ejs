<link rel="stylesheet" href="/css/camera-capture.css">
<script src="/js/camera-capture.js"></script>
<script>document.addEventListener("DOMContentLoaded",function(){var f=document.getElementById("quickProductForm");if(f&&window.initCameraForForm)initCameraForForm(f,{imageInputName:"images",multiple:true,mobileOnly:false});});</script>
<div class="quick-product-form container-fluid px-3 px-md-4 py-3">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">
      <i class="fas fa-bolt text-warning me-2"></i>Criar Produto Rápido
    </h1>
    <a href="/admin/products" class="btn btn-outline-secondary btn-sm">
      <i class="fas fa-list"></i> Ver Produtos
    </a>
  </div>

  <%- include('../partials/flash-messages') %>

  <div class="card shadow mb-4 border-0">
    <div class="card-body p-3 p-md-4">
      <form action="/admin/quick-product" method="POST" enctype="multipart/form-data" id="quickProductForm" class="needs-validation" novalidate>
        
        <!-- Categoria / Subcategoria -->
        <div class="row g-2">
          <div class="col-12 col-md-6">
            <label for="family_id" class="form-label">Categoria</label>
            <select class="form-select form-select-lg" id="family_id" name="family_id">
              <option value="">-- Selecione --</option>
              <% (familiesForView || []).forEach(f => { 
                const d = f.depth || 0;
                const indent = (d > 0 ? '  '.repeat(d) + '└ ' : '');
              %>
                <option value="<%= f.id %>" data-code="<%= f.code || '' %>" <%= (typeof preselectedFamilyId !== 'undefined' && preselectedFamilyId && String(preselectedFamilyId) === String(f.id)) ? 'selected' : '' %>><%= indent %><%= f.name %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-12 col-md-6">
            <label for="reference" class="form-label">Referência</label>
            <div class="input-group input-group-lg">
              <input type="text" class="form-control" id="reference" name="reference" placeholder="Auto" autocomplete="off">
              <button type="button" class="btn btn-outline-secondary" id="btnRefreshRef" title="Gerar nova referência">
                <i class="fas fa-sync-alt"></i>
              </button>
            </div>
            <small class="text-muted">Editável. Gerada automaticamente se vazio.</small>
          </div>
        </div>

        <!-- Nome e Preço -->
        <div class="row g-2 mt-2">
          <div class="col-12 col-md-6">
            <label for="name" class="form-label">Nome <small class="text-muted">(opcional)</small></label>
            <input type="text" class="form-control form-control-lg" id="name" name="name" placeholder="Ex: Anel Celtic Knot">
          </div>
          <div class="col-12 col-md-6">
            <label for="sale_price" class="form-label">Preço (€) *</label>
            <input type="number" class="form-control form-control-lg" id="sale_price" name="sale_price" step="0.01" min="0" required placeholder="0.00">
            <div class="invalid-feedback">Preço é obrigatório.</div>
          </div>
        </div>

        <!-- Cor e Quantidade -->
        <div class="row g-2 mt-2">
          <div class="col-12 col-md-6">
            <label for="color" class="form-label">Cor</label>
            <select class="form-select form-select-lg" id="color" name="color">
              <option value="">— Selecionar —</option>
              <% (colors || []).forEach(c => { %>
                <option value="<%= c.name %>" <%= (typeof preselectedColor !== 'undefined' && preselectedColor === c.name) ? 'selected' : '' %>><%= c.name %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-12 col-md-6">
            <label for="current_stock" class="form-label">Quantidade</label>
            <input type="number" class="form-control form-control-lg" id="current_stock" name="current_stock" min="0" value="1">
          </div>
        </div>

        <!-- Descrição -->
        <div class="mt-2">
          <label for="description" class="form-label">Descrição <small class="text-muted">(opcional)</small></label>
          <textarea class="form-control" id="description" name="description" rows="2" placeholder="Breve descrição..."></textarea>
        </div>

        <!-- Visibilidade -->
        <div class="row g-2 mt-2">
          <div class="col-4">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" id="is_active" name="is_active" value="1" <%= preselectedActive !== false ? 'checked' : '' %>>
              <label class="form-check-label" for="is_active">Ativo</label>
            </div>
          </div>
          <div class="col-4">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" id="is_catalog_visible" name="is_catalog_visible" value="1" <%= preselectedCatalogVisible !== false ? 'checked' : '' %>>
              <label class="form-check-label" for="is_catalog_visible">Visível no Catálogo</label>
            </div>
          </div>
          <div class="col-4">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" id="featured" name="featured" value="1" <%= preselectedFeatured === true ? 'checked' : '' %>>
              <label class="form-check-label" for="featured">Destaque</label>
            </div>
          </div>
        </div>

        <!-- Imagem (câmara ou ficheiro) -->
        <div class="mt-3">
          <label class="form-label">Imagem <small class="text-muted">(opcional)</small></label>
          <div class="d-flex flex-column flex-sm-row gap-2">
            <button type="button" class="btn btn-camera-capture" data-action="open-camera" id="btnOpenCamera">
              <i class="fas fa-camera"></i>
              <span>Tirar foto</span>
            </button>
            <div class="flex-grow-1">
              <input type="file" class="form-control form-control-lg" id="images" name="images" accept="image/*" multiple>
            </div>
          </div>
          <small class="text-muted d-block mt-1">Tirar foto (in-page) ou escolher da galeria. Máx. 5MB. JPEG, PNG, GIF, WebP. Máx. 5 imagens.</small>
          <div id="imagePreviews" class="qp-previews-grid mt-2"></div>
        </div>
        <!-- Modal zoom imagem: encaixa no ecrã do telemóvel, zoom com dedos -->
        <div class="modal fade" id="imageZoomModal" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
            <div class="modal-content bg-dark">
              <div class="modal-header border-secondary py-2">
                <h6 class="modal-title text-white">Ver imagem</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
              </div>
              <div class="modal-body p-0 d-flex align-items-center justify-content-center min-vh-50" style="touch-action: pinch-zoom;">
                <img id="imageZoomImg" src="" alt="Pré-visualização" class="img-fluid qp-zoom-img" style="max-height: 75vh; max-width: 100%; object-fit: contain; user-select: none;">
              </div>
            </div>
          </div>
        </div>

        <!-- Botões -->
        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
          <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
            <i class="fas fa-plus-circle"></i> Criar Produto
          </button>
          <a href="/admin/dashboard" class="btn btn-outline-secondary btn-lg">Cancelar</a>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
(function() {
  const form = document.getElementById('quickProductForm');
  const familySelect = document.getElementById('family_id');
  const referenceInput = document.getElementById('reference');
  const btnRefreshRef = document.getElementById('btnRefreshRef');
  const imagesInput = document.getElementById('images');
  const imagePreviews = document.getElementById('imagePreviews');

  function getPrefix() {
    const opt = familySelect.options[familySelect.selectedIndex];
    return opt && opt.dataset.code ? opt.dataset.code : 'GEN';
  }

  function fetchNextReference() {
    const prefix = getPrefix();
    fetch('/admin/quick-product/api/next-reference?prefix=' + encodeURIComponent(prefix))
      .then(r => r.json())
      .then(data => {
        if (data.reference) referenceInput.value = data.reference;
      })
      .catch(() => {});
  }

  familySelect.addEventListener('change', function() {
    if (!referenceInput.value || referenceInput.value.match(/^[A-Z]+\d+$/)) {
      fetchNextReference();
    }
  });

  btnRefreshRef.addEventListener('click', fetchNextReference);

  if (familySelect.value) fetchNextReference();

  const MAX_FILE_SIZE = 5 * 1024 * 1024; // 5MB
  const MAX_IMAGES = 5;
  let pendingFiles = [];

  function syncFileInput() {
    const dt = new DataTransfer();
    pendingFiles.forEach(function(f) { dt.items.add(f); });
    imagesInput.files = dt.files;
  }

  function removeImage(index) {
    pendingFiles.splice(index, 1);
    syncFileInput();
    renderPreviews();
  }

  function renderPreviews() {
    imagePreviews.innerHTML = '';
    pendingFiles.forEach(function(f, i) {
      const div = document.createElement('div');
      div.className = 'qp-preview-item';
      div.innerHTML = '<div class="qp-img-card position-relative" style="width:64px;height:64px;">' +
        '<img src="" alt="" class="qp-img-thumb rounded" data-index="' + i + '" style="width:100%;height:100%;object-fit:cover;max-width:64px;max-height:64px">' +
        '<div class="qp-img-actions">' +
        '<button type="button" class="btn btn-sm btn-light qp-img-zoom" title="Ver melhor" data-index="' + i + '"><i class="fas fa-search-plus"></i></button>' +
        '<button type="button" class="btn btn-sm btn-danger qp-img-remove" title="Remover" data-index="' + i + '"><i class="fas fa-trash"></i></button>' +
        '</div>' +
        '</div>';
      const img = div.querySelector('.qp-img-thumb');
      const reader = new FileReader();
      reader.onload = function(e) {
        img.src = e.target.result;
        img.dataset.src = e.target.result;
      };
      reader.readAsDataURL(f);
      imagePreviews.appendChild(div);
    });
  }

  imagePreviews.addEventListener('click', function(e) {
    const zoomBtn = e.target.closest('.qp-img-zoom');
    const removeBtn = e.target.closest('.qp-img-remove');
    if (zoomBtn) {
      const idx = parseInt(zoomBtn.dataset.index, 10);
      const thumb = imagePreviews.querySelector('.qp-img-thumb[data-index="' + idx + '"]');
      const src = thumb?.src || thumb?.dataset?.src;
      if (src) {
        document.getElementById('imageZoomImg').src = src;
        new bootstrap.Modal(document.getElementById('imageZoomModal')).show();
      }
    } else if (removeBtn) {
      removeImage(parseInt(removeBtn.dataset.index, 10));
    }
  });

  imagesInput.addEventListener('change', function() {
    const files = Array.from(this.files || []);
    pendingFiles = [];
    for (let i = 0; i < Math.min(files.length, MAX_IMAGES); i++) {
      const f = files[i];
      if (!f.type.startsWith('image/')) continue;
      if (f.size > MAX_FILE_SIZE) {
        alert('Imagem "' + f.name + '" excede 5MB. Reduza o tamanho ou escolha outra.');
        this.value = '';
        pendingFiles = [];
        renderPreviews();
        return;
      }
      pendingFiles.push(f);
    }
    syncFileInput();
    renderPreviews();
  });

  form.addEventListener('submit', function(e) {
    if (!form.checkValidity()) {
      e.preventDefault();
      e.stopPropagation();
    }
    form.classList.add('was-validated');
  });
})();
</script>
