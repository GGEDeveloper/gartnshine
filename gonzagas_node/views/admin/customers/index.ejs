<%
function fmtDate(d) {
  if (!d) return '—';
  return new Date(d).toLocaleString('pt-PT', { dateStyle: 'short', timeStyle: 'short' });
}
function fmtMoney(v) {
  return '€' + (parseFloat(v || 0)).toFixed(2);
}
const providerLabel = { local: 'Email/password', google: 'Google', both: 'Email + Google' };
function qs(overrides) {
  const params = new URLSearchParams();
  if (filters.search) params.set('search', filters.search);
  if (filters.sort && filters.sort !== 'recent') params.set('sort', filters.sort);
  Object.entries(overrides || {}).forEach(([k, v]) => {
    if (v === null || v === undefined || v === '') params.delete(k);
    else params.set(k, v);
  });
  const s = params.toString();
  return s ? '?' + s : '';
}
%>
<div class="container-fluid px-0 py-3">

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <h1 class="h3 mb-1">Clientes e Utilizadores</h1>
      <p class="text-muted small mb-0">Contas registadas na loja e utilizadores com acesso ao backoffice.</p>
    </div>
    <a href="/admin/carrinhos" class="btn btn-outline-primary btn-sm">
      <i class="fas fa-shopping-basket me-1"></i> Carrinhos em tempo real
    </a>
  </div>

  <% if (missingTable) { %>
    <div class="alert alert-warning">
      A tabela <code>customers</code> não existe nesta base de dados. Nada a mostrar.
    </div>
  <% } %>

  <% if (stats) { %>
    <div class="row g-3 mb-4">
      <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
          <div class="text-muted small text-uppercase">Total de clientes</div>
          <div class="h3 mb-0"><%= stats.total %></div>
        </div></div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
          <div class="text-muted small text-uppercase">Novos (7 dias)</div>
          <div class="h3 mb-0"><%= stats.hasCreated ? stats.new7d : '—' %></div>
        </div></div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
          <div class="text-muted small text-uppercase">Novos (30 dias)</div>
          <div class="h3 mb-0"><%= stats.hasCreated ? stats.new30d : '—' %></div>
        </div></div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
          <div class="text-muted small text-uppercase">Contas Google</div>
          <div class="h3 mb-0"><%= stats.withGoogle %></div>
        </div></div>
      </div>
    </div>
  <% } %>

  <ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item">
      <button class="nav-link <%= filters.tab === 'customers' ? 'active' : '' %>" data-bs-toggle="tab" data-bs-target="#tab-clientes" type="button">
        Clientes da loja <span class="badge bg-secondary ms-1"><%= total %></span>
      </button>
    </li>
    <li class="nav-item">
      <button class="nav-link <%= filters.tab === 'users' ? 'active' : '' %>" data-bs-toggle="tab" data-bs-target="#tab-users" type="button">
        Utilizadores do admin <span class="badge bg-secondary ms-1"><%= adminUsers.length %></span>
      </button>
    </li>
  </ul>

  <div class="tab-content">

    <!-- ── Clientes da loja ───────────────────────────── -->
    <div class="tab-pane fade <%= filters.tab === 'customers' ? 'show active' : '' %>" id="tab-clientes">

      <form method="get" class="row g-2 mb-3">
        <input type="hidden" name="tab" value="customers">
        <div class="col-md-5">
          <input type="search" name="search" class="form-control" placeholder="Pesquisar nome, email, telefone…" value="<%= filters.search %>">
        </div>
        <div class="col-md-3">
          <select name="sort" class="form-select">
            <option value="recent" <%= filters.sort === 'recent' ? 'selected' : '' %>>Mais recentes primeiro</option>
            <option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>>Mais antigos primeiro</option>
            <option value="email"  <%= filters.sort === 'email'  ? 'selected' : '' %>>Email (A–Z)</option>
          </select>
        </div>
        <div class="col-md-4">
          <button type="submit" class="btn btn-primary">Filtrar</button>
          <% if (filters.search || filters.sort !== 'recent') { %>
            <a href="/admin/clientes" class="btn btn-outline-secondary ms-1">Limpar</a>
          <% } %>
        </div>
      </form>

      <div class="card">
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead>
                <tr>
                  <th>Cliente</th>
                  <th>Contacto</th>
                  <th>Registo</th>
                  <th>Origem</th>
                  <th class="text-end">Encomendas</th>
                  <th class="text-end">Total pago</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% if (!customers.length) { %>
                  <tr><td colspan="7" class="text-center text-muted py-4">Sem clientes registados<%= filters.search ? ' para esta pesquisa' : '' %>.</td></tr>
                <% } %>
                <% customers.forEach(function(c) { %>
                  <tr>
                    <td>
                      <div class="fw-semibold"><%= c.display_name || '(sem nome)' %></div>
                      <small class="text-muted">#<%= c.id %></small>
                      <% if (c.has_active_cart) { %>
                        <span class="badge bg-info text-dark ms-1" title="Tem itens no carrinho agora">
                          <i class="fas fa-shopping-basket"></i> carrinho
                        </span>
                      <% } %>
                      <% if (c.is_active === 0) { %>
                        <span class="badge bg-secondary ms-1">inactivo</span>
                      <% } %>
                    </td>
                    <td>
                      <div><%= c.email || '—' %></div>
                      <% if (c.phone) { %><small class="text-muted"><%= c.phone %></small><% } %>
                    </td>
                    <td><small class="text-muted"><%= fmtDate(c.created_at) %></small></td>
                    <td><span class="badge bg-dark-subtle text-body"><%= providerLabel[c.provider] || c.provider %></span></td>
                    <td class="text-end"><%= c.orders_count %></td>
                    <td class="text-end fw-semibold"><%= fmtMoney(c.orders_total) %></td>
                    <td class="text-end">
                      <a href="/admin/clientes/<%= c.id %>" class="btn btn-sm btn-outline-primary">Ver ficha</a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <% if (pages > 1) { %>
        <nav class="mt-3">
          <ul class="pagination pagination-sm mb-0">
            <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
              <a class="page-link" href="<%= qs({ tab: 'customers', page: page - 1 }) %>">Anterior</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Página <%= page %> de <%= pages %></span></li>
            <li class="page-item <%= page >= pages ? 'disabled' : '' %>">
              <a class="page-link" href="<%= qs({ tab: 'customers', page: page + 1 }) %>">Seguinte</a>
            </li>
          </ul>
        </nav>
      <% } %>
      <p class="text-muted small mt-2 mb-0">Total: <%= total %> cliente(s).</p>
    </div>

    <!-- ── Utilizadores do admin ──────────────────────── -->
    <div class="tab-pane fade <%= filters.tab === 'users' ? 'show active' : '' %>" id="tab-users">
      <div class="card">
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead>
                <tr>
                  <th>Nome</th>
                  <th>Email</th>
                  <th>Perfil</th>
                  <th>Criado</th>
                  <th>Último acesso</th>
                </tr>
              </thead>
              <tbody>
                <% if (!adminUsers.length) { %>
                  <tr><td colspan="5" class="text-center text-muted py-4">Sem utilizadores.</td></tr>
                <% } %>
                <% adminUsers.forEach(function(u) { %>
                  <tr>
                    <td class="fw-semibold"><%= u.name || u.username || '—' %></td>
                    <td><%= u.email || '—' %></td>
                    <td>
                      <span class="badge <%= u.role === 'admin' ? 'bg-primary' : 'bg-secondary' %>"><%= u.role || 'user' %></span>
                      <% if (u.is_active === 0) { %><span class="badge bg-secondary ms-1">inactivo</span><% } %>
                    </td>
                    <td><small class="text-muted"><%= fmtDate(u.created_at) %></small></td>
                    <td><small class="text-muted"><%= u.last_login ? fmtDate(u.last_login) : '—' %></small></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <p class="text-muted small mt-2 mb-0">Painel só de leitura — para criar ou alterar utilizadores use as Configurações.</p>
    </div>

  </div>
</div>
