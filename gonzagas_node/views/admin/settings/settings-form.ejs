<%- contentFor('title') %>
<%= title %>
<%- contentFor('body') %>

<div class="container-fluid px-3 px-md-4 py-3">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-3">
        <h1 class="h4 mb-0">Configurações do Site</h1>
    </div>

    <%- include('../partials/flash-messages') %>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 fw-semibold">Funcionalidades do Catálogo</h6>
        </div>
        <div class="card-body">
            <form action="/admin/settings" method="POST" class="settings-form">
                <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <% } %>

                <div class="mb-4">
                    <div class="form-check form-switch py-3 border-bottom">
                        <input type="checkbox" class="form-check-input" id="featured_carousel_enabled" name="featured_carousel_enabled" <%- settings.featured_carousel_enabled ? 'checked' : '' %>>
                        <label class="form-check-label" for="featured_carousel_enabled">Carrossel de peças em destaque (página inicial)</label>
                        <small class="d-block form-text text-muted mt-1">Controla a visibilidade do carrossel de produtos em destaque na página inicial.</small>
                    </div>

                    <div class="form-check form-switch py-3 border-bottom">
                        <input type="checkbox" class="form-check-input" id="catalog_page_enabled" name="catalog_page_enabled" <%- settings.catalog_page_enabled ? 'checked' : '' %>>
                        <label class="form-check-label" for="catalog_page_enabled">Página do catálogo ativa</label>
                        <small class="d-block form-text text-muted mt-1">Controla se a página principal do catálogo está acessível.</small>
                    </div>

                    <div class="form-check form-switch py-3 border-bottom">
                        <input type="checkbox" class="form-check-input" id="hide_catalog_prices" name="hide_catalog_prices" <%- settings.hide_catalog_prices ? 'checked' : '' %>>
                        <label class="form-check-label" for="hide_catalog_prices">Esconder preços (mostrar "Preço sob consulta")</label>
                        <small class="d-block form-text text-muted mt-1">Quando ativo, todos os produtos mostram "Preço sob consulta" em vez de preços reais.</small>
                    </div>

                    <div class="form-check form-switch py-3">
                        <input type="checkbox" class="form-check-input" id="hide_out_of_stock" name="hide_out_of_stock" <%- settings.hide_out_of_stock ? 'checked' : '' %>>
                        <label class="form-check-label" for="hide_out_of_stock">Esconder produtos sem stock do catálogo</label>
                        <small class="d-block form-text text-muted mt-1">Quando ativo, produtos com stock 0 ficam ocultos no catálogo público.</small>
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-2">
                    <button type="submit" class="btn btn-primary">Guardar configurações</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 fw-semibold">Imagem de fundo do Hero (página inicial)</h6>
        </div>
        <div class="card-body">
            <p class="text-muted mb-3">
                A primeira secção da página inicial (título + frase de destaque) usa esta imagem como fundo.
                Sem nenhuma escolhida, é usada automaticamente a primeira imagem encontrada na pasta da galeria.
            </p>

            <div class="mb-4">
                <p class="fw-semibold mb-2">Em uso atualmente:</p>
                <% if (typeof effectiveHeroImage !== 'undefined' && effectiveHeroImage) { %>
                    <div class="d-flex align-items-center gap-3">
                        <img src="<%= effectiveHeroImage %>" alt="Imagem atual do hero" style="width: 220px; height: 90px; object-fit: cover; border-radius: 8px; border: 1px solid #dee2e6;">
                        <div>
                            <code class="d-block"><%= effectiveHeroImage %></code>
                            <% if (!settings.hero_image) { %>
                                <small class="text-muted">Automático (nenhuma imagem escolhida explicitamente)</small>
                            <% } %>
                        </div>
                    </div>
                <% } else { %>
                    <p class="text-muted">Nenhuma imagem disponível — está a ser usado o placeholder por defeito.</p>
                <% } %>
            </div>

            <% if (settings.hero_image) { %>
                <form action="/admin/settings/hero-image" method="POST" class="mb-4">
                    <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <% } %>
                    <input type="hidden" name="reset_to_default" value="1">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Voltar à imagem automática</button>
                </form>
            <% } %>

            <hr>

            <div class="row g-4">
                <div class="col-12 col-lg-7">
                    <p class="fw-semibold mb-2">Escolher uma imagem já existente na galeria</p>
                    <% if (typeof galleryImages !== 'undefined' && galleryImages.length > 0) { %>
                        <form action="/admin/settings/hero-image" method="POST">
                            <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <% } %>
                            <div class="d-flex flex-wrap gap-2 mb-3" style="max-height: 320px; overflow-y: auto;">
                                <% galleryImages.forEach(function(img) { %>
                                    <label style="cursor: pointer;" title="<%= img.filename %>">
                                        <input type="radio" name="hero_image_existing" value="<%= img.path %>" class="visually-hidden" <%= effectiveHeroImage === img.path ? 'checked' : '' %>>
                                        <img src="<%= img.path %>" alt="<%= img.filename %>"
                                             style="width: 110px; height: 70px; object-fit: cover; border-radius: 6px; border: 3px solid <%= effectiveHeroImage === img.path ? '#0d6efd' : 'transparent' %>;">
                                    </label>
                                <% }); %>
                            </div>
                            <button type="submit" class="btn btn-primary">Usar imagem selecionada</button>
                        </form>
                        <script>
                            document.querySelectorAll('input[name="hero_image_existing"]').forEach(function (radio) {
                                radio.addEventListener('change', function () {
                                    document.querySelectorAll('input[name="hero_image_existing"]').forEach(function (r) {
                                        r.nextElementSibling.style.borderColor = r.checked ? '#0d6efd' : 'transparent';
                                    });
                                });
                            });
                        </script>
                    <% } else { %>
                        <p class="text-muted">Ainda não há imagens em <code>public/media/gallery</code>.</p>
                    <% } %>
                </div>

                <div class="col-12 col-lg-5">
                    <p class="fw-semibold mb-2">Ou enviar uma imagem nova</p>
                    <form action="/admin/settings/hero-image" method="POST" enctype="multipart/form-data">
                        <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <% } %>
                        <input type="file" name="hero_image_file" accept="image/jpeg,image/png,image/gif,image/webp" class="form-control mb-3" required>
                        <button type="submit" class="btn btn-primary">Enviar e usar como hero</button>
                        <small class="d-block form-text text-muted mt-2">JPG, PNG, GIF ou WebP, até 8MB. Fica também disponível na galeria geral.</small>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 fw-semibold">Loja Online (E-commerce)</h6>
        </div>
        <div class="card-body">
            <p class="text-muted mb-3">Preços/IVA, envio, Stripe e activação da loja online.</p>
            <a href="/admin/settings/ecommerce" class="btn btn-outline-primary">Configurações E-commerce</a>
        </div>
    </div>
</div>
