<!-- Catalog Page - Enhanced Version with All Features -->
<main class="catalog-main">
  <div class="catalog-container">
    
    <!-- Filter Drawer (Sidebar) -->
    <div class="filter-drawer-overlay" id="filter-drawer-overlay"></div>
    <aside class="catalog-sidebar filter-drawer" id="catalog-sidebar">
      <div class="sidebar-header">
        <h3 class="sidebar-title">
          <i class="fas fa-filter me-2"></i>
          Filtros
        </h3>
        <button class="sidebar-close" id="sidebar-close" aria-label="Fechar filtros">
          <i class="fas fa-times"></i>
        </button>
      </div>
      
      <div class="sidebar-content">
        <form id="catalog-filters" method="GET" action="/catalog">
          
          <!-- Search Input -->
          <div class="filter-section">
            <h4 class="filter-title">Pesquisar</h4>
            <div class="catalog-search-wrapper">
              <input type="text" 
                     id="catalog-search" 
                     name="search" 
                     class="catalog-search-input" 
                     placeholder="Pesquisar produtos..."
                     value="<%= typeof queryParams !== 'undefined' && queryParams.search ? queryParams.search : '' %>">
              <button type="button" class="search-clear-btn" id="search-clear" style="display: none;">
                <i class="fas fa-times"></i>
              </button>
            </div>
          </div>
          
          <!-- Famílias: árvore expansível; seleção do pai marca subcategorias -->
          <div class="filter-section filter-section-families">
            <div class="filter-section-families-heading">
              <h4 class="filter-title filter-title-families">Famílias e subcategorias</h4>
              <% if (typeof familiesTree !== 'undefined' && familiesTree && familiesTree.length) { %>
              <div class="family-tree-toolbar" role="toolbar" aria-label="Abrir ou fechar toda a árvore">
                <button type="button" class="family-tree-bulk-btn" id="family-tree-expand-all">Expandir tudo</button>
                <button type="button" class="family-tree-bulk-btn" id="family-tree-collapse-all">Recolher tudo</button>
              </div>
              <% } %>
            </div>
            <div class="filter-options filter-family-tree-forest">
              <% var fChecked = typeof familyCheckboxCheckedIds !== 'undefined' && familyCheckboxCheckedIds ? familyCheckboxCheckedIds : []; %>
              <div class="filter-option family-tree-all-row">
                <input type="checkbox" id="all-families" name="families" value="all" 
                       class="filter-checkbox" <%= (typeof selectedFamilyIds !== 'undefined' && selectedFamilyIds.length === 0) ? 'checked' : '' %>>
                <label for="all-families" class="filter-label">Todas as famílias</label>
              </div>
              <% if (typeof familiesTree !== 'undefined' && familiesTree && familiesTree.length) { %>
                <% familiesTree.forEach(function (root) { %>
                  <%- include('../partials/_catalogFamilyNode', { node: root, depth: 0, initialFacets: typeof initialFacets !== 'undefined' ? initialFacets : null, familyCheckboxCheckedIds: fChecked }) %>
                <% }); %>
              <% } else if ((families || []).length) { %>
                <% (families || []).forEach(function (family) {
                     var ffc = typeof initialFacets !== 'undefined' && initialFacets && initialFacets.families && initialFacets.families[family.id] != null ? initialFacets.families[family.id] : null;
                     var d = family.depth || 0;
                %>
                <div class="filter-option" style="padding-left: <%= 8 + d * 14 %>px;">
                  <input type="checkbox" id="family-<%= family.id %>" name="families" value="<%= family.id %>" class="filter-checkbox family-filter"
                    <%= fChecked.indexOf(family.id) >= 0 ? 'checked' : '' %>>
                  <label for="family-<%= family.id %>" class="filter-label"><%= family.name %><% if (ffc != null) { %> <span class="filter-count">(<%= ffc %>)</span><% } %></label>
                </div>
                <% }); %>
              <% } %>
            </div>
          </div>

          <% var fLabels = typeof facetOptionLabels !== 'undefined' && facetOptionLabels ? facetOptionLabels : { colors: [], materials: [] }; %>
          <% var selC = typeof selectedColors !== 'undefined' ? selectedColors : []; %>
          <% var selM = typeof selectedMaterials !== 'undefined' ? selectedMaterials : []; %>

          <% if (fLabels.colors && fLabels.colors.length) { %>
          <div class="filter-section">
            <h4 class="filter-title">Cor</h4>
            <div class="filter-options">
              <% fLabels.colors.forEach(function(lab) { 
                   var fk = helpers.facetKey(lab);
                   var cInf = typeof initialFacets !== 'undefined' && initialFacets && initialFacets.colors && initialFacets.colors[fk];
                   var cCnt = cInf && typeof cInf === 'object' ? cInf.count : null;
              %>
                <div class="filter-option">
                  <input type="checkbox" id="color-<%= fk.replace(/[^a-z0-9]+/gi, '-') %>" name="colors" value="<%= lab %>"
                    class="filter-checkbox facet-color" data-facet-key="<%= fk %>"
                    <%= selC.some(function(c) { return String(c).trim().toLowerCase() === fk; }) ? 'checked' : '' %>>
                  <label for="color-<%= fk.replace(/[^a-z0-9]+/gi, '-') %>" class="filter-label"><%= lab %><% if (cCnt != null) { %><span class="filter-count"> (<%= cCnt %>)</span><% } %></label>
                </div>
              <% }); %>
            </div>
          </div>
          <% } %>

          <% if (fLabels.materials && fLabels.materials.length) { %>
          <div class="filter-section">
            <h4 class="filter-title">Material</h4>
            <div class="filter-options">
              <% fLabels.materials.forEach(function(lab) { 
                   var fk = helpers.facetKey(lab);
                   var mInf = typeof initialFacets !== 'undefined' && initialFacets && initialFacets.materials && initialFacets.materials[fk];
                   var mCnt = mInf && typeof mInf === 'object' ? mInf.count : null;
              %>
                <div class="filter-option">
                  <input type="checkbox" id="mat-<%= fk.replace(/[^a-z0-9]+/gi, '-') %>" name="materials" value="<%= lab %>"
                    class="filter-checkbox facet-material" data-facet-key="<%= fk %>"
                    <%= selM.some(function(c) { return String(c).trim().toLowerCase() === fk; }) ? 'checked' : '' %>>
                  <label for="mat-<%= fk.replace(/[^a-z0-9]+/gi, '-') %>" class="filter-label"><%= lab %><% if (mCnt != null) { %><span class="filter-count"> (<%= mCnt %>)</span><% } %></label>
                </div>
              <% }); %>
            </div>
          </div>
          <% } %>
          
          <!-- Price Range Filter -->
          <div class="filter-section">
            <h4 class="filter-title">Preço</h4>
            <div class="filter-options">
              <div class="filter-option">
                <input type="radio" id="price-all" name="price_range" value="all" 
                       class="filter-radio" <%= typeof queryParams !== 'undefined' && queryParams.price_range !== '0-50' && queryParams.price_range !== '50-100' && queryParams.price_range !== '100+' ? 'checked' : '' %>>
                <label for="price-all" class="filter-label">Todos</label>
              </div>
              <div class="filter-option">
                <input type="radio" id="price-low" name="price_range" value="0-50" 
                       class="filter-radio" <%= typeof queryParams !== 'undefined' && queryParams.price_range === '0-50' ? 'checked' : '' %>>
                <label for="price-low" class="filter-label">Até €50</label>
              </div>
              <div class="filter-option">
                <input type="radio" id="price-mid" name="price_range" value="50-100" 
                       class="filter-radio" <%= typeof queryParams !== 'undefined' && queryParams.price_range === '50-100' ? 'checked' : '' %>>
                <label for="price-mid" class="filter-label">€50 - €100</label>
              </div>
              <div class="filter-option">
                <input type="radio" id="price-high" name="price_range" value="100+" 
                       class="filter-radio" <%= typeof queryParams !== 'undefined' && queryParams.price_range === '100+' ? 'checked' : '' %>>
                <label for="price-high" class="filter-label">€100+</label>
              </div>
            </div>
          </div>
          
          <!-- Filter Actions -->
          <div class="filter-actions">
            <button type="submit" class="btn-filter-apply">
              <i class="fas fa-check me-2"></i>
              Aplicar Filtros
            </button>
            <a href="/catalog" class="btn-filter-clear">
              <i class="fas fa-times me-2"></i>
              Limpar Filtros
            </a>
          </div>
          
        </form>
      </div>
    </aside>
    
    <!-- Main Content Area -->
    <section class="catalog-content">
      <% 
        var totalCatalogCount = (typeof catalogPagination !== 'undefined' && catalogPagination) 
          ? catalogPagination.totalFiltered 
          : ((products && products.length) || 0);
        var curSort = (typeof queryParams !== 'undefined' && queryParams && queryParams.sort) ? String(queryParams.sort) : 'default';
        var curPerPage = (typeof catalogPagination !== 'undefined' && catalogPagination) 
          ? catalogPagination.perPage 
          : 24;
        var perPageOpts = (typeof catalogPagination !== 'undefined' && catalogPagination && catalogPagination.perPageOptions) 
          ? catalogPagination.perPageOptions 
          : [12, 24, 48];
        function appendMulti(pairs, key, val) {
          if (val === undefined || val === null || val === '') return;
          if (Array.isArray(val)) { val.forEach(function(v) { if (v) pairs.push(key + '=' + encodeURIComponent(v)); }); }
          else pairs.push(key + '=' + encodeURIComponent(val));
        }
        function catalogPageHref(p) {
          var qp = typeof queryParams !== 'undefined' ? queryParams : {};
          var pairs = [];
          if (qp.search) pairs.push('search=' + encodeURIComponent(qp.search));
          if (qp.price_range && qp.price_range !== 'all') pairs.push('price_range=' + encodeURIComponent(qp.price_range));
          if (curSort && curSort !== 'default') pairs.push('sort=' + encodeURIComponent(curSort));
          pairs.push('per_page=' + encodeURIComponent(curPerPage));
          pairs.push('page=' + encodeURIComponent(p));
          var fam = qp.families;
          if (fam) {
            if (Array.isArray(fam)) { fam.forEach(function(id) { pairs.push('families=' + encodeURIComponent(id)); }); }
            else { pairs.push('families=' + encodeURIComponent(fam)); }
          }
          appendMulti(pairs, 'colors', qp.colors);
          appendMulti(pairs, 'materials', qp.materials);
          return '/catalog?' + pairs.join('&');
        }
      %>
      
      <!-- Header with Controls -->
      <div class="catalog-header">
        <div class="header-left">
          <h1 class="page-title">Catálogo de Produtos</h1>
          <p class="page-subtitle">Descubra as nossas peças únicas</p>
        </div>
        <div class="header-right">
          <button class="filter-toggle-btn" id="filter-toggle-btn" aria-label="Abrir filtros">
            <i class="fas fa-filter me-2"></i>
            <span class="d-none d-md-inline">Filtros</span>
          </button>
          <div class="results-count">
            <span class="count-number"><%= totalCatalogCount %></span>
            <span class="count-text">produto<%= totalCatalogCount !== 1 ? 's' : '' %></span>
          </div>
        </div>
      </div>

      <%
        // ===== Categorias =====
        // Entrada do catálogo. Sem filtro activo aparecem em cartões grandes;
        // com filtro encolhem para uma tira que continua a servir de
        // navegação e mostra onde se está, em vez de desaparecerem.
        const materiais = (typeof catalogMaterials !== 'undefined' && Array.isArray(catalogMaterials))
          ? catalogMaterials : [];
        const compacto = typeof filtroActivo !== 'undefined' && filtroActivo;
        // Que material está seleccionado? O filtro guarda ids de família, que
        // podem ser subcategorias — sobe-se à raiz para marcar o cartão certo.
        const idsSeleccionados = (typeof selectedFamilyIds !== 'undefined' && Array.isArray(selectedFamilyIds))
          ? selectedFamilyIds.map(Number) : [];
      %>
      <% if (materiais.length > 0) { %>
        <section class="catalog-categories<%= compacto ? ' is-compact' : '' %>"
                 aria-label="Navegar por material">
          <% if (!compacto) { %>
            <header class="catalog-categories-header">
              <p class="section-eyebrow">Explorar por material</p>
            </header>
          <% } %>

          <div class="catalog-categories-list">
            <a href="/catalog"
               class="catalog-category-card is-all<%= idsSeleccionados.length === 0 ? ' is-active' : '' %>">
              <span class="catalog-category-media" aria-hidden="true"></span>
              <span class="catalog-category-body">
                <span class="catalog-category-name">Ver todos</span>
                <span class="catalog-category-count"><%= totalCatalogCount %> peças</span>
              </span>
            </a>

            <% materiais.forEach(function(m) {
              const img = m.card_image || m.hero_image
                || (m.fallback_image ? productImg(m.fallback_image, 'medium').jpg : null);
              const activo = idsSeleccionados.includes(Number(m.id));
            %>
              <a href="/catalog?families=<%= m.id %>"
                 class="catalog-category-card<%= img ? ' has-image' : '' %><%= activo ? ' is-active' : '' %>">
                <span class="catalog-category-media"
                      <% if (img) { %>style="background-image: url('<%= encodeURI(img) %>');"<% } %>
                      aria-hidden="true"></span>
                <span class="catalog-category-body">
                  <span class="catalog-category-name"><%= m.name %></span>
                  <span class="catalog-category-count"><%= m.product_count %> peças</span>
                </span>
              </a>
            <% }); %>
          </div>
        </section>
      <% } %>

      <!-- Catalog Controls (Sort & View) -->
      <div class="catalog-controls">
        <div class="catalog-controls-left">
          <label for="catalog-sort" class="sort-label">Ordenar por:</label>
          <select id="catalog-sort" class="sort-select" aria-label="Ordenar produtos">
            <option value="default" <%= curSort === 'default' ? 'selected' : '' %>>Padrão</option>
            <option value="price-asc" <%= curSort === 'price-asc' ? 'selected' : '' %>>Preço: Menor → Maior</option>
            <option value="price-desc" <%= curSort === 'price-desc' ? 'selected' : '' %>>Preço: Maior → Menor</option>
            <option value="name-asc" <%= curSort === 'name-asc' ? 'selected' : '' %>>Nome: A-Z</option>
            <option value="name-desc" <%= curSort === 'name-desc' ? 'selected' : '' %>>Nome: Z-A</option>
            <option value="reference-asc" <%= curSort === 'reference-asc' ? 'selected' : '' %>>Referência: Crescente</option>
            <option value="reference-desc" <%= curSort === 'reference-desc' ? 'selected' : '' %>>Referência: Decrescente</option>
          </select>
          <label for="catalog-per-page" class="sort-label ms-md-3 mt-2 mt-md-0 d-block d-md-inline">Por página:</label>
          <select id="catalog-per-page" class="sort-select" aria-label="Produtos por página" form="catalog-filters">
            <% perPageOpts.forEach(function(n) { %>
              <option value="<%= n %>" <%= curPerPage === n ? 'selected' : '' %>><%= n %> / página</option>
            <% }); %>
          </select>
        </div>
        <div class="catalog-controls-right">
          <div class="view-toggle">
            <button type="button" class="view-btn active" id="view-grid" title="Vista em grelha" aria-label="Vista em grelha">
              <i class="fas fa-th"></i>
            </button>
            <button type="button" class="view-btn" id="view-list" title="Vista em lista" aria-label="Vista em lista">
              <i class="fas fa-list"></i>
            </button>
          </div>
        </div>
      </div>

      <div id="catalog-chips" class="catalog-chips" aria-label="Filtros ativos"></div>
      
      <!-- Products Grid -->
      <div class="products-container">
        <% if (products && products.length > 0) { %>
          <div class="products-grid grid-view" id="products-grid">
            <% 
              var retPath = typeof catalogReturnPath !== 'undefined' ? catalogReturnPath : '/catalog';
            %>
            <% products.forEach((product, index) => { %>
              <div class="product-item" 
                   data-product-id="<%= product.id %>"
                   data-aos="fade-up" 
                   data-aos-delay="<%= index * 50 %>">
                <div class="product-card">
                  <div class="product-image-container">
                    <% 
                      const imageUrl = product.image_url ? `/media/products/${product.image_url.replace(/\.[^.]+$/, '')}-medium.jpg` : '/images/imagem-nao-disponivel.svg';
                      const slugOrId = product.slug || product.id;
                      const productHref = '/catalog/product/' + encodeURIComponent(slugOrId) + '?return=' + encodeURIComponent(retPath);
                    %>
                    <a href="<%= productHref %>" 
                       class="product-image-link">
                      <img src="<%= imageUrl %>" 
                           alt="<%= product.name %> — joia artesanal prata 925" 
                           class="product-image lazy-loaded"
                           loading="lazy"
                           onerror="this.onerror=null;this.src='/images/imagem-nao-disponivel.svg';">
                      <div class="product-overlay">
                        <a href="<%= productHref %>" class="btn-quick-view">
                          <i class="fas fa-eye"></i> Ver Detalhes
                        </a>
                      </div>
                    </a>
                    <% if (product.is_new) { %>
                      <span class="product-badge badge-new">Novo</span>
                    <% } %>
                    <% if (product.on_sale) { %>
                      <span class="product-badge badge-sale">Promoção</span>
                    <% } %>
                  </div>
                  <div class="product-info">
                    <p class="product-reference">Ref: <%= product.reference || 'N/A' %></p>
                    <% if (product.family_name) { %>
                      <p class="product-family"><small class="text-highlight"><%= product.family_name %></small></p>
                    <% } %>
                    <h3 class="product-title"><%= product.name || 'Produto' %></h3>
                    <p class="product-price">
                      <% if (typeof siteSettings !== 'undefined' && siteSettings.hide_catalog_prices) { %>
                        <span class="text-muted fst-italic">Preço sob consulta</span>
                      <% } else { %>
                        <%= product.formatted_sale_price || '<span class="text-muted fst-italic">Preço sob consulta</span>' %>
                      <% } %>
                    </p>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="no-products">
            <div class="no-products-icon">
              <i class="fas fa-search"></i>
            </div>
            <h3>Nenhum produto encontrado</h3>
            <p>Tente ajustar os filtros ou <a href="/catalog">ver todos os produtos</a></p>
          </div>
        <% } %>
      </div>

      <nav id="catalog-pagination-wrap" class="catalog-pagination-wrap" aria-label="Paginação do catálogo">
        <% if (typeof catalogPagination !== 'undefined' && catalogPagination && catalogPagination.totalPages > 1) { %>
          <div class="catalog-pagination">
            <% if (catalogPagination.page > 1) { %>
              <a class="pagination-btn" href="<%= catalogPageHref(catalogPagination.page - 1) %>" rel="prev" aria-label="Página anterior"><i class="fas fa-chevron-left"></i></a>
            <% } %>
            <% 
              var start = Math.max(1, catalogPagination.page - 2);
              var end = Math.min(catalogPagination.totalPages, catalogPagination.page + 2);
              for (var pi = start; pi <= end; pi++) { 
            %>
              <% if (pi === catalogPagination.page) { %>
                <span class="pagination-btn active" aria-current="page"><%= pi %></span>
              <% } else { %>
                <a class="pagination-btn" href="<%= catalogPageHref(pi) %>"><%= pi %></a>
              <% } %>
            <% } %>
            <% if (catalogPagination.page < catalogPagination.totalPages) { %>
              <a class="pagination-btn" href="<%= catalogPageHref(catalogPagination.page + 1) %>" rel="next" aria-label="Página seguinte"><i class="fas fa-chevron-right"></i></a>
            <% } %>
          </div>
          <p class="catalog-pagination-meta text-muted small mt-2 mb-0">Página <%= catalogPagination.page %> de <%= catalogPagination.totalPages %></p>
        <% } %>
      </nav>
      
    </section>
    
  </div>
</main>

<!-- Floating Filter Button (Fixed) -->
<button class="floating-filter-btn" id="floating-filter-btn" aria-label="Abrir filtros" title="Abrir filtros">
  <div class="filter-btn-content">
    <svg class="filter-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M4 6H20M7 12H17M10 18H14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <circle cx="4" cy="6" r="2" fill="currentColor"/>
      <circle cx="7" cy="12" r="2" fill="currentColor"/>
      <circle cx="10" cy="18" r="2" fill="currentColor"/>
    </svg>
    <span class="filter-btn-label">Filtros</span>
  </div>
  <span class="floating-filter-badge" id="active-filters-count" style="display: none;">0</span>
</button>

<!-- Mobile Sidebar Overlay -->

<script>
  window.__CATALOG_SETTINGS__ = {
    hideCatalogPrices: <%= (typeof siteSettings !== 'undefined' && siteSettings.hide_catalog_prices) ? true : false %>
  };
  window.__CATALOG_RETURN_PATH__ = <%- JSON.stringify(typeof catalogReturnPath !== 'undefined' ? catalogReturnPath : '/catalog') %>;
  window.__CATALOG_FAMILY_NAMES__ = <%- JSON.stringify(typeof familyNameById !== 'undefined' ? familyNameById : {}) %>;
  window.__INITIAL_FACETS__ = <%- JSON.stringify(typeof initialFacets !== 'undefined' && initialFacets ? initialFacets : null) %>;
</script>
<!-- Catalog Enhanced JavaScript Modules -->
<script src="/js/modules/catalog-filters.js"></script>
<script src="/js/modules/catalog-lazy-load.js"></script>
<script src="/js/modules/catalog-sort.js"></script>
<script src="/js/modules/catalog-grid.js"></script>
<script src="/js/modules/catalog-view-modes.js"></script>
<script src="/js/modules/catalog-search.js"></script>
<script src="/js/catalog-enhanced.js"></script>

<!-- Catalog Image Handler - Optimized -->
<script>
(function() {
  'use strict';
  
  function ensureImagesVisible() {
    const images = document.querySelectorAll('.product-image');
    images.forEach(img => {
      // Ensure all images have lazy-loaded class for proper display
      if (!img.classList.contains('lazy-loaded')) {
        img.classList.add('lazy-loaded');
      }
      
      // Handle error state
      if (!img.complete || img.naturalHeight === 0) {
        img.addEventListener('error', function() {
          this.onerror = null;
          this.src = '/images/imagem-nao-disponivel.svg';
          this.classList.add('lazy-loaded');
        }, { once: true });
      }
    });
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', ensureImagesVisible);
  } else {
    ensureImagesVisible();
  }
  
  // Run once more after full page load
  window.addEventListener('load', ensureImagesVisible, { once: true });
})();
</script>

