<!-- Fix: Ensure all product images display correctly -->
<script>
(function() {
  'use strict';
  
  function ensureImageVisibility() {
    const containers = document.querySelectorAll('.product-image-container');
    let fixedCount = 0;
    
    containers.forEach(container => {
      const img = container.querySelector('.product-image');
      if (img) {
        // Get container height - use padding-top calculation if offsetHeight is 0
        let containerHeight = container.offsetHeight;
        if (containerHeight === 0) {
          const paddingTop = parseFloat(window.getComputedStyle(container).paddingTop);
          const width = container.offsetWidth || container.clientWidth;
          if (width > 0 && paddingTop > 0) {
            containerHeight = paddingTop;
          }
        }
        
        // If still no height, use width (square aspect ratio)
        if (containerHeight === 0) {
          const width = container.offsetWidth || container.clientWidth;
          if (width > 0) {
            containerHeight = width;
          }
        }
        
        // Always ensure image has proper dimensions - use 100% if we can't calculate
        const targetHeight = containerHeight > 0 ? containerHeight + 'px' : '100%';
        
        // Force image to fill container using absolute positioning
        img.style.cssText = `
          position: absolute !important;
          top: 0 !important;
          left: 0 !important;
          right: 0 !important;
          bottom: 0 !important;
          width: 100% !important;
          height: ${targetHeight} !important;
          min-height: ${targetHeight} !important;
          max-height: ${targetHeight} !important;
          object-fit: cover !important;
          object-position: center center !important;
          opacity: 1 !important;
          visibility: visible !important;
          display: block !important;
          z-index: 2 !important;
        `;
        
        if (img.offsetHeight === 0 && containerHeight > 0) {
          fixedCount++;
        }
      }
    });
    
    if (fixedCount > 0) {
      console.log('Fixed', fixedCount, 'images with zero height');
    }
  }
  
  function initImageFix() {
    ensureImageVisibility();
    
    // Observe image load events
    const images = document.querySelectorAll('.product-image');
    images.forEach(img => {
      if (img.complete) {
        ensureImageVisibility();
      } else {
        img.addEventListener('load', function() {
          ensureImageVisibility();
        }, { once: true });
        img.addEventListener('error', function() {
          ensureImageVisibility();
        }, { once: true });
      }
    });
    
    // Use IntersectionObserver to fix images as they come into view
    if ('IntersectionObserver' in window) {
      const containers = document.querySelectorAll('.product-image-container');
      const observer = new IntersectionObserver(function(entries) {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            ensureImageVisibility();
          }
        });
      }, { rootMargin: '100px' });
      
      containers.forEach(container => {
        observer.observe(container);
      });
    }
  }
  
  // Run immediately if DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      initImageFix();
      // Multiple attempts to catch all images
      setTimeout(ensureImageVisibility, 50);
      setTimeout(ensureImageVisibility, 200);
      setTimeout(ensureImageVisibility, 500);
      setTimeout(ensureImageVisibility, 1000);
    });
  } else {
    initImageFix();
    setTimeout(ensureImageVisibility, 50);
    setTimeout(ensureImageVisibility, 200);
    setTimeout(ensureImageVisibility, 500);
    setTimeout(ensureImageVisibility, 1000);
  }
  
  // Run after all images load
  window.addEventListener('load', function() {
    ensureImageVisibility();
    setTimeout(ensureImageVisibility, 100);
    setTimeout(ensureImageVisibility, 500);
  });
  
  // Also run on scroll to fix images as they come into view
  let scrollTimeout;
  window.addEventListener('scroll', function() {
    clearTimeout(scrollTimeout);
    scrollTimeout = setTimeout(ensureImageVisibility, 100);
  }, { passive: true });
})();
</script>

