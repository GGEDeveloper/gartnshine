<div class="instagram-page">
  <section class="instagram-hero">
    <div class="instagram-hero-inner">
      <h1>Instagram</h1>
      <p class="instagram-hero-lead">Últimas publicações de Gonzaga's Art & Shine</p>
      <div class="geometric-divider instagram-divider">
        <span></span><span></span><span></span>
      </div>
      <p class="instagram-lab-teaser">
        <a href="/instagram-lab">Laboratório API</a>
        <span class="instagram-lab-teaser-hint"> — comentários, contagens e estado do módulo</span>
      </p>
    </div>
  </section>

  <% if (typeof instagramError !== 'undefined' && instagramError) { %>
  <section class="instagram-message">
    <p role="alert">
      <% if (instagramError === 'not_configured') { %>
        O feed do Instagram não está configurado neste ambiente.
      <% } else { %>
        Não foi possível carregar o feed do Instagram. Tenta mais tarde.
      <% } %>
    </p>
    <p>
      <a href="https://www.instagram.com/gonzagaartnshine/" target="_blank" rel="noopener noreferrer">Abrir perfil no Instagram</a>
    </p>
  </section>
  <% } %>

  <% if (typeof posts !== 'undefined' && posts && posts.length) { %>
  <section class="instagram-grid-section">
    <div class="instagram-grid">
      <% posts.forEach(function (post) {
        var isVideo = post.media_type === 'VIDEO';
        var imgUrl = isVideo && post.thumbnail_url ? post.thumbnail_url : post.media_url;
        var cap = post.caption || '';
        var shortCap = cap.length > 100 ? cap.slice(0, 100) + '…' : cap;
        var isCarousel = post.media_type === 'CAROUSEL_ALBUM';
      %>
      <article class="instagram-card">
        <a href="<%= post.permalink %>" class="instagram-card-link" target="_blank" rel="noopener noreferrer" aria-label="Ver publicação no Instagram">
          <div class="instagram-card-image-wrap">
            <% if (imgUrl) { %>
            <img src="<%= imgUrl %>" alt="" loading="lazy" decoding="async" class="instagram-card-img">
            <% } else { %>
            <div class="instagram-card-placeholder" aria-hidden="true"></div>
            <% } %>
            <span class="instagram-type-badge" title="<%= post.media_type %>">
              <% if (isVideo) { %>
              <i class="fas fa-video" aria-hidden="true"></i><span class="sr-only">Vídeo</span>
              <% } else if (isCarousel) { %>
              <i class="fas fa-images" aria-hidden="true"></i><span class="sr-only">Álbum</span>
              <% } else { %>
              <i class="fas fa-image" aria-hidden="true"></i><span class="sr-only">Imagem</span>
              <% } %>
            </span>
          </div>
          <% if (shortCap) { %>
          <p class="instagram-card-caption"><%= shortCap %></p>
          <% } %>
        </a>
      </article>
      <% }); %>
    </div>
  </section>
  <% } else if (!instagramError) { %>
  <section class="instagram-message">
    <p>Ainda não há publicações para mostrar.</p>
  </section>
  <% } %>
</div>
