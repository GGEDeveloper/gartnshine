<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex,nofollow">
  <title><%= brand.nomeSeo %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500&family=Source+Sans+3:wght@300;400&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      min-height: 100vh;
      background: #050505;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Source Sans 3', sans-serif;
      color: #f0ece4;
      background-image:
        radial-gradient(ellipse at 20% 50%, rgba(201,168,76,0.04) 0%, transparent 60%),
        radial-gradient(ellipse at 80% 20%, rgba(201,168,76,0.03) 0%, transparent 50%);
    }

    .lock-wrap {
      width: 100%;
      max-width: 360px;
      padding: 2.5rem 2rem 2rem;
      text-align: center;
    }

    .brand-mark {
      font-family: 'Cinzel', serif;
      font-size: 1.05rem;
      letter-spacing: 0.32em;
      text-transform: uppercase;
      color: rgba(240,236,228,0.55);
      margin-bottom: 0.4rem;
    }

    .brand-title {
      font-family: 'Cinzel', serif;
      font-size: 1.55rem;
      font-weight: 400;
      letter-spacing: 0.12em;
      color: #f0ece4;
      margin-bottom: 0.3rem;
    }

    .brand-divider {
      width: 40px;
      height: 1px;
      background: rgba(201,168,76,0.5);
      margin: 1.1rem auto 2rem;
    }

    .lock-icon {
      font-size: 1.6rem;
      opacity: 0.35;
      margin-bottom: 1.2rem;
      display: block;
    }

    .error-msg {
      background: rgba(220,60,60,0.12);
      border: 1px solid rgba(220,60,60,0.3);
      color: #f08080;
      border-radius: 6px;
      padding: 0.6rem 1rem;
      font-size: 0.88rem;
      margin-bottom: 1rem;
    }

    .form-group { position: relative; margin-bottom: 1rem; }

    input[type="password"] {
      width: 100%;
      background: rgba(240,236,228,0.05);
      border: 1px solid rgba(201,168,76,0.22);
      border-radius: 6px;
      padding: 0.75rem 1rem;
      color: #f0ece4;
      font-size: 1rem;
      letter-spacing: 0.15em;
      text-align: center;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
      font-family: inherit;
    }

    input[type="password"]::placeholder {
      color: rgba(240,236,228,0.2);
      letter-spacing: 0.05em;
    }

    input[type="password"]:focus {
      border-color: rgba(201,168,76,0.55);
      box-shadow: 0 0 0 3px rgba(201,168,76,0.1);
    }

    button[type="submit"] {
      width: 100%;
      padding: 0.75rem 1rem;
      background: rgba(201,168,76,0.12);
      border: 1px solid rgba(201,168,76,0.35);
      border-radius: 6px;
      color: #c9a84c;
      font-family: 'Cinzel', serif;
      font-size: 0.82rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s, color 0.2s;
    }

    button[type="submit"]:hover {
      background: rgba(201,168,76,0.2);
      border-color: rgba(201,168,76,0.6);
      color: #e0bc5a;
    }

    .site-hint {
      margin-top: 1.75rem;
      font-size: 0.72rem;
      color: rgba(240,236,228,0.2);
      letter-spacing: 0.08em;
    }
  </style>
</head>
<body>
  <div class="lock-wrap">
    <p class="brand-mark">Gonzaga's</p>
    <h1 class="brand-title">Art &amp; Shine</h1>
    <div class="brand-divider"></div>

    <span class="lock-icon" aria-hidden="true">🔒</span>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error-msg"><%= error %></div>
    <% } %>

    <form method="POST" action="/site-password" autocomplete="off">
      <div class="form-group">
        <input type="password" name="sitePassword" placeholder="••••" autofocus maxlength="20" required>
      </div>
      <button type="submit">Entrar</button>
    </form>

    <p class="site-hint">Acesso privado · © <%= brand.nomeSeo %></p>
  </div>
</body>
</html>
