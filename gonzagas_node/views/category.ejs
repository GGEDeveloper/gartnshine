<%
  // Imagem escolhida no admin; sem ela, uma foto de uma peça desta categoria.
  const headerImage = family.hero_image
    || (family.fallback_image ? productImg(family.fallback_image, 'full').jpg : null);
  const temIndice = grupos && grupos.length > 1;
  const temNav = nav && (nav.parent || nav.children.length > 0 || nav.siblings.length > 0);
%>

<div class="category-page<%= temIndice ? ' category-page--with-index' : '' %>">
  <%
    // Numa subcategoria sobe-se para o material; num material, para o catálogo.
    const _vh = nav.parent ? ('/categoria/' + (nav.parent.slug || nav.parent.id)) : '/loja';
    const _vr = nav.parent ? nav.parent.name : 'Loja';
  %>
  <nav class="voltar-barra" aria-label="Voltar">
    <%- include('partials/_voltar', { voltarHref: _vh, voltarRotulo: _vr }) %>
  </nav>
  <section class="collection-header<%= headerImage ? ' has-background' : '' %>"
           <% if (headerImage) { %>style="background-image: url('<%= encodeURI(headerImage) %>'); background-size: cover; background-position: center;"<% } %>>
    <div class="collection-title">
      <p class="section-eyebrow">
        <% if (nav.parent) { %>
          <a href="/categoria/<%= nav.parent.slug || nav.parent.id %>"><%= nav.parent.name %></a>
        <% } else { %>
          Categoria
        <% } %>
      </p>
      <h1><%= family.name %></h1>
      <div class="geometric-divider" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <% if (family.description) { %>
        <p class="collection-description"><%= family.description %></p>
      <% } %>
      <p class="collection-meta">
        <span><%= products.length %> peça<%= products.length === 1 ? '' : 's' %></span>
      </p>
    </div>
  </section>

  <div class="category-body">
    <%
      // Índice lateral: só faz sentido numa categoria de topo, onde os
      // produtos estão agrupados por subcategoria e há para onde saltar.
      // O botão "voltar ao topo" já é criado por /js/modules/ui.js — não
      // se repete aqui.
    %>
    <% if (temIndice) { %>
      <aside class="category-index" aria-label="Subcategorias de <%= family.name %>">
        <nav class="category-index-inner">
          <p class="category-index-title"><%= family.name %></p>
          <ul class="category-index-list">
            <% grupos.forEach(function(g) { %>
              <li>
                <a href="#<%= g.anchor %>" data-index-link="<%= g.anchor %>">
                  <span class="category-index-name"><%= g.name.split(' - ')[0] %></span>
                  <span class="category-index-count"><%= g.products.length %></span>
                </a>
              </li>
            <% }); %>
          </ul>
        </nav>
      </aside>
    <% } %>

    <div class="category-content">
      <% if (!products || products.length === 0) { %>
        <div class="no-products">
          <p>Ainda não há peças nesta categoria.</p>
          <a href="/loja" class="btn btn-primary">Ir para a loja</a>
        </div>
      <% } else if (temIndice) { %>
        <% grupos.forEach(function(g) { %>
          <section class="category-group" id="<%= g.anchor %>">
            <header class="category-group-header">
              <h2><%= g.name.split(' - ')[0] %></h2>
              <a href="/categoria/<%= g.slug || g.id %>" class="category-group-link">
                Ver só <%= g.name.split(' - ')[0].toLowerCase() %>
              </a>
            </header>
            <div class="products-grid">
              <% g.products.forEach(function(product) { %>
                <%- include('partials/_productCard', {product: product}) %>
              <% }); %>
            </div>
          </section>
        <% }); %>
      <% } else { %>
        <%
          // Ordenação só quando há uma única grelha. Nas categorias de topo os
          // produtos estão agrupados por subcategoria e reordenar tudo de uma
          // vez baralharia os grupos — aí a organização é o próprio índice.
        %>
        <section class="filter-controls">
          <div class="filter-container">
            <div class="sort-by">
              <label for="sort-select">Ordenar por:</label>
              <select id="sort-select">
                <option value="name-asc">Nome: A-Z</option>
                <option value="name-desc">Nome: Z-A</option>
              </select>
            </div>
          </div>
        </section>
        <section class="products-section">
          <div class="products-grid">
            <% products.forEach(function(product) { %>
              <%- include('partials/_productCard', {product: product}) %>
            <% }); %>
          </div>
        </section>
      <% } %>
    </div>
  </div>

  <% if (temNav) { %>
    <section class="category-nav">
      <h2 class="category-nav-title">
        <% if (nav.children.length > 0) { %>
          Subcategorias de <%= family.name %>
        <% } else if (nav.parent) { %>
          Mais em <%= nav.parent.name %>
        <% } %>
      </h2>
      <div class="category-nav-list">
        <% (nav.children.length > 0 ? nav.children : nav.siblings).forEach(function(c) { %>
          <a href="/categoria/<%= c.slug || c.id %>" class="category-nav-link">
            <span class="category-nav-link-name"><%= c.name %></span>
            <span class="category-nav-link-count"><%= c.product_count %></span>
          </a>
        <% }); %>
      </div>
      <div class="category-nav-footer">
        <% if (nav.parent) { %>
          <a href="/categoria/<%= nav.parent.slug || nav.parent.id %>">Toda a categoria <%= nav.parent.name %></a>
        <% } %>
        <a href="/loja">Ver toda a loja</a>
        <a href="/colecoes">Coleções curadas</a>
      </div>
    </section>
  <% } %>
</div>

<script>
  // Ordenação da grelha única. O elemento só existe nas subcategorias, por
  // isso a guarda não é defensiva a mais — nas categorias de topo é null.
  (function () {
    const sortSelect = document.getElementById('sort-select');
    const grid = document.querySelector('.products-grid');
    if (!sortSelect || !grid) return;

    sortSelect.addEventListener('change', function () {
      const asc = sortSelect.value === 'name-asc';
      Array.from(grid.querySelectorAll('.product-card'))
        .sort(function (a, b) {
          const na = a.getAttribute('data-name') || '';
          const nb = b.getAttribute('data-name') || '';
          return asc ? na.localeCompare(nb) : nb.localeCompare(na);
        })
        .forEach(function (card) { grid.appendChild(card); });
    });
  })();
</script>

<%
  // Breadcrumb hierárquico: Início → [Material] → Subcategoria.
  // O antigo apontava para /collections, que é a galeria — não tinha nada
  // que ver com a árvore de categorias.
  const trilho = [{ name: 'Início', url: '/' }];
  if (nav.parent) {
    trilho.push({ name: nav.parent.name, url: '/categoria/' + (nav.parent.slug || nav.parent.id) });
  }
  trilho.push({ name: family.name, url: '/categoria/' + (family.slug || family.id) });
%>
<%- include('partials/schema-breadcrumb', { breadcrumbs: trilho }) %>
