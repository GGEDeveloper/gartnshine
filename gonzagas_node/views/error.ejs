<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Erro' %> | <%= brand.nomeSeo %></title>
  
  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico">
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --igp-bg: #0a0a0a;
      --igp-gold: #c9a84c;
      --igp-cream: #f0ece4;
      --igp-muted: rgba(240,236,228,0.55);
      --igp-border: rgba(201,168,76,0.18);
    }
    body {
      font-family: 'Poppins', Georgia, sans-serif;
      background-color: var(--igp-bg);
      background-image: radial-gradient(ellipse 120% 80% at 50% -20%, rgba(201,168,76,0.1), transparent 55%);
      color: var(--igp-cream);
      line-height: 1.6;
      margin: 0;
      padding: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .error-container {
      max-width: 720px;
      width: 90%;
      margin: var(--space-xl) auto;
      padding: var(--space-lg);
      background: rgba(12,12,12,0.9);
      border: 1px solid var(--igp-border);
      border-radius: var(--radius-md);
      box-shadow: 0 8px 32px rgba(0,0,0,0.55);
    }
    .error-content { padding: 0; }
    h1 {
      color: var(--igp-cream);
      font-family: Georgia, 'Times New Roman', serif;
      font-size: clamp(1.5rem, 4vw, 2rem);
      font-weight: 300;
      letter-spacing: 0.12em;
      margin-top: 0;
      margin-bottom: var(--space-sm);
    }
    p { color: var(--igp-muted); margin-bottom: var(--space-md); }
    .btn {
      display: inline-block;
      padding: var(--space-xs) var(--space-md);
      background: var(--igp-gold);
      color: #0a0a0a;
      text-decoration: none;
      border-radius: var(--radius-md);
      margin-top: var(--space-2xs);
      font-weight: 500;
      transition: background 0.25s;
    }
    .btn:hover { background: #e0bc5a; color: #0a0a0a; }
    .btn + .btn {
      background: rgba(201,168,76,0.1);
      color: var(--igp-cream);
      border: 1px solid var(--igp-border);
      margin-left: var(--space-xs);
    }
    .btn + .btn:hover { background: rgba(201,168,76,0.2); color: var(--igp-cream); }
    .error-details {
      margin-top: var(--space-lg);
      padding: var(--space-sm) var(--space-sm);
      background: rgba(0,0,0,0.4);
      border-left: 3px solid var(--igp-gold);
      border-radius: var(--radius-sm);
      font-family: monospace;
      font-size: var(--text-sm);
      color: var(--igp-muted);
      white-space: pre-wrap;
      word-break: break-all;
    }
    @media (max-width: 767.98px) {
      .error-container {
        width: 95%;
        margin: var(--space-lg) auto;
        padding: var(--space-md);
      }
      h1 {
        font-size: var(--text-xl);
      }
      .btn {
        display: block;
        width: 100%;
        text-align: center;
        margin: var(--space-2xs) 0 0 0;
        min-height: 48px;
        padding: var(--space-xs) var(--space-sm);
        font-size: var(--text-base);
      }
      .btn + .btn {
        margin-left: 0;
      }
    }
  </style>
</head>
<body>
  <div class="error-container">
    <div class="error-content">
      <h1><%= typeof title !== 'undefined' ? title : 'Erro' %></h1>
      <p><%= typeof message !== 'undefined' ? message : 'Ocorreu um erro inesperado.' %></p>
      
      <% if (typeof error !== 'undefined' && Object.keys(error).length > 0) { %>
        <div class="error-details">
          <p><strong>Error Details:</strong></p>
          <p><%= error.message %></p>
          <% if (error.stack) { %>
            <pre><%= error.stack %></pre>
          <% } %>
        </div>
      <% } %>
      
      <a href="/" class="btn">Return to Home</a>
      <a href="/admin/dashboard" class="btn" style="margin-left: 10px;">Back to Dashboard</a>
    </div>
  </div>
</body>
</html> 