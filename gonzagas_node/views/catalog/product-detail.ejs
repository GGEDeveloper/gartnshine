<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css">
<link rel="stylesheet" href="/css/background-override.css">
<% if (user && user.role === 'admin') { %>
    <link rel="stylesheet" href="/css/admin-quick-actions.css">
<% } %>
<style>
    /* Product Detail Layout - Images Left, Details Right */
    .product-detail-container {
        max-width: var(--container-base);
        margin: 0 auto;
        padding: var(--space-lg);
    }
    
    .product-detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-xl);
        margin-top: var(--space-lg);
    }
    
    /* Left: Image Gallery */
    .product-gallery-section {
        position: sticky;
        top: 2rem;
        height: fit-content;
    }
    
    .product-main-image {
        position: relative;
        width: 100%;
        padding-top: 100%; /* Square aspect ratio */
        background: rgba(20, 20, 20, 0.5);
        border-radius: var(--radius-md);
        overflow: hidden;
        margin-bottom: var(--space-sm);
        cursor: pointer;
        transition: transform 0.3s ease;
    }
    
    .product-main-image:hover {
        transform: scale(1.02);
    }
    
    .product-main-image img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: var(--radius-md);
    }
    
    .product-thumbnails {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
        gap: var(--space-xs);
    }
    
    .product-thumbnail {
        position: relative;
        width: 100%;
        padding-top: 100%;
        background: rgba(20, 20, 20, 0.5);
        border-radius: var(--radius-md);
        overflow: hidden;
        cursor: pointer;
        border: 2px solid transparent;
        transition: all 0.3s ease;
    }
    
    .product-thumbnail:hover {
        border-color: var(--color-highlight, #c9a84c);
        transform: scale(1.05);
    }
    
    .product-thumbnail.active {
        border-color: var(--color-accent, #c9a84c);
    }
    
    .product-thumbnail img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    /* Right: Product Info */
    .product-info-section {
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
    }
    
    .product-title {
        font-size: var(--text-2xl);
        font-weight: var(--weight-bold);
        /* era var(--color-primary) — a cor de FUNDO do site */
        color: var(--color-highlight);
        margin-bottom: var(--space-2xs);
    }
    
    .product-reference {
        color: var(--color-text-secondary, #999);
        font-size: var(--text-sm);
        margin-bottom: var(--space-sm);
    }
    
    .product-category {
        color: var(--color-accent, #A8A8A8);
        font-size: var(--text-base);
        margin-bottom: var(--space-sm);
    }
    
    .product-price {
        font-size: var(--text-2xl);
        color: var(--color-highlight, #C0C0C0);
        font-weight: 700;
        margin: var(--space-sm) 0;
    }
    
    .product-availability {
        padding: var(--space-xs) var(--space-sm);
        border-radius: var(--radius-md);
        font-weight: 600;
        margin: var(--space-sm) 0;
        display: inline-block;
    }
    
    .product-availability.available {
        background: rgba(201, 168, 76, 0.12);
        color: var(--color-highlight, #c9a84c);
        border: 1px solid var(--color-accent, #c9a84c);
    }
    
    .product-availability.on-order {
        background: rgba(201, 168, 76, 0.1);
        color: var(--color-accent-alt, #c9a84c);
        border: 1px solid var(--color-accent-alt, #c9a84c);
    }
    
    .product-availability.out-of-stock {
        background: rgba(220, 53, 69, 0.15);
        color: #dc3545;
        border: 1px solid rgba(220, 53, 69, 0.4);
    }
    
    .btn-notify {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-xs);
        background: rgba(37, 211, 102, 0.1);
        color: #25D366;
        padding: var(--space-xs) var(--space-lg);
        text-decoration: none;
        border-radius: var(--radius-md);
        font-weight: 600;
        font-size: var(--text-base);
        border: 1px solid rgba(37, 211, 102, 0.3);
        transition: all 0.3s ease;
        text-align: center;
    }
    
    .btn-notify:hover {
        background: rgba(37, 211, 102, 0.2);
        border-color: #25D366;
        color: #25D366;
        text-decoration: none;
        transform: translateY(-2px);
    }
    
    .related-products-section {
        margin-top: var(--space-xl);
        padding-top: var(--space-lg);
        border-top: 1px solid rgba(201, 168, 76, 0.15);
    }
    
    .related-products-section h3 {
        font-size: var(--text-lg);
        margin-bottom: var(--space-md);
        color: var(--color-highlight);
    }
    
    .related-products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: var(--space-md);
    }
    
    .related-product-card {
        background: rgba(12, 12, 12, 0.85);
        border-radius: var(--radius-md);
        overflow: hidden;
        border: 1px solid rgba(201, 168, 76, 0.12);
        transition: all 0.3s ease;
        text-decoration: none;
        color: inherit;
        display: block;
    }
    
    .related-product-card:hover {
        transform: translateY(-4px);
        border-color: rgba(201, 168, 76, 0.35);
        text-decoration: none;
        color: inherit;
        box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    }
    
    .related-product-card img {
        width: 100%;
        aspect-ratio: 1;
        object-fit: cover;
    }
    
    .related-product-card .related-info {
        padding: var(--space-xs) var(--space-sm);
    }
    
    .related-product-card .related-name {
        font-size: var(--text-sm);
        font-weight: 500;
        color: var(--color-text);
        margin-bottom: var(--space-3xs);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    
    .related-product-card .related-price {
        font-size: var(--text-sm);
        color: var(--color-highlight, #c9a84c);
    }
    
    .related-product-card .related-stock {
        font-size: var(--text-xs);
        margin-top: var(--space-3xs);
    }
    
    .related-product-card .related-stock.in-stock {
        color: #28a745;
    }
    
    .related-product-card .related-stock.no-stock {
        color: #dc3545;
    }
    
    .product-description {
        margin-top: var(--space-md);
        line-height: 1.6;
        color: var(--color-text, #ddd);
    }

    .product-description h3 {
        /* `--color-primary` é a cor de FUNDO do site (#05070a). Como a
           variável existe, o fallback #f5f5f5 nunca era usado e o título
           "Descrição" renderizava preto sobre preto — invisível, e uma
           falha de contraste (WCAG 1.4.3). */
        font-size: var(--text-lg);
        margin-bottom: var(--space-xs);
        color: var(--color-highlight);
    }

    .product-specifications {
        margin-top: var(--space-md);
        padding: var(--space-sm);
        background: rgba(20, 20, 20, 0.3);
        border-radius: var(--radius-md);
        border: 1px solid rgba(201, 168, 76, 0.2);
    }

    .product-specifications h3 {
        font-size: var(--text-md);
        margin-bottom: var(--space-xs);
        color: var(--color-highlight, #c9a84c);
    }

    .specs-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: var(--space-2xs);
    }

    .specs-list li {
        padding: var(--space-2xs) 0;
        color: var(--color-text, #ddd);
        font-size: var(--text-sm);
        border-bottom: 1px solid rgba(201, 168, 76, 0.1);
    }

    .specs-list li:last-child {
        border-bottom: none;
    }

    .specs-list strong {
        color: var(--color-highlight, #c9a84c);
        margin-right: var(--space-2xs);
    }
    
    .product-actions {
        margin-top: var(--space-lg);
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
    }
    
    .btn-whatsapp {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-xs);
        background: #25D366;
        /* Branco sobre #25D366 dá 1.98:1 e falha o mínimo AA (4.5:1).
           Texto escuro sobre o mesmo verde da marca dá ~10:1 e mantém o
           reconhecimento imediato do WhatsApp. */
        color: #06231a;
        padding: var(--space-sm) var(--space-lg);
        text-decoration: none;
        border-radius: var(--radius-md);
        font-weight: 600;
        font-size: var(--text-md);
        transition: all 0.3s ease;
        text-align: center;
    }
    
    .btn-whatsapp:hover {
        background: #20BA5A;
        color: #06231a;
        text-decoration: none;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(37, 211, 102, 0.3);
    }
    
    .btn-copy {
        background: rgba(30, 30, 30, 0.8);
        border: 1px solid var(--border-strong);
        color: var(--color-text, #ddd);
        padding: var(--space-xs) var(--space-md);
        border-radius: var(--radius-md);
        cursor: pointer;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    
    .btn-copy:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: var(--color-highlight);
        transform: translateY(-2px);
    }
    
    /* As migalhas e o "voltar" desta página vivem agora em `.peca-cabecalho`,
       em transitions.css, junto das setas entre peças — os três elementos
       formam um bloco só e separá-los era o que os fazia divergir. */

    /* Mobile Responsive */
    @media (max-width: 767.98px) {
        .product-detail-container {
            padding: var(--space-sm);
        }
        
        .product-detail-grid {
            grid-template-columns: 1fr;
            gap: var(--space-lg);
        }
        
        .product-gallery-section {
            position: static;
        }
        
        .product-title {
            font-size: var(--text-xl);
        }
        
        .product-price {
            font-size: var(--text-xl);
        }
        
        .btn-whatsapp {
            font-size: var(--text-base);
            padding: var(--space-xs) var(--space-md);
        }
    }
</style>

<div class="product-detail-container">
    <%
      // ===== Cabeçalho de navegação da peça =====
      //
      // Eram três barras empilhadas — migalhas, um "voltar" e as setas — a
      // dizer três vezes a mesma coisa por outras palavras, e o "Loja (com
      // filtros)" a expor vocabulário interno a quem só quer voltar atrás.
      // Passam a ser duas linhas: onde estou (com o caminho completo, que
      // antes saltava a categoria) e como percorro a categoria.
      var catBack = (typeof catalogBackUrl !== 'undefined' && catalogBackUrl) ? catalogBackUrl : '/loja';
      var hasCtx = typeof catalogBackUrl !== 'undefined' && catalogBackUrl && catalogBackUrl !== '/loja';
      var catUrl = product.family_slug ? '/categoria/' + product.family_slug : null;

      // Com filtros activos volta-se à listagem que a pessoa tinha montado;
      // sem eles, à categoria da peça — que é de onde se vem na maioria dos
      // casos, e serve também a quem chega do Google sem histórico nenhum.
      var voltarHref = hasCtx ? catBack : (catUrl || '/loja');
      var voltarRotulo = hasCtx
        ? 'Voltar aos resultados'
        : ('Voltar a ' + (product.family_name || 'Loja'));
    %>

    <nav class="peca-cabecalho" aria-label="Onde estou">
      <%- include('../partials/_voltar', { voltarHref: voltarHref, voltarRotulo: voltarRotulo }) %>

      <ol class="peca-migalhas">
        <li><a href="/">Início</a></li>
        <li><a href="<%= catBack %>">Loja</a></li>
        <% if (product.family_name && catUrl) { %>
          <li><a href="<%= catUrl %>"><%= product.family_name %></a></li>
        <% } %>
        <li aria-current="page"><%= product.name %></li>
      </ol>
    </nav>

    <%
      // ===== Setas entre peças da mesma categoria =====
      // Permitem percorrer a categoria sem voltar atrás. A ordem é a mesma
      // da página da categoria, senão as setas levariam a uma sequência
      // diferente da que se estava a ver.
      var viz = (typeof vizinhas !== 'undefined' && vizinhas) ? vizinhas : null;
      var temViz = viz && (viz.anterior || viz.seguinte);
    %>
    <% if (temViz) { %>
      <nav class="peca-nav" aria-label="Navegar entre peças de <%= product.family_name || 'esta categoria' %>">
        <% if (viz.anterior) { %>
          <a class="peca-nav-link peca-nav-anterior"
             href="/loja/produto/<%= viz.anterior.slug || viz.anterior.id %>"
             rel="prev" data-direccao="anterior">
            <span class="peca-nav-seta" aria-hidden="true">&larr;</span>
            <span class="peca-nav-texto">
              <span class="peca-nav-rotulo"><span class="peca-nav-rotulo-longo">Peça </span>anterior</span>
              <span class="peca-nav-nome"><%= viz.anterior.name %></span>
            </span>
          </a>
        <% } else { %><span class="peca-nav-vazio"></span><% } %>

        <% if (viz.posicao) { %>
          <%
            // "8 / 90" é notação de ficheiro. Em português corrente, e a
            // dizer de que categoria se trata — sem isso o número não diz
            // de que sequência estamos a falar.
            var posTexto = viz.posicao + '.ª de ' + viz.total;
          %>
          <span class="peca-nav-posicao">
            <span class="peca-nav-posicao-num"><%= posTexto %></span>
            <% if (product.family_name) { %>
              <span class="peca-nav-posicao-cat">em <%= product.family_name %></span>
            <% } %>
          </span>
        <% } %>

        <% if (viz.seguinte) { %>
          <a class="peca-nav-link peca-nav-seguinte"
             href="/loja/produto/<%= viz.seguinte.slug || viz.seguinte.id %>"
             rel="next" data-direccao="seguinte">
            <span class="peca-nav-texto">
              <span class="peca-nav-rotulo"><span class="peca-nav-rotulo-longo">Peça </span>seguinte</span>
              <span class="peca-nav-nome"><%= viz.seguinte.name %></span>
            </span>
            <span class="peca-nav-seta" aria-hidden="true">&rarr;</span>
          </a>
        <% } else { %><span class="peca-nav-vazio"></span><% } %>
      </nav>
    <% } %>

    <div class="product-detail-grid">
        <!-- Left: Image Gallery -->
        <div class="product-gallery-section">
            <% 
                // Get all product images
                let allImages = [];
                if (product.image_url) {
                    allImages.push(product.image_url);
                }
                if (product.images && product.images.length > 0) {
                    product.images.forEach(img => {
                        if (img && !allImages.includes(img)) {
                            allImages.push(img);
                        }
                    });
                }
                
                const hasGalleryImages = allImages.length > 0;
                const placeholderImg = '/images/imagem-nao-disponivel.svg';
                const mainImg = hasGalleryImages ? productImg(allImages[0], 'medium') : { jpg: placeholderImg, webp: null };
                const mainFullImg = hasGalleryImages ? productImg(allImages[0], 'full') : { jpg: placeholderImg, webp: null };
            %>

            <div class="product-main-image">
                <a href="<%= mainFullImg.jpg %>"
                   class="glightbox product-image-link"
                   data-glightbox="type: image; title: <%= product.name %>"
                   data-gallery="product-gallery">
                    <picture>
                        <% if (mainImg.webp) { %><source srcset="<%= mainImg.webp %>" type="image/webp"><% } %>
                        <img src="<%= mainImg.jpg %>"
                             alt="<%= product.name %>"
                             id="mainProductImage"
                             loading="eager"
                             onerror="this.onerror=null;this.src='<%= placeholderImg %>';">
                    </picture>
                </a>
            </div>

            <% if (allImages.length > 1) { %>
            <div class="product-thumbnails">
                <% allImages.forEach((img, index) => {
                    const thumbImg = productImg(img, 'thumb');
                    const thumbMediumImg = productImg(img, 'medium');
                    const thumbFullImg = productImg(img, 'full');
                %>
                <div class="product-thumbnail <%= index === 0 ? 'active' : '' %>"
                     data-medium="<%= thumbMediumImg.jpg %>"
                     data-medium-webp="<%= thumbMediumImg.webp || '' %>"
                     data-full="<%= thumbFullImg.jpg %>"
                     data-index="<%= index %>">
                    <a href="<%= thumbFullImg.jpg %>"
                       class="glightbox product-thumbnail-link"
                       data-glightbox="type: image; title: <%= product.name %>"
                       data-gallery="product-gallery">
                        <picture>
                            <% if (thumbImg.webp) { %><source srcset="<%= thumbImg.webp %>" type="image/webp"><% } %>
                            <img src="<%= thumbImg.jpg %>"
                                 alt="<%= product.name %> - Imagem <%= index + 1 %>"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.src='/images/imagem-nao-disponivel.svg';">
                        </picture>
                    </a>
                </div>
                <% }); %>
            </div>
            <% } %>
        </div>
        
        <!-- Right: Product Info -->
        <div class="product-info-section">
            <!-- Admin Quick Edit Button (só aparece para admins) -->
            <% if (user && user.role === 'admin') { %>
            <div class="admin-quick-actions">
                <a href="/admin/products/edit/<%= product.id %>?returnTo=<%= encodeURIComponent('/loja/produto/' + product.id) %>" 
                   class="btn-admin-edit"
                   title="Editar este produto"
                   data-tooltip="Editar Produto">
                    <i class="fas fa-edit"></i>
                    <span class="btn-text">Editar Produto</span>
                </a>
            </div>
            <% } %>
            
            <div>
                <h1 class="product-title"><%= product.name %></h1>
                <p class="product-reference">Ref: <%= product.reference %></p>
                
                <% if (product.family_name) { %>
                    <p class="product-category"><%= product.family_name %></p>
                <% } %>
            </div>
            
            <%
              // "€0.00" é uma string verdadeira: quem decide se há preço é o
              // número, não o texto formatado. Sem isto uma peça sob consulta
              // anunciava-se a zero euros.
              const semPrecoTitulo = !product.sale_price || parseFloat(product.sale_price) <= 0;
            %>
            <% if (semPrecoTitulo || (typeof siteSettings !== 'undefined' && siteSettings.hide_catalog_prices)) { %>
                <div class="product-price">Preço sob consulta</div>
            <% } else if (product.formatted_sale_price) { %>
                <div class="product-price"><%= product.formatted_sale_price %></div>
            <% } else if (product.sale_price) { %>
                <div class="product-price">€<%= parseFloat(product.sale_price).toFixed(2) %></div>
            <% } else { %>
                <div class="product-price">Preço sob consulta</div>
            <% } %>
            
            <% if (product.current_stock > 0) { %>
                <div class="product-availability available">
                    ✓ Disponível
                </div>
            <% } else { %>
                <div class="product-availability out-of-stock">
                    Esgotado
                </div>
            <% } %>
            
            <% if (product.description) { %>
                <div class="product-description">
                    <h3>Descrição</h3>
                    <p><%= product.description %></p>
                </div>
            <% } %>

            <% if (product.weight || product.dimensions || product.material || product.style) { %>
                <div class="product-specifications">
                    <h3>Especificações</h3>
                    <ul class="specs-list">
                        <% if (product.weight) { %>
                            <li><strong>Peso:</strong> <%= product.weight %></li>
                        <% } %>
                        <% if (product.dimensions) { %>
                            <li><strong>Dimensões:</strong> <%= product.dimensions %></li>
                        <% } %>
                        <% if (product.material) { %>
                            <li><strong>Material:</strong> <%= product.material %></li>
                        <% } %>
                        <% if (product.style) { %>
                            <li><strong>Estilo:</strong> <%= product.style %></li>
                        <% } %>
                    </ul>
                </div>
            <% } %>
            
            <div class="product-actions">
                <%
                  // Peça sob consulta: sem preço não vai ao carrinho, senão era
                  // encomendada por 0,00 €. Fica o WhatsApp, que é por onde o
                  // preço se pede. Ver a mesma guarda em partials/_productCard.ejs.
                  const semPreco = !product.sale_price || parseFloat(product.sale_price) <= 0;
                %>
                <% if (product.current_stock > 0 && !semPreco) { %>
                <% if (typeof ecommerceEnabled !== 'undefined' && ecommerceEnabled) { %>
                <div class="product-add-wrap">
                  <% if (product.current_stock > 1) { %>
                  <div class="product-qty-stepper" data-max="<%= product.current_stock %>">
                    <button type="button" class="detail-qty-btn detail-qty-minus" disabled aria-label="Diminuir">−</button>
                    <span class="detail-qty-value">1</span>
                    <button type="button" class="detail-qty-btn detail-qty-plus" <%= product.current_stock <= 1 ? 'disabled' : '' %> aria-label="Aumentar">+</button>
                    <small class="detail-qty-stock">(<%= product.current_stock %> disponíveis)</small>
                  </div>
                  <% } %>
                  <button type="button" class="btn-add-to-cart" data-product-id="<%= product.id %>" style="display:flex;align-items:center;justify-content:center;gap:0.75rem;padding:1rem 2rem;border:1px solid rgba(201,162,39,0.5);background:transparent;color:inherit;border-radius:4px;cursor:pointer;width:100%;margin-bottom:0.5rem;">
                      🛒 Adicionar ao carrinho
                  </button>
                </div>
                <% } %>
                <a href="https://wa.me/<%= whatsappData.number %>?text=<%= whatsappData.encodedMessage %>" 
                   class="btn-whatsapp" 
                   target="_blank"
                   onclick="trackWhatsApp()">
                    <i class="fab fa-whatsapp"></i>
                    Pedir Informações via WhatsApp
                </a>
                <% } else { %>
                <a href="https://wa.me/<%= whatsappData.number %>?text=<%= whatsappNotifyMsg %>" 
                   class="btn-notify" 
                   target="_blank">
                    <i class="fab fa-whatsapp"></i>
                    Avisar quando disponível
                </a>
                <a href="https://wa.me/<%= whatsappData.number %>?text=<%= whatsappData.encodedMessage %>" 
                   class="btn-whatsapp" 
                   target="_blank"
                   onclick="trackWhatsApp()">
                    <i class="fab fa-whatsapp"></i>
                    Pedir Informações via WhatsApp
                </a>
                <% } %>
                
                <button onclick="copyInfo()" class="btn-copy">
                    📋 Copiar Informações
                </button>
            </div>
        </div>
    </div>
    
    <% if (typeof relatedProducts !== 'undefined' && relatedProducts.length > 0) { %>
    <div class="related-products-section">
        <h3>Peças semelhantes</h3>
        <div class="related-products-grid">
            <% relatedProducts.forEach(function(rp) { %>
            <a href="/loja/produto/<%= rp.slug || rp.id %>" class="related-product-card">
                <img src="<%= rp.image_url ? '/media/products/' + rp.image_url.replace(/\.[^.]+$/, '') + '-medium.jpg' : '/images/imagem-nao-disponivel.svg' %>"
                     onerror="this.onerror=null;this.src='/images/imagem-nao-disponivel.svg';"
                     alt="<%= rp.name %> — joia artesanal prata 925" loading="lazy">
                <div class="related-info">
                    <div class="related-name"><%= rp.name %></div>
                    <% if (rp.sale_price) { %>
                    <div class="related-price">€<%= parseFloat(rp.sale_price).toFixed(2) %></div>
                    <% } %>
                    <% if (rp.current_stock > 0) { %>
                    <div class="related-stock in-stock">Disponível</div>
                    <% } else { %>
                    <div class="related-stock no-stock">Esgotado</div>
                    <% } %>
                </div>
            </a>
            <% }); %>
        </div>
    </div>
    <% } %>
</div>

<%- contentFor('scripts') %>
<script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>
<script>
    // Initialize GLightbox for product images
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof GLightbox !== 'undefined') {
            const lightbox = GLightbox({
                selector: '.glightbox',
                touchNavigation: true,
                loop: true,
                zoomable: true,
                draggable: true,
                openEffect: 'zoom',
                closeEffect: 'zoom',
                slideEffect: 'slide',
                closeButton: true,
                touchFollowAxis: true,
                keyboardNavigation: true,
                closeOnOutsideClick: true
            });
        }
        
        // Thumbnail click handler to change main image
        const thumbnails = document.querySelectorAll('.product-thumbnail');
        const mainImage = document.getElementById('mainProductImage');
        const mainImageLink = document.querySelector('.product-main-image .product-image-link');
        
        thumbnails.forEach(thumb => {
            thumb.addEventListener('click', function(e) {
                e.preventDefault();
                const mediumUrl = this.dataset.medium;
                const mediumWebpUrl = this.dataset.mediumWebp;
                const fullUrl = this.dataset.full;
                const imageIndex = parseInt(this.dataset.index);

                // Update main image (variante 'medium' otimizada, não o ficheiro full-size)
                if (mainImage) {
                    mainImage.src = mediumUrl;
                    const sourceEl = mainImage.parentElement && mainImage.parentElement.querySelector('source');
                    if (sourceEl && mediumWebpUrl) sourceEl.srcset = mediumWebpUrl;
                }
                if (mainImageLink) {
                    mainImageLink.href = fullUrl;
                }

                // Update active thumbnail
                thumbnails.forEach(t => t.classList.remove('active'));
                this.classList.add('active');
            });
        });
    });
    
    function copyInfo() {
        const productName = '<%= product.name %>';
        const reference = '<%= product.reference %>';
        const price = '<%= product.sale_price ? "€" + parseFloat(product.sale_price).toFixed(2) : "Preço sob consulta" %>';
        const url = window.location.href;
        
        const info = `${productName}\nReferência: ${reference}\n${price}\nVer: ${url}`;
        
        if (navigator.clipboard) {
            navigator.clipboard.writeText(info).then(() => {
                alert('Informações copiadas!');
            }).catch(err => {
                console.error('Error copying to clipboard:', err);
                alert('Informações: ' + info);
            });
        } else {
            alert('Informações: ' + info);
        }
    }
    
    function trackWhatsApp() {
        console.log('WhatsApp clicked for product:', '<%= product.id %>');
        // Track WhatsApp click for analytics
        if (typeof gtag !== 'undefined') {
            gtag('event', 'whatsapp_click', {
                'event_category': 'engagement',
                'event_label': 'Product Detail',
                'product_id': '<%= product.id %>'
            });
        }
    }
</script>

<%
  // O caminho estruturado tem de ser o mesmo que está visível na página — a
  // categoria faltava nos dois sítios, e é o degrau que diz ao Google (e a
  // quem lê o resultado da pesquisa) em que secção da loja a peça vive.
  var migalhasSchema = [
    { name: 'Início', url: '/' },
    { name: 'Loja', url: '/loja' }
  ];
  if (product.family_name && product.family_slug) {
    migalhasSchema.push({ name: product.family_name, url: '/categoria/' + product.family_slug });
  }
  migalhasSchema.push({ name: product.name, url: '/loja/produto/' + (product.slug || product.id) });
%>
<%- include('../partials/schema-breadcrumb', { breadcrumbs: migalhasSchema }) %>

<% if (process.env.GA_TRACKING_ID) { %>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof gtag === 'undefined') return;
    gtag('event', 'view_item', {
      currency: 'EUR',
      value: <%= product.sale_price ? parseFloat(product.sale_price).toFixed(2) : 0 %>,
      items: [{
        item_id: '<%= (product.reference || product.id) %>',
        item_name: '<%= (product.name || '').replace(/'/g, "\\'").replace(/"/g, '\\"') %>',
        item_category: '<%= (product.family_name || 'Sem categoria').replace(/'/g, "\\'") %>',
        price: <%= product.sale_price ? parseFloat(product.sale_price).toFixed(2) : 0 %>,
        quantity: 1,
        item_brand: "<%= brand.nomeSeo %>"
      }]
    });
  });
</script>
<% } %>
