<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pesquisa: <%= query %> - Gonzaga's Art & Shine</title>
    <meta name="robots" content="<%= typeof metaRobots !== 'undefined' && metaRobots ? metaRobots : 'noindex, follow' %>">
    <% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %>
    <link rel="canonical" href="<%= canonicalUrl %>">
    <% } %>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Main CSS - variables primeiro para paleta consistente -->
    <link rel="stylesheet" href="/css/variables.css">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/catalog.css">
    <link rel="stylesheet" href="/css/search-results.css">
    <link rel="stylesheet" href="/css/frontend-mobile.css">
    <link rel="stylesheet" href="/css/dark-luxe.css">
</head>
<body>

<%- include('../partials/header') %>

<main class="search-results-page">
    <div class="container">
        <!-- Search Header -->
        <div class="search-header">
            <div class="search-title-section">
                <h1 class="search-title">
                    <i class="fas fa-search"></i>
                    Resultados para "<%= query %>"
                </h1>
                <p class="search-meta">
                    <%= totalResults %> <%= totalResults === 1 ? 'produto encontrado' : 'produtos encontrados' %>
                </p>
            </div>
            
            <!-- Search Controls -->
            <div class="search-controls">
                <!-- Sort By -->
                <div class="control-group">
                    <label for="sortBy">
                        <i class="fas fa-sort"></i>
                        Ordenar:
                    </label>
                    <select id="sortBy" class="form-select">
                        <option value="relevance" <%= sortBy === 'relevance' ? 'selected' : '' %>>Relevância</option>
                        <option value="price_asc" <%= sortBy === 'price_asc' ? 'selected' : '' %>>Preço: Menor → Maior</option>
                        <option value="price_desc" <%= sortBy === 'price_desc' ? 'selected' : '' %>>Preço: Maior → Menor</option>
                        <option value="name_asc" <%= sortBy === 'name_asc' ? 'selected' : '' %>>Nome: A → Z</option>
                        <option value="newest" <%= sortBy === 'newest' ? 'selected' : '' %>>Mais Recentes</option>
                    </select>
                </div>
                
                <!-- View Toggle -->
                <div class="view-toggle">
                    <button class="btn-view active" data-view="grid" title="Vista em grelha">
                        <i class="fas fa-th"></i>
                    </button>
                    <button class="btn-view" data-view="list" title="Vista em lista">
                        <i class="fas fa-list"></i>
                    </button>
                </div>
            </div>
        </div>
        
        <div class="search-layout">
            <!-- Sidebar Filters -->
            <aside class="search-filters">
                <div class="filters-header">
                    <h3>
                        <i class="fas fa-filter"></i>
                        Filtros
                    </h3>
                    <button class="btn-clear-filters" onclick="clearFilters()">
                        Limpar
                    </button>
                </div>
                
                <!-- Category Filter -->
                <div class="filter-group">
                    <h4 class="filter-title">
                        <i class="fas fa-tags"></i>
                        Categoria
                    </h4>
                    <div class="filter-options">
                        <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                            <% categories.forEach(function(cat) { %>
                            <label class="filter-option">
                                <input type="checkbox" name="category" value="<%= cat.id %>" 
                                       <%= selectedCategories && selectedCategories.includes(cat.id.toString()) ? 'checked' : '' %>>
                                <span><%= cat.name %></span>
                                <span class="count">(<%= cat.count %>)</span>
                            </label>
                            <% }); %>
                        <% } else { %>
                            <p class="no-options">Sem categorias disponíveis</p>
                        <% } %>
                    </div>
                </div>
                
                <!-- Price Filter -->
                <div class="filter-group">
                    <h4 class="filter-title">
                        <i class="fas fa-euro-sign"></i>
                        Preço
                    </h4>
                    <div class="price-range">
                        <input type="number" id="priceMin" placeholder="Min" 
                               value="<%= priceMin || '' %>" class="price-input">
                        <span>—</span>
                        <input type="number" id="priceMax" placeholder="Max" 
                               value="<%= priceMax || '' %>" class="price-input">
                    </div>
                    <button class="btn-apply-price" onclick="applyPriceFilter()">
                        Aplicar
                    </button>
                </div>
                
                <!-- Stock Filter -->
                <div class="filter-group">
                    <h4 class="filter-title">
                        <i class="fas fa-box"></i>
                        Disponibilidade
                    </h4>
                    <div class="filter-options">
                        <label class="filter-option">
                            <input type="checkbox" name="stock" value="in_stock" 
                                   <%= inStock ? 'checked' : '' %>>
                            <span>Em Stock</span>
                        </label>
                    </div>
                </div>
            </aside>
            
            <!-- Results Grid -->
            <div class="search-results-content">
                <% if (products && products.length > 0) { %>
                    <div class="products-grid" data-view="grid">
                        <% products.forEach(function(product) { %>
                        <div class="product-card">
                            <a href="/catalog/product/<%= product.id %>" class="product-link">
                                <div class="product-image-wrapper">
                                    <img src="<%= product.main_image ? '/uploads/products/' + product.main_image : '/images/imagem-nao-disponivel.svg' %>" 
                                         alt="<%= product.name %>"
                                         class="product-image"
                                         loading="lazy">
                                    <% if (!product.in_stock) { %>
                                    <span class="badge-out-stock">Esgotado</span>
                                    <% } %>
                                </div>
                                <div class="product-info">
                                    <h3 class="product-name"><%= product.name %></h3>
                                    <p class="product-ref">REF: <%= product.reference %></p>
                                    <% if (product.family_name) { %>
                                    <p class="product-category">
                                        <i class="fas fa-tag"></i>
                                        <%= product.family_name %>
                                    </p>
                                    <% } %>
                                    <div class="product-footer">
                                        <span class="product-price">€<%= parseFloat(product.sale_price || 0).toFixed(2) %></span>
                                        <% if (product.in_stock) { %>
                                        <span class="badge-in-stock">
                                            <i class="fas fa-check"></i>
                                            Disponível
                                        </span>
                                        <% } %>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <% }); %>
                    </div>
                    
                    <!-- Pagination -->
                    <% if (totalPages > 1) { %>
                    <div class="pagination">
                        <% if (currentPage > 1) { %>
                        <a href="?q=<%= query %>&page=<%= currentPage - 1 %>" class="page-btn">
                            <i class="fas fa-chevron-left"></i>
                            Anterior
                        </a>
                        <% } %>
                        
                        <div class="page-numbers">
                            <% for (let i = 1; i <= totalPages; i++) { %>
                                <% if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) { %>
                                <a href="?q=<%= query %>&page=<%= i %>" 
                                   class="page-number <%= i === currentPage ? 'active' : '' %>">
                                    <%= i %>
                                </a>
                                <% } else if (i === currentPage - 3 || i === currentPage + 3) { %>
                                <span class="page-dots">...</span>
                                <% } %>
                            <% } %>
                        </div>
                        
                        <% if (currentPage < totalPages) { %>
                        <a href="?q=<%= query %>&page=<%= currentPage + 1 %>" class="page-btn">
                            Próximo
                            <i class="fas fa-chevron-right"></i>
                        </a>
                        <% } %>
                    </div>
                    <% } %>
                <% } else { %>
                    <!-- No Results -->
                    <div class="no-results">
                        <i class="fas fa-search no-results-icon"></i>
                        <h2>Nenhum resultado encontrado</h2>
                        <p>Tenta ajustar os filtros ou fazer uma nova pesquisa</p>
                        <a href="/catalog" class="btn-primary">
                            <i class="fas fa-th"></i>
                            Ver Todo o Catálogo
                        </a>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>

<script>
// Sort change
document.getElementById('sortBy')?.addEventListener('change', function() {
    const url = new URL(window.location);
    url.searchParams.set('sort', this.value);
    window.location = url.toString();
});

// View toggle
document.querySelectorAll('.btn-view').forEach(btn => {
    btn.addEventListener('click', function() {
        document.querySelectorAll('.btn-view').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        const view = this.dataset.view;
        document.querySelector('.products-grid').setAttribute('data-view', view);
    });
});

// Filter changes
document.querySelectorAll('input[name="category"], input[name="stock"]').forEach(input => {
    input.addEventListener('change', function() {
        applyFilters();
    });
});

function applyFilters() {
    const url = new URL(window.location);
    
    // Categories
    const categories = Array.from(document.querySelectorAll('input[name="category"]:checked'))
        .map(el => el.value);
    if (categories.length > 0) {
        url.searchParams.set('categories', categories.join(','));
    } else {
        url.searchParams.delete('categories');
    }
    
    // Stock
    const inStock = document.querySelector('input[name="stock"]:checked');
    if (inStock) {
        url.searchParams.set('inStock', '1');
    } else {
        url.searchParams.delete('inStock');
    }
    
    window.location = url.toString();
}

function applyPriceFilter() {
    const url = new URL(window.location);
    const min = document.getElementById('priceMin').value;
    const max = document.getElementById('priceMax').value;
    
    if (min) url.searchParams.set('priceMin', min);
    else url.searchParams.delete('priceMin');
    
    if (max) url.searchParams.set('priceMax', max);
    else url.searchParams.delete('priceMax');
    
    window.location = url.toString();
}

function clearFilters() {
    const url = new URL(window.location);
    url.searchParams.delete('categories');
    url.searchParams.delete('inStock');
    url.searchParams.delete('priceMin');
    url.searchParams.delete('priceMax');
    url.searchParams.delete('sort');
    window.location = url.toString();
}
</script>

<% if (process.env.GA_TRACKING_ID && typeof query !== 'undefined' && query) { %>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof gtag === 'undefined') return;
    gtag('event', 'search', {
      search_term: '<%= (query || '').replace(/'/g, "\\'") %>',
      number_of_results: <%= typeof totalResults !== 'undefined' ? totalResults : 0 %>
    });
  });
</script>
<% } %>

</body>
</html>

