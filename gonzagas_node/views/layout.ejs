<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | <%= siteTitle %></title>
  
  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico">
  
  <!-- Google Fonts - Enhanced for Visual Refresh 2025 -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Poppins:wght@300;400;500;600;700&family=Comfortaa:wght@300;400;500&display=swap" rel="stylesheet">
  
  <!-- Visual Refresh 2025 - Theme System -->
  <link rel="stylesheet" href="/css/themes/theme-system.css">
  
  <!-- Visual Refresh 2025 - Components -->
  <link rel="stylesheet" href="/css/components/buttons.css">
  <link rel="stylesheet" href="/css/components/cards.css">
  
  <!-- Visual Refresh 2025 - Responsive Utilities -->
  <link rel="stylesheet" href="/css/utilities/responsive.css">
  
  <!-- Legacy CSS (transitional) -->
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/cookie-banner.css">
        <link rel="stylesheet" href="/css/mobile/mobile-base.css">
      <link rel="stylesheet" href="/css/mobile/mobile-header.css">
      <link rel="stylesheet" href="/css/mobile/mobile-cards.css">
      <link rel="stylesheet" href="/css/mobile/mobile-catalog.css">
      <link rel="stylesheet" href="/css/mobile/mobile-admin.css">
  <% if (typeof customCss !== 'undefined' && customCss) { %>
    <link rel="stylesheet" href="/css/<%= customCss %>.css">
  <% } %>
  
  <!-- Theme Integration - Legacy Support -->
  <style>
    /* Legacy theme variables for backward compatibility */
    :root {
      --color-primary: <%= theme.colorPrimary %>;
      --color-secondary: <%= theme.colorSecondary %>;
      --color-accent: <%= theme.colorAccent %>;
      --color-text: <%= theme.colorText %>;
      --color-highlight: <%= theme.colorHighlight %>;
    }
    
    /* Enhanced body styling for theme transitions */
    body {
      background: var(--color-surface-primary, var(--color-primary));
      color: var(--color-text-primary, var(--color-text));
      transition: background-color 0.3s ease, color 0.3s ease;
    }
    
    /* Theme transition class for smooth changes */
    .theme-transition * {
      transition: background-color 0.3s ease, 
                 color 0.3s ease, 
                 border-color 0.3s ease,
                 box-shadow 0.3s ease !important;
    }
  </style>
</head>
<body>
  <!-- Header -->
  <%- include('partials/header') %>
  
  <!-- Mobile Header -->
  <%- include('partials/mobile-header') %>
  
  <!-- Flash Messages -->
  <% if(typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
    <div class="alert alert-success">
      <%= success_msg %>
    </div>
  <% } %>
  
  <% if(typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
    <div class="alert alert-danger">
      <%= error_msg %>
    </div>
  <% } %>
  
  <!-- Main Content -->
  <main class="container main-content">
    <%- body %>
  </main>
  
  <!-- Footer -->
  <%- include('partials/footer') %>
  
  <!-- Cookie Banner -->
  <%- include('partials/cookie-banner') %>
  
  <!-- Main JavaScript -->
  <script src="/js/main.js"></script>
  
  <!-- Carousel JavaScript -->
  <script src="/js/carousel.js"></script>
  
  <!-- Cookie Consent JavaScript -->
  <script src="/js/cookie-consent.js"></script>
  
  <!-- Mobile Navigation JavaScript -->
  <script src="/js/mobile-nav.js"></script>
  
  <!-- Visual Refresh 2025 - Theme Controller -->
  <script src="/js/theme-controller.js"></script>
  
  <!-- BOOM Festival Integration -->
  <script src="/js/boom-festival-integration.js"></script>
  
  <!-- Performance Optimizer -->
  <script src="/js/performance-optimizer.js"></script>
  
  <% if (typeof customJs !== 'undefined' && customJs) { %>
    <script src="/js/<%= customJs %>.js"></script>
  <% } %>
  
  <!-- Theme Integration Script -->
  <script>
    // Enhanced theme integration for Visual Refresh 2025
    document.addEventListener('DOMContentLoaded', function() {
      // Initialize theme system
      if (window.themeController) {
        // Subscribe to theme changes for enhanced integration
        window.themeController.onThemeChange(function(theme) {
          console.log('🎨 Tema alterado para:', theme);
          
          // Update page title with theme indicator
          const titleElement = document.querySelector('title');
          if (titleElement) {
            const baseTitle = titleElement.textContent.replace(/ \(.*\)$/, '');
            const themeNames = {
              dark: 'Terra Noturna',
              light: 'Terra Diurna',
              boom: 'BOOM Festival'
            };
            titleElement.textContent = `${baseTitle} (${themeNames[theme] || theme})`;
          }
        });
        
        // Auto-activate BOOM theme during festival period
        const now = new Date();
        const boomStart = new Date('2025-07-17');
        const boomEnd = new Date('2025-07-24');
        
        if (now >= boomStart && now <= boomEnd) {
          window.themeController.activateBoomMode();
        }
      }
    });
  </script>
</body>
</html>