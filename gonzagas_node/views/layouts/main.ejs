<!DOCTYPE html>
<html lang="pt-PT" class="h-100" data-theme="<%= typeof theme !== 'undefined' ? theme : 'dark' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Google Search Console Verification -->
  <meta name="google-site-verification" content="-_FeGat-XpwLOs3WEoMLcCUnb95_95LgamxM1EZCrHs">

  <!-- SEO: Title dinâmico -->
  <%
    // O sufixo da marca só entra se o título continuar a caber no resultado
    // do Google (~60 chars). Nos nomes de produto mais longos vale mais
    // manter o nome completo visível do que a marca repetida.
    let _pageTitle = (typeof title !== 'undefined' && title) ? title : '';
    if (!_pageTitle) {
      _pageTitle = 'Art&Shine — Elegância que nasce da terra';
    } else if (!_pageTitle.includes('Art&Shine') && _pageTitle.length + 12 <= 60) {
      _pageTitle += ' | Art&Shine';
    }
  %>
  <title><%= _pageTitle %></title>

  <!-- SEO Meta Tags dinâmicas -->
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : (typeof siteDescription !== 'undefined' ? siteDescription : 'Joias artesanais em prata 925 e pedras naturais. Elegância que nasce da terra — Gonzaga\'s Art & Shine.') %>">
  <meta name="keywords" content="<%= typeof metaKeywords !== 'undefined' && metaKeywords ? metaKeywords : 'prata 925, joias artesanais, pedras naturais, ónix, olho-de-tigre, ametista, turquesa, Gonzaga Art Shine, joias dark nature, prata alternativa, elegância natural, Portugal' %>">
  <meta name="robots" content="<%= typeof metaRobots !== 'undefined' && metaRobots ? metaRobots : 'index, follow' %>">

  <!-- Canonical URL -->
  <link rel="canonical" href="<%= typeof canonicalUrl !== 'undefined' && canonicalUrl ? canonicalUrl : ((typeof app !== 'undefined' && app && app.baseUrl) ? app.baseUrl : 'https://artnshine.pt') + (typeof currentPath !== 'undefined' ? currentPath : '/') %>">

  <!-- Open Graph -->
  <meta property="og:site_name" content="Art&Shine">
  <meta property="og:locale" content="pt_PT">
  <meta property="og:type" content="<%= typeof ogType !== 'undefined' && ogType ? ogType : 'website' %>">
  <meta property="og:title" content="<%= typeof title !== 'undefined' && title ? title : 'Art&Shine — Elegância que nasce da terra' %>">
  <meta property="og:description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : (typeof siteDescription !== 'undefined' ? siteDescription : 'Joias artesanais em prata 925 e pedras naturais. Elegância que nasce da terra.') %>">
  <meta property="og:url" content="<%= typeof canonicalUrl !== 'undefined' && canonicalUrl ? canonicalUrl : ((typeof app !== 'undefined' && app && app.baseUrl) ? app.baseUrl : 'https://artnshine.pt') + (typeof currentPath !== 'undefined' ? currentPath : '/') %>">
  <meta property="og:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : ((typeof app !== 'undefined' && app && app.baseUrl) ? app.baseUrl : 'https://artnshine.pt') + '/images/og-artnshine.jpg' %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Art&Shine — Elegância que nasce da terra">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= typeof title !== 'undefined' && title ? title : 'Art&Shine' %>">
  <meta name="twitter:description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : (typeof siteDescription !== 'undefined' ? siteDescription : 'Joias artesanais em prata 925 e pedras naturais. Elegância que nasce da terra.') %>">
  <meta name="twitter:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : ((typeof app !== 'undefined' && app && app.baseUrl) ? app.baseUrl : 'https://artnshine.pt') + '/images/og-artnshine.jpg' %>">

  <!-- Schema.org @graph: Organization + WebSite + WebPage -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "OnlineStore",
        "@id": "https://artnshine.pt/#organization",
        "name": "Gonzaga's Art & Shine",
        "alternateName": "Art&Shine",
        "description": "Joias artesanais em prata 925, latão banhado a prata e pedras naturais. Elegância que nasce da terra.",
        "url": "https://artnshine.pt",
        "logo": {
          "@type": "ImageObject",
          "@id": "https://artnshine.pt/#logo",
          "url": "https://artnshine.pt/logo.svg",
          "contentUrl": "https://artnshine.pt/logo.svg",
          "caption": "Gonzaga's Art & Shine"
        },
        "image": { "@id": "https://artnshine.pt/#logo" },
        "contactPoint": {
          "@type": "ContactPoint",
          "email": "g.art.shine@gmail.com",
          "telephone": "+351939500592",
          "contactType": "Customer Service",
          "areaServed": "PT",
          "availableLanguage": "Portuguese"
        },
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "PT"
        },
        "sameAs": [
          "https://www.instagram.com/gonzagaartnshine/",
          "https://www.facebook.com/profile.php?id=61573519807731"
        ]
      },
      {
        "@type": "WebSite",
        "@id": "https://artnshine.pt/#website",
        "url": "https://artnshine.pt",
        "name": "Art&Shine",
        "description": "Joias artesanais em prata 925 e pedras naturais. Elegância que nasce da terra.",
        "publisher": { "@id": "https://artnshine.pt/#organization" },
        "inLanguage": "pt-PT",
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": "https://artnshine.pt/search?q={search_term_string}"
          },
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": "WebPage",
        "@id": "<%= typeof canonicalUrl !== 'undefined' && canonicalUrl ? canonicalUrl : ((typeof app !== 'undefined' && app && app.baseUrl) ? app.baseUrl : 'https://artnshine.pt') + (typeof currentPath !== 'undefined' ? currentPath : '/') %>#webpage",
        "url": "<%= typeof canonicalUrl !== 'undefined' && canonicalUrl ? canonicalUrl : ((typeof app !== 'undefined' && app && app.baseUrl) ? app.baseUrl : 'https://artnshine.pt') + (typeof currentPath !== 'undefined' ? currentPath : '/') %>",
        "name": "<%= typeof title !== 'undefined' && title ? title : 'Art&Shine — Elegância que nasce da terra' %>",
        "isPartOf": { "@id": "https://artnshine.pt/#website" },
        "about": { "@id": "https://artnshine.pt/#organization" },
        "inLanguage": "pt-PT"
      }
    ]
  }
  </script>

  <!-- metas dinâmicas injetadas por view (extractMetas) -->
  <%- typeof metas !== 'undefined' ? metas : '' %>

  <% if (typeof ogType !== 'undefined' && ogType === 'product' && typeof product !== 'undefined' && product) { %>
  <% 
    const _baseUrl = 'https://artnshine.pt';
    const _canonical = typeof canonicalUrl !== 'undefined' ? canonicalUrl : (_baseUrl + '/catalog/product/' + (product.slug || product.id));
    let _mainImg = null;
    if (product.image_url) _mainImg = product.image_url;
    else if (product.images && product.images.length > 0) _mainImg = (typeof product.images[0] === 'string' ? product.images[0] : (product.images[0].image_filename || product.images[0]));
    const _mainImageUrl = _mainImg
      ? (_baseUrl + '/media/products/' + _mainImg.replace(/\.[^.]+$/, '') + '-medium.jpg')
      : (_baseUrl + '/images/imagem-nao-disponivel.svg');
    const _price = (product.sale_price && parseFloat(product.sale_price) > 0) ? parseFloat(product.sale_price).toFixed(2) : (product.price ? parseFloat(product.price).toFixed(2) : '0');
    const _availability = (product.current_stock > 0) ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock';
    const _desc = (product.description || (product.name + ' — joia artesanal em prata 925')).replace(/"/g, '&quot;');
  %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": "<%= _canonical %>#product",
    "name": "<%= product.name %>",
    "description": "<%= _desc %>",
    "sku": "<%= product.reference || product.id %>",
    "brand": {
      "@type": "Brand",
      "name": "Gonzaga's Art & Shine"
    },
    "image": ["<%= _mainImageUrl %>"],
    "offers": {
      "@type": "Offer",
      "@id": "<%= _canonical %>#offer",
      "url": "<%= _canonical %>",
      "priceCurrency": "EUR",
      "price": "<%= _price %>",
      "availability": "<%= _availability %>",
      "itemCondition": "https://schema.org/NewCondition",
      "seller": { "@id": "https://artnshine.pt/#organization" }
    }
  }
  </script>
  <% } %>

  <!-- Favicons -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <!-- Preconnect para Performance -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <% if (process.env.GA_TRACKING_ID) { %>
  <link rel="preconnect" href="https://www.googletagmanager.com">
  <link rel="dns-prefetch" href="https://www.google-analytics.com">
  <% } %>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Source+Sans+3:wght@300;400;500;600&display=swap" rel="stylesheet">

  <!-- Font Awesome (header icons, search, etc.) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">

  <!-- Main CSS Files -->
  <link rel="stylesheet" href="/css/variables.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/homepage.css?v=<%= app.version %>">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/components.css?v=<%= app.version %>">
  <link rel="stylesheet" href="/css/catalog-enhanced.css?v=<%= app.version %>">
  <link rel="stylesheet" href="/css/notifications.css">
  <link rel="stylesheet" href="/css/search.css">
  <link rel="stylesheet" href="/css/frontend-mobile.css?v=<%= app.version %>">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css">
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"/>
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css"/>

  <!-- Theme Variables -->
  <style>
    :root {
      --color-primary: <%= typeof theme !== 'undefined' && theme.colorPrimary ? theme.colorPrimary : '#05070a' %>;
      --color-secondary: <%= typeof theme !== 'undefined' && theme.colorSecondary ? theme.colorSecondary : '#0b1016' %>;
      --color-accent: <%= typeof theme !== 'undefined' && theme.colorAccent ? theme.colorAccent : '#A8A8A8' %>;
      --color-text: <%= typeof theme !== 'undefined' && theme.colorText ? theme.colorText : '#f4f6f8' %>;
      --color-highlight: <%= typeof theme !== 'undefined' && theme.colorHighlight ? theme.colorHighlight : '#C0C0C0' %>;
    }
  </style>

  <%- style %>
  <link rel="stylesheet" href="/css/dark-luxe.css?v=<%= app.version %>">
  <link rel="stylesheet" href="/css/media-cards.css?v=<%= app.version %>">
  <% if (typeof showcaseTheme !== 'undefined' && showcaseTheme) { %>
  <link rel="stylesheet" href="/css/brand-showcase.css?v=<%= app.version %>">
  <% } %>
  <link rel="stylesheet" href="/css/header.css?v=<%= app.version %>">

  <% if (process.env.GA_TRACKING_ID && (typeof cookieConsent === 'undefined' || cookieConsent === null || (typeof canUseAnalytics === 'function' && canUseAnalytics()))) { %>
  <!-- Google Tag Manager / GA4 -->
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    window.gtag = gtag;
    gtag('js', new Date());
    gtag('config', '<%= process.env.GA_TRACKING_ID %>', {
      anonymize_ip: true,
      page_title: typeof title !== 'undefined' ? title : document.title,
      page_location: window.location.href,
      send_page_view: true
    });
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= process.env.GA_TRACKING_ID %>"></script>
  <% } %>
</head>
<body class="d-flex flex-column h-100<%= typeof showcaseTheme !== 'undefined' && showcaseTheme ? ' showcase-theme' : '' %>" data-theme="<%= typeof theme !== 'undefined' ? theme : 'dark' %>">
    
  <%- include('../partials/header') %>
  
    <main class="flex-shrink-0">
  <%- body %>
    </main>
  
  <%- include('../partials/footer') %>
  
    <!-- Notification Container (bottom-right) -->
    <div id="notification-container"></div>
  
    <!-- CDN Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>
    
    <!-- jQuery e Slick Carousel -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
    
    <!-- Gonzaga Modular System -->
    <script src="/js/config.js"></script>
    <!-- Core modules in order - utils.js must load and initialize first -->
    <script src="/js/utils.js?v=<%= app.version %>"></script>
    <script>
      // Ensure utils.js is fully loaded and initialized before other modules
      (function checkUtils() {
        if (typeof GonzagaUtils !== 'undefined') {
          if (typeof GonzagaUtils.init === 'function') {
            GonzagaUtils.init();
          }
          // Verify handleError and log are available
          if (typeof GonzagaUtils.handleError === 'undefined') {
            console.error('[Layout] handleError not found in GonzagaUtils! Available methods:', Object.keys(GonzagaUtils));
            // Retry after a short delay
            setTimeout(checkUtils, 50);
            return;
          }
          if (typeof GonzagaUtils.log === 'undefined') {
            console.error('[Layout] log not found in GonzagaUtils!');
            setTimeout(checkUtils, 50);
            return;
          }
          console.log('[Layout] GonzagaUtils verified - handleError and log available');
        } else {
          console.error('[Layout] GonzagaUtils not loaded! Retrying...');
          setTimeout(checkUtils, 50);
        }
      })();
    </script>
    <script src="/js/modules/navigation.js"></script>
    <script src="/js/header.js?v=<%= app.version %>"></script>
    <script src="/js/modules/ui.js?v=<%= app.version %>"></script>
    <script src="/js/modules/carousel.js"></script>
    <script src="/js/modules/motion.js"></script>
    <script src="/js/main.js"></script>
    <script src="/js/notifications.js"></script>
    <script src="/js/frontend-mobile-navigation-fix.js"></script>
    <script src="/js/featured-carousel.js"></script>
    
    <!-- Flash Messages para Notificações -->
    <script>
        // Passar mensagens flash para o JavaScript
        window.flashMessages = {
            <% if (typeof messages !== 'undefined') { %>
                <% Object.keys(messages).forEach(function(type) { %>
                    "<%= type %>": <%- JSON.stringify(messages[type]) %>,
                <% }); %>
            <% } %>
        };
  </script>

    <!-- Advanced Search -->
    <script src="/js/advanced-search.js"></script>
    
    <!-- Image Optimization -->
    <script src="/js/image-optimization.js"></script>

    <!-- Analytics Tracking (Client-Side) -->
    <script src="/js/analytics-tracking.js"></script>

    <% if (typeof ecommerceEnabled !== 'undefined' && ecommerceEnabled) { %>
    <link rel="stylesheet" href="/ecommerce/css/cart.css">
    <script src="/ecommerce/js/shopping-cart.js" defer></script>
    <% } %>

    <%- script %>
</body>
</html>
