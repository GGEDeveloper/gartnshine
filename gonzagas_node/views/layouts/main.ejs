<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | <%= siteTitle %></title>
  
  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico">
  
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
  
  <!-- Theme CSS -->
  <link rel="stylesheet" href="/css/theme.css">
  <!-- Main CSS -->
  <link rel="stylesheet" href="/css/main.css">
  <!-- Catalog CSS -->
  <!-- GLightbox CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" />
  <link rel="stylesheet" href="/css/catalog.css">
  
  <style>
    :root {
      --color-primary: <%= theme.colorPrimary || '#1a1a1a' %>;
      --color-secondary: <%= theme.colorSecondary || '#2d2d2d' %>;
      --color-accent: <%= theme.colorAccent || '#c0a080' %>;
      --color-text: <%= theme.colorText || '#ffffff' %>;
      --color-highlight: <%= theme.colorHighlight || '#d4b190' %>;
    }
  </style>
</head>
<body>
  <%- include('../partials/header') %>
  
  <!-- Flash Messages -->
  <% if(typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
    <div class="alert alert-success">
      <%= success_msg %>
    </div>
  <% } %>
  
  <% if(typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
    <div class="alert alert-danger">
      <%= error_msg %>
    </div>
  <% } %>
  
  <!-- Main Content -->
  <%- body %>
  
  <%- include('../partials/footer') %>
  
  <!-- GLightbox JS -->
  <script src="https://cdn.jsdelivr.net/gh/mcstudios/glightbox/dist/js/glightbox.min.js"></script>
  <script type="text/javascript">
    const lightbox = GLightbox({
      touchNavigation: true,
      loop: true,
      autoplayVideos: true
    });

    // Specific logic for /media/gallery or /media/ pages
    if (window.location.pathname.startsWith('/media/gallery') || window.location.pathname.startsWith('/media/')) {
      document.addEventListener('DOMContentLoaded', () => {
        const galleryImages = document.querySelectorAll('img.gallery-image');
        let galleryHasItems = false;

        galleryImages.forEach(img => {
          const imgSrc = img.src;
          if (!imgSrc) return;

          // Prevent double-wrapping if script runs multiple times or if already wrapped
          if (img.parentElement && img.parentElement.classList.contains('glightbox')) {
            return;
          }

          const href = imgSrc; // For GLightbox, href is the full media path
          const isImage = /\.(jpe?g|png|gif|webp)$/i.test(href);
          // Assuming videos would not be in an <img> tag with class 'gallery-image' in this context,
          // but check just in case the src points to a video file somehow.
          const isVideo = /\.(mp4|webm|ogg)$/i.test(href);

          if (isImage || isVideo) {
            const anchor = document.createElement('a');
            anchor.href = href;
            anchor.classList.add('glightbox');
            anchor.setAttribute('data-gallery', 'media-page-gallery');
            
            let title = img.alt || decodeURIComponent(href.substring(href.lastIndexOf('/') + 1));
            anchor.setAttribute('data-title', title);

            if (isVideo) {
              anchor.setAttribute('data-type', 'video');
            }

            // Wrap the image with the anchor
            if (img.parentNode) {
              img.parentNode.insertBefore(anchor, img);
              anchor.appendChild(img);
              galleryHasItems = true;
            }
          }
        });

        if (galleryHasItems) {
          // console.log('GLightbox setup for .gallery-image elements complete.');
          // If GLightbox instance `lightbox` is available and has a reload method:
          if (typeof lightbox !== 'undefined' && lightbox.reload) {
            lightbox.reload();
          }
        }
      });
    }
  </script>

  <!-- Main JavaScript -->
  <script src="/js/main.js"></script>
</body>
</html>
