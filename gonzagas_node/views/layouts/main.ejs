<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | <%= siteTitle %></title>
  
  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico">
  
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
  
  <!-- Theme CSS -->
  <link rel="stylesheet" href="/css/theme.css">
  <!-- Main CSS -->
  <link rel="stylesheet" href="/css/main.css">
  <!-- Catalog CSS -->
  <!-- GLightbox CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" />
  <link rel="stylesheet" href="/css/catalog.css">
  
  <style>
    :root {
      --color-primary: <%= theme.colorPrimary || '#1a1a1a' %>;
      --color-secondary: <%= theme.colorSecondary || '#2d2d2d' %>;
      --color-accent: <%= theme.colorAccent || '#c0a080' %>;
      --color-text: <%= theme.colorText || '#ffffff' %>;
      --color-highlight: <%= theme.colorHighlight || '#d4b190' %>;
    }
  </style>
</head>
<body>
  <%- include('../partials/header') %>
  
  <!-- Flash Messages -->
  <% if(typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
    <div class="alert alert-success">
      <%= success_msg %>
    </div>
  <% } %>
  
  <% if(typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
    <div class="alert alert-danger">
      <%= error_msg %>
    </div>
  <% } %>
  
  <!-- Main Content -->
  <%- body %>
  
  <%- include('../partials/footer') %>
  
  <!-- GLightbox JS -->
  <script src="https://cdn.jsdelivr.net/gh/mcstudios/glightbox/dist/js/glightbox.min.js"></script>
  <script type="text/javascript">
    const lightbox = GLightbox({
      touchNavigation: true,
      loop: true,
      autoplayVideos: true
    });

    // Specific logic for /media/gallery or /media/ pages
    if (window.location.pathname.startsWith('/media/gallery') || window.location.pathname.startsWith('/media/')) {
      document.addEventListener('DOMContentLoaded', () => {
        const mediaLinks = document.querySelectorAll('a[href*="/media/"]');
        let galleryHasItems = false;

        mediaLinks.forEach(link => {
          const href = link.getAttribute('href');
          // Check if the link itself is an image/video, not just contains /media/
          const isDirectMediaLink = /^\/media\/gallery\/[^\/]+\.(jpe?g|png|gif|webp|mp4|webm|ogg)$/i.test(href);

          if (isDirectMediaLink) {
            const isImage = /\.(jpe?g|png|gif|webp)$/i.test(href);
            const isVideo = /\.(mp4|webm|ogg)$/i.test(href);

            if (isImage || isVideo) {
              link.classList.add('glightbox');
              link.setAttribute('data-gallery', 'media-page-gallery');
              galleryHasItems = true;
              if (isVideo) {
                link.setAttribute('data-type', 'video');
              }
              const filename = href.substring(href.lastIndexOf('/') + 1);
              link.setAttribute('data-title', decodeURIComponent(filename));
            }
          }
        });
        
        // If items were added to a gallery, GLightbox should pick them up.
        // If GLightbox was initialized with a specific selector that didn't exist yet,
        // you might need to re-initialize or call lightbox.reload() if available.
        // However, with the default class selector, it should work.
        if (galleryHasItems) {
            // console.log('GLightbox should process new items for media gallery page');
        }
      });
    }
  </script>

  <!-- Main JavaScript -->
  <script src="/js/main.js"></script>
</body>
</html>
