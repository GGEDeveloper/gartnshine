<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | <%= siteTitle %></title>
  
  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico">
  
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- Google Fonts - Enhanced for Visual Refresh 2025 -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Poppins:wght@300;400;500;600;700&family=Comfortaa:wght@300;400;500&display=swap" rel="stylesheet">
  
  <!-- Visual Refresh 2025 - Theme System -->
  <link rel="stylesheet" href="/css/themes/theme-system.css">
  
  <!-- Visual Refresh 2025 - Components -->
  <link rel="stylesheet" href="/css/components/buttons.css">
  <link rel="stylesheet" href="/css/components/cards.css">
  
  <!-- Visual Refresh 2025 - Responsive Utilities -->
  <link rel="stylesheet" href="/css/utilities/responsive.css">
  
  <!-- Legacy CSS (transitional) -->
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/catalog.css">
  
  <!-- External Libraries -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" />
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"/>
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css"/>
  
  <style>
    /* Legacy theme variables for backward compatibility */
    :root {
      --color-primary: <%= theme.colorPrimary || '#1a1a1a' %>;
      --color-secondary: <%= theme.colorSecondary || '#2d2d2d' %>;
      --color-accent: <%= theme.colorAccent || '#c0a080' %>;
      --color-text: <%= theme.colorText || '#ffffff' %>;
      --color-highlight: <%= theme.colorHighlight || '#d4b190' %>;
    }
    
    /* Enhanced body styling for theme transitions */
    body {
      background: var(--color-surface-primary, var(--color-primary));
      color: var(--color-text-primary, var(--color-text));
      transition: background-color 0.3s ease, color 0.3s ease;
    }
    
    /* Theme transition class for smooth changes */
    .theme-transition * {
      transition: background-color 0.3s ease, 
                 color 0.3s ease, 
                 border-color 0.3s ease,
                 box-shadow 0.3s ease !important;
    }
    
    /* Hide the description container in GLightbox */
    .glightbox-container .gslide-description {
      display: none !important;
    }
  </style>
</head>
<body>
  <%- include('../partials/header') %>
  
  <!-- Flash Messages -->
  <% if(typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
    <div class="alert alert-success">
      <%= success_msg %>
    </div>
  <% } %>
  
  <% if(typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
    <div class="alert alert-danger">
      <%= error_msg %>
    </div>
  <% } %>
  
  <!-- Main Content -->
  <%- body %>
  
  <%- include('../partials/footer') %>
  
  <!-- GLightbox JS -->
  <script src="https://cdn.jsdelivr.net/gh/mcstudios/glightbox/dist/js/glightbox.min.js"></script>
  <script type="text/javascript">
    // Inicializa o GLightbox
    const lightbox = GLightbox({
      selector: '.glightbox',
      touchNavigation: true,
      keyboardNavigation: true,
      closeButton: true,
      loop: true,
      autoplayVideos: true
    });
    
    // Debug
    console.log('GLightbox initialized');
    
    // Script para modificar o DOM e adicionar o GLightbox às imagens
    document.addEventListener('DOMContentLoaded', function() {
      console.log('DOM fully loaded');
      
      const galleryImages = document.querySelectorAll('img.gallery-image');
      console.log('Found', galleryImages.length, 'gallery images');
      
      galleryImages.forEach(img => {
        // Se já estiver dentro de um link GLightbox, pule
        if (img.closest('a.glightbox')) {
          console.log('Image already has GLightbox parent, skipping:', img.src);
          return;
        }
        
        const wrapper = document.createElement('a');
        wrapper.href = img.src;
        wrapper.className = 'glightbox';
        wrapper.setAttribute('data-gallery', 'gallery1');
        
        // Adiciona título se disponível
        if (img.alt) {
          wrapper.setAttribute('data-title', img.alt);
        }
        
        // Envolve a imagem com o link
        img.parentNode.insertBefore(wrapper, img);
        wrapper.appendChild(img);
        
        console.log('Wrapped image with GLightbox link:', img.src);
      });
      
      // Recarrega o GLightbox para pegar os novos elementos
      if (galleryImages.length > 0) {
        console.log('Reloading GLightbox with new elements');
        lightbox.reload();
      }
    });

    // Specific logic for /media/gallery or /media/ pages
    if (window.location.pathname.startsWith('/media/gallery') || window.location.pathname.startsWith('/media/')) {
      document.addEventListener('DOMContentLoaded', () => {
        const galleryImages = document.querySelectorAll('img.gallery-image');
        let galleryHasItems = false;

        galleryImages.forEach(img => {
          const imgSrc = img.src;
          if (!imgSrc) return;

          // Prevent double-wrapping if script runs multiple times or if already wrapped
          if (img.parentElement && img.parentElement.classList.contains('glightbox')) {
            return;
          }

          const href = imgSrc; // For GLightbox, href is the full media path
          const isImage = /\.(jpe?g|png|gif|webp)$/i.test(href);
          // Assuming videos would not be in an <img> tag with class 'gallery-image' in this context,
          // but check just in case the src points to a video file somehow.
          const isVideo = /\.(mp4|webm|ogg)$/i.test(href);

          if (isImage || isVideo) {
            const anchor = document.createElement('a');
            anchor.href = href;
            anchor.classList.add('glightbox');
            anchor.setAttribute('data-gallery', 'media-page-gallery');
            
            let title = img.alt || decodeURIComponent(href.substring(href.lastIndexOf('/') + 1));
            anchor.setAttribute('data-title', title);

            if (isVideo) {
              anchor.setAttribute('data-type', 'video');
            }

            // Wrap the image with the anchor
            if (img.parentNode) {
              img.parentNode.insertBefore(anchor, img);
              anchor.appendChild(img);
              galleryHasItems = true;
            }
          }
        });

        if (galleryHasItems) {
          console.log('GLightbox setup for .gallery-image elements complete.');
          // If GLightbox instance `lightbox` is available and has a reload method:
          if (typeof lightbox !== 'undefined' && lightbox.reload) {
            lightbox.reload();
          }
        }
      });
    }
  </script>

  <!-- jQuery -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script>
    // Evitar conflitos com outras bibliotecas que usam o símbolo $
    var $j = jQuery.noConflict();
    // Tornar o jQuery disponível globalmente para outros scripts
    window.jQuery = window.$ = $j;
  </script>
  <!-- Slick Carousel JS -->
  <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
  <script>
    // Garantir que o Slick esteja disponível com o jQuery correto
    if (typeof $j.fn.slick === 'undefined') {
      console.error('Slick Carousel não foi carregado corretamente!');
    }
  </script>
  <!-- Main JavaScript -->
  <script src="/js/main.js"></script>
  
  <!-- Visual Refresh 2025 - Theme Controller -->
  <script src="/js/theme-controller.js"></script>
  
  <!-- BOOM Festival Integration -->
  <script src="/js/boom-festival-integration.js"></script>
  
  <!-- Performance Optimizer -->
  <script src="/js/performance-optimizer.js"></script>
  
  <!-- Theme Integration Script -->
  <script>
    // Enhanced theme integration for Visual Refresh 2025
    document.addEventListener('DOMContentLoaded', function() {
      // Initialize theme system
      if (window.themeController) {
        // Subscribe to theme changes for enhanced integration
        window.themeController.onThemeChange(function(theme) {
          console.log('🎨 Tema alterado para:', theme);
          
          // Update page title with theme indicator
          const titleElement = document.querySelector('title');
          if (titleElement) {
            const baseTitle = titleElement.textContent.replace(/ \(.*\)$/, '');
            const themeNames = {
              dark: 'Terra Noturna',
              light: 'Terra Diurna',
              boom: 'BOOM Festival'
            };
            titleElement.textContent = `${baseTitle} (${themeNames[theme] || theme})`;
          }
        });
        
        // Auto-activate BOOM theme during festival period
        const now = new Date();
        const boomStart = new Date('2025-07-17');
        const boomEnd = new Date('2025-07-24');
        
        if (now >= boomStart && now <= boomEnd) {
          window.themeController.activateBoomMode();
        }
      }
    });
  </script>
</body>
</html>
