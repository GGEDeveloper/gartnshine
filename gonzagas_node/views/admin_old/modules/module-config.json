{
  "modules": {
    "products": {
      "name": "Produtos",
      "icon": "box",
      "routes": [
        { "path": "", "component": "list" },
        { "path": "new", "component": "form" },
        { "path": ":id", "component": "view" },
        { "path": ":id/edit", "component": "form" }
      ],
      "permissions": ["view_products", "manage_products"]
    },
    "customers": {
      "name": "Clientes",
      "icon": "users",
      "routes": [
        { "path": "", "component": "list" },
        { "path": "new", "component": "form" },
        { "path": ":id", "component": "view" },
        { "path": ":id/edit", "component": "form" }
      ],
      "permissions": ["view_customers", "manage_customers"]
    },
    "orders": {
      "name": "Pedidos",
      "icon": "shopping-cart",
      "routes": [
        { "path": "", "component": "list" },
        { "path": ":id", "component": "view" },
        { "path": ":id/invoice", "component": "invoice" }
      ],
      "permissions": ["view_orders", "manage_orders"]
    },
    "reports": {
      "name": "Relatórios",
      "icon": "chart-bar",
      "routes": [
        { "path": "", "component": "dashboard" },
        { "path": "sales", "component": "sales" },
        { "path": "products", "component": "products" },
        { "path": "customers", "component": "customers" }
      ],
      "permissions": ["view_reports"]
    },
    "settings": {
      "name": "Configurações",
      "icon": "cog",
      "routes": [
        { "path": "", "component": "general" },
        { "path": "email", "component": "email" },
        { "path": "payment", "component": "payment" },
        { "path": "shipping", "component": "shipping" },
        { "path": "seo", "component": "seo" },
        { "path": "social", "component": "social" },
        { "path": "security", "component": "security" },
        { "path": "backup", "component": "backup" },
        { "path": "maintenance", "component": "maintenance" }
      ],
      "permissions": ["manage_settings"]
    },
    "users": {
      "name": "Usuários",
      "icon": "user",
      "routes": [
        { "path": "", "component": "list" },
        { "path": "new", "component": "form" },
        { "path": ":id", "component": "view" },
        { "path": ":id/edit", "component": "form" },
        { "path": "roles", "component": "roles" },
        { "path": "permissions", "component": "permissions" }
      ],
      "permissions": ["manage_users", "manage_roles"]
    }
  },
  "components": {
    "form": {
      "fields": {
        "text": "components/form-fields/text",
        "email": "components/form-fields/email",
        "password": "components/form-fields/password",
        "number": "components/form-fields/number",
        "select": "components/form-fields/select",
        "textarea": "components/form-fields/textarea",
        "checkbox": "components/form-fields/checkbox",
        "radio": "components/form-fields/radio",
        "file": "components/form-fields/file",
        "date": "components/form-fields/date",
        "time": "components/form-fields/time",
        "datetime": "components/form-fields/datetime",
        "color": "components/form-fields/color",
        "editor": "components/form-fields/editor"
      },
      "templates": {
        "default": "components/form-templates/default",
        "inline": "components/form-templates/inline",
        "horizontal": "components/form-templates/horizontal"
      }
    },
    "table": {
      "columns": {
        "text": "components/table-columns/text",
        "number": "components/table-columns/number",
        "date": "components/table-columns/date",
        "status": "components/table-columns/status",
        "actions": "components/table-columns/actions",
        "image": "components/table-columns/image"
      },
      "templates": {
        "default": "components/table-templates/default",
        "striped": "components/table-templates/striped",
        "bordered": "components/table-templates/bordered",
        "hover": "components/table-templates/hover"
      }
    },
    "card": {
      "templates": {
        "default": "components/card-templates/default",
        "primary": "components/card-templates/primary",
        "success": "components/card-templates/success",
        "info": "components/card-templates/info",
        "warning": "components/card-templates/warning",
        "danger": "components/card-templates/danger"
      }
    }
  },
  "routes": [
    {
      "path": "/admin",
      "component": "dashboard",
      "permissions": ["view_dashboard"]
    },
    {
      "path": "/admin/profile",
      "component": "profile",
      "permissions": ["view_profile"]
    },
    {
      "path": "/admin/settings",
      "redirect": "/admin/settings/general"
    }
  ]
}
