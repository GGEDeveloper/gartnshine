<div class="table-responsive">
  <table class="table table-hover table-striped table-bordered" id="ordersTable">
    <thead class="bg-light">
      <tr>
        <th>ID</th>
        <th>Cliente</th>
        <th>Data</th>
        <th>Total</th>
        <th>Status</th>
        <th class="text-center">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% if (typeof orders !== 'undefined' && orders.length > 0) { %>
        <% orders.forEach(order => { %>
          <tr data-order-id="<%= order.id %>">
            <td>#<%= order.id %></td>
            <td><%= order.customerName %></td>
            <td><%= new Date(order.date).toLocaleDateString('pt-BR') %></td>
            <td><%= order.total.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></td>
            <td class="order-status">
              <span class="badge <%= order.status === 'Pago' ? 'bg-success' : 'bg-warning' %>">
                <%= order.status %>
              </span>
            </td>
            <td class="text-nowrap text-center">
              <button class="btn btn-sm btn-info btn-view-order" data-order-id="<%= order.id %>" title="Visualizar">
                <i class="fas fa-eye"></i>
              </button>
              <a href="/admin/orders/<%= order.id %>/edit" class="btn btn-sm btn-primary" title="Editar">
                <i class="fas fa-edit"></i>
              </a>
              <button class="btn btn-sm btn-warning btn-update-status" data-order-id="<%= order.id %>" title="Atualizar Status">
                <i class="fas fa-sync-alt"></i>
              </button>
              <button class="btn btn-sm btn-danger btn-delete-order" data-order-id="<%= order.id %>" title="Excluir">
                <i class="fas fa-trash"></i>
              </button>
            </td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr>
          <td colspan="6" class="text-center">Nenhum pedido encontrado</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<% if (typeof pagination !== 'undefined') { %>
  <div class="row mt-4">
    <div class="col-md-5 d-flex align-items-center">
      <div class="dataTables_info" id="ordersTable_info" role="status" aria-live="polite">
        Mostrando <%= pagination.startItem %> a <%= pagination.endItem %> de <%= pagination.totalItems %> registros
      </div>
    </div>
    <div class="col-md-7">
      <div class="dataTables_paginate paging_simple_numbers" id="ordersTable_paginate">
        <ul class="pagination justify-content-end mb-0">
          <li class="paginate_button page-item <%= pagination.currentPage === 1 ? 'disabled' : '' %>" id="ordersTable_previous">
            <a href="?page=<%= pagination.currentPage - 1 %>" aria-controls="ordersTable" data-dt-idx="0" tabindex="0" class="page-link">Anterior</a>
          </li>
          
          <% for (let i = 1; i <= pagination.totalPages; i++) { %>
            <li class="paginate_button page-item <%= i === pagination.currentPage ? 'active' : '' %>">
              <a href="?page=<%= i %>" aria-controls="ordersTable" data-dt-idx="<%= i %>" class="page-link"><%= i %></a>
            </li>
          <% } %>
          
          <li class="paginate_button page-item <%= pagination.currentPage === pagination.totalPages ? 'disabled' : '' %>" id="ordersTable_next">
            <a href="?page=<%= pagination.currentPage + 1 %>" aria-controls="ordersTable" data-dt-idx="<%= pagination.totalPages + 1 %>" class="page-link">Próximo</a>
          </li>
        </ul>
      </div>
    </div>
  </div>
<% } %>
