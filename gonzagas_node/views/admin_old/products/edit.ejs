<%- include('../../layouts/admin-layout', { 
  title: 'Editar Produto',
  currentPath: `/admin/products/${product.id}/edit`,
  customCss: 'admin-product-form',
  customJs: 'admin-product-form',
  scripts: [
    '/adminlte/plugins/bs-custom-file-input/bs-custom-file-input.min.js',
    '/adminlte/plugins/summernote/summernote-bs4.min.js',
    '/adminlte/plugins/inputmask/jquery.inputmask.min.js'
  ],
  body: `
    <div class="alerts-container"></div>
    
    <div class="container-fluid">
      <div class="row mb-4">
        <div class="col-12">
          <div class="page-header">
            <div class="d-flex justify-content-between align-items-center">
              <h1 class="page-title">Editar Produto</h1>
              <div>
                <a href="/admin/products" class="btn btn-default">
                  <i class="fas fa-arrow-left mr-1"></i> Voltar
                </a>
                <a href="/admin/products/<%= product.id %>" class="btn btn-info">
                  <i class="fas fa-eye mr-1"></i> Visualizar
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <%- include('_form', { product: product }) %>
    </div>
  `
}) %>
