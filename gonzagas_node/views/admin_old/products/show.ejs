<%- include('../../layouts/admin-layout', { 
  title: product.name,
  currentPath: `/admin/products/${product.id}`,
  customCss: 'admin-product-detail',
  body: `
    <div class="container-fluid">
      <div class="row mb-4">
        <div class="col-12">
          <div class="page-header">
            <div class="d-flex justify-content-between align-items-center">
              <h1 class="page-title">Detalhes do Produto</h1>
              <div>
                <a href="/admin/products" class="btn btn-default">
                  <i class="fas fa-arrow-left mr-1"></i> Voltar
                </a>
                <a href="/admin/products/<%= product.id %>/edit" class="btn btn-primary">
                  <i class="fas fa-edit mr-1"></i> Editar
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-5">
          <div class="card">
            <div class="card-body text-center">
              <% if (product.image) { %>
                <img src="<%= product.image %>" alt="<%= product.name %>" class="img-fluid" style="max-height: 400px;">
              <% } else { %>
                <div class="bg-light d-flex align-items-center justify-content-center" style="height: 300px;">
                  <i class="fas fa-box-open fa-5x text-muted"></i>
                </div>
              <% } %>
              <% if (product.featured) { %>
                <div class="mt-2">
                  <span class="badge badge-warning"><i class="fas fa-star mr-1"></i> Destaque</span>
                </div>
              <% } %>
            </div>
          </div>
        </div>
        
        <div class="col-md-7">
          <div class="card">
            <div class="card-body">
              <h2><%= product.name %></h2>
              
              <div class="mb-4">
                <span class="text-muted">Código: #<%= product.id %></span>
              </div>
              
              <div class="mb-4">
                <h3 class="text-primary"><%= product.price.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></h3>
              </div>
              
              <div class="mb-4">
                <h5>Status</h5>
                <span class="badge <%= product.status === 'Ativo' ? 'bg-success' : (product.status === 'Esgotado' ? 'bg-danger' : 'bg-secondary') %>">
                  <%= product.status %>
                </span>
              </div>
              
              <div class="mb-4">
                <h5>stock</h5>
                <p><%= product.stock %> unidades disponíveis</p>
                <% if (product.stock <= 10) { %>
                  <div class="alert alert-warning p-2">
                    <i class="fas fa-exclamation-triangle mr-1"></i> stock baixo
                  </div>
                <% } %>
              </div>
              
              <div class="mb-4">
                <h5>Categoria</h5>
                <p><%= product.category %></p>
              </div>
              
              <div class="mb-4">
                <h5>Descrição</h5>
                <p><%= product.description || 'Nenhuma descrição fornecida.' %></p>
              </div>
              
              <div class="mb-4">
                <h5>Data de Cadastro</h5>
                <p><%= new Date(product.createdAt).toLocaleString('pt-BR') %></p>
              </div>
              
              <div class="mb-4">
                <h5>Última Atualização</h5>
                <p><%= new Date(product.updatedAt).toLocaleString('pt-BR') %></p>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Histórico de Preços -->
      <div class="row">
        <div class="col-12">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">Histórico de Preços</h3>
            </div>
            <div class="card-body">
              <div class="table-responsive">
                <table class="table table-bordered">
                  <thead>
                    <tr>
                      <th>Data</th>
                      <th>Preço Anterior</th>
                      <th>Novo Preço</th>
                      <th>Variação</th>
                      <th>Responsável</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (product.priceHistory && product.priceHistory.length > 0) { %>
                      <% product.priceHistory.forEach(history => { %>
                        <tr>
                          <td><%= new Date(history.date).toLocaleString('pt-BR') %></td>
                          <td><%= history.oldPrice.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></td>
                          <td><%= history.newPrice.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></td>
                          <td class="<%= history.newPrice > history.oldPrice ? 'text-danger' : 'text-success' %>">
                            <% const variation = ((history.newPrice - history.oldPrice) / history.oldPrice * 100).toFixed(2); %>
                            <%= variation > 0 ? '+' + variation + '%' : variation + '%' %>
                          </td>
                          <td><%= history.changedBy || 'Sistema' %></td>
                        </tr>
                      <% }); %>
                    <% } else { %>
                      <tr>
                        <td colspan="5" class="text-center">Nenhum histórico de preços disponível</td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  `
}) %>
