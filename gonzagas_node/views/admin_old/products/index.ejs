<%- include('../layouts/admin-main', {
  title: 'Gerenciar Produtos',
  breadcrumb: [
    { title: 'Dashboard', url: '/admin/dashboard' },
    { title: 'Produtos', active: true }
  ],
  scripts: [
    '/adminlte/plugins/datatables/jquery.dataTables.min.js',
    '/adminlte/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js',
    '/adminlte/plugins/datatables-responsive/js/dataTables.responsive.min.js',
    '/adminlte/plugins/datatables-responsive/js/responsive.bootstrap4.min.js',
    '/js/admin-products.js'
  ]
}) %>

<!-- Main content -->
<div class="content-wrapper">
  <div class="container-fluid">
    <!-- Mensagens de alerta -->
    <div class="alerts-container">
      <%- include('../partials/flash-messages') %>
    </div>

    <!-- Card principal -->
    <div class="card card-primary card-outline">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fas fa-boxes mr-2"></i>
          Lista de Produtos
        </h3>
        <div class="card-tools">
          <a href="/admin/products/new" class="btn btn-primary btn-sm">
            <i class="fas fa-plus"></i> Novo Produto
          </a>
        </div>
      </div>
      <!-- /.card-header -->
      <div class="card-body">
        <div class="table-responsive">
          <table id="productsTable" class="table table-bordered table-striped table-hover">
            <thead>
              <tr>
                <th>ID</th>
                <th>Imagem</th>
                <th>Nome</th>
                <th>Família</th>
                <th>Referência</th>
                <th>Preço</th>
                <th>stock</th>
                <th>Status</th>
                <th class="text-center">Ações</th>
              </tr>
            </thead>
            <tbody>
              <% if (products && products.length > 0) { %>
                <% products.forEach(product => { %>
                  <tr>
                    <td><%= product.id %></td>
                    <td class="text-center" style="width: 100px;">
                      <div style="width: 60px; height: 60px; margin: 0 auto; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                        <img 
                          src="<%= product.image_url || '/img/default-product.jpg' %>" 
                          alt="<%= product.name || 'Produto sem nome' %>" 
                          class="img-fluid img-thumbnail" 
                          style="max-width: 100%; max-height: 100%; object-fit: contain; cursor: pointer"
                          data-product-name="<%= product.name || 'Produto sem nome' %>"
                          onclick="showImageModal(this, this.getAttribute('data-product-name'))"
                          onerror="this.onerror=null; this.src='/img/default-product.jpg'"
                          data-product-id="<%= product.id %>" />
                      </div>
                    </td>
                    <td><%= product.name %></td>
                    <td><%= product.family_name || 'Sem família' %></td>
                    <td><%= product.reference %></td>
                    <td class="text-nowrap">
                      <% if (product.discount_price && product.discount_price > 0) { %>
                        <span class="text-muted text-decoration-line-through mr-1"><%= formatCurrency(product.price) %></span>
                        <span class="text-danger font-weight-bold"><%= formatCurrency(product.discount_price) %></span>
                      <% } else { %>
                        <span><%= formatCurrency(product.price) %></span>
                      <% } %>
                    </td>
                    <td class="text-center">
                      <span class="badge <%= product.quantity > 0 ? 'bg-success' : 'bg-danger' %>">
                        <%= product.quantity %>
                      </span>
                    </td>
                    <td class="text-center">
                      <span class="badge <%= product.status === 'active' ? 'bg-success' : 'bg-secondary' %>">
                        <%= product.status === 'active' ? 'Ativo' : 'Inativo' %>
                      </span>
                    </td>
                    <td class="text-center text-nowrap">
                      <a href="/admin/products/<%= product.id %>/edit" class="btn btn-sm btn-primary mr-1" title="Editar">
                        <i class="fas fa-edit"></i>
                      </a>
                      <button type="button" 
                              class="btn btn-sm btn-danger delete-product" 
                              title="Excluir"
                              data-id="<%= product.id %>">
                        <i class="fas fa-trash"></i>
                      </button>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="9" class="text-center">Nenhum produto encontrado</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="card-footer">
        <div class="d-flex justify-content-between align-items-center">
          <div class="text-muted">
            <i class="fas fa-info-circle mr-1"></i> 
            Mostrando <%= pagination.startItem || 0 %> a <%= pagination.endItem || 0 %> de <%= pagination.totalItems || 0 %> produtos
          </div>
          <% if (pagination.totalPages > 1) { %>
            <nav>
              <ul class="pagination pagination-sm m-0">
                <% if (pagination.currentPage > 1) { %>
                  <li class="page-item">
                    <a class="page-link" href="?page=<%= pagination.currentPage - 1 %>">&laquo;</a>
                  </li>
                <% } %>
                
                <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                  <li class="page-item <%= i === pagination.currentPage ? 'active' : '' %>">
                    <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                  </li>
                <% } %>
                
                <% if (pagination.currentPage < pagination.totalPages) { %>
                  <li class="page-item">
                    <a class="page-link" href="?page=<%= pagination.currentPage + 1 %>">&raquo;</a>
                  </li>
                <% } %>
              </ul>
            </nav>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal de Visualização de Imagem -->
<div class="modal fade" id="imagePreviewModal" tabindex="-1" role="dialog" aria-labelledby="imagePreviewModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="imagePreviewModalLabel">Visualizar Imagem</h5>
        <button type="button" class="close text-white" data-dismiss="modal" aria-label="Fechar">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body text-center p-0">
        <img id="modalImagePreview" src="" alt="" class="img-fluid" style="max-height: 80vh; width: auto;">
      </div>
      <div class="modal-footer">
        <a id="downloadImage" href="#" class="btn btn-outline-primary" download>
          <i class="fas fa-download mr-1"></i> Baixar Imagem
        </a>
        <button type="button" class="btn btn-secondary" data-dismiss="modal">
          <i class="fas fa-times mr-1"></i> Fechar
        </button>
      </div>
    </div>
  </div>
</div>

<script>
// Função para exibir a imagem em um modal
function showImageModal(imgElement, title) {
  const modal = new bootstrap.Modal(document.getElementById('imagePreviewModal'));
  const modalImage = document.getElementById('modalImagePreview');
  const modalTitle = document.getElementById('imagePreviewModalLabel');
  const downloadLink = document.getElementById('downloadImage');
  
  // Configura a imagem no modal
  modalImage.src = imgElement.src;
  modalImage.alt = title;
  modalTitle.textContent = title || 'Visualização da Imagem';
  
  // Configura o link de download
  downloadLink.href = imgElement.src;
  downloadLink.download = title ? `${title.replace(/[^a-z0-9]/gi, '_').toLowerCase()}.jpg` : 'produto.jpg';
  
  // Exibe o modal
  modal.show();
}

// Inicialização do DataTable
$(document).ready(function() {
  // Verifica se a tabela existe na página
  if ($.fn.DataTable.isDataTable('#productsTable')) {
    $('#productsTable').DataTable().destroy();
  }
  
  // Inicializa o DataTable com configurações personalizadas
  const dataTable = $('#productsTable').DataTable({
    responsive: true,
    autoWidth: false,
    language: {
      url: '//cdn.datatables.net/plug-ins/1.10.25/i18n/Portuguese-Brasil.json',
      search: 'Pesquisar:',
      lengthMenu: 'Mostrar _MENU_ itens por página',
      info: 'Mostrando _START_ a _END_ de _TOTAL_ itens',
      infoEmpty: 'Nenhum item encontrado',
      infoFiltered: '(filtrado de _MAX_ itens totais)',
      paginate: {
        first: 'Primeira',
        last: 'Última',
        next: 'Próxima',
        previous: 'Anterior'
      }
    },
    order: [[0, 'desc']],
    pageLength: 25,
    dom: "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
         "<'row'<'col-sm-12'tr>>" +
         "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
    columnDefs: [
      { orderable: false, targets: [1, 8] },
      { width: '100px', targets: 1 },
      { className: 'text-center', targets: [6, 7, 8] },
      { className: 'text-nowrap', targets: [0, 4, 5] }
    ]
  });

  // Confirmação antes de excluir um produto
  $(document).on('click', '.delete-product', function(e) {
    e.preventDefault();
    const productId = $(this).data('id');
    const productName = $(this).closest('tr').find('td:eq(2)').text().trim();
    
    if (confirm(`Tem certeza que deseja excluir o produto "${productName}"?\n\nEsta ação não pode ser desfeita!`)) {
      // Aqui você pode adicionar a chamada AJAX para excluir o produto
      console.log('Excluindo produto ID:', productId);
      // Exemplo de chamada AJAX (descomente e ajuste conforme necessário):
      /*
      $.ajax({
        url: '/admin/products/' + productId,
        type: 'DELETE',
        success: function(response) {
          // Recarregar a página ou remover a linha da tabela
          dataTable.row($(this).parents('tr')).remove().draw();
          alert('Produto excluído com sucesso!');
        },
        error: function(xhr) {
          alert('Erro ao excluir o produto: ' + (xhr.responseJSON?.message || 'Erro desconhecido'));
        }
      });
      */
    }
  });
});
</script>
