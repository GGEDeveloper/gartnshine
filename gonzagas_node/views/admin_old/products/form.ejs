<%- include('../../layouts/admin-layout', { 
  title: typeof product.id !== 'undefined' ? 'Editar Produto' : 'Novo Produto',
  currentPath: '/admin/products',
  customCss: 'admin-product-form',
  customJs: 'admin-product-form',
  body: `
    <div class="alerts-container"></div>
    
    <div class="container-fluid">
      <div class="row">
        <div class="col-12">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">
                <%= typeof product.id !== 'undefined' ? 'Editar Produto' : 'Adicionar Novo Produto' %>
              </h3>
              <div class="card-tools">
                <a href="/admin/products" class="btn btn-sm btn-outline-secondary">
                  <i class="fas fa-arrow-left"></i> Voltar
                </a>
              </div>
            </div>
            <form id="productForm" action="<%= formAction || '/admin/products' %>" method="POST" enctype="multipart/form-data">
              <% if (typeof product.id !== 'undefined') { %>
                <input type="hidden" name="_method" value="PUT">
              <% } %>
              
              <div class="card-body">
                <div class="row">
                  <div class="col-md-8">
                    <div class="form-group">
                      <label for="name">Nome do Produto <span class="text-danger">*</span></label>
                      <input type="text" class="form-control" id="name" name="name" 
                             value="<%= product.name || '' %>" required>
                    </div>
                    
                    <div class="form-group">
                      <label for="description">Descrição</label>
                      <textarea class="form-control summernote" id="description" name="description" 
                                rows="3"><%= product.description || '' %></textarea>
                    </div>
                    
                    <div class="row">
                      <div class="col-md-6">
                        <div class="form-group">
                          <label for="sku">SKU</label>
                          <input type="text" class="form-control" id="sku" name="sku" 
                                 value="<%= product.sku || '' %>">
                        </div>
                      </div>
                      <div class="col-md-6">
                        <div class="form-group">
                          <label for="barcode">Código de Barras</label>
                          <input type="text" class="form-control" id="barcode" name="barcode" 
                                 value="<%= product.barcode || '' %>">
                        </div>
                      </div>
                    </div>
                  </div>
                  
                  <div class="col-md-4">
                    <div class="card">
                      <div class="card-header">
                        <h3 class="card-title">Publicação</h3>
                      </div>
                      <div class="card-body">
                        <div class="form-group">
                          <label for="status">Status</label>
                          <select class="form-control" id="status" name="status">
                            <option value="draft" <%= product.status === 'draft' ? 'selected' : '' %>>Rascunho</option>
                            <option value="published" <%= !product.status || product.status === 'published' ? 'selected' : '' %>>Publicado</option>
                            <option value="archived" <%= product.status === 'archived' ? 'selected' : '' %>>Arquivado</option>
                          </select>
                        </div>
                        
                        <div class="form-group">
                          <label for="publishedAt">Data de Publicação</label>
                          <input type="datetime-local" class="form-control" id="publishedAt" name="publishedAt" 
                                 value="<%= product.publishedAt ? new Date(product.publishedAt).toISOString().slice(0, 16) : '' %>">
                        </div>
                        
                        <div class="form-check">
                          <input type="checkbox" class="form-check-input" id="featured" name="featured" 
                                 <%= product.featured ? 'checked' : '' %>>
                          <label class="form-check-label" for="featured">Destaque</label>
                        </div>
                      </div>
                      <div class="card-footer text-right">
                        <button type="submit" class="btn btn-primary">
                          <i class="fas fa-save"></i> Salvar
                        </button>
                        <a href="/admin/products" class="btn btn-default">Cancelar</a>
                      </div>
                    </div>
                    
                    <div class="card mt-3">
                      <div class="card-header">
                        <h3 class="card-title">Imagem do Produto</h3>
                      </div>
                      <div class="card-body text-center">
                        <div class="product-image-preview mb-3">
                          <img id="imagePreview" 
                               src="<%= product.imageUrl || '/img/default-product.png' %>" 
                               alt="Preview" 
                               class="img-fluid"
                               style="max-height: 200px; width: auto;">
                        </div>
                        <div class="form-group">
                          <div class="custom-file">
                            <input type="file" class="custom-file-input" id="image" name="image" accept="image/*">
                            <label class="custom-file-label" for="image">Escolher arquivo</label>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                
                <div class="row mt-4">
                  <div class="col-12">
                    <ul class="nav nav-tabs" id="productTabs" role="tablist">
                      <li class="nav-item">
                        <a class="nav-link active" id="pricing-tab" data-toggle="tab" href="#pricing" role="tab">
                          Preços
                        </a>
                      </li>
                      <li class="nav-item">
                        <a class="nav-link" id="inventory-tab" data-toggle="tab" href="#inventory" role="tab">
                          stock
                        </a>
                      </li>
                      <li class="nav-item">
                        <a class="nav-link" id="shipping-tab" data-toggle="tab" href="#shipping" role="tab">
                          Envio
                        </a>
                      </li>
                      <li class="nav-item">
                        <a class="nav-link" id="attributes-tab" data-toggle="tab" href="#attributes" role="tab">
                          Atributos
                        </a>
                      </li>
                    </ul>
                    
                    <div class="tab-content p-3 border border-top-0" id="productTabsContent">
                      <!-- Preços -->
                      <div class="tab-pane fade show active" id="pricing" role="tabpanel">
                        <div class="row">
                          <div class="col-md-4">
                            <div class="form-group">
                              <label for="price">Preço</label>
                              <div class="input-group">
                                <div class="input-group-prepend">
                                  <span class="input-group-text">R$</span>
                                </div>
                                <input type="number" class="form-control" id="price" name="price" 
                                       step="0.01" min="0" value="<%= product.price || '0.00' %>" required>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-4">
                            <div class="form-group">
                              <label for="compareAtPrice">Preço de Comparação</label>
                              <div class="input-group">
                                <div class="input-group-prepend">
                                  <span class="input-group-text">R$</span>
                                </div>
                                <input type="number" class="form-control" id="compareAtPrice" name="compareAtPrice" 
                                       step="0.01" min="0" value="<%= product.compareAtPrice || '' %>">
                              </div>
                              <small class="form-text text-muted">Mostre um preço original riscado ao lado do preço atual.</small>
                            </div>
                          </div>
                          <div class="col-md-4">
                            <div class="form-group">
                              <label for="costPerItem">Custo por item</label>
                              <div class="input-group">
                                <div class="input-group-prepend">
                                  <span class="input-group-text">R$</span>
                                </div>
                                <input type="number" class="form-control" id="costPerItem" name="costPerItem" 
                                       step="0.01" min="0" value="<%= product.costPerItem || '' %>">
                              </div>
                              <small class="form-text text-muted">Os clientes não verão isso.</small>
                            </div>
                          </div>
                        </div>
                        
                        <div class="form-check">
                          <input type="checkbox" class="form-check-input" id="chargeTax" name="chargeTax" 
                                 <%= product.chargeTax ? 'checked' : '' %>>
                          <label class="form-check-label" for="chargeTax">Cobrar impostos sobre este produto</label>
                        </div>
                      </div>
                      
                      <!-- stock -->
                      <div class="tab-pane fade" id="inventory" role="tabpanel">
                        <div class="row">
                          <div class="col-md-6">
                            <div class="form-group">
                              <label for="sku">SKU (Unidade de Manutenção de stock)</label>
                              <input type="text" class="form-control" id="inventorySku" name="inventorySku" 
                                     value="<%= product.sku || '' %>">
                            </div>
                            
                            <div class="form-group">
                              <label for="barcode">Código de Barras (ISBN, UPC, GTIN, etc.)</label>
                              <input type="text" class="form-control" id="inventoryBarcode" name="inventoryBarcode" 
                                     value="<%= product.barcode || '' %>">
                            </div>
                            
                            <div class="form-check">
                              <input type="checkbox" class="form-check-input" id="trackQuantity" name="trackQuantity" 
                                     <%= product.trackQuantity !== false ? 'checked' : '' %>>
                              <label class="form-check-label" for="trackQuantity">Acompanhar quantidade</label>
                            </div>
                          </div>
                          
                          <div class="col-md-6">
                            <div class="form-group">
                              <label for="quantity">Quantidade</label>
                              <input type="number" class="form-control" id="quantity" name="quantity" 
                                     min="0" value="<%= product.quantity || 0 %>">
                            </div>
                            
                            <div class="form-group">
                              <label for="lowStockAlert">Alerta de stock baixo</label>
                              <input type="number" class="form-control" id="lowStockAlert" name="lowStockAlert" 
                                     min="0" value="<%= product.lowStockAlert || 5 %>">
                            </div>
                          </div>
                        </div>
                      </div>
                      
                      <!-- Envio -->
                      <div class="tab-pane fade" id="shipping" role="tabpanel">
                        <div class="form-group">
                          <label for="weight">Peso</label>
                          <div class="input-group">
                            <input type="number" class="form-control" id="weight" name="weight" 
                                   step="0.01" min="0" value="<%= product.weight || '' %>">
                            <div class="input-group-append">
                              <span class="input-group-text">kg</span>
                            </div>
                          </div>
                        </div>
                        
                        <div class="form-check">
                          <input type="checkbox" class="form-check-input" id="requiresShipping" name="requiresShipping" 
                                 <%= product.requiresShipping !== false ? 'checked' : '' %>>
                          <label class="form-check-label" for="requiresShipping">Este produto requer envio</label>
                        </div>
                      </div>
                      
                      <!-- Atributos -->
                      <div class="tab-pane fade" id="attributes" role="tabpanel">
                        <div class="form-group">
                          <label for="category">Categoria</label>
                          <select class="form-control select2" id="category" name="category" multiple>
                            <% const categories = ['Eletrônicos', 'Roupas', 'Acessórios', 'Casa', 'Esporte', 'Brinquedos'];
                               const productCategories = product.categories ? product.categories.split(',') : [];
                               categories.forEach(category => { 
                            %>
                              <option value="<%= category %>" <%= productCategories.includes(category) ? 'selected' : '' %>>
                                <%= category %>
                              </option>
                            <% }); %>
                          </select>
                        </div>
                        
                        <div class="form-group">
                          <label for="tags">Tags</label>
                          <select class="form-control select2" id="tags" name="tags" multiple>
                            <% const allTags = ['promoção', 'novidade', 'esgotando', 'mais vendidos'];
                               const productTags = product.tags ? product.tags.split(',') : [];
                               allTags.forEach(tag => { 
                            %>
                              <option value="<%= tag %>" <%= productTags.includes(tag) ? 'selected' : '' %>>
                                <%= tag %>
                              </option>
                            <% }); %>
                          </select>
                        </div>
                        
                        <div class="form-group">
                          <label>Atributos personalizados</label>
                          <div id="customAttributes">
                            <% if (product.attributes && product.attributes.length > 0) { 
                                 product.attributes.forEach((attr, index) => { 
                            %>
                              <div class="row mb-2 attribute-row">
                                <div class="col-md-5">
                                  <input type="text" class="form-control" name="attributeNames[]" 
                                         placeholder="Nome do atributo" value="<%= attr.name %>">
                                </div>
                                <div class="col-md-6">
                                  <input type="text" class="form-control" name="attributeValues[]" 
                                         placeholder="Valor" value="<%= attr.value %>">
                                </div>
                                <div class="col-md-1">
                                  <button type="button" class="btn btn-danger btn-sm remove-attribute">
                                    <i class="fas fa-times"></i>
                                  </button>
                                </div>
                              </div>
                            <% }); 
                               } else { 
                            %>
                              <div class="row mb-2 attribute-row">
                                <div class="col-md-5">
                                  <input type="text" class="form-control" name="attributeNames[]" 
                                         placeholder="Nome do atributo">
                                </div>
                                <div class="col-md-6">
                                  <input type="text" class="form-control" name="attributeValues[]" 
                                         placeholder="Valor">
                                </div>
                                <div class="col-md-1">
                                  <button type="button" class="btn btn-danger btn-sm remove-attribute">
                                    <i class="fas fa-times"></i>
                                  </button>
                                </div>
                              </div>
                            <% } %>
                          </div>
                          <button type="button" id="addAttribute" class="btn btn-sm btn-outline-secondary mt-2">
                            <i class="fas fa-plus"></i> Adicionar atributo
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              
              <div class="card-footer">
                <button type="submit" class="btn btn-primary">
                  <i class="fas fa-save"></i> Salvar
                </button>
                <a href="/admin/products" class="btn btn-default">Cancelar</a>
                <% if (typeof product.id !== 'undefined') { %>
                  <button type="button" class="btn btn-danger float-right" id="deleteProduct" 
                          data-product-id="<%= product.id %>">
                    <i class="fas fa-trash"></i> Excluir
                  </button>
                <% } %>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  `,
  scripts: [
    '/adminlte/plugins/select2/js/select2.full.min.js',
    '/adminlte/plugins/summernote/summernote-bs4.min.js',
    '/adminlte/plugins/bs-custom-file-input/bs-custom-file-input.min.js',
    '/js/admin-product-form.js'
  ],
  styles: [
    '/adminlte/plugins/select2/css/select2.min.css',
    '/adminlte/plugins/select2-bootstrap4-theme/select2-bootstrap4.min.css',
    '/adminlte/plugins/summernote/summernote-bs4.min.css'
  ]
}) %>

<!-- Template para novos campos de atributo -->
<template id="attributeTemplate">
  <div class="row mb-2 attribute-row">
    <div class="col-md-5">
      <input type="text" class="form-control" name="attributeNames[]" placeholder="Nome do atributo">
    </div>
    <div class="col-md-6">
      <input type="text" class="form-control" name="attributeValues[]" placeholder="Valor">
    </div>
    <div class="col-md-1">
      <button type="button" class="btn btn-danger btn-sm remove-attribute">
        <i class="fas fa-times"></i>
      </button>
    </div>
  </div>
</template>
