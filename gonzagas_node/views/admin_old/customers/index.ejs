<%- include('../../layouts/admin-layout', { 
  title: 'Clientes',
  currentPath: '/admin/customers',
  customCss: 'admin-customers',
  customJs: 'admin-customers',
  body: `
    <div class="alerts-container"></div>
    
    <div class="container-fluid">
      <div class="row mb-4">
        <div class="col-12">
          <div class="page-header">
            <div class="d-flex justify-content-between align-items-center">
              <h1 class="page-title">Gerenciamento de Clientes</h1>
              <div>
                <a href="/admin/customers/new" class="btn btn-primary">
                  <i class="fas fa-plus"></i> Novo Cliente
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-12">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">Lista de Clientes</h3>
              <div class="card-tools">
                <button type="button" class="btn btn-tool" data-card-widget="collapse">
                  <i class="fas fa-minus"></i>
                </button>
              </div>
            </div>
            <div class="card-body">
              <div class="row mb-4">
                <div class="col-md-8 mb-3 mb-md-0">
                  <div class="d-flex flex-wrap gap-2">
                    <div class="btn-group">
                      <button type="button" class="btn btn-default btn-flat dropdown-toggle" data-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-download mr-2"></i> Exportar
                      </button>
                      <div class="dropdown-menu">
                        <a class="dropdown-item export-action" href="#" data-type="excel">
                          <i class="fas fa-file-excel mr-2 text-success"></i> Excel
                        </a>
                        <a class="dropdown-item export-action" href="#" data-type="pdf">
                          <i class="fas fa-file-pdf mr-2 text-danger"></i> PDF
                        </a>
                      </div>
                    </div>
                    <button type="button" class="btn btn-default btn-flat" id="refreshCustomers">
                      <i class="fas fa-sync-alt mr-2"></i> Atualizar
                    </button>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="input-group">
                    <input type="text" class="form-control" placeholder="Buscar clientes..." id="searchInput">
                    <div class="input-group-append">
                      <button class="btn btn-default" type="button" id="searchButton">
                        <i class="fas fa-search"></i>
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <div class="table-responsive">
                <table class="table table-hover table-striped table-bordered" id="customersTable">
                  <thead class="bg-light">
                    <tr>
                      <th>ID</th>
                      <th>Nome</th>
                      <th>Email</th>
                      <th>Telefone</th>
                      <th>Cadastrado em</th>
                      <th>Status</th>
                      <th class="text-center">Ações</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (typeof customers !== 'undefined' && customers.length > 0) { %>
                      <% customers.forEach(customer => { %>
                        <tr data-customer-id="<%= customer.id %>">
                          <td>#<%= customer.id %></td>
                          <td><%= customer.name %></td>
                          <td><%= customer.email %></td>
                          <td><%= customer.phone || '--' %></td>
                          <td><%= new Date(customer.createdAt).toLocaleDateString('pt-BR') %></td>
                          <td>
                            <span class="badge <%= customer.status === 'Ativo' ? 'bg-success' : 'bg-secondary' %>">
                              <%= customer.status || 'Ativo' %>
                            </span>
                          </td>
                          <td class="text-nowrap text-center">
                            <a href="/admin/customers/<%= customer.id %>" class="btn btn-sm btn-info" title="Visualizar">
                              <i class="fas fa-eye"></i>
                            </a>
                            <a href="/admin/customers/<%= customer.id %>/edit" class="btn btn-sm btn-primary" title="Editar">
                              <i class="fas fa-edit"></i>
                            </a>
                            <button class="btn btn-sm btn-danger btn-delete-customer" data-customer-id="<%= customer.id %>" title="Excluir">
                              <i class="fas fa-trash"></i>
                            </button>
                          </td>
                        </tr>
                      <% }); %>
                    <% } else { %>
                      <tr>
                        <td colspan="7" class="text-center">Nenhum cliente encontrado</td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
              
              <div class="row mt-4">
                <div class="col-md-5 d-flex align-items-center">
                  <div class="dataTables_info" id="customersTable_info" role="status" aria-live="polite">
                    Mostrando <%= pagination?.startItem || 0 %> a <%= pagination?.endItem || 0 %> de <%= pagination?.totalItems || 0 %> registros
                  </div>
                </div>
                <div class="col-md-7">
                  <div class="dataTables_paginate paging_simple_numbers" id="customersTable_paginate">
                    <ul class="pagination justify-content-end mb-0">
                      <li class="paginate_button page-item <%= pagination?.currentPage === 1 ? 'disabled' : '' %>" id="customersTable_previous">
                        <a href="?page=<%= (pagination?.currentPage || 1) - 1 %>" aria-controls="customersTable" data-dt-idx="0" tabindex="0" class="page-link">Anterior</a>
                      </li>
                      
                      <% if (pagination?.totalPages) { %>
                        <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                          <li class="paginate_button page-item <%= i === pagination.currentPage ? 'active' : '' %>">
                            <a href="?page=<%= i %>" aria-controls="customersTable" data-dt-idx="<%= i %>" class="page-link"><%= i %></a>
                          </li>
                        <% } %>
                      <% } %>
                      
                      <li class="paginate_button page-item <%= pagination?.currentPage === pagination?.totalPages ? 'disabled' : '' %>" id="customersTable_next">
                        <a href="?page=<%= (pagination?.currentPage || 1) + 1 %>" aria-controls="customersTable" data-dt-idx="<%= (pagination?.totalPages || 1) + 1 %>" class="page-link">Próximo</a>
                      </li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
            <div class="card-footer">
              <div class="d-flex justify-content-between align-items-center">
                <div class="text-muted">
                  <i class="fas fa-info-circle mr-1"></i> Total de clientes: <%= pagination?.totalItems || 0 %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  `,
  scripts: [
    '/adminlte/plugins/datatables/jquery.dataTables.min.js',
    '/adminlte/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js',
    '/adminlte/plugins/datatables-buttons/js/dataTables.buttons.min.js',
    '/adminlte/plugins/datatables-buttons/js/buttons.colVis.min.js',
    '/js/admin-customers.js'
  ]
}) %>
