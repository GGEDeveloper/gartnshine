<%- include('../../layouts/admin-layout', { 
  title: customer.name,
  currentPath: `/admin/customers/${customer.id}`,
  customCss: 'admin-customer-detail',
  body: `
    <div class="container-fluid">
      <div class="row mb-4">
        <div class="col-12">
          <div class="page-header">
            <div class="d-flex justify-content-between align-items-center">
              <h1 class="page-title">Detalhes do Cliente</h1>
              <div>
                <a href="/admin/customers" class="btn btn-default">
                  <i class="fas fa-arrow-left mr-1"></i> Voltar
                </a>
                <a href="/admin/customers/<%= customer.id %>/edit" class="btn btn-primary">
                  <i class="fas fa-edit mr-1"></i> Editar
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-4">
          <div class="card card-primary card-outline">
            <div class="card-body box-profile">
              <div class="text-center">
                <div class="profile-user-img img-circle bg-primary d-flex align-items-center justify-content-center" style="width: 100px; height: 100px; margin: 0 auto 15px;">
                  <i class="fas fa-user fa-3x text-white"></i>
                </div>
              </div>

              <h3 class="profile-username text-center"><%= customer.name %></h3>

              <p class="text-muted text-center">
                <span class="badge <%= customer.status === 'Ativo' ? 'bg-success' : 'bg-secondary' %>">
                  <%= customer.status || 'Ativo' %>
                </span>
              </p>

              <ul class="list-group list-group-unbordered mb-3">
                <li class="list-group-item">
                  <b>CPF</b> <a class="float-right"><%= customer.cpf %></a>
                </li>
                <li class="list-group-item">
                  <b>Email</b> <a class="float-right"><%= customer.email %></a>
                </li>
                <li class="list-group-item">
                  <b>Telefone</b> <a class="float-right"><%= customer.phone || '--' %></a>
                </li>
                <% if (customer.birthDate) { %>
                  <li class="list-group-item">
                    <b>Data de Nascimento</b> <span class="float-right"><%= new Date(customer.birthDate).toLocaleDateString('pt-BR') %></span>
                  </li>
                <% } %>
                <li class="list-group-item">
                  <b>Membro desde</b> <span class="float-right"><%= new Date(customer.createdAt).toLocaleDateString('pt-BR') %></span>
                </li>
              </ul>
            </div>
          </div>

          <div class="card">
            <div class="card-header">
              <h3 class="card-title">Endereço</h3>
            </div>
            <div class="card-body">
              <% if (customer.address) { %>
                <address>
                  <%= customer.address.street %>, <%= customer.address.number %><br>
                  <% if (customer.address.complement) { %>
                    <%= customer.address.complement %><br>
                  <% } %>
                  <%= customer.address.neighborhood %><br>
                  <%= customer.address.city %> - <%= customer.address.state %><br>
                  CEP: <%= customer.address.zipCode %><br>
                </address>
              <% } else { %>
                <p>Nenhum endereço cadastrado.</p>
              <% } %>
            </div>
          </div>
        </div>

        <div class="col-md-8">
          <div class="card">
            <div class="card-header p-2">
              <ul class="nav nav-pills" id="customerTabs" role="tablist">
                <li class="nav-item">
                  <a class="nav-link active" id="orders-tab" data-toggle="pill" href="#orders" role="tab" aria-controls="orders" aria-selected="true">
                    <i class="fas fa-shopping-cart mr-1"></i> Pedidos
                    <span class="badge bg-primary ml-1"><%= customer.ordersCount || 0 %></span>
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" id="activity-tab" data-toggle="pill" href="#activity" role="tab" aria-controls="activity" aria-selected="false">
                    <i class="fas fa-history mr-1"></i> Atividades
                  </a>
                </li>
                <% if (customer.notes) { %>
                  <li class="nav-item">
                    <a class="nav-link" id="notes-tab" data-toggle="pill" href="#notes" role="tab" aria-controls="notes" aria-selected="false">
                      <i class="fas fa-sticky-note mr-1"></i> Anotações
                    </a>
                  </li>
                <% } %>
              </ul>
            </div>
            <div class="card-body">
              <div class="tab-content" id="customerTabsContent">
                <!-- Aba de Pedidos -->
                <div class="tab-pane fade show active" id="orders" role="tabpanel" aria-labelledby="orders-tab">
                  <% if (customer.orders && customer.orders.length > 0) { %>
                    <div class="table-responsive">
                      <table class="table table-hover">
                        <thead>
                          <tr>
                            <th>Nº Pedido</th>
                            <th>Data</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th class="text-right">Ações</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% customer.orders.forEach(order => { %>
                            <tr>
                              <td>#<%= order.id %></td>
                              <td><%= new Date(order.date).toLocaleDateString('pt-BR') %></td>
                              <td><%= order.total.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></td>
                              <td>
                                <span class="badge <%= order.status === 'Pago' ? 'bg-success' : (order.status === 'Pendente' ? 'bg-warning' : 'bg-secondary') %>">
                                  <%= order.status %>
                                </span>
                              </td>
                              <td class="text-right">
                                <a href="/admin/orders/<%= order.id %>" class="btn btn-sm btn-info" title="Visualizar">
                                  <i class="fas fa-eye"></i>
                                </a>
                              </td>
                            </tr>
                          <% }); %>
                        </tbody>
                      </table>
                    </div>
                  <% } else { %>
                    <div class="text-center py-4">
                      <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
                      <p class="text-muted">Nenhum pedido encontrado para este cliente.</p>
                      <a href="/admin/orders/new?customerId=<%= customer.id %>" class="btn btn-primary">
                        <i class="fas fa-plus mr-1"></i> Novo Pedido
                      </a>
                    </div>
                  <% } %>
                </div>
                
                <!-- Aba de Atividades -->
                <div class="tab-pane fade" id="activity" role="tabpanel" aria-labelledby="activity-tab">
                  <div class="timeline">
                    <% const activities = customer.activities || []; %>
                    <% if (activities.length > 0) { %>
                      <% activities.forEach(activity => { %>
                        <div class="time-label">
                          <span class="bg-info"><%= new Date(activity.date).toLocaleDateString('pt-BR') %></span>
                        </div>
                        
                        <div>
                          <i class="<%= activity.icon || 'fas fa-info-circle' %> bg-blue"></i>
                          <div class="timeline-item">
                            <span class="time"><i class="far fa-clock"></i> <%= new Date(activity.date).toLocaleTimeString('pt-BR') %></span>
                            <h3 class="timeline-header"><%= activity.title %></h3>
                            <div class="timeline-body">
                              <%= activity.description %>
                            </div>
                          </div>
                        </div>
                      <% }); %>
                      
                      <div>
                        <i class="fas fa-clock bg-gray"></i>
                      </div>
                    <% } else { %>
                      <div class="text-center py-4">
                        <i class="fas fa-history fa-3x text-muted mb-3"></i>
                        <p class="text-muted">Nenhuma atividade registrada para este cliente.</p>
                      </div>
                    <% } %>
                  </div>
                </div>
                
                <!-- Aba de Anotações -->
                <% if (customer.notes) { %>
                  <div class="tab-pane fade" id="notes" role="tabpanel" aria-labelledby="notes-tab">
                    <div class="card card-primary card-outline">
                      <div class="card-body">
                        <p><%= customer.notes %></p>
                      </div>
                    </div>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  `
}) %>
