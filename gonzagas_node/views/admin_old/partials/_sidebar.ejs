<!-- Main Sidebar Container -->
<aside class="main-sidebar sidebar-dark-primary elevation-4">
  <!-- Brand Logo -->
  <a href="/admin" class="brand-link">
    <img src="/img/logo.png" alt="Gonzagas Logo" class="brand-image img-circle elevation-3" style="opacity: .8">
    <span class="brand-text font-weight-light">Gonzagas</span>
  </a>

  <!-- Sidebar -->
  <div class="sidebar">
    <!-- Sidebar user panel (optional) -->
    <div class="user-panel mt-3 pb-3 mb-3 d-flex">
      <div class="image">
        <img src="/img/user2-160x160.jpg" class="img-circle elevation-2" alt="User Image">
      </div>
      <div class="info">
        <a href="/admin/profile" class="d-block">Admin</a>
      </div>
    </div>

    <!-- Sidebar Menu -->
    <nav class="mt-2">
      <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
        <li class="nav-item">
          <a href="/admin" class="nav-link <%= currentPath === '/admin' ? 'active' : '' %>">
            <i class="nav-icon fas fa-tachometer-alt"></i>
            <p>Dashboard</p>
          </a>
        </li>
        
        <!-- Pedidos -->
        <li class="nav-item <%= currentPath.startsWith('/admin/orders') ? 'menu-open' : '' %>">
          <a href="#" class="nav-link <%= currentPath.startsWith('/admin/orders') ? 'active' : '' %>">
            <i class="nav-icon fas fa-shopping-cart"></i>
            <p>
              Pedidos
              <i class="right fas fa-angle-left"></i>
            </p>
          </a>
          <ul class="nav nav-treeview">
            <li class="nav-item">
              <a href="/admin/orders" class="nav-link <%= currentPath === '/admin/orders' ? 'active' : '' %>">
                <i class="far fa-circle nav-icon"></i>
                <p>Listar Pedidos</p>
              </a>
            </li>
            <li class="nav-item">
              <a href="/admin/orders/new" class="nav-link <%= currentPath === '/admin/orders/new' ? 'active' : '' %>">
                <i class="far fa-circle nav-icon"></i>
                <p>Novo Pedido</p>
              </a>
            </li>
          </ul>
        </li>
        
        <!-- Produtos -->
        <li class="nav-item <%= currentPath.startsWith('/admin/products') ? 'menu-open' : '' %>">
          <a href="#" class="nav-link <%= currentPath.startsWith('/admin/products') ? 'active' : '' %>">
            <i class="nav-icon fas fa-box"></i>
            <p>
              Produtos
              <i class="right fas fa-angle-left"></i>
            </p>
          </a>
          <ul class="nav nav-treeview">
            <li class="nav-item">
              <a href="/admin/products" class="nav-link <%= currentPath === '/admin/products' ? 'active' : '' %>">
                <i class="far fa-circle nav-icon"></i>
                <p>Listar Produtos</p>
              </a>
            </li>
            <li class="nav-item">
              <a href="/admin/products/new" class="nav-link <%= currentPath === '/admin/products/new' ? 'active' : '' %>">
                <i class="far fa-circle nav-icon"></i>
                <p>Novo Produto</p>
              </a>
            </li>
          </ul>
        </li>
        
        <!-- Clientes -->
        <li class="nav-item">
          <a href="/admin/customers" class="nav-link <%= currentPath === '/admin/customers' ? 'active' : '' %>">
            <i class="nav-icon fas fa-users"></i>
            <p>Clientes</p>
          </a>
        </li>
        
        <!-- Relatórios -->
        <li class="nav-item">
          <a href="/admin/reports" class="nav-link <%= currentPath === '/admin/reports' ? 'active' : '' %>">
            <i class="nav-icon fas fa-chart-bar"></i>
            <p>Relatórios</p>
          </a>
        </li>
        
        <!-- Configurações -->
        <li class="nav-header">CONFIGURAÇÕES</li>
        <li class="nav-item">
          <a href="/admin/settings" class="nav-link <%= currentPath === '/admin/settings' ? 'active' : '' %>">
            <i class="nav-icon fas fa-cog"></i>
            <p>Configurações</p>
          </a>
        </li>
        <li class="nav-item">
          <a href="/admin/users" class="nav-link <%= currentPath === '/admin/users' ? 'active' : '' %>">
            <i class="nav-icon fas fa-users-cog"></i>
            <p>Usuários</p>
          </a>
        </li>
      </ul>
    </nav>
    <!-- /.sidebar-menu -->
  </div>
  <!-- /.sidebar -->
</aside>
