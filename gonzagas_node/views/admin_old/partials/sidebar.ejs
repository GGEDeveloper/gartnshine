             class="group flex items-center px-3 py-2 text-sm rounded-md hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors duration-150">
            <i class="fas fa-boxes w-5 text-center mr-2" :class="isRouteActive('/admin/relatorios/estoque') ? 'text-blue-500' : 'text-gray-400 group-hover:text-blue-500 dark:group-hover:text-blue-400'"></i>
            <span>Estoque</span>
            <span x-show="isRouteActive('/admin/relatorios/estoque')" class="ml-auto w-1.5 h-1.5 bg-blue-500 rounded-full"></span>
