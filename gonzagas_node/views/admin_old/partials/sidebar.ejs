             :class="isRouteActive('/admin/relatorios/financeiro') ? 'text-blue-700 dark:text-blue-400 font-medium' : 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200'"
             class="group flex items-center px-3 py-2 text-sm rounded-md hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors duration-150">
            <i class="fas fa-money-bill-wave w-5 text-center mr-2" :class="isRouteActive('/admin/relatorios/financeiro') ? 'text-blue-500' : 'text-gray-400 group-hover:text-blue-500 dark:group-hover:text-blue-400'"></i>
