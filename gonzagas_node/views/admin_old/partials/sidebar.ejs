        <i class="fas fa-gem text-xl"></i>
      </div>
      <div>
        <h2 class="text-lg font-bold text-white dark:text-white">Gonzaga's</h2>
        <p class="text-xs text-blue-100 dark:text-blue-300">Painel Administrativo</p>
      </div>
    </a>
    <button @click="toggleSidebar" class="lg:hidden text-blue-200 hover:text-white transition-colors duration-200">
      <i class="fas fa-times text-xl"></i>
