            <i class="fas fa-database w-5 text-center mr-2" :class="isRouteActive('/admin/backup') ? 'text-blue-500' : 'text-gray-400 group-hover:text-blue-500 dark:group-hover:text-blue-400'"></i>
            <span>Backup</span>
            <span x-show="isRouteActive('/admin/backup')" class="ml-auto w-1.5 h-1.5 bg-blue-500 rounded-full"></span>
