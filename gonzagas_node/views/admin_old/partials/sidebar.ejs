<aside x-data="{ 
  isOpen: window.innerWidth >= 1024,
  activeSubmenu: '',
  
  init() {
    // Fechar menu em telas pequenas ao carregar
    if (window.innerWidth < 1024) {
      this.isOpen = false;
    } else {
      this.isOpen = true;
    }
    
    // Atualizar estado ao redimensionar a tela
    const handleResize = () => {
      if (window.innerWidth >= 1024) {
        this.isOpen = true;
      } else {
        this.isOpen = false;
      }
    };
    
    window.addEventListener('resize', handleResize);
    
    // Limpar event listener quando o componente for destruído
    this.$el._handleResize = handleResize;
    
    // Verificar rota ativa
    this.setActiveMenu();
    
    // Fechar submenus inativos
    this.$watch('isOpen', (value) => {
      if (!value) {
        this.activeSubmenu = '';
      }
    });
  },
  
  // Limpar event listeners quando o componente for destruído
  destroy() {
    if (this.$el._handleResize) {
      window.removeEventListener('resize', this.$el._handleResize);
    }
  },
  
  setActiveMenu() {
    const currentPath = window.location.pathname;
    
    // Mapear rotas para submenus
    const routeMap = {
      '/admin/produtos': 'cadastros',
      '/admin/categorias': 'cadastros',
      '/admin/clientes': 'cadastros',
      '/admin/fornecedores': 'cadastros',
      '/admin/estoque': 'operacoes',
      '/admin/vendas': 'operacoes',
      '/admin/compras': 'operacoes',
      '/admin/relatorios': 'relatorios',
      '/admin/ajustes': 'configuracoes',
      '/admin/usuarios': 'configuracoes'
    };
    
    // Encontrar o submenu ativo
    for (const [path, menu] of Object.entries(routeMap)) {
      if (currentPath.startsWith(path)) {
        this.activeSubmenu = menu;
        break;
      }
    }
  },
  
  toggleSubmenu(menu) {
    this.activeSubmenu = this.activeSubmenu === menu ? '' : menu;
  },
  
  isActive(menu) {
    return this.activeSubmenu === menu;
  },
  
  isRouteActive(path) {
    return window.location.pathname.startsWith(path);
  },
  
  toggleSidebar() {
    this.isOpen = !this.isOpen;
  },
  
  isExactRoute(path) {
    return window.location.pathname === path;
  }
}" 
     :class="{'translate-x-0': isOpen, '-translate-x-full': !isOpen}"
     class="fixed lg:static inset-y-0 left-0 z-30 w-64 bg-gray-800 shadow-xl transform transition-all duration-300 ease-in-out flex flex-col h-screen border-r border-gray-700">
  
