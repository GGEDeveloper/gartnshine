                :class="isActive('configuracoes') || isRouteActive('/admin/ajustes') || isRouteActive('/admin/usuarios') || isRouteActive('/admin/backup') ? 'text-blue-400' : 'text-gray-200 hover:bg-gray-700'"
                class="w-full flex items-center justify-between px-4 py-3 text-sm font-medium rounded-r-md transition-colors duration-200">
          <div class="flex items-center">
