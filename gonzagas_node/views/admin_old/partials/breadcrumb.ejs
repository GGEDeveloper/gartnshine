<% 
  // Default breadcrumbs if not provided
  const defaultBreadcrumbs = [
    { label: 'Dashboard', url: '/admin' }
  ];
  
  // Use provided breadcrumbs or default to empty array
  const pageBreadcrumbs = typeof breadcrumbs !== 'undefined' ? breadcrumbs : [];
  
  // Combine default with page-specific breadcrumbs
  const allBreadcrumbs = [...defaultBreadcrumbs, ...pageBreadcrumbs];
%>

<nav class="breadcrumb" aria-label="Navegação">
  <ol class="flex items-center text-sm">
    <% allBreadcrumbs.forEach((item, index) => { %>
      <li class="flex items-center">
        <% if (index > 0) { %>
          <i class="fas fa-chevron-right mx-2 text-xs text-muted"></i>
        <% } %>
        
        <% if (index === allBreadcrumbs.length - 1) { %>
          <span class="text-primary font-medium"><%= item.label %></span>
        <% } else { %>
          <a href="<%= item.url %>" class="text-muted hover:text-primary transition-colors">
            <%= item.label %>
          </a>
        <% } %>
      </li>
    <% }); %>
  </ol>
</nav>
