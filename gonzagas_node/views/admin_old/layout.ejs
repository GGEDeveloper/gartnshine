<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Painel Administrativo' %> | Gonzaga's Art & Shine</title>
  
  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico">
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet">
  
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Admin Theme CSS -->
  <link rel="stylesheet" href="/css/admin-theme.css">
  
  <!-- AdminLTE CSS -->
  <link rel="stylesheet" href="/adminlte/plugins/fontawesome-free/css/all.min.css">
  <link rel="stylesheet" href="/adminlte/plugins/tempusdominus-bootstrap-4/css/tempusdominus-bootstrap-4.min.css">
  <link rel="stylesheet" href="/adminlte/plugins/icheck-bootstrap/icheck-bootstrap.min.css">
  <link rel="stylesheet" href="/adminlte/plugins/jqvmap/jqvmap.min.css">
  <link rel="stylesheet" href="/adminlte/dist/css/adminlte.min.css">
  <link rel="stylesheet" href="/adminlte/plugins/overlayScrollbars/css/OverlayScrollbars.min.css">
  <link rel="stylesheet" href="/adminlte/plugins/daterangepicker/daterangepicker.css">
  <link rel="stylesheet" href="/adminlte/plugins/summernote/summernote-bs4.min.css">
  
  <!-- Custom CSS -->
  <% if (typeof customCss !== 'undefined' && customCss) { %>
    <link rel="stylesheet" href="/css/<%= customCss %>.css">
  <% } %>
  
  <style>
    :root {
      --color-primary: <%= theme?.colorPrimary || '#6a8c69' %>;
      --color-primary-dark: <%= theme?.colorPrimaryDark || '#5a7c59' %>;
      --color-primary-light: <%= theme?.colorPrimaryLight || '#7a9c79' %>;
      --color-accent: <%= theme?.colorAccent || '#b19cd9' %>;
      --color-accent-dark: <%= theme?.colorAccentDark || '#a18cc9' %>;
    }
  </style>
</head>
<body>
  <!-- Sidebar -->
  <%- include('partials/sidebar') %>
  
  <!-- Main Content -->
  <div class="main-content">
    <!-- Navbar -->
    <%- include('partials/navbar') %>
    
    <!-- Page Content -->
    <main class="container">
      <!-- Flash Messages -->
      <% if (typeof success_msg !== 'undefined' && success_msg) { %>
        <div class="alert alert-success">
          <i class="fas fa-check-circle me-2"></i>
          <%= success_msg %>
          <button type="button" class="close" data-dismiss="alert">
            <span>&times;</span>
          </button>
        </div>
      <% } %>
      
      <% if (typeof error_msg !== 'undefined' && error_msg) { %>
        <div class="alert alert-error">
          <i class="fas fa-exclamation-circle me-2"></i>
          <%= error_msg %>
          <button type="button" class="close" data-dismiss="alert">
            <span>&times;</span>
          </button>
        </div>
      <% } %>
      
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error">
          <i class="fas fa-exclamation-triangle me-2"></i>
          <%= typeof error === 'string' ? error : error.message || 'Ocorreu um erro inesperado.' %>
          <button type="button" class="close" data-dismiss="alert">
            <span>&times;</span>
          </button>
        </div>
      <% } %>
      
      <!-- Page Header -->
      <div class="page-header flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold"><%= title || 'Dashboard' %></h1>
        <%- include('partials/breadcrumb') %>
      </div>
      
      <!-- Page Content -->
      <div class="content">
        <% if (typeof content !== 'undefined') { %>
          <%- content %>
        <% } else if (typeof body !== 'undefined') { %>
          <%- include(body) %>
        <% } else { %>
          <p>Nenhum conteúdo disponível</p>
        <% } %>
      </div>
    </main>
    
    <!-- Footer -->
    <%- include('partials/footer') %>
  </div>
  
  <!-- Scripts -->
  <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
  <script>
    // Toggle sidebar
    document.addEventListener('DOMContentLoaded', function() {
      const sidebarToggle = document.querySelector('[data-sidebar-toggle]');
      const sidebar = document.querySelector('.admin-sidebar');
      const overlay = document.querySelector('.sidebar-overlay');
      
      function toggleSidebar() {
        if (window.innerWidth < 992) {
          // Em telas pequenas, use um overlay
          if (sidebar.classList.contains('mobile-open')) {
            sidebar.classList.remove('mobile-open');
            if (overlay) overlay.style.display = 'none';
          } else {
            sidebar.classList.add('mobile-open');
            if (overlay) overlay.style.display = 'block';
          }
        } else {
          // Em telas grandes, apenas recolhe/expande
          sidebar.classList.toggle('collapsed');
        }
      }
      
      // Toggle ao clicar no botão
      if (sidebarToggle) {
        sidebarToggle.addEventListener('click', toggleSidebar);
      }
      
      // Fechar sidebar ao clicar no overlay
      if (overlay) {
        overlay.addEventListener('click', function() {
          sidebar.classList.remove('mobile-open');
          this.style.display = 'none';
        });
      }
      
      // Ajustar sidebar ao redimensionar a janela
      function handleResize() {
        if (window.innerWidth >= 992) {
          // Em telas grandes, garantir que o overlay não fique visível
          if (overlay) overlay.style.display = 'none';
          // Se estiver em modo mobile, voltar ao normal
          sidebar.classList.remove('mobile-open');
        } else {
          // Em telas pequenas, garantir que o sidebar esteja fechado por padrão
          if (!sidebar.classList.contains('mobile-open')) {
            sidebar.classList.add('collapsed');
          }
        }
      }
      
      // Inicializar
      handleResize();
      
      // Adicionar listener para redimensionamento
      window.addEventListener('resize', handleResize);
    });
  </script>
  <!-- REQUIRED SCRIPTS -->
  <!-- jQuery -->
  <script src="/adminlte/plugins/jquery/jquery.min.js"></script>
  <!-- jQuery UI 1.11.4 -->
  <script src="/adminlte/plugins/jquery-ui/jquery-ui.min.js"></script>
  <!-- Bootstrap 4 -->
  <script src="/adminlte/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
  <!-- AdminLTE App -->
  <script src="/adminlte/dist/js/adminlte.min.js"></script>
  <!-- AdminLTE for demo purposes -->
  <script src="/adminlte/dist/js/demo.js"></script>
  
  <!-- Custom Scripts -->
  <script>
    // Inicializa os componentes do AdminLTE
    $(function () {
      // Fechar alertas
      $('.alert .close').on('click', function() {
        $(this).closest('.alert').fadeOut();
      });
      
      // Ativar tooltips
      $('[data-toggle="tooltip"]').tooltip();
      
      // Ativar popovers
      $('[data-toggle="popover"]').popover();
      
      // Navegação ativa
      const currentPath = window.location.pathname;
      $('.nav-link, .sidebar-link').each(function() {
        if ($(this).attr('href') === currentPath) {
          $(this).addClass('active');
        }
      });
      
      // Inicializa o controle de sidebar
      $('.sidebar-toggle').on('click', function() {
        $('body').toggleClass('sidebar-collapse');
      });
    });
    
    // Remove a classe 'no-js' do body se estiver presente
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
  </script>
  
  <% if (typeof scripts !== 'undefined' && Array.isArray(scripts)) { %>
    <% scripts.forEach(script => { %>
      <script src="<%= script %>"></script>
    <% }); %>
  <% } %>
  
  <% if (typeof inlineScripts !== 'undefined') { %>
    <%- inlineScripts %>
  <% } %>
  
  <!-- Overlay do Sidebar para Mobile -->
  <div class="sidebar-overlay" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 15;"></div>
</body>
</html>
