<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Admin Login' %> | Gonzaga's Art & Shine</title>
  
  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico">
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --color-primary: #1a1a1a;
      --color-secondary: #2a2a2a;
      --color-accent: #c0a062;
      --color-text: #ffffff;
      --color-highlight: #d4b87a;
      --color-error: #ff6b6b;
    }
    
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    
    body {
      font-family: 'Poppins', sans-serif;
      background-color: var(--color-primary);
      color: var(--color-text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background-image: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    }

    .main-wrapper {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 2rem;
    }
    
    .login-container {
      max-width: 400px;
      width: 100%;
      background-color: rgba(0, 0, 0, 0.7);
      padding: 2.5rem;
      border-radius: 10px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      text-align: center;
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .logo {
      margin-bottom: 2rem;
    }
    
    h1 {
      font-family: 'Playfair Display', serif;
      font-size: 2.2rem;
      margin-bottom: 0.5rem;
      color: var(--color-text);
      letter-spacing: 0.5px;
    }
    
    .admin-badge {
      display: inline-block;
      background-color: var(--color-highlight);
      color: var(--color-primary);
      font-size: 0.8rem;
      padding: 0.3rem 1rem;
      border-radius: 20px;
      margin: 0.5rem 0 1.5rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    
    form {
      display: flex;
      flex-direction: column;
    }
    
    .form-group {
      margin-bottom: 1.25rem;
      text-align: left;
    }
    
    label {
      display: block;
      margin-bottom: 0.5rem;
      font-size: 0.9rem;
      opacity: 0.9;
      font-weight: 500;
    }
    
    input {
      width: 100%;
      padding: 0.9rem 1.2rem;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 6px;
      background-color: rgba(255, 255, 255, 0.05);
      color: var(--color-text);
      font-family: inherit;
      font-size: 1rem;
      transition: all 0.3s ease;
    }
    
    input:focus {
      outline: none;
      border-color: var(--color-highlight);
      box-shadow: 0 0 0 3px rgba(192, 160, 98, 0.2);
    }
    
    button {
      padding: 1rem;
      background-color: var(--color-accent);
      color: #1a1a1a;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 600;
      font-size: 1rem;
      transition: all 0.3s ease;
      margin-top: 0.5rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    
    button:hover {
      background-color: var(--color-highlight);
      transform: translateY(-1px);
    }
    
    button:active {
      transform: translateY(0);
    }
    
    .error-message {
      background-color: rgba(255, 107, 107, 0.15);
      border-left: 3px solid var(--color-error);
      padding: 0.8rem 1rem;
      margin: 0 0 1.5rem;
      text-align: left;
      border-radius: 0 5px 5px 0;
      font-size: 0.9rem;
      line-height: 1.5;
    }
    
    .back-to-site {
      margin-top: 1.5rem;
      font-size: 0.9rem;
      opacity: 0.8;
    }
    
    .back-to-site a {
      color: var(--color-highlight);
      text-decoration: none;
      font-weight: 500;
      transition: all 0.2s ease;
    }
    
    .back-to-site a:hover {
      text-decoration: underline;
      opacity: 0.9;
    }

    /* Loading state */
    .button-spinner {
      display: none;
    }

    .button-spinner:after {
      content: "";
      display: inline-block;
      width: 1rem;
      height: 1rem;
      border: 2px solid rgba(0, 0, 0, 0.3);
      border-radius: 50%;
      border-top-color: rgba(0, 0, 0, 0.6);
      animation: spin 0.6s linear infinite;
      margin-left: 0.5rem;
      vertical-align: middle;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* Responsive adjustments */
    @media (max-width: 480px) {
      .login-container {
        padding: 1.5rem;
      }
      
      h1 {
        font-size: 1.8rem;
      }
      
      input {
        padding: 0.8rem 1rem;
      }
    }
  </style>
</head>
<body>
  <div class="main-wrapper">
    <div class="login-container">
      <div class="logo">
        <h1>Gonzaga's Art & Shine</h1>
        <div class="admin-badge">Painel Administrativo</div>
      </div>
      
      <% if(typeof error !== 'undefined' && error) { %>
        <div class="error-message">
          <i class="fas fa-exclamation-circle"></i> <%= error %>
        </div>
      <% } %>
      
      <form action="/admin/login" method="POST" id="loginForm">
        <div class="form-group">
          <label for="username">Email ou Nome de Usuário</label>
          <input 
            type="text" 
            id="username" 
            name="username" 
            value="<%= typeof username !== 'undefined' ? username : '' %>" 
            required 
            autofocus
            autocomplete="username"
            placeholder="Digite seu email ou usuário"
          >
        </div>
        
        <div class="form-group">
          <label for="password">Senha</label>
          <input 
            type="password" 
            id="password" 
            name="password" 
            required 
            autocomplete="current-password"
            placeholder="Digite sua senha"
          >
        </div>
        
        <button type="submit" id="loginButton">
          <span class="button-text">Entrar</span>
          <span class="button-spinner"></span>
        </button>
      </form>
      
      <div class="back-to-site">
        <a href="/">&larr; Voltar para o site</a>
      </div>
    </div>
  </div>
  
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const loginForm = document.getElementById('loginForm');
      
      if (loginForm) {
        loginForm.addEventListener('submit', function(e) {
          const button = document.getElementById('loginButton');
          const buttonText = button.querySelector('.button-text');
          const spinner = button.querySelector('.button-spinner');
          
          // Show loading state
          button.disabled = true;
          buttonText.textContent = 'Autenticando';
          spinner.style.display = 'inline-block';
        
          // Se houver um erro, remover a mensagem de erro após alguns segundos
          const errorMessage = document.querySelector('.error-message');
          if (errorMessage) {
            setTimeout(() => {
              errorMessage.style.opacity = '0';
              setTimeout(() => errorMessage.remove(), 300);
            }, 5000);
          }
        });
      }
    });
  </script>
</body>
</html>