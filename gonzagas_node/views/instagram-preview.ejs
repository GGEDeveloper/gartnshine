<!DOCTYPE html>
<html lang="pt-PT">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Instagram — Pré-visualização | Gonzaga's Art & Shine</title>
  <link rel="stylesheet" href="/css/instagram-preview.css">
</head>
<body class="ig-preview-body">
  <main class="ig-preview-main">
    <header class="ig-hero" aria-label="Introdução">
      <div class="ig-hero-noise" aria-hidden="true"></div>
      <p class="ig-hero-brand">Gonzaga&apos;s Art &amp; Shine</p>
      <h1 class="ig-hero-title">Instagram</h1>
      <p class="ig-hero-lead">Prata, pedras naturais e alma boho — vitrine em movimento</p>
      <div class="ig-hero-line" aria-hidden="true"></div>
    </header>

    <% if (typeof instagramPreviewError !== 'undefined' && instagramPreviewError) { %>
      <p class="ig-preview-unavailable" role="status">Conteúdo temporariamente indisponível</p>
    <% } %>

    <section class="ig-collections" aria-labelledby="ig-collections-title">
      <header class="ig-collections-head">
        <h2 id="ig-collections-title" class="ig-collections-title">Colecções</h2>
        <p class="ig-collections-sub">Prata &amp; Pedras com Design Alternativo</p>
      </header>
      <% var posts = typeof instagramPosts !== 'undefined' && instagramPosts ? instagramPosts : []; %>
      <% if (posts.length) { %>
      <div class="ig-collections-grid">
        <% posts.forEach(function (post) {
          var img = post.media_url || post.thumbnail_url || '';
        %>
        <article class="ig-card">
          <a class="ig-card-link" href="<%= post.permalink %>" target="_blank" rel="noopener noreferrer" aria-label="Abrir no Instagram">
            <% if (img) { %>
            <img class="ig-card-img" src="<%= img %>" alt="" loading="lazy" decoding="async">
            <% } %>
            <span class="ig-card-overlay" aria-hidden="true">
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" focusable="false"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </span>
          </a>
        </article>
        <% }); %>
      </div>
      <% } %>
    </section>

    <% var reels = typeof instagramReels !== 'undefined' && instagramReels ? instagramReels : [];
       var spotlightReel = reels.length ? reels[0] : null;
       var stripReels = reels.length > 1 ? reels.slice(1) : [];
    %>
    <% if (reels.length) { %>
    <section class="ig-motion" aria-labelledby="ig-reels-title">
      <div class="ig-reels-head">
        <h2 id="ig-reels-title" class="ig-reels-title">Em Movimento</h2>
        <% if (stripReels.length) { %>
        <div class="ig-reels-nav" id="ig-reels-nav">
          <button type="button" class="ig-reels-arrow" id="ig-reel-prev" aria-label="Anterior">&#8249;</button>
          <button type="button" class="ig-reels-arrow" id="ig-reel-next" aria-label="Seguinte">&#8250;</button>
        </div>
        <% } %>
      </div>

      <% if (spotlightReel) {
           var rawCap = spotlightReel.caption || '';
           var sCap = rawCap.length > 100 ? rawCap.slice(0, 100) + '…' : rawCap;
           var sThumb = spotlightReel.thumbnail_url || '';
           var sVid = spotlightReel.media_url || '';
           var sPerm = spotlightReel.permalink || '#';
      %>
      <div class="ig-spotlight">
        <div class="ig-spotlight-inner">
          <div class="ig-spotlight-media ig-reel-media">
            <% if (sVid) { %>
            <video class="ig-reel-video" data-src="<%- sVid %>" <% if (sThumb) { %>poster="<%- sThumb %>"<% } %> muted playsinline loop disablePictureInPicture preload="none"></video>
            <% } else if (sThumb) { %>
            <img class="ig-spotlight-fallback-img" src="<%- sThumb %>" alt="">
            <% } %>
            <div class="ig-reel-play-overlay" aria-hidden="true"><span class="ig-reel-play-icon">&#9654;</span></div>
            <button type="button" class="ig-reel-play-toggle" aria-label="Reproduzir vídeo"><span class="ig-reel-play-icon">&#9654;</span></button>
            <a href="<%= sPerm %>" class="ig-reel-external" target="_blank" rel="noopener noreferrer" title="Ver no Instagram" aria-label="Ver no Instagram">
              <svg width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
            <p class="ig-reel-fallback-msg" hidden>Vídeo indisponível. <a href="<%= sPerm %>" target="_blank" rel="noopener noreferrer">Abrir no Instagram</a></p>
          </div>
          <% if (sCap) { %><p class="ig-spotlight-caption"><%= sCap %></p><% } %>
        </div>
      </div>
      <% } %>

      <% if (stripReels.length) { %>
      <p class="ig-reels-more" id="ig-reels-more">Mais reels</p>
      <div class="ig-reels-strip-wrap">
        <div class="ig-reels-strip" id="ig-reels-strip" tabindex="0" aria-describedby="ig-reels-more">
          <% stripReels.forEach(function (reel) {
            var thumb = reel.thumbnail_url || '';
            var vid = reel.media_url || '';
            var cap = reel.caption || '';
            var short = cap.length > 60 ? cap.slice(0, 60) + '…' : cap;
            var perm = reel.permalink || '#';
          %>
          <article class="ig-reel-card">
            <div class="ig-reel-card-inner">
              <div class="ig-reel-media ig-reel-aspect">
                <% if (vid) { %>
                <video class="ig-reel-video" data-src="<%- vid %>" <% if (thumb) { %>poster="<%- thumb %>"<% } %> muted playsinline loop disablePictureInPicture preload="none"></video>
                <% } else if (thumb) { %>
                <img class="ig-reel-fallback-img" src="<%- thumb %>" alt="">
                <% } %>
                <div class="ig-reel-play-overlay" aria-hidden="true"><span class="ig-reel-play-icon">&#9654;</span></div>
                <button type="button" class="ig-reel-play-toggle" aria-label="Reproduzir vídeo"><span class="ig-reel-play-icon">&#9654;</span></button>
                <a href="<%= perm %>" class="ig-reel-external" target="_blank" rel="noopener noreferrer" title="Ver no Instagram" aria-label="Ver no Instagram">
                  <svg width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                </a>
                <p class="ig-reel-fallback-msg" hidden>Indisponível. <a href="<%= perm %>" target="_blank" rel="noopener noreferrer">Instagram</a></p>
              </div>
              <% if (short) { %><p class="ig-reel-caption"><%= short %></p><% } else { %><p class="ig-reel-caption">&nbsp;</p><% } %>
            </div>
          </article>
          <% }); %>
        </div>
      </div>
      <% } %>
    </section>
    <% } %>
  </main>

  <footer class="ig-follow">
    <div class="ig-follow-inner">
      <p class="ig-follow-tagline">Junta-te à comunidade</p>
      <div class="ig-follow-row">
        <span class="ig-follow-handle">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          @gonzagaartnshine
        </span>
        <a class="ig-follow-btn" href="https://www.instagram.com/gonzagaartnshine/" target="_blank" rel="noopener noreferrer">Ver perfil completo</a>
      </div>
      <p class="ig-follow-lab"><a href="/instagram-lab">Laboratório API</a> — comentários e métricas</p>
    </div>
  </footer>

  <script src="/js/instagram-preview.js" defer></script>
</body>
</html>
