
<div class="collection-page">
  <!-- Collection header -->
  <section class="collection-header">
    <div class="collection-title">
      <h1><%= family.name %></h1>
      <div class="geometric-divider">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <% if (family.description) { %>
        <p class="collection-description"><%= family.description %></p>
      <% } %>
    </div>
  </section>
  
  <!-- Filter and sort controls -->
  <section class="filter-controls">
    <div class="filter-container">
      <div class="sort-by">
        <label for="sort-select">Ordenar por:</label>
        <select id="sort-select">
          <option value="name-asc">Nome: A-Z</option>
          <option value="name-desc">Nome: Z-A</option>
        </select>
      </div>
    </div>
  </section>
  
  <!-- Products grid -->
  <section class="products-section">
    <div class="products-grid">
      <% if (products && products.length > 0) { %>
        <% products.forEach(product => { %>
          <%- include('partials/_productCard', {product: product}) %>
        <% }); %>
      <% } else { %>
        <div class="no-products">
          <p>Não foram encontrados produtos nesta coleção.</p>
          <a href="/" class="btn btn-primary">Voltar ao início</a>
        </div>
      <% } %>
    </div>
  </section>
  
  <!-- Collection navigation -->
  <section class="collection-nav">
    <h3>Outras Coleções</h3>
    <div class="collections-list">
      <% families.forEach(otherFamily => { %>
        <% if (otherFamily.id !== family.id) { %>
          <a href="/collection/<%= otherFamily.id %>" class="collection-link">
            <%= otherFamily.name %>
          </a>
        <% } %>
      <% }); %>
    </div>
  </section>
</div>

<script>
  // Intersection Observer for fade-in animations
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };
  
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);
  
  // Select elements to animate
  document.querySelectorAll('.product-card').forEach(el => {
    observer.observe(el);
  });
  
  // Sort functionality
  const sortSelect = document.getElementById('sort-select');
  const productsGrid = document.querySelector('.products-grid');
  
  sortSelect.addEventListener('change', () => {
    const sortValue = sortSelect.value;
    const products = Array.from(document.querySelectorAll('.product-card'));
    
    products.sort((a, b) => {
      const nameA = a.getAttribute('data-name');
      const nameB = b.getAttribute('data-name');
      
      if (sortValue === 'name-asc') {
        return nameA.localeCompare(nameB);
      } else {
        return nameB.localeCompare(nameA);
      }
    });
    
    // Remove all products and re-add in sorted order
    products.forEach(product => product.remove());
    products.forEach(product => productsGrid.appendChild(product));
  });
</script>

<%- include('partials/schema-breadcrumb', {
  breadcrumbs: [
    { name: 'Início', url: '/' },
    { name: 'Coleções', url: '/collections' },
    { name: family.name, url: '/collection/' + (family.slug || family.id) }
  ]
}) %>
 