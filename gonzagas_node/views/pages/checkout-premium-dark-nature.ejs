<!DOCTYPE html>
<html lang="pt" data-theme="dark-nature">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout Seguro - Gonzaga Art & Shine</title>
    
    <!-- Dark Nature CSS Stack -->
    <link rel="stylesheet" href="/css/tokens-dark-nature.css">
    <link rel="stylesheet" href="/css/base-dark-nature.css">
    <link rel="stylesheet" href="/css/components-dark-nature.css">
    <link rel="stylesheet" href="/css/checkout-premium-dark-nature.css">
    
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Source+Sans+3:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <!-- Meta Tags -->
    <meta name="description" content="Finalize a sua compra de joias artesanais portuguesas de forma segura. Métodos de pagamento portugueses: MB Way, PayPal, Transferência.">
    <meta name="robots" content="noindex, nofollow">
</head>
<body class="checkout-premium-page" data-page="checkout">
    
    <!-- Minimal Header -->
    <header class="checkout-header">
        <div class="container">
            <div class="checkout-brand">
                <a href="/" class="brand-link">
                    <span class="brand-name">Gonzaga</span>
                    <span class="brand-accent">Art & Shine</span>
                </a>
            </div>
            <div class="checkout-security">
                <span class="security-icon">🔒</span>
                <span class="security-text">Checkout Seguro</span>
            </div>
        </div>
    </header>
    
    <main class="checkout-main">
        <div class="container">
            
            <!-- Progress Indicator -->
            <div class="checkout-progress">
                <div class="progress-step progress-step--active" data-step="1">
                    <div class="step-number">1</div>
                    <div class="step-label">Informações</div>
                </div>
                <div class="progress-step" data-step="2">
                    <div class="step-number">2</div>
                    <div class="step-label">Envio</div>
                </div>
                <div class="progress-step" data-step="3">
                    <div class="step-number">3</div>
                    <div class="step-label">Pagamento</div>
                </div>
                <div class="progress-step" data-step="4">
                    <div class="step-number">4</div>
                    <div class="step-label">Confirmação</div>
                </div>
            </div>
            
            <!-- Checkout Layout -->
            <div class="checkout-layout">
                
                <!-- Left Column: Wizard Steps -->
                <div class="checkout-wizard">
                    
                    <!-- STEP 1: Informações Pessoais -->
                    <section class="wizard-step" id="step-1" data-step="1">
                        <h2 class="step-title">
                            <span class="step-icon">📝</span>
                            <span class="step-text">Informações Pessoais</span>
                        </h2>
                        
                        <div class="form-sacred">
                            <div class="form-group">
                                <label for="customer-name" class="sacred-label">Nome Completo *</label>
                                <input type="text" 
                                       id="customer-name" 
                                       name="customerName"
                                       class="sacred-input" 
                                       placeholder="Hugo Gonzaga Gomes"
                                       required>
                            </div>
                            
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="customer-email" class="sacred-label">Email *</label>
                                    <input type="email" 
                                           id="customer-email" 
                                           name="customerEmail"
                                           class="sacred-input" 
                                           placeholder="email@exemplo.pt"
                                           required>
                                </div>
                                
                                <div class="form-group">
                                    <label for="customer-phone" class="sacred-label">Telefone *</label>
                                    <input type="tel" 
                                           id="customer-phone" 
                                           name="customerPhone"
                                           class="sacred-input" 
                                           placeholder="+351 912 345 678"
                                           required>
                                </div>
                            </div>
                            
                            <!-- Stone Preference (Optional) -->
                            <div class="stone-preference-section">
                                <h3 class="preference-title">
                                    <span class="preference-icon">💎</span>
                                    <span>Qual a sua pedra sagrada preferida?</span>
                                </h3>
                                <p class="preference-subtitle">Ajuda-nos a personalizar a sua experiência</p>
                                
                                <div class="stone-preference-grid">
                                    <label class="stone-preference-card">
                                        <input type="radio" name="stonePreference" value="onix">
                                        <div class="preference-content">
                                            <span class="stone-symbol">⚫</span>
                                            <span class="stone-name">Ónix</span>
                                            <span class="stone-essence">Força ancestral</span>
                                        </div>
                                    </label>
                                    
                                    <label class="stone-preference-card">
                                        <input type="radio" name="stonePreference" value="olho-de-tigre">
                                        <div class="preference-content">
                                            <span class="stone-symbol">🟤</span>
                                            <span class="stone-name">Olho-de-Tigre</span>
                                            <span class="stone-essence">Poder dourado</span>
                                        </div>
                                    </label>
                                    
                                    <label class="stone-preference-card">
                                        <input type="radio" name="stonePreference" value="ametista">
                                        <div class="preference-content">
                                            <span class="stone-symbol">🟣</span>
                                            <span class="stone-name">Ametista</span>
                                            <span class="stone-essence">Sabedoria cristalina</span>
                                        </div>
                                    </label>
                                    
                                    <label class="stone-preference-card">
                                        <input type="radio" name="stonePreference" value="turquesa">
                                        <div class="preference-content">
                                            <span class="stone-symbol">🔵</span>
                                            <span class="stone-name">Turquesa</span>
                                            <span class="stone-essence">Proteção oceânica</span>
                                        </div>
                                    </label>
                                </div>
                            </div>
                        </div>
                        
                        <div class="step-actions">
                            <a href="/cart" class="btn btn--secondary btn--large">
                                <span class="btn-icon">←</span>
                                <span class="btn-text">Voltar ao Carrinho</span>
                            </a>
                            <button type="button" class="btn btn--gold btn--large" onclick="checkoutWizard.nextStep()">
                                <span class="btn-text">Continuar para Envio</span>
                                <span class="btn-icon">→</span>
                            </button>
                        </div>
                    </section>
                    
                    <!-- STEP 2: Informações de Envio -->
                    <section class="wizard-step wizard-step--hidden" id="step-2" data-step="2">
                        <h2 class="step-title">
                            <span class="step-icon">📦</span>
                            <span class="step-text">Informações de Envio</span>
                        </h2>
                        
                        <div class="form-sacred">
                            <div class="form-group">
                                <label for="shipping-address" class="sacred-label">Morada *</label>
                                <input type="text" 
                                       id="shipping-address" 
                                       name="shippingAddress"
                                       class="sacred-input" 
                                       placeholder="Rua da Prata, nº 25, 1º andar"
                                       required>
                            </div>
                            
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="shipping-city" class="sacred-label">Cidade *</label>
                                    <input type="text" 
                                           id="shipping-city" 
                                           name="shippingCity"
                                           class="sacred-input" 
                                           placeholder="Lisboa"
                                           required>
                                </div>
                                
                                <div class="form-group">
                                    <label for="shipping-postal" class="sacred-label">Código Postal *</label>
                                    <input type="text" 
                                           id="shipping-postal" 
                                           name="shippingPostalCode"
                                           class="sacred-input" 
                                           placeholder="1100-123"
                                           pattern="[0-9]{4}-[0-9]{3}"
                                           required>
                                </div>
                            </div>
                            
                            <!-- Shipping Method -->
                            <div class="shipping-method-section">
                                <h3 class="method-title">Método de Envio</h3>
                                
                                <div class="shipping-methods">
                                    <label class="shipping-method-card shipping-method--standard">
                                        <input type="radio" name="shippingMethod" value="standard" checked>
                                        <div class="method-content">
                                            <div class="method-header">
                                                <span class="method-icon">📮</span>
                                                <span class="method-name">Envio Standard</span>
                                                <span class="method-price">€5.99</span>
                                            </div>
                                            <p class="method-description">3-5 dias úteis • Grátis em compras >€75</p>
                                        </div>
                                    </label>
                                    
                                    <label class="shipping-method-card shipping-method--express">
                                        <input type="radio" name="shippingMethod" value="express">
                                        <div class="method-content">
                                            <div class="method-header">
                                                <span class="method-icon">⚡</span>
                                                <span class="method-name">Envio Expresso</span>
                                                <span class="method-price">€12.99</span>
                                            </div>
                                            <p class="method-description">1-2 dias úteis • Entrega prioritária</p>
                                        </div>
                                    </label>
                                </div>
                            </div>
                        </div>
                        
                        <div class="step-actions">
                            <button type="button" class="btn btn--secondary btn--large" onclick="checkoutWizard.prevStep()">
                                <span class="btn-icon">←</span>
                                <span class="btn-text">Voltar</span>
                            </button>
                            <button type="button" class="btn btn--gold btn--large" onclick="checkoutWizard.nextStep()">
                                <span class="btn-text">Continuar para Pagamento</span>
                                <span class="btn-icon">→</span>
                            </button>
                        </div>
                    </section>
                    
                    <!-- STEP 3: Método de Pagamento -->
                    <section class="wizard-step wizard-step--hidden" id="step-3" data-step="3">
                        <h2 class="step-title">
                            <span class="step-icon">💳</span>
                            <span class="step-text">Método de Pagamento</span>
                        </h2>
                        
                        <div class="form-sacred">
                            <div class="payment-methods">
                                
                                <!-- MB Way (Primary - Portuguese) -->
                                <label class="payment-method payment-method--primary">
                                    <input type="radio" name="paymentMethod" value="mbway" checked>
                                    <div class="payment-sacred-label">
                                        <div class="payment-header">
                                            <span class="payment-icon">📱</span>
                                            <span class="payment-name">MB Way</span>
                                            <span class="payment-badge payment-badge--recommended">Recomendado</span>
                                        </div>
                                        <p class="payment-description">Pagamento instantâneo via telemóvel português</p>
                                    </div>
                                </label>
                                
                                <!-- PayPal (International) -->
                                <label class="payment-method payment-method--international">
                                    <input type="radio" name="paymentMethod" value="paypal">
                                    <div class="payment-sacred-label">
                                        <div class="payment-header">
                                            <span class="payment-icon">🌐</span>
                                            <span class="payment-name">PayPal</span>
                                            <span class="payment-badge payment-badge--secure">Seguro</span>
                                        </div>
                                        <p class="payment-description">Proteção do comprador internacional</p>
                                    </div>
                                </label>
                                
                                <!-- Transferência Bancária (Traditional) -->
                                <label class="payment-method payment-method--traditional">
                                    <input type="radio" name="paymentMethod" value="transfer">
                                    <div class="payment-sacred-label">
                                        <div class="payment-header">
                                            <span class="payment-icon">🏦</span>
                                            <span class="payment-name">Transferência Bancária</span>
                                        </div>
                                        <p class="payment-description">IBAN fornecido após confirmação do pedido</p>
                                    </div>
                                </label>
                            </div>
                            
                            <!-- Payment Details (Dynamic per method) -->
                            <div class="payment-details" id="payment-details-mbway" style="display: block;">
                                <h4 class="details-title">Detalhes MB Way</h4>
                                <div class="form-group">
                                    <label for="mbway-phone" class="sacred-label">Número de Telemóvel *</label>
                                    <input type="tel" 
                                           id="mbway-phone" 
                                           name="mbwayPhone"
                                           class="sacred-input" 
                                           placeholder="+351 912 345 678"
                                           pattern="[+]?[0-9]{9,13}">
                                    <small class="input-help">Receberá notificação MB Way para confirmar pagamento</small>
                                </div>
                            </div>
                            
                            <div class="payment-details" id="payment-details-paypal" style="display: none;">
                                <div class="paypal-info">
                                    <p>Será redirecionado para PayPal para completar o pagamento de forma segura.</p>
                                </div>
                            </div>
                            
                            <div class="payment-details" id="payment-details-transfer" style="display: none;">
                                <div class="transfer-info">
                                    <p><strong>IBAN será fornecido</strong> após confirmação do pedido.</p>
                                    <p>Prazo: Até 3 dias úteis após transferência confirmada.</p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="step-actions">
                            <button type="button" class="btn btn--secondary btn--large" onclick="checkoutWizard.prevStep()">
                                <span class="btn-icon">←</span>
                                <span class="btn-text">Voltar</span>
                            </button>
                            <button type="button" class="btn btn--gold btn--large" onclick="checkoutWizard.nextStep()">
                                <span class="btn-text">Rever Pedido</span>
                                <span class="btn-icon">→</span>
                            </button>
                        </div>
                    </section>
                    
                    <!-- STEP 4: Confirmação & Submissão -->
                    <section class="wizard-step wizard-step--hidden" id="step-4" data-step="4">
                        <h2 class="step-title">
                            <span class="step-icon">✨</span>
                            <span class="step-text">Confirmar Pedido</span>
                        </h2>
                        
                        <div class="order-review">
                            <!-- Customer Info Review -->
                            <div class="review-section">
                                <h3 class="review-title">Informações Pessoais</h3>
                                <div class="review-content" id="review-customer-info">
                                    <!-- Populated by JS -->
                                </div>
                                <button type="button" class="review-edit" onclick="checkoutWizard.goToStep(1)">Editar</button>
                            </div>
                            
                            <!-- Shipping Info Review -->
                            <div class="review-section">
                                <h3 class="review-title">Envio</h3>
                                <div class="review-content" id="review-shipping-info">
                                    <!-- Populated by JS -->
                                </div>
                                <button type="button" class="review-edit" onclick="checkoutWizard.goToStep(2)">Editar</button>
                            </div>
                            
                            <!-- Payment Info Review -->
                            <div class="review-section">
                                <h3 class="review-title">Pagamento</h3>
                                <div class="review-content" id="review-payment-info">
                                    <!-- Populated by JS -->
                                </div>
                                <button type="button" class="review-edit" onclick="checkoutWizard.goToStep(3)">Editar</button>
                            </div>
                        </div>
                        
                        <!-- Terms & Conditions -->
                        <div class="terms-section">
                            <label class="terms-checkbox">
                                <input type="checkbox" id="terms-accept" name="termsAccept" required>
                                <span class="checkbox-label">
                                    Li e aceito os <a href="/terms-of-service" target="_blank">Termos de Serviço</a> e a 
                                    <a href="/privacy-policy" target="_blank">Política de Privacidade</a>
                                </span>
                            </label>
                        </div>
                        
                        <div class="step-actions">
                            <button type="button" class="btn btn--secondary btn--large" onclick="checkoutWizard.prevStep()">
                                <span class="btn-icon">←</span>
                                <span class="btn-text">Voltar</span>
                            </button>
                            <button type="button" 
                                    class="btn btn--sacred btn--large" 
                                    id="submit-order-btn"
                                    onclick="checkoutWizard.submitOrder()">
                                <span class="btn-text">Finalizar Pedido Sagrado</span>
                                <span class="btn-icon">✨</span>
                            </button>
                        </div>
                    </section>
                    
                </div>
                
                <!-- Right Column: Order Summary -->
                <aside class="checkout-summary">
                    <div class="summary-card">
                        <h3 class="summary-title">Resumo do Pedido</h3>
                        
                        <!-- Cart Items -->
                        <div class="summary-items" id="summary-items">
                            <!-- Populated by JS from localStorage cart -->
                        </div>
                        
                        <!-- Totals -->
                        <div class="summary-totals">
                            <div class="total-line">
                                <span>Subtotal</span>
                                <span id="summary-subtotal">€0.00</span>
                            </div>
                            <div class="total-line">
                                <span>Envio</span>
                                <span id="summary-shipping">€5.99</span>
                            </div>
                            <div class="total-line total-line--tax">
                                <span>IVA (23%)</span>
                                <span id="summary-tax">€0.00</span>
                            </div>
                            <div class="total-line total-line--final">
                                <span>Total</span>
                                <span id="summary-total">€0.00</span>
                            </div>
                        </div>
                        
                        <!-- Trust Signals -->
                        <div class="trust-signals">
                            <div class="trust-item">
                                <span class="trust-icon">🔒</span>
                                <span class="trust-text">Pagamento Seguro</span>
                            </div>
                            <div class="trust-item">
                                <span class="trust-icon">✅</span>
                                <span class="trust-text">Autenticidade Garantida</span>
                            </div>
                            <div class="trust-item">
                                <span class="trust-icon">📦</span>
                                <span class="trust-text">Envio Cuidadoso</span>
                            </div>
                            <div class="trust-item">
                                <span class="trust-icon">💎</span>
                                <span class="trust-text">Artesanato Português</span>
                            </div>
                        </div>
                    </div>
                </aside>
                
            </div>
            
        </div>
    </main>
    
    <!-- Footer Minimal -->
    <footer class="checkout-footer">
        <div class="container">
            <div class="footer-links">
                <a href="/envios">Envios</a>
                <a href="/privacy-policy">Privacidade</a>
                <a href="/terms-of-service">Termos</a>
                <a href="/contacto">Ajuda</a>
            </div>
            <p class="footer-copy">&copy; 2025 Gonzaga Art & Shine. Elegância que nasce da terra.</p>
        </div>
    </footer>
    
    <!-- Scripts -->
    <script src="/js/checkout-premium-dark-nature.js"></script>
    <script>
        // Initialize checkout wizard
        const checkoutWizard = new CheckoutPremiumDarkNature();
        checkoutWizard.init();
    </script>
</body>
</html>

