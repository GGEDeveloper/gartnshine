<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gonzaga Art & Shine - Elegância que nasce da terra</title>
    
    <!-- SEO Meta Tags -->
    <meta name="description" content="Joias artesanais em prata 925 com pedras naturais. Ónix e olho-de-tigre, elegância gothic natural que nasce da terra.">
    <meta name="keywords" content="joias ónix, olho-de-tigre, prata 925, artesanal, gothic natural, elegância terra, portugal">
    
    <!-- Open Graph -->
    <meta property="og:title" content="Gonzaga Art & Shine - Elegância que nasce da terra">
    <meta property="og:description" content="Joias únicas em prata 925 com ónix e olho-de-tigre. Elegância gothic natural autêntica.">
    <meta property="og:image" content="/images/og-dark-nature.jpg">
    <meta property="og:type" content="website">
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Gonzaga Art & Shine - Elegância que nasce da terra">
    <meta name="twitter:description" content="Joias gothic natural em prata 925 com pedras autênticas">
    <meta name="twitter:image" content="/images/og-dark-nature.jpg">
    
    <!-- Preconnect para Performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    <!-- Google Fonts - Dark Nature Typography -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Source+Sans+3:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <!-- CSS Dark Nature - Ordem Crítica -->
    <link rel="stylesheet" href="/css/tokens-dark-nature.css">
    <link rel="stylesheet" href="/css/base-dark-nature.css">
    <link rel="stylesheet" href="/css/components-dark-nature.css">
    <link rel="stylesheet" href="/css/pages-dark-nature.css">
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg">
    <link rel="alternate icon" href="/favicon-dark.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-dark.png">
</head>
<body class="home-dark-nature">
    <!-- Skip Link para Acessibilidade -->
    <a href="#main-content" class="skip-link">Saltar para conteúdo principal</a>
    
    <!-- Navigation -->
    <%- include('../partials/header-dark-nature') %>
    
    <!-- Main Content -->
    <main id="main-content">
        
        <!-- Hero Section: Ónix - Força em Negro Profundo -->
        <section class="hero hero--onyx" data-stone-theme="onyx" aria-labelledby="hero-onyx-title">
            <div class="hero__background">
                <div class="hero__overlay"></div>
            </div>
            
            <div class="container">
                <div class="hero__content">
                    <div class="hero__text">
                        <span class="hero__subtitle" data-aos="fade-up" data-aos-delay="100">
                            Coleção Ónix
                        </span>
                        
                        <h1 id="hero-onyx-title" class="hero__title" data-aos="fade-up" data-aos-delay="200">
                            <span class="hero__title-line">Ónix —</span>
                            <span class="hero__title-line hero__title-line--accent">Força em negro profundo</span>
                        </h1>
                        
                        <p class="hero__description" data-aos="fade-up" data-aos-delay="300">
                            A prata 925 destaca a energia serena desta pedra de proteção ancestral. 
                            Cada peça carrega consigo a força da terra e a elegância atemporal.
                        </p>
                        
                        <div class="hero__cta" data-aos="fade-up" data-aos-delay="400">
                            <a href="/catalogo?pedra=onix" class="btn btn--silver btn--large">
                                <span class="btn__text">Ver Coleção Ónix</span>
                                <span class="btn__icon" aria-hidden="true">→</span>
                            </a>
                            
                            <a href="/manifesto" class="btn btn--gold-outline btn--large">
                                <span class="btn__text">Origem e Cuidados</span>
                            </a>
                        </div>
                        
                        <!-- Trust Indicators -->
                        <div class="hero__trust" data-aos="fade-up" data-aos-delay="500">
                            <div class="trust-indicator">
                                <span class="trust-indicator__icon" aria-hidden="true">⚡</span>
                                <span class="trust-indicator__text">Prata 925 Autêntica</span>
                            </div>
                            <div class="trust-indicator">
                                <span class="trust-indicator__icon" aria-hidden="true">🏔️</span>
                                <span class="trust-indicator__text">Origem Rastreável</span>
                            </div>
                            <div class="trust-indicator">
                                <span class="trust-indicator__icon" aria-hidden="true">✋</span>
                                <span class="trust-indicator__text">Artesanal</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Scroll Indicator -->
            <div class="hero__scroll-indicator" data-aos="fade-up" data-aos-delay="600">
                <div class="scroll-indicator">
                    <div class="scroll-indicator__mouse">
                        <div class="scroll-indicator__wheel"></div>
                    </div>
                    <span class="scroll-indicator__text">Descobre mais</span>
                </div>
            </div>
        </section>
        
        <!-- Hero Section: Olho-de-tigre - Poder Dourado da Terra -->
        <section class="hero hero--tiger-eye" data-stone-theme="tiger-eye" aria-labelledby="hero-tiger-title">
            <div class="hero__background">
                <div class="hero__overlay"></div>
            </div>
            
            <div class="container">
                <div class="hero__content">
                    <div class="hero__text">
                        <span class="hero__subtitle" data-aos="fade-up" data-aos-delay="100">
                            Coleção Olho-de-tigre
                        </span>
                        
                        <h2 id="hero-tiger-title" class="hero__title" data-aos="fade-up" data-aos-delay="200">
                            <span class="hero__title-line">Olho-de-tigre —</span>
                            <span class="hero__title-line hero__title-line--accent">Poder dourado da terra</span>
                        </h2>
                        
                        <p class="hero__description" data-aos="fade-up" data-aos-delay="300">
                            Veios quentes, presença magnética, coragem em cada detalhe. 
                            A energia dourada que desperta a força interior e a confiança.
                        </p>
                        
                        <div class="hero__cta" data-aos="fade-up" data-aos-delay="400">
                            <a href="/catalogo?pedra=olho-de-tigre" class="btn btn--gold btn--large">
                                <span class="btn__text">Explorar Peças</span>
                                <span class="btn__icon" aria-hidden="true">→</span>
                            </a>
                            
                            <a href="/catalogo" class="btn btn--silver-outline btn--large">
                                <span class="btn__text">Ver Tudo</span>
                            </a>
                        </div>
                        
                        <!-- Trust Indicators -->
                        <div class="hero__trust" data-aos="fade-up" data-aos-delay="500">
                            <div class="trust-indicator">
                                <span class="trust-indicator__icon" aria-hidden="true">🔥</span>
                                <span class="trust-indicator__text">Energia Autêntica</span>
                            </div>
                            <div class="trust-indicator">
                                <span class="trust-indicator__icon" aria-hidden="true">🌍</span>
                                <span class="trust-indicator__text">África do Sul</span>
                            </div>
                            <div class="trust-indicator">
                                <span class="trust-indicator__icon" aria-hidden="true">💫</span>
                                <span class="trust-indicator__text">Coragem Natural</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        
        <!-- Featured Products Section -->
        <section class="featured-products" id="produtos-destaque" aria-labelledby="featured-title">
            <div class="container">
                <header class="section-header" data-aos="fade-up">
                    <span class="section-header__subtitle">Seleção Especial</span>
                    <h2 id="featured-title" class="section-header__title">Peças que Contam Histórias</h2>
                    <p class="section-header__description">
                        Cada criação nasce da união entre tradição ancestral e design contemporâneo. 
                        Descubra a origem das matérias que dão vida às nossas joias.
                    </p>
                </header>
                
                <div class="featured-products__grid" data-aos="fade-up" data-aos-delay="200">
                    <% if (locals.produtosDestaque && produtosDestaque.length > 0) { %>
                        <% produtosDestaque.slice(0, 6).forEach(produto => { %>
                            <article class="product-card" data-stone="<%= produto.stone_type %>">
                                <a href="/produto/<%= produto.slug %>" class="product-card__link">
                                    <div class="product-card__image">
                                        <img src="<%= produto.imagem_principal || '/images/placeholder-produto.jpg' %>" 
                                             alt="<%= produto.nome %> - <%= produto.pedra_nome %> em <%= produto.metal_nome %>"
                                             loading="lazy"
                                             class="product-card__img">
                                        
                                        <% if (produto.stone_type) { %>
                                            <span class="product-card__badge product-card__badge--<%= produto.stone_type %>">
                                                <%= produto.stone_type === 'onix' ? 'Ónix' : 'Olho-de-tigre' %>
                                            </span>
                                        <% } %>
                                    </div>
                                    
                                    <div class="product-card__content">
                                        <h3 class="product-card__title"><%= produto.nome %></h3>
                                        
                                        <div class="product-card__meta">
                                            <span class="product-card__stone"><%= produto.pedra_nome || 'Pedra natural' %></span>
                                            <span class="product-card__separator" aria-hidden="true">•</span>
                                            <span class="product-card__metal"><%= produto.metal_nome || 'Prata 925' %></span>
                                        </div>
                                        
                                        <div class="product-card__price">
                                            <%= produto.preco_formatado || 'Consultar' %>
                                        </div>
                                        
                                        <% if (produto.stone_origin) { %>
                                            <div class="product-card__origin">
                                                <span class="product-card__origin-label">Origem:</span>
                                                <span class="product-card__origin-value"><%= produto.stone_origin %></span>
                                            </div>
                                        <% } %>
                                    </div>
                                </a>
                            </article>
                        <% }) %>
                    <% } else { %>
                        <!-- Produtos Exemplo Estáticos para Demo -->
                        <article class="product-card" data-stone="onix">
                            <a href="/produto/anel-onix-protecao" class="product-card__link">
                                <div class="product-card__image">
                                    <img src="/images/produtos/onix/anel-protecao-01.jpg" 
                                         alt="Anel Ónix Proteção - Ónix em Prata 925"
                                         loading="lazy"
                                         class="product-card__img">
                                    <span class="product-card__badge product-card__badge--onix">Ónix</span>
                                </div>
                                <div class="product-card__content">
                                    <h3 class="product-card__title">Anel Ónix Proteção</h3>
                                    <div class="product-card__meta">
                                        <span class="product-card__stone">Ónix</span>
                                        <span class="product-card__separator" aria-hidden="true">•</span>
                                        <span class="product-card__metal">Prata 925</span>
                                    </div>
                                    <div class="product-card__price">€59,90</div>
                                    <div class="product-card__origin">
                                        <span class="product-card__origin-label">Origem:</span>
                                        <span class="product-card__origin-value">Brasil</span>
                                    </div>
                                </div>
                            </a>
                        </article>
                        
                        <article class="product-card" data-stone="tiger-eye">
                            <a href="/produto/colar-olho-tigre-coragem" class="product-card__link">
                                <div class="product-card__image">
                                    <img src="/images/produtos/olho-de-tigre/colar-coragem-01.jpg" 
                                         alt="Colar Olho-de-tigre Coragem - Olho-de-tigre em Prata 925"
                                         loading="lazy"
                                         class="product-card__img">
                                    <span class="product-card__badge product-card__badge--tiger-eye">Olho-de-tigre</span>
                                </div>
                                <div class="product-card__content">
                                    <h3 class="product-card__title">Colar Olho-de-tigre Coragem</h3>
                                    <div class="product-card__meta">
                                        <span class="product-card__stone">Olho-de-tigre</span>
                                        <span class="product-card__separator" aria-hidden="true">•</span>
                                        <span class="product-card__metal">Prata 925</span>
                                    </div>
                                    <div class="product-card__price">€79,90</div>
                                    <div class="product-card__origin">
                                        <span class="product-card__origin-label">Origem:</span>
                                        <span class="product-card__origin-value">África do Sul</span>
                                    </div>
                                </div>
                            </a>
                        </article>
                    <% } %>
                </div>
                
                <div class="featured-products__cta" data-aos="fade-up" data-aos-delay="400">
                    <a href="/catalogo" class="btn btn--gold-outline btn--large">
                        <span class="btn__text">Ver Toda a Coleção</span>
                        <span class="btn__icon" aria-hidden="true">→</span>
                    </a>
                </div>
            </div>
        </section>
        
        <!-- About Section - Manifesto -->
        <section class="manifesto-preview" id="manifesto" aria-labelledby="manifesto-title">
            <div class="container">
                <div class="manifesto-preview__content" data-aos="fade-up">
                    <div class="manifesto-preview__text">
                        <span class="section-header__subtitle">O Nosso Manifesto</span>
                        <h2 id="manifesto-title" class="section-header__title">Elegância que Nasce da Terra</h2>
                        
                        <div class="manifesto-preview__description">
                            <p class="lead">
                                Cada joia Gonzaga carrega em si a história da terra de onde nasceu. 
                                Do ónix brasileiro ao olho-de-tigre sul-africano, honramos a origem 
                                de cada matéria com transparência radical.
                            </p>
                            
                            <p>
                                A nossa arte é a união entre tradição ancestral e design contemporâneo, 
                                onde cada peça é criada à mão com técnicas portuguesas passadas de 
                                geração em geração.
                            </p>
                        </div>
                        
                        <div class="manifesto-preview__values">
                            <div class="value-item">
                                <h3 class="value-item__title">Autenticidade Radical</h3>
                                <p class="value-item__text">
                                    Nunca inventamos origens. Cada pedra tem a sua história verdadeira.
                                </p>
                            </div>
                            
                            <div class="value-item">
                                <h3 class="value-item__title">Origem Transparente</h3>
                                <p class="value-item__text">
                                    Conhece o artesão, a região da pedra e a técnica utilizada.
                                </p>
                            </div>
                            
                            <div class="value-item">
                                <h3 class="value-item__title">Qualidade Sobre Quantidade</h3>
                                <p class="value-item__text">
                                    Preferimos menos produtos com mais qualidade e significado.
                                </p>
                            </div>
                        </div>
                        
                        <div class="manifesto-preview__cta">
                            <a href="/manifesto" class="btn btn--silver btn--large">
                                <span class="btn__text">Ler Manifesto Completo</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        
        <!-- CTA Final -->
        <section class="cta-final" aria-labelledby="cta-title">
            <div class="container">
                <div class="cta-final__content" data-aos="zoom-in">
                    <div class="cta-final__text">
                        <h2 id="cta-title" class="cta-final__title">
                            Pronto para descobrir a tua próxima joia favorita?
                        </h2>
                        <p class="cta-final__description">
                            Explora a nossa coleção completa ou contacta-nos para criações personalizadas
                        </p>
                    </div>
                    
                    <div class="cta-final__actions">
                        <a href="/catalogo" class="btn btn--gold btn--large">
                            <span class="btn__text">Explorar Coleção</span>
                            <span class="btn__icon" aria-hidden="true">💎</span>
                        </a>
                        
                        <a href="/contacto" class="btn btn--silver-outline btn--large">
                            <span class="btn__text">Contactar</span>
                        </a>
                    </div>
                </div>
            </div>
        </section>
        
    </main>
    
    <!-- Footer -->
    <%- include('../partials/footer-dark-nature') %>
    
    <!-- Scripts -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        // Initialize AOS (Animate On Scroll)
        AOS.init({
            duration: 800,
            easing: 'ease-in-out',
            once: true,
            offset: 100,
            disable: 'mobile' // Desabilitar animações em mobile para performance
        });
        
        // Lazy Loading Manual Fallback
        if ('loading' in HTMLImageElement.prototype) {
            const images = document.querySelectorAll('img[loading="lazy"]');
            images.forEach(img => {
                img.onload = () => img.classList.add('loaded');
            });
        } else {
            // Intersection Observer fallback para browsers antigos
            const imageObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const img = entry.target;
                        img.src = img.dataset.src;
                        img.classList.add('loaded');
                        imageObserver.unobserve(img);
                    }
                });
            });
            
            document.querySelectorAll('img[loading="lazy"]').forEach(img => {
                imageObserver.observe(img);
            });
        }
        
        // Analytics - Product View Tracking
        function trackProductView(productId, productName, stoneType) {
            // Google Analytics 4
            if (typeof gtag !== 'undefined') {
                gtag('event', 'view_item', {
                    currency: 'EUR',
                    value: 0, // Adicionar valor real se disponível
                    items: [{
                        item_id: productId,
                        item_name: productName,
                        item_category: 'Joias',
                        item_category2: stoneType === 'onix' ? 'Ónix' : 'Olho-de-tigre'
                    }]
                });
            }
        }
        
        // Track clicks em produtos
        document.querySelectorAll('.product-card__link').forEach(link => {
            link.addEventListener('click', function() {
                const card = this.closest('.product-card');
                const productName = card.querySelector('.product-card__title').textContent;
                const stoneType = card.dataset.stone;
                const productId = this.href.split('/').pop();
                
                trackProductView(productId, productName, stoneType);
            });
        });
    </script>
    
    <!-- AOS CSS -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
</body>
</html>