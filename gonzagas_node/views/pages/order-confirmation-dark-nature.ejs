<!DOCTYPE html>
<html lang="pt" data-theme="dark-nature">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <!-- Dark Nature CSS -->
    <link rel="stylesheet" href="/css/tokens-dark-nature.css">
    <link rel="stylesheet" href="/css/base-dark-nature.css">
    <link rel="stylesheet" href="/css/components-dark-nature.css">
    
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Source+Sans+3:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <style>
        /* Order Confirmation Specific Styles */
        .order-confirmation-page {
            background: var(--black);
            color: var(--ivory);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        
        .confirmation-header {
            background: rgba(11,13,12,0.95);
            border-bottom: 1px solid rgba(110,107,101,0.2);
            padding: var(--space-xl) 0;
        }
        
        .confirmation-brand {
            text-align: center;
        }
        
        .brand-link {
            display: inline-flex;
            align-items: baseline;
            gap: var(--space-xs);
            text-decoration: none;
        }
        
        .brand-link .brand-name {
            font-family: var(--font-heading);
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--ivory);
        }
        
        .brand-link .brand-accent {
            font-family: var(--font-heading);
            font-size: 1rem;
            color: var(--gold-old);
        }
        
        .confirmation-main {
            flex: 1;
            padding: var(--space-4xl) 0;
        }
        
        .confirmation-hero {
            text-align: center;
            margin-bottom: var(--space-4xl);
        }
        
        .success-icon {
            font-size: 5rem;
            margin-bottom: var(--space-xl);
            animation: successPulse 2s ease-in-out infinite;
        }
        
        @keyframes successPulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }
        
        .confirmation-title {
            font-family: var(--font-heading);
            font-size: clamp(2.5rem, 6vw, 4rem);
            font-weight: 700;
            color: var(--gold-old);
            margin-bottom: var(--space-md);
        }
        
        .confirmation-subtitle {
            font-size: 1.1rem;
            color: var(--slate);
            max-width: 600px;
            margin: 0 auto;
        }
        
        .order-info-card {
            background: linear-gradient(145deg, rgba(11,13,12,0.98) 0%, rgba(11,13,12,0.92) 100%);
            border: 1px solid rgba(110,107,101,0.2);
            border-radius: var(--radius-large);
            padding: var(--space-3xl);
            margin-bottom: var(--space-2xl);
            box-shadow: 0 8px 32px rgba(0,0,0,0.3);
        }
        
        .order-number {
            font-size: 1.5rem;
            color: var(--gold-old);
            text-align: center;
            margin-bottom: var(--space-2xl);
        }
        
        .order-items {
            margin: var(--space-2xl) 0;
        }
        
        .confirmation-item {
            display: flex;
            gap: var(--space-lg);
            padding: var(--space-lg);
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(110,107,101,0.1);
            border-radius: var(--radius);
            margin-bottom: var(--space-md);
        }
        
        .item-image {
            width: 80px;
            height: 80px;
            border-radius: var(--radius);
            overflow: hidden;
            background: var(--slate);
            flex-shrink: 0;
        }
        
        .item-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .item-details {
            flex: 1;
        }
        
        .item-name {
            font-family: var(--font-heading);
            font-weight: 600;
            color: var(--ivory);
            margin-bottom: var(--space-xs);
        }
        
        .item-quantity {
            font-size: 0.9rem;
            color: var(--slate);
            margin-bottom: var(--space-xs);
        }
        
        .item-price {
            font-family: var(--font-heading);
            font-weight: 700;
            color: var(--gold-old);
            font-size: 1.1rem;
        }
        
        .order-totals {
            border-top: 2px solid rgba(176,141,87,0.3);
            padding-top: var(--space-xl);
            margin-top: var(--space-xl);
        }
        
        .total-line {
            display: flex;
            justify-content: space-between;
            margin-bottom: var(--space-md);
            font-size: 1rem;
            color: var(--ivory);
        }
        
        .total-line--final {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--gold-old);
            margin-top: var(--space-lg);
            padding-top: var(--space-lg);
            border-top: 1px solid rgba(176,141,87,0.2);
        }
        
        .confirmation-actions {
            display: flex;
            gap: var(--space-lg);
            justify-content: center;
            margin: var(--space-4xl) 0;
            flex-wrap: wrap;
        }
        
        .confirmation-footer {
            background: rgba(11,13,12,0.95);
            border-top: 1px solid rgba(110,107,101,0.2);
            padding: var(--space-2xl) 0;
            text-align: center;
        }
        
        .footer-brand {
            margin-bottom: var(--space-md);
        }
        
        .brand-name {
            font-family: var(--font-heading);
            font-size: 1.2rem;
            color: var(--gold-old);
            display: block;
        }
        
        .brand-tagline {
            color: var(--slate);
            font-style: italic;
            font-size: 0.9rem;
        }
        
        .footer-contact a {
            color: var(--gold-old);
        }
    </style>
</head>
<body class="order-confirmation-page" data-page="order-confirmation">
    
    <!-- Minimal Header -->
    <header class="confirmation-header">
        <div class="container">
            <div class="confirmation-brand">
                <a href="/" class="brand-link">
                    <span class="brand-name">Gonzaga</span>
                    <span class="brand-accent">Art & Shine</span>
                </a>
            </div>
        </div>
    </header>
    
    <main class="confirmation-main">
        <div class="container">
            
            <!-- Success Hero -->
            <div class="confirmation-hero">
                <div class="success-icon">✨</div>
                <h1 class="confirmation-title">Ritual Sagrado Completo</h1>
                <p class="confirmation-subtitle">
                    O seu pedido <strong><%= order.order_number %></strong> foi recebido com sucesso. 
                    A jornada da sua peça sagrada começou.
                </p>
            </div>
            
            <!-- Order Details -->
            <div class="order-info-card">
                <div class="order-number">
                    Pedido: <strong><%= order.order_number %></strong>
                </div>
                
                <div class="order-items">
                    <h3 style="color: var(--gold-old); margin-bottom: var(--space-lg);">Peças Selecionadas</h3>
                    <% order.items.forEach(item => { %>
                    <div class="confirmation-item">
                        <div class="item-image">
                            <% if (item.image) { %>
                            <img src="/uploads/products/<%= item.image %>" alt="<%= item.name %>" loading="lazy">
                            <% } else { %>
                            <img src="/images/placeholders/product-dark.jpg" alt="<%= item.name %>" loading="lazy">
                            <% } %>
                        </div>
                        <div class="item-details">
                            <div class="item-name"><%= item.name %></div>
                            <div class="item-quantity">Quantidade: <%= item.quantity %></div>
                            <div class="item-price">€<%= (item.price * item.quantity).toFixed(2) %></div>
                        </div>
                    </div>
                    <% }); %>
                </div>
                
                <div class="order-totals">
                    <div class="total-line">
                        <span>Subtotal:</span>
                        <span>€<%= parseFloat(order.subtotal_amount).toFixed(2) %></span>
                    </div>
                    <div class="total-line">
                        <span>Envio:</span>
                        <span>
                            <% if (parseFloat(order.shipping_amount) > 0) { %>
                                €<%= parseFloat(order.shipping_amount).toFixed(2) %>
                            <% } else { %>
                                Grátis
                            <% } %>
                        </span>
                    </div>
                    <div class="total-line total-line--final">
                        <span>Total:</span>
                        <span>€<%= parseFloat(order.total_amount).toFixed(2) %></span>
                    </div>
                </div>
            </div>
            
            <!-- Actions -->
            <div class="confirmation-actions">
                <a href="/order-tracking/<%= order.order_number %>" class="btn btn--gold btn--large">
                    <span class="btn-icon">📦</span>
                    <span class="btn-text">Acompanhar Pedido</span>
                </a>
                <a href="/catalogo" class="btn btn--silver-outline btn--large">
                    <span class="btn-text">Continuar Compras</span>
                    <span class="btn-icon">💎</span>
                </a>
            </div>
            
        </div>
    </main>
    
    <!-- Footer -->
    <footer class="confirmation-footer">
        <div class="container">
            <div class="footer-brand">
                <span class="brand-name">Gonzaga Art & Shine</span>
                <span class="brand-tagline">Elegância que nasce da terra</span>
            </div>
            <div class="footer-contact">
                <p>Dúvidas? <a href="/contacto">Contacte-nos</a></p>
            </div>
        </div>
    </footer>
    
    <script>
        // Analytics tracking
        if (typeof gtag !== 'undefined') {
            gtag('event', 'purchase_confirmation_viewed', {
                order_number: '<%= order.order_number %>',
                order_value: <%= order.total_amount %>,
                payment_method: '<%= order.payment_method %>'
            });
        }
    </script>
</body>
</html>

