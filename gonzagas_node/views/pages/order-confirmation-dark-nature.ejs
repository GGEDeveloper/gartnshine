<!DOCTYPE html>
<html lang="pt" data-theme="dark-nature">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <!-- Dark Nature CSS -->
    <link rel="stylesheet" href="/css/tokens-dark-nature.css">
    <link rel="stylesheet" href="/css/base-dark-nature.css">
    <link rel="stylesheet" href="/css/components-dark-nature.css">
    
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Source+Sans+3:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <style>
        /* Order Confirmation Specific Styles */
        .order-confirmation-page {
            background: var(--black);
            color: var(--ivory);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        
        .confirmation-header {
            background: rgba(11,13,12,0.95);
            border-bottom: 1px solid rgba(110,107,101,0.2);
            padding: var(--space-xl) 0;
        }
        
        .confirmation-brand {
            text-align: center;
        }
        
        .brand-link {
            display: inline-flex;
            align-items: baseline;
            gap: var(--space-xs);
            text-decoration: none;
        }
        
        .brand-link .brand-name {
            font-family: var(--font-heading);
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--ivory);
        }
        
        .brand-link .brand-accent {
            font-family: var(--font-heading);
            font-size: 1rem;
            color: var(--gold-old);
        }
        
        .confirmation-main {
            flex: 1;
            padding: var(--space-4xl) 0;
        }
        
        .confirmation-hero {
            text-align: center;
            margin-bottom: var(--space-4xl);
        }
        
        .success-icon {
            font-size: 5rem;
            margin-bottom: var(--space-xl);
            animation: successPulse 2s ease-in-out infinite;
        }
        
        @keyframes successPulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }
        
        .confirmation-title {
            font-family: var(--font-heading);
            font-size: clamp(2.5rem, 6vw, 4rem);
            font-weight: 700;
            color: var(--gold-old);
            margin-bottom: var(--space-md);
        }
        
        .confirmation-subtitle {
            font-size: 1.1rem;
            color: var(--slate);
            max-width: 600px;
            margin: 0 auto;
        }
        
        .order-info-card {
            background: linear-gradient(145deg, rgba(11,13,12,0.98) 0%, rgba(11,13,12,0.92) 100%);
            border: 1px solid rgba(110,107,101,0.2);
            border-radius: var(--radius-large);
            padding: var(--space-3xl);
            margin-bottom: var(--space-2xl);
            box-shadow: 0 8px 32px rgba(0,0,0,0.3);
        }
        
        .order-number {
            font-size: 1.5rem;
            color: var(--gold-old);
            text-align: center;
            margin-bottom: var(--space-2xl);
        }
        
        .order-items {
            margin: var(--space-2xl) 0;
        }
        
        .confirmation-item {
            display: flex;
            gap: var(--space-lg);
            padding: var(--space-lg);
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(110,107,101,0.1);
            border-radius: var(--radius);
            margin-bottom: var(--space-md);
        }
        
        .item-image {
            width: 80px;
            height: 80px;
            border-radius: var(--radius);
            overflow: hidden;
            background: var(--slate);
            flex-shrink: 0;
        }
        
        .item-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .item-details {
            flex: 1;
        }
        
        .item-name {
            font-family: var(--font-heading);
            font-weight: 600;
            color: var(--ivory);
            margin-bottom: var(--space-xs);
        }
        
        .item-quantity {
            font-size: 0.9rem;
            color: var(--slate);
            margin-bottom: var(--space-xs);
        }
        
        .item-price {
            font-family: var(--font-heading);
            font-weight: 700;
            color: var(--gold-old);
            font-size: 1.1rem;
        }
        
        .order-totals {
            border-top: 2px solid rgba(176,141,87,0.3);
            padding-top: var(--space-xl);
            margin-top: var(--space-xl);
        }
        
        .total-line {
            display: flex;
            justify-content: space-between;
            margin-bottom: var(--space-md);
            font-size: 1rem;
            color: var(--ivory);
        }
        
        .total-line--final {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--gold-old);
            margin-top: var(--space-lg);
            padding-top: var(--space-lg);
            border-top: 1px solid rgba(176,141,87,0.2);
        }
        
        .confirmation-actions {
            display: flex;
            gap: var(--space-lg);
            justify-content: center;
            margin: var(--space-4xl) 0;
            flex-wrap: wrap;
        }
        
        .confirmation-footer {
            background: rgba(11,13,12,0.95);
            border-top: 1px solid rgba(110,107,101,0.2);
            padding: var(--space-2xl) 0;
            text-align: center;
        }
        
        .footer-brand {
            margin-bottom: var(--space-md);
        }
        
        .brand-name {
            font-family: var(--font-heading);
            font-size: 1.2rem;
            color: var(--gold-old);
            display: block;
        }
        
        .brand-tagline {
            color: var(--slate);
            font-style: italic;
            font-size: 0.9rem;
        }
        
        .footer-contact a {
            color: var(--gold-old);
        }
        
        /* Timeline Styles */
        .delivery-timeline {
            position: relative;
            padding-left: var(--space-3xl);
        }
        
        .delivery-timeline::before {
            content: '';
            position: absolute;
            left: 20px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: linear-gradient(180deg, rgba(176,141,87,0.5) 0%, rgba(176,141,87,0.1) 100%);
        }
        
        .timeline-step {
            position: relative;
            margin-bottom: var(--space-2xl);
            display: flex;
            gap: var(--space-lg);
        }
        
        .timeline-icon {
            position: absolute;
            left: -48px;
            width: 40px;
            height: 40px;
            background: rgba(11,13,12,0.9);
            border: 2px solid rgba(110,107,101,0.3);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            z-index: 2;
        }
        
        .timeline-step--active .timeline-icon {
            background: linear-gradient(135deg, var(--gold-old) 0%, rgba(176,141,87,0.9) 100%);
            border-color: var(--gold-old);
            box-shadow: 0 0 20px rgba(176,141,87,0.4);
        }
        
        .timeline-content {
            flex: 1;
        }
        
        .timeline-title {
            font-family: var(--font-heading);
            font-weight: 600;
            color: var(--ivory);
            font-size: 1.1rem;
            margin-bottom: 4px;
        }
        
        .timeline-date {
            color: var(--gold-old);
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: var(--space-sm);
        }
        
        .timeline-description {
            color: var(--slate);
            font-size: 0.95rem;
            line-height: 1.5;
        }
        
        /* Detail Rows */
        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: var(--space-sm) 0;
            border-bottom: 1px solid rgba(110,107,101,0.1);
        }
        
        .detail-label {
            color: var(--slate);
            font-size: 0.9rem;
        }
        
        .detail-value {
            color: var(--ivory);
            font-weight: 500;
        }
        
        /* Status Badges */
        .status-badge {
            padding: 4px 12px;
            border-radius: var(--radius);
            font-size: 0.85rem;
            font-weight: 600;
        }
        
        .status-badge--success {
            background: rgba(34,139,34,0.2);
            color: rgba(34,139,34,1);
            border: 1px solid rgba(34,139,34,0.4);
        }
        
        .status-badge--pending {
            background: rgba(255,165,0,0.2);
            color: rgba(255,165,0,1);
            border: 1px solid rgba(255,165,0,0.4);
        }
        
        /* Payment Instructions */
        .payment-instructions {
            margin-top: var(--space-lg);
            padding: var(--space-lg);
            background: rgba(176,141,87,0.05);
            border: 1px solid rgba(176,141,87,0.2);
            border-radius: var(--radius);
        }
        
        .iban-box {
            background: rgba(11,13,12,0.8);
            border: 1px solid rgba(176,141,87,0.3);
            padding: var(--space-md);
            border-radius: var(--radius);
            font-family: monospace;
            font-size: 1.1rem;
            color: var(--gold-old);
            text-align: center;
            margin-top: var(--space-sm);
            letter-spacing: 0.05em;
        }
        
        /* Next Steps Grid */
        .next-steps-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: var(--space-xl);
        }
        
        .next-step-item {
            display: flex;
            gap: var(--space-md);
        }
        
        .step-number {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--gold-old) 0%, rgba(176,141,87,0.9) 100%);
            color: var(--black);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-heading);
            font-weight: 700;
            font-size: 1.2rem;
            flex-shrink: 0;
        }
        
        .step-content {
            flex: 1;
        }
        
        .step-title {
            font-family: var(--font-heading);
            font-weight: 600;
            color: var(--ivory);
            margin-bottom: var(--space-xs);
            font-size: 1rem;
        }
        
        .step-text {
            color: var(--slate);
            font-size: 0.9rem;
            line-height: 1.5;
            margin: 0;
        }
        
        /* Responsive */
        @media (max-width: 768px) {
            .next-steps-grid {
                grid-template-columns: 1fr;
            }
            
            .order-info-card > div[style*="grid-template-columns"] {
                grid-template-columns: 1fr !important;
            }
            
            .delivery-timeline {
                padding-left: var(--space-2xl);
            }
            
            .timeline-icon {
                left: -42px;
                width: 35px;
                height: 35px;
                font-size: 1.1rem;
            }
        }
    </style>
</head>
<body class="order-confirmation-page" data-page="order-confirmation">
    
    <!-- Minimal Header -->
    <header class="confirmation-header">
        <div class="container">
            <div class="confirmation-brand">
                <a href="/" class="brand-link">
                    <span class="brand-name">Gonzaga</span>
                    <span class="brand-accent">Art & Shine</span>
                </a>
            </div>
        </div>
    </header>
    
    <main class="confirmation-main">
        <div class="container">
            
            <!-- Success Hero -->
            <div class="confirmation-hero">
                <div class="success-icon">✨</div>
                <h1 class="confirmation-title">Ritual Sagrado Completo</h1>
                <p class="confirmation-subtitle">
                    O seu pedido <strong><%= order.order_number %></strong> foi recebido com sucesso. 
                    A jornada da sua peça sagrada começou.
                </p>
            </div>
            
            <!-- Order Details -->
            <div class="order-info-card">
                <div class="order-number">
                    Pedido: <strong><%= order.order_number %></strong>
                </div>
                
                <div class="order-items">
                    <h3 style="color: var(--gold-old); margin-bottom: var(--space-lg);">Peças Selecionadas</h3>
                    <% order.items.forEach(item => { %>
                    <div class="confirmation-item">
                        <div class="item-image">
                            <% if (item.image) { %>
                            <img src="/uploads/products/<%= item.image %>" alt="<%= item.name %>" loading="lazy">
                            <% } else { %>
                            <img src="/images/placeholders/product-dark.jpg" alt="<%= item.name %>" loading="lazy">
                            <% } %>
                        </div>
                        <div class="item-details">
                            <div class="item-name"><%= item.name %></div>
                            <div class="item-quantity">Quantidade: <%= item.quantity %></div>
                            <div class="item-price">€<%= (item.price * item.quantity).toFixed(2) %></div>
                        </div>
                    </div>
                    <% }); %>
                </div>
                
                <div class="order-totals">
                    <div class="total-line">
                        <span>Subtotal:</span>
                        <span>€<%= parseFloat(order.subtotal_amount).toFixed(2) %></span>
                    </div>
                    <div class="total-line">
                        <span>Envio:</span>
                        <span>
                            <% if (parseFloat(order.shipping_amount) > 0) { %>
                                €<%= parseFloat(order.shipping_amount).toFixed(2) %>
                            <% } else { %>
                                Grátis
                            <% } %>
                        </span>
                    </div>
                    <div class="total-line total-line--final">
                        <span>Total:</span>
                        <span>€<%= parseFloat(order.total_amount).toFixed(2) %></span>
                    </div>
                </div>
            </div>
            
            <!-- Delivery Timeline -->
            <div class="order-info-card">
                <h3 style="color: var(--gold-old); margin-bottom: var(--space-2xl); font-family: var(--font-heading); font-size: 1.4rem;">
                    <span style="margin-right: var(--space-sm);">📍</span>
                    Jornada da Sua Peça Sagrada
                </h3>
                
                <div class="delivery-timeline">
                    <div class="timeline-step timeline-step--active">
                        <div class="timeline-icon">✅</div>
                        <div class="timeline-content">
                            <div class="timeline-title">Pedido Confirmado</div>
                            <div class="timeline-date">Hoje</div>
                            <div class="timeline-description">Recebemos o seu pedido e iniciámos o processo de preparação artesanal.</div>
                        </div>
                    </div>
                    
                    <div class="timeline-step">
                        <div class="timeline-icon">⚒️</div>
                        <div class="timeline-content">
                            <div class="timeline-title">Em Preparação</div>
                            <div class="timeline-date">1-2 dias úteis</div>
                            <div class="timeline-description">Os nossos artesãos preparam e embalam cuidadosamente a sua peça.</div>
                        </div>
                    </div>
                    
                    <% if (order.shipping_method === 'express') { %>
                    <div class="timeline-step">
                        <div class="timeline-icon">⚡</div>
                        <div class="timeline-content">
                            <div class="timeline-title">Envio Expresso</div>
                            <div class="timeline-date">1-2 dias úteis</div>
                            <div class="timeline-description">Entrega prioritária através de transportadora certificada.</div>
                        </div>
                    </div>
                    <% } else { %>
                    <div class="timeline-step">
                        <div class="timeline-icon">📮</div>
                        <div class="timeline-content">
                            <div class="timeline-title">Envio Standard</div>
                            <div class="timeline-date">3-5 dias úteis</div>
                            <div class="timeline-description">Envio seguro através dos CTT - Correios de Portugal.</div>
                        </div>
                    </div>
                    <% } %>
                    
                    <div class="timeline-step">
                        <div class="timeline-icon">🏠</div>
                        <div class="timeline-content">
                            <div class="timeline-title">Entrega na Morada</div>
                            <div class="timeline-date">
                                <% if (order.shipping_method === 'express') { %>
                                    Estimativa: 3-4 dias úteis
                                <% } else { %>
                                    Estimativa: 5-7 dias úteis
                                <% } %>
                            </div>
                            <div class="timeline-description">A sua peça sagrada chega ao destino final com amor e cuidado.</div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Payment & Delivery Details -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2xl); margin-bottom: var(--space-3xl);">
                
                <!-- Payment Details -->
                <div class="order-info-card">
                    <h4 style="color: var(--gold-old); margin-bottom: var(--space-lg); font-family: var(--font-heading);">
                        <span style="margin-right: var(--space-sm);">💳</span>
                        Detalhes de Pagamento
                    </h4>
                    <div class="detail-row">
                        <span class="detail-label">Método:</span>
                        <span class="detail-value">
                            <% if (order.payment_method === 'mbway') { %>
                                MB Way
                            <% } else if (order.payment_method === 'paypal') { %>
                                PayPal
                            <% } else { %>
                                Transferência Bancária
                            <% } %>
                        </span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Status:</span>
                        <span class="detail-value">
                            <% if (order.payment_status === 'completed') { %>
                                <span class="status-badge status-badge--success">✓ Pago</span>
                            <% } else if (order.payment_status === 'pending') { %>
                                <span class="status-badge status-badge--pending">⏱ Pendente</span>
                            <% } %>
                        </span>
                    </div>
                    <% if (order.payment_method === 'transfer' && order.payment_status === 'pending') { %>
                    <div class="payment-instructions">
                        <strong>IBAN para Transferência:</strong>
                        <div class="iban-box">PT50 0033 0000 0000 0000 0000 0</div>
                        <small style="color: var(--slate); display: block; margin-top: var(--space-sm);">
                            Utilize a referência <strong><%= order.order_number %></strong>
                        </small>
                    </div>
                    <% } %>
                </div>
                
                <!-- Delivery Details -->
                <div class="order-info-card">
                    <h4 style="color: var(--gold-old); margin-bottom: var(--space-lg); font-family: var(--font-heading);">
                        <span style="margin-right: var(--space-sm);">📦</span>
                        Informações de Envio
                    </h4>
                    <div class="detail-row">
                        <span class="detail-label">Nome:</span>
                        <span class="detail-value"><%= order.customer_name %></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Morada:</span>
                        <span class="detail-value"><%= order.customer_address %></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Cidade:</span>
                        <span class="detail-value"><%= order.customer_city %></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Código Postal:</span>
                        <span class="detail-value"><%= order.customer_postal_code %></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Telefone:</span>
                        <span class="detail-value"><%= order.customer_phone || 'N/A' %></span>
                    </div>
                </div>
            </div>
            
            <!-- Next Steps -->
            <div class="order-info-card next-steps-card">
                <h3 style="color: var(--gold-old); margin-bottom: var(--space-xl); font-family: var(--font-heading); font-size: 1.4rem; text-align: center;">
                    <span style="margin-right: var(--space-sm);">✨</span>
                    Próximos Passos
                </h3>
                
                <div class="next-steps-grid">
                    <div class="next-step-item">
                        <div class="step-number">1</div>
                        <div class="step-content">
                            <h5 class="step-title">Confirmação por Email</h5>
                            <p class="step-text">Receberá um email de confirmação em <strong><%= order.customer_email %></strong> com todos os detalhes do seu pedido.</p>
                        </div>
                    </div>
                    
                    <div class="next-step-item">
                        <div class="step-number">2</div>
                        <div class="step-content">
                            <h5 class="step-title">Acompanhamento</h5>
                            <p class="step-text">Aceda ao <a href="/order-tracking/<%= order.order_number %>" style="color: var(--gold-old); text-decoration: underline;">tracking do pedido</a> para ver o status em tempo real.</p>
                        </div>
                    </div>
                    
                    <div class="next-step-item">
                        <div class="step-number">3</div>
                        <div class="step-content">
                            <h5 class="step-title">Notificações de Envio</h5>
                            <p class="step-text">Receberá SMS/email quando a sua peça for enviada, com código de tracking.</p>
                        </div>
                    </div>
                    
                    <div class="next-step-item">
                        <div class="step-number">4</div>
                        <div class="step-content">
                            <h5 class="step-title">Receba & Desfrute</h5>
                            <p class="step-text">Desembale com cuidado e comece a jornada com a sua nova peça sagrada artesanal.</p>
                        </div>
                    </div>
                </div>
                
                <div class="help-section" style="margin-top: var(--space-2xl); padding-top: var(--space-xl); border-top: 1px solid rgba(110,107,101,0.2); text-align: center;">
                    <p style="color: var(--slate); margin-bottom: var(--space-md);">Precisa de ajuda ou tem alguma questão?</p>
                    <a href="/contacto" class="btn btn--secondary">
                        <span class="btn-icon">💬</span>
                        <span class="btn-text">Contacte-nos</span>
                    </a>
                </div>
            </div>
            
            <!-- Actions -->
            <div class="confirmation-actions">
                <a href="/order-tracking/<%= order.order_number %>" class="btn btn--gold btn--large">
                    <span class="btn-icon">📦</span>
                    <span class="btn-text">Acompanhar Pedido</span>
                </a>
                <a href="/catalogo" class="btn btn--silver-outline btn--large">
                    <span class="btn-text">Continuar Compras</span>
                    <span class="btn-icon">💎</span>
                </a>
            </div>
            
        </div>
    </main>
    
    <!-- Footer -->
    <footer class="confirmation-footer">
        <div class="container">
            <div class="footer-brand">
                <span class="brand-name">Gonzaga Art & Shine</span>
                <span class="brand-tagline">Elegância que nasce da terra</span>
            </div>
            <div class="footer-contact">
                <p>Dúvidas? <a href="/contacto">Contacte-nos</a></p>
            </div>
        </div>
    </footer>
    
    <script>
        // Analytics tracking
        if (typeof gtag !== 'undefined') {
            gtag('event', 'purchase_confirmation_viewed', {
                order_number: '<%= order.order_number %>',
                order_value: <%= order.total_amount %>,
                payment_method: '<%= order.payment_method %>'
            });
        }
    </script>
</body>
</html>

