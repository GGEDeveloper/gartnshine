<!DOCTYPE html>
<html lang="pt" data-theme="dark-nature">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Envios & Devoluções - Gonzaga Art & Shine</title>
    
    <!-- Meta Tags -->
    <meta name="description" content="Informações sobre envios, prazos de entrega, custos e política de devoluções para joias artesanais portuguesas.">
    <meta name="keywords" content="envios portugal, devoluções joias, política envios, entrega rápida">
    
    <!-- Dark Nature CSS Stack -->
    <link rel="stylesheet" href="/css/tokens-dark-nature.css">
    <link rel="stylesheet" href="/css/base-dark-nature.css">
    <link rel="stylesheet" href="/css/components-dark-nature.css">
    <link rel="stylesheet" href="/css/support-pages-dark-nature.css">
    
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Source+Sans+3:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>
<body class="support-page envios-page" data-page="envios">
    
    <%- include('../partials/header-dark-nature') %>
    
    <main id="main-content">
        
        <!-- Hero -->
        <section class="support-hero">
            <div class="container">
                <h1 class="hero-title">Envios & Devoluções</h1>
                <p class="hero-subtitle">
                    Entregamos as suas peças sagradas com o máximo cuidado e segurança. Conheça os nossos prazos, custos e política de devoluções.
                </p>
            </div>
        </section>
        
        <!-- Shipping Methods -->
        <section class="shipping-section">
            <div class="container">
                <h2 class="section-title">
                    <span class="title-icon">📦</span>
                    Métodos de Envio
                </h2>
                
                <div class="shipping-methods-grid">
                    <div class="shipping-method-card method-standard">
                        <div class="method-badge">Recomendado</div>
                        <div class="method-icon">📮</div>
                        <h3 class="method-name">Envio Standard</h3>
                        <div class="method-price">€5.99</div>
                        <ul class="method-features">
                            <li>✓ Prazo: 3-5 dias úteis</li>
                            <li>✓ CTT - Correios de Portugal</li>
                            <li>✓ Tracking incluído</li>
                            <li>✓ Seguro até €50</li>
                        </ul>
                        <p class="method-note"><strong>Grátis</strong> em compras acima de €75!</p>
                    </div>
                    
                    <div class="shipping-method-card method-express">
                        <div class="method-badge method-badge--premium">Premium</div>
                        <div class="method-icon">⚡</div>
                        <h3 class="method-name">Envio Expresso</h3>
                        <div class="method-price">€12.99</div>
                        <ul class="method-features">
                            <li>✓ Prazo: 1-2 dias úteis</li>
                            <li>✓ Transportadora certificada</li>
                            <li>✓ Tracking em tempo real</li>
                            <li>✓ Seguro até €100</li>
                            <li>✓ Entrega prioritária</li>
                        </ul>
                        <p class="method-note">Ideal para presentes urgentes!</p>
                    </div>
                </div>
                
                <!-- Shipping Coverage -->
                <div class="shipping-coverage">
                    <h3 class="coverage-title">Onde Enviamos</h3>
                    <div class="coverage-grid">
                        <div class="coverage-region">
                            <span class="region-flag">🇵🇹</span>
                            <span class="region-name">Portugal Continental</span>
                            <span class="region-status">Envio Nacional</span>
                        </div>
                        <div class="coverage-region">
                            <span class="region-flag">🇪🇸</span>
                            <span class="region-name">Espanha</span>
                            <span class="region-status">+€8 • 5-7 dias</span>
                        </div>
                        <div class="coverage-region">
                            <span class="region-flag">🇫🇷</span>
                            <span class="region-name">França</span>
                            <span class="region-status">+€10 • 6-8 dias</span>
                        </div>
                        <div class="coverage-region">
                            <span class="region-flag">🇩🇪</span>
                            <span class="region-name">Alemanha</span>
                            <span class="region-status">+€12 • 7-9 dias</span>
                        </div>
                        <div class="coverage-region">
                            <span class="region-flag">🇮🇹</span>
                            <span class="region-name">Itália</span>
                            <span class="region-status">+€12 • 7-9 dias</span>
                        </div>
                        <div class="coverage-region coverage-region--other">
                            <span class="region-flag">🌍</span>
                            <span class="region-name">Outros Países</span>
                            <span class="region-status"><a href="/contacto">Contacte-nos</a></span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        
        <!-- Returns Policy -->
        <section class="returns-section">
            <div class="container">
                <h2 class="section-title">
                    <span class="title-icon">↩️</span>
                    Política de Devoluções
                </h2>
                
                <div class="returns-content">
                    <div class="returns-highlight">
                        <h3 class="highlight-title">14 Dias de Garantia</h3>
                        <p class="highlight-description">Não ficou satisfeito? Devolvemos o seu dinheiro ou trocamos a peça, sem complicações.</p>
                    </div>
                    
                    <div class="returns-process">
                        <h4 class="process-title">Como Devolver</h4>
                        <div class="process-steps">
                            <div class="process-step">
                                <div class="step-number">1</div>
                                <div class="step-content">
                                    <h5 class="step-title">Contacte-nos</h5>
                                    <p class="step-text">Email ou formulário de contacto indicando número de pedido e motivo.</p>
                                </div>
                            </div>
                            <div class="process-step">
                                <div class="step-number">2</div>
                                <div class="step-content">
                                    <h5 class="step-title">Autorização</h5>
                                    <p class="step-text">Receberá instruções e morada para devolução.</p>
                                </div>
                            </div>
                            <div class="process-step">
                                <div class="step-number">3</div>
                                <div class="step-content">
                                    <h5 class="step-title">Envie a Peça</h5>
                                    <p class="step-text">Embalagem original + certificados. Portes por sua conta.</p>
                                </div>
                            </div>
                            <div class="process-step">
                                <div class="step-number">4</div>
                                <div class="step-content">
                                    <h5 class="step-title">Reembolso</h5>
                                    <p class="step-text">Processado em 5-7 dias após recebermos a peça.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="returns-conditions">
                        <h4 class="conditions-title">Condições de Devolução</h4>
                        <ul class="conditions-list">
                            <li>✓ Peça não usada e em estado original</li>
                            <li>✓ Embalagem original intacta (caixa + bolsa de veludo)</li>
                            <li>✓ Certificado de autenticidade incluído</li>
                            <li>✓ Dentro do prazo de 14 dias após receber</li>
                            <li>✗ Peças personalizadas não são elegíveis para devolução</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>
        
        <!-- Packaging Info -->
        <section class="packaging-section">
            <div class="container">
                <h2 class="section-title">
                    <span class="title-icon">🎁</span>
                    Embalagem Premium
                </h2>
                
                <p class="section-intro">Cada encomenda Gonzaga Art & Shine é uma experiência sagrada desde a abertura da caixa.</p>
                
                <div class="packaging-grid">
                    <div class="packaging-item">
                        <div class="packaging-icon">📦</div>
                        <h4 class="packaging-title">Caixa Rígida</h4>
                        <p class="packaging-description">Protegida com material acolchoado de alta qualidade.</p>
                    </div>
                    <div class="packaging-item">
                        <div class="packaging-icon">💼</div>
                        <h4 class="packaging-title">Bolsa de Veludo</h4>
                        <p class="packaging-description">Premium com logótipo bordado para armazenamento.</p>
                    </div>
                    <div class="packaging-item">
                        <div class="packaging-icon">📜</div>
                        <h4 class="packaging-title">Certificado</h4>
                        <p class="packaging-description">Autenticidade da pedra e composição da prata 925.</p>
                    </div>
                    <div class="packaging-item">
                        <div class="packaging-icon">📖</div>
                        <h4 class="packaging-title">Guia de Cuidados</h4>
                        <p class="packaging-description">Instruções personalizadas para a sua pedra sagrada.</p>
                    </div>
                </div>
                
                <p class="packaging-note">✨ Perfeito para presente! Não incluímos preços na embalagem.</p>
            </div>
        </section>
        
        <!-- CTA -->
        <section class="shipping-cta">
            <div class="container">
                <div class="cta-card">
                    <h3 class="cta-title">Ainda tem dúvidas sobre envios?</h3>
                    <p class="cta-description">A nossa equipa está pronta para ajudar com qualquer questão sobre entregas, acompanhamento ou devoluções.</p>
                    <div class="cta-actions">
                        <a href="/contacto" class="btn btn--gold btn--large">
                            <span class="btn-icon">💬</span>
                            <span class="btn-text">Contactar Suporte</span>
                        </a>
                        <a href="/faq" class="btn btn--silver-outline btn--large">
                            <span class="btn-text">Ver FAQ</span>
                        </a>
                    </div>
                </div>
            </div>
        </section>
        
    </main>
    
    <%- include('../partials/footer-dark-nature') %>
</body>
</html>

