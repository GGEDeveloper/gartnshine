<!DOCTYPE html>
<html lang="pt" data-theme="dark-nature">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <meta name="description" content="<%= meta.description %>">
    <meta name="keywords" content="<%= meta.keywords %>">
    
    <!-- OG Tags -->
    <meta property="og:title" content="Manifesto Dark Nature - Elegância que Nasce da Terra">
    <meta property="og:description" content="<%= meta.description %>">
    <meta property="og:image" content="/gallery/dark-nature/hero/caverna-primordial-hero.jpg">
    <meta property="og:type" content="website">
    
    <!-- Dark Nature CSS -->
    <link rel="stylesheet" href="/css/tokens-dark-nature.css">
    <link rel="stylesheet" href="/css/base-dark-nature.css">
    <link rel="stylesheet" href="/css/components-dark-nature.css">
    <link rel="stylesheet" href="/css/manifesto-dark-nature.css">
    
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Source+Sans+3:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <!-- AOS Animation Library -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
</head>
<body class="manifesto-dark-nature-page" data-page="manifesto">
    
    <!-- Header Dark Nature -->
    <%- include('../partials/header-dark-nature') %>
    
    <main class="manifesto-main">
        
        <!-- Hero com Caverna Background -->
        <section class="manifesto-hero" style="background-image: url('/gallery/dark-nature/hero/caverna-primordial-hero.jpg')">
            <div class="hero-overlay-deep"></div>
            <div class="container">
                <div class="manifesto-hero-content" data-aos="fade-up" data-aos-duration="1500">
                    <div class="hero-badge">
                        <span class="badge-icon">📜</span>
                        <span class="badge-text">Manifesto Dark Nature</span>
                    </div>
                    
                    <h1 class="manifesto-main-title">
                        <span class="title-part title-part--primary">Elegância</span>
                        <span class="title-part title-part--connector">que</span>
                        <span class="title-part title-part--accent">Nasce da Terra</span>
                    </h1>
                    
                    <div class="hero-essence">
                        <p class="essence-text">
                            Cada joia carrega consigo <strong>milhões de anos</strong> de história terrestre 
                            e <strong>gerações</strong> de sabedoria artesanal portuguesa. 
                            Não criamos apenas acessórios — <em>revelamos a alma ancestral dos minerais.</em>
                        </p>
                    </div>
                    
                    <div class="hero-scroll-indicator">
                        <span class="scroll-text">Descubra a nossa filosofia</span>
                        <div class="scroll-arrow">↓</div>
                    </div>
                </div>
            </div>
        </section>
        
        <!-- Os 4 Pilares (com assets Lote 1) -->
        <section class="manifesto-pilares">
            <div class="container">
                <div class="section-header">
                    <h2 class="section-title">Os 4 Pilares Sagrados</h2>
                    <p class="section-subtitle">
                        Princípios invioláveis que guiam cada decisão, cada gesto, cada peça criada
                    </p>
                </div>
                
                <div class="pilares-grid">
                    <!-- Pilar 1: Autenticidade -->
                    <article class="pilar-card pilar-card--autenticidade" data-aos="zoom-in" data-aos-delay="100">
                        <div class="pilar-header">
                            <div class="pilar-number">01</div>
                            <div class="pilar-icon">💎</div>
                        </div>
                        <div class="pilar-content">
                            <h3 class="pilar-title">Autenticidade Absoluta</h3>
                            <p class="pilar-description">
                                Zero elementos sintéticos. Cada pedra é genuína, cada processo é real, 
                                cada história é verdadeira. A natureza não aceita imitações.
                            </p>
                            <div class="pilar-features">
                                <span class="feature">✓ Minerais certificados</span>
                                <span class="feature">✓ Origem rastreável</span>
                                <span class="feature">✓ Transparência total</span>
                            </div>
                        </div>
                    </article>
                    
                    <!-- Pilar 2: Tradição -->
                    <article class="pilar-card pilar-card--tradicao" data-aos="zoom-in" data-aos-delay="200">
                        <div class="pilar-header">
                            <div class="pilar-number">02</div>
                            <div class="pilar-icon">⚒️</div>
                        </div>
                        <div class="pilar-content">
                            <h3 class="pilar-title">Tradição Artesanal</h3>
                            <p class="pilar-description">
                                Técnicas portuguesas centenárias passadas de mestre para aprendiz. 
                                Ferramentas que contam histórias, mãos que honram gerações.
                            </p>
                            <div class="pilar-features">
                                <span class="feature">✓ Métodos ancestrais</span>
                                <span class="feature">✓ Artesãos especializados</span>
                                <span class="feature">✓ Peças únicas</span>
                            </div>
                        </div>
                    </article>
                    
                    <!-- Pilar 3: Harmonia -->
                    <article class="pilar-card pilar-card--harmonia" data-aos="zoom-in" data-aos-delay="300">
                        <div class="pilar-header">
                            <div class="pilar-number">03</div>
                            <div class="pilar-icon">🌿</div>
                        </div>
                        <div class="pilar-content">
                            <h3 class="pilar-title">Harmonia Natural</h3>
                            <p class="pilar-description">
                                Respeitamos o tempo da terra e o ritmo do artesão. 
                                Beleza que emerge organicamente, nunca forçada.
                            </p>
                            <div class="pilar-features">
                                <span class="feature">✓ Ritmo natural</span>
                                <span class="feature">✓ Sem produção em massa</span>
                                <span class="feature">✓ Timing respeitoso</span>
                            </div>
                        </div>
                    </article>
                    
                    <!-- Pilar 4: Legado -->
                    <article class="pilar-card pilar-card--legado" data-aos="zoom-in" data-aos-delay="400">
                        <div class="pilar-header">
                            <div class="pilar-number">04</div>
                            <div class="pilar-icon">🏛️</div>
                        </div>
                        <div class="pilar-content">
                            <h3 class="pilar-title">Legado Eterno</h3>
                            <p class="pilar-description">
                                Cada peça é criada para atravessar gerações. 
                                Não fazemos moda — fazemos história que permanece.
                            </p>
                            <div class="pilar-features">
                                <span class="feature">✓ Qualidade duradoura</span>
                                <span class="feature">✓ Design atemporal</span>
                                <span class="feature">✓ Valor crescente</span>
                            </div>
                        </div>
                    </article>
                </div>
            </div>
        </section>
        
        <!-- Quaternário das Pedras (com asset quaternário) -->
        <section class="manifesto-quaternario" style="background-image: url('/gallery/dark-nature/natureza/quaternario-natural-organic.jpg')">
            <div class="quaternario-overlay"></div>
            <div class="container">
                <div class="quaternario-content">
                    <h2 class="quaternario-title">O Quaternário Sagrado</h2>
                    <p class="quaternario-intro">
                        Quatro pedras, quatro elementos, quatro caminhos para a mesma verdade: 
                        <strong>a elegância nasce da terra.</strong>
                    </p>
                    
                    <div class="pedras-quaternario">
                        <!-- Ónix - Terra -->
                        <div class="pedra-quaternario pedra-quaternario--onix" data-aos="fade-up" data-aos-delay="100">
                            <div class="pedra-symbol">⚫</div>
                            <div class="pedra-info">
                                <h3 class="pedra-name">Ónix</h3>
                                <div class="pedra-element">Elemento Terra</div>
                                <p class="pedra-essence">
                                    Força primordial das profundezas vulcânicas. 
                                    Proteção ancestral que emerge das entranhas da terra.
                                </p>
                                <a href="/catalogo?pedra=onix" class="pedra-explore">
                                    Explorar Ónix →
                                </a>
                            </div>
                        </div>
                        
                        <!-- Olho-de-tigre - Fogo -->
                        <div class="pedra-quaternario pedra-quaternario--tiger" data-aos="fade-up" data-aos-delay="200">
                            <div class="pedra-symbol">🟤</div>
                            <div class="pedra-info">
                                <h3 class="pedra-name">Olho-de-Tigre</h3>
                                <div class="pedra-element">Elemento Fogo</div>
                                <p class="pedra-essence">
                                    Coragem dourada capturada em fibra mineral. 
                                    Energia solar cristalizada em veios de luz.
                                </p>
                                <a href="/catalogo?pedra=olho-de-tigre" class="pedra-explore">
                                    Explorar Olho-de-Tigre →
                                </a>
                            </div>
                        </div>
                        
                        <!-- Ametista - Éter -->
                        <div class="pedra-quaternario pedra-quaternario--amethyst" data-aos="fade-up" data-aos-delay="300">
                            <div class="pedra-symbol">🟣</div>
                            <div class="pedra-info">
                                <h3 class="pedra-name">Ametista</h3>
                                <div class="pedra-element">Elemento Éter</div>
                                <p class="pedra-essence">
                                    Sabedoria cristalina dos geodas ancestrais. 
                                    Transmutação espiritual em geometria sagrada.
                                </p>
                                <a href="/catalogo?pedra=ametista" class="pedra-explore">
                                    Explorar Ametista →
                                </a>
                            </div>
                        </div>
                        
                        <!-- Turquesa - Água -->
                        <div class="pedra-quaternario pedra-quaternario--turquoise" data-aos="fade-up" data-aos-delay="400">
                            <div class="pedra-symbol">🔵</div>
                            <div class="pedra-info">
                                <h3 class="pedra-name">Turquesa</h3>
                                <div class="pedra-element">Elemento Água</div>
                                <p class="pedra-essence">
                                    Proteção milenar dos oceanos antigos. 
                                    Comunicação autêntica que flui como água pura.
                                </p>
                                <a href="/catalogo?pedra=turquesa" class="pedra-explore">
                                    Explorar Turquesa →
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        
        <!-- Jornada Artesanal (com asset bancada) -->
        <section class="manifesto-jornada" style="background-image: url('/gallery/dark-nature/transformacao/bancada-artesao-penumbra.jpg')">
            <div class="jornada-overlay"></div>
            <div class="container">
                <div class="jornada-content">
                    <h2 class="jornada-title">A Jornada do Mineral à Arte</h2>
                    
                    <div class="jornada-steps">
                        <div class="jornada-step" data-aos="fade-right" data-aos-delay="100">
                            <div class="step-icon">🌍</div>
                            <div class="step-content">
                                <h3>Origem Primordial</h3>
                                <p>Nas profundezas da terra, milhões de anos criam cada mineral único</p>
                            </div>
                        </div>
                        
                        <div class="jornada-step" data-aos="fade-right" data-aos-delay="200">
                            <div class="step-icon">⛏️</div>
                            <div class="step-content">
                                <h3>Seleção Criteriosa</h3>
                                <p>Apenas specimens perfeitos são escolhidos pelos nossos especialistas</p>
                            </div>
                        </div>
                        
                        <div class="jornada-step" data-aos="fade-right" data-aos-delay="300">
                            <div class="step-icon">⚒️</div>
                            <div class="step-content">
                                <h3>Transformação Artesanal</h3>
                                <p>Mãos experientes revelam a beleza oculta com técnicas centenárias</p>
                            </div>
                        </div>
                        
                        <div class="jornada-step" data-aos="fade-right" data-aos-delay="400">
                            <div class="step-icon">💎</div>
                            <div class="step-content">
                                <h3>Peça Única</h3>
                                <p>Cada joia conta uma história que começou nas profundezas da terra</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="jornada-cta">
                        <a href="/artesaos" class="btn btn--gold btn--large">
                            <span class="btn-text">Conhecer os Artesãos</span>
                            <span class="btn-icon">👨‍🎨</span>
                        </a>
                    </div>
                </div>
            </div>
        </section>
        
        <!-- Call to Action Final (com asset prata líquida) -->
        <section class="manifesto-final-cta" style="background-image: url('/gallery/dark-nature/transformacao/prata-abracando-onix.jpg')">
            <div class="final-cta-overlay"></div>
            <div class="container">
                <div class="final-cta-content">
                    <h2 class="final-cta-title">Viva a Filosofia Dark Nature</h2>
                    <p class="final-cta-text">
                        Cada peça é um manifesto pessoal. Descubra qual das 4 pedras sagradas 
                        ressoa com a sua essência e comece a sua jornada de elegância natural.
                    </p>
                    
                    <div class="final-cta-actions">
                        <a href="/catalogo" class="btn btn--gold btn--xl">
                            <span class="btn-text">Explorar Coleção Completa</span>
                            <span class="btn-icon">💎</span>
                        </a>
                        <a href="/galeria" class="btn btn--silver-outline btn--xl">
                            <span class="btn-text">Ver Jornada Visual</span>
                        </a>
                    </div>
                    
                    <div class="final-philosophy">
                        <blockquote class="philosophy-quote">
                            "Não vendemos joias. Revelamos histórias que estavam adormecidas 
                            nas profundezas da terra há milhões de anos."
                        </blockquote>
                        <cite class="philosophy-author">— Filosofia Gonzaga Art & Shine</cite>
                    </div>
                </div>
            </div>
        </section>
        
    </main>
    
    <!-- Footer Dark Nature -->
    <%- include('../partials/footer-dark-nature') %>
    
    <!-- Scripts -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({
            duration: 1200,
            easing: 'ease-out-cubic',
            once: true,
            offset: 80
        });
        
        // Smooth scroll for internal links
        document.querySelectorAll('a[href^="#"]').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    </script>
</body>
</html>
