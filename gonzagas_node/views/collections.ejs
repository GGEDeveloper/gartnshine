<%- contentFor('style') %>
<style>
  :root {
    --color-primary: #1a1a1a;
    --color-secondary: #2a2a2a;
    --color-text: #f5f5f5;
    --color-text-muted: #b0b0b0;
    --color-accent: #d4af37;
    --color-highlight: #f4e4a6;
    --shadow-sm: 0 2px 4px rgba(0,0,0,0.3);
    --shadow-md: 0 4px 6px rgba(0,0,0,0.4);
    --shadow-lg: 0 10px 15px rgba(0,0,0,0.5);
    --transition-medium: cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Loading Overlay */
  .loading-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(26, 26, 26, 0.9);
    backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  .loading-overlay.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .loading-spinner {
    width: 60px;
    height: 60px;
    border: 3px solid var(--color-secondary);
    border-top: 3px solid var(--color-accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Back to Top Button */
  .back-to-top {
    position: fixed;
    bottom: 30px;
    right: 30px;
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-highlight) 100%);
    border: none;
    border-radius: 50%;
    color: var(--color-primary);
    font-size: 20px;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(212, 175, 55, 0.4);
    transform: translateY(100px);
    opacity: 0;
    transition: all 0.3s ease;
    z-index: 1000;
  }

  .back-to-top.visible {
    transform: translateY(0);
    opacity: 1;
  }

  .back-to-top:hover {
    transform: translateY(-5px) scale(1.1);
    box-shadow: 0 8px 30px rgba(212, 175, 55, 0.6);
  }

  /* Gallery Controls */
  .gallery-controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    margin: 3rem 0;
    flex-wrap: wrap;
  }

  .view-toggle {
    display: flex;
    background: var(--color-secondary);
    border-radius: 50px;
    padding: 4px;
    border: 1px solid rgba(212, 175, 55, 0.3);
  }

  .view-toggle button {
    background: none;
    border: none;
    color: var(--color-text-muted);
    padding: 12px 20px;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 14px;
    font-weight: 500;
  }

  .view-toggle button.active {
    background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-highlight) 100%);
    color: var(--color-primary);
    box-shadow: 0 2px 10px rgba(212, 175, 55, 0.3);
  }

  .gallery-search {
    position: relative;
  }

  .gallery-search input {
    background: var(--color-secondary);
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 25px;
    padding: 12px 20px 12px 45px;
    color: var(--color-text);
    font-size: 14px;
    width: 250px;
    transition: all 0.3s ease;
  }

  .gallery-search input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.2);
  }

  .gallery-search .search-icon {
    position: absolute;
    left: 15px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    font-size: 14px;
  }

  .sort-select {
    background: var(--color-secondary);
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 25px;
    padding: 12px 20px;
    color: var(--color-text);
    font-size: 14px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .sort-select:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.2);
  }

  /* Gallery Stats */
  .gallery-stats {
    text-align: center;
    margin: 2rem 0;
    color: var(--color-text-muted);
    font-size: 14px;
  }

  .collection-page {
    padding: 3rem 0;
    min-height: 100vh;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
  }

  .container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .collection-header {
    text-align: center;
    padding: 4rem 0 3rem;
    margin-bottom: 2rem;
    position: relative;
    overflow: hidden;
  }

  .collection-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 200%;
    height: 100%;
    background: radial-gradient(ellipse at center, rgba(212, 175, 55, 0.1) 0%, transparent 70%);
    z-index: 0;
  }

  .collection-title {
    position: relative;
    z-index: 1;
  }

  .collection-title h1 {
    font-size: 3.5rem;
    color: var(--color-accent);
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 4px;
    font-weight: 700;
    position: relative;
    display: inline-block;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
  }

  .collection-title h1::after {
    content: '';
    position: absolute;
    bottom: -20px;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 4px;
    background: linear-gradient(90deg, transparent 0%, var(--color-accent) 20%, var(--color-highlight) 50%, var(--color-accent) 80%, transparent 100%);
    border-radius: 2px;
  }

  .geometric-divider {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    margin-top: 3rem;
    opacity: 0.8;
  }

  .geometric-divider::before,
  .geometric-divider::after {
    content: '';
    width: 80px;
    height: 2px;
    background: linear-gradient(90deg, transparent 0%, var(--color-accent) 50%, transparent 100%);
    border-radius: 1px;
  }

  .geometric-divider span {
    width: 12px;
    height: 12px;
    background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-highlight) 100%);
    transform: rotate(45deg);
    border-radius: 2px;
    box-shadow: 0 0 10px rgba(212, 175, 55, 0.3);
    transition: all 0.3s ease;
  }

  .geometric-divider span:nth-child(1) { 
    animation-delay: 0.1s; 
    transform: rotate(45deg) scale(0.8);
  }
  .geometric-divider span:nth-child(2) { 
    animation-delay: 0.2s; 
    transform: rotate(45deg) scale(1.1);
  }
  .geometric-divider span:nth-child(3) { 
    animation-delay: 0.3s; 
    transform: rotate(45deg) scale(0.9);
  }

  @keyframes sparkle {
    0%, 100% { 
      opacity: 0.6; 
      transform: rotate(45deg) scale(var(--scale, 1));
      box-shadow: 0 0 5px rgba(212, 175, 55, 0.2);
    }
    50% { 
      opacity: 1; 
      transform: rotate(45deg) scale(calc(var(--scale, 1) * 1.3));
      box-shadow: 0 0 20px rgba(212, 175, 55, 0.6);
    }
  }

  .geometric-divider span {
    animation: sparkle 3s ease-in-out infinite;
  }

  /* Gallery Grid Layouts */
  .gallery-grid {
    display: grid !important;
    gap: 2rem !important;
    padding: 0 1rem !important;
    margin: 0 auto !important;
    max-width: 1400px !important;
    width: 100% !important;
    justify-items: center !important;
    transition: all 0.3s ease;
  }

  .gallery-grid.grid-view {
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)) !important;
  }

  .gallery-grid.list-view {
    grid-template-columns: 1fr !important;
    max-width: 800px !important;
    gap: 1rem !important;
  }

  .gallery-grid.masonry-view {
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)) !important;
    grid-auto-rows: 10px !important;
  }

  /* Gallery Items */
  .gallery-item {
    overflow: hidden !important;
    border-radius: 16px !important;
    box-shadow: var(--shadow-md) !important;
    transition: all 0.4s var(--transition-medium) !important;
    background: linear-gradient(145deg, var(--color-secondary), #3a3a3a) !important;
    position: relative !important;
    cursor: pointer !important;
    will-change: transform, box-shadow !important;
    width: 100% !important;
    max-width: 320px !important;
    margin: 0 auto !important;
    border: 1px solid rgba(212, 175, 55, 0.2);
    opacity: 0;
    animation: fadeInUp 0.6s ease forwards;
  }

  .gallery-item.grid-view {
    aspect-ratio: 1 / 1 !important;
  }

  .gallery-item.list-view {
    aspect-ratio: 16 / 9 !important;
    max-width: 100% !important;
    display: flex;
    align-items: center;
  }

  .gallery-item.masonry-view {
    aspect-ratio: unset !important;
    height: fit-content !important;
  }

  .gallery-item.hidden {
    display: none;
  }

  @keyframes fadeInUp {
    0% {
      opacity: 0;
      transform: translateY(30px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .gallery-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.2) 0%, rgba(0, 0, 0, 0.4) 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 1;
    border-radius: 16px;
  }

  .gallery-item:hover {
    transform: translateY(-12px) scale(1.02);
    box-shadow: 0 20px 40px rgba(0,0,0,0.6), 0 0 30px rgba(212, 175, 55, 0.3);
    border-color: var(--color-accent);
  }

  .gallery-item:hover::before {
    opacity: 1;
  }

  .gallery-image-container {
    width: 100% !important;
    height: 0 !important;
    padding-bottom: 100% !important;
    position: relative !important;
    overflow: hidden !important;
    border-radius: 16px !important;
  }

  .list-view .gallery-image-container {
    height: 100% !important;
    padding-bottom: 0 !important;
  }

  .gallery-image {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    transition: transform 0.6s ease !important;
    display: block !important;
    filter: brightness(0.9) contrast(1.1);
  }

  .gallery-item:hover .gallery-image {
    transform: scale(1.15);
    filter: brightness(1.1) contrast(1.2);
  }

  /* Zoom Controls */
  .gallery-item .zoom-controls {
    position: absolute;
    top: 15px;
    right: 15px;
    z-index: 2;
    opacity: 0;
    transform: translateY(-10px);
    transition: all 0.3s ease;
  }

  .gallery-item:hover .zoom-controls {
    opacity: 1;
    transform: translateY(0);
  }

  .zoom-btn {
    background: rgba(212, 175, 55, 0.9);
    border: none;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    color: var(--color-primary);
    font-size: 16px;
    cursor: pointer;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
  }

  .zoom-btn:hover {
    background: var(--color-accent);
    transform: scale(1.1);
  }

  /* Image Info Overlay */
  .image-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0,0,0,0.8));
    color: white;
    padding: 20px 15px 15px;
    transform: translateY(100%);
    transition: transform 0.3s ease;
    z-index: 2;
    border-radius: 0 0 16px 16px;
  }

  .gallery-item:hover .image-info {
    transform: translateY(0);
  }

  .image-info h3 {
    margin: 0 0 5px 0;
    font-size: 16px;
    font-weight: 600;
  }

  .image-info p {
    margin: 0;
    font-size: 12px;
    opacity: 0.8;
  }

  /* No Images State */
  .no-images {
    text-align: center;
    padding: 6rem 2rem;
    background: linear-gradient(145deg, var(--color-secondary), #3a3a3a);
    border-radius: 16px;
    box-shadow: var(--shadow-sm);
    grid-column: 1 / -1;
    margin: 2rem 0;
    border: 1px solid rgba(212, 175, 55, 0.2);
  }

  .no-images p {
    color: var(--color-text-muted);
    font-size: 1.3rem;
    margin: 0;
    font-weight: 500;
  }

  /* Enhanced Lightbox */
  .lb-nav a.lb-prev,
  .lb-nav a.lb-next {
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.9), rgba(244, 228, 166, 0.9)) !important;
    border-radius: 50% !important;
    width: 60px !important;
    height: 60px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: all 0.3s ease !important;
    backdrop-filter: blur(10px) !important;
  }

  .lb-nav a.lb-prev:hover,
  .lb-nav a.lb-next:hover {
    transform: scale(1.1);
    box-shadow: 0 0 20px rgba(212, 175, 55, 0.6);
  }

  .lb-data .lb-caption {
    background: linear-gradient(135deg, rgba(26, 26, 26, 0.9), rgba(42, 42, 42, 0.9)) !important;
    backdrop-filter: blur(10px) !important;
    border-radius: 10px !important;
    padding: 15px 20px !important;
    margin: 20px auto !important;
    max-width: 600px !important;
    text-align: center !important;
    border: 1px solid rgba(212, 175, 55, 0.3) !important;
  }

  /* Responsive Design */
  @media (max-width: 1200px) {
    .gallery-grid.grid-view {
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 1.8rem;
    }
    
    .collection-title h1 {
      font-size: 3rem;
    }
  }

  @media (max-width: 768px) {
    .gallery-grid.grid-view {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 1.5rem;
      padding: 0 1rem;
    }
    
    .collection-title h1 {
      font-size: 2.5rem;
      letter-spacing: 2px;
    }
    
    .collection-header {
      padding: 3rem 0 2rem;
    }
    
    .gallery-item {
      max-width: 100%;
    }

    .gallery-controls {
      flex-direction: column;
      gap: 1rem;
    }

    .gallery-search input {
      width: 200px;
    }

    .back-to-top {
      bottom: 20px;
      right: 20px;
      width: 50px;
      height: 50px;
      font-size: 18px;
    }
  }

  @media (max-width: 480px) {
    .collection-title h1 {
      font-size: 2rem;
    }
    
    .geometric-divider {
      gap: 1rem;
    }
    
    .geometric-divider::before,
    .geometric-divider::after {
      width: 50px;
    }

    .gallery-search input {
      width: 180px;
    }
  }

  /* Keyboard Navigation Indicators */
  .keyboard-hint {
    position: fixed;
    bottom: 20px;
    left: 20px;
    background: rgba(42, 42, 42, 0.9);
    color: var(--color-text-muted);
    padding: 10px 15px;
    border-radius: 8px;
    font-size: 12px;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 1000;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(212, 175, 55, 0.2);
  }

  .keyboard-hint.visible {
    opacity: 1;
  }

  /* Loading Animation for Images */
  .gallery-image.loading {
    background: linear-gradient(90deg, #3a3a3a 0%, #4a4a4a 50%, #3a3a3a 100%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
  }

  @keyframes shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }
</style>
<%- contentFor('body') %>

<!-- Loading Overlay -->
<div class="loading-overlay" id="loadingOverlay">
  <div class="loading-spinner"></div>
</div>

<!-- Back to Top Button -->
<button class="back-to-top" id="backToTop" aria-label="Voltar ao topo">
  <i class="fas fa-arrow-up"></i>
</button>

<!-- Keyboard Hints -->
<div class="keyboard-hint" id="keyboardHint">
  Use ← → para navegar | ESC para fechar | SPACE para zoom
</div>

<main class="collection-page">
  <div class="container">
    <div class="collection-header">
      <div class="collection-title">
        <h1>Gallery</h1>
        <div class="geometric-divider">
          <span style="--scale: 0.8"></span>
          <span style="--scale: 1.1"></span>
          <span style="--scale: 0.9"></span>
        </div>
      </div>
    </div>

    <!-- Gallery Controls -->
    <div class="gallery-controls">
      <div class="view-toggle">
        <button class="view-btn active" data-view="grid">
          <i class="fas fa-th"></i> Grid
        </button>
        <button class="view-btn" data-view="list">
          <i class="fas fa-list"></i> List
        </button>
        <button class="view-btn" data-view="masonry">
          <i class="fas fa-columns"></i> Masonry
        </button>
      </div>

      <div class="gallery-search">
        <i class="fas fa-search search-icon"></i>
        <input type="text" id="imageSearch" placeholder="Pesquisar imagens..." autocomplete="off">
      </div>

      <select class="sort-select" id="sortSelect">
        <option value="name-asc">Nome: A-Z</option>
        <option value="name-desc">Nome: Z-A</option>
        <option value="date-new">Mais recentes</option>
        <option value="date-old">Mais antigas</option>
      </select>
    </div>

    <!-- Gallery Stats -->
    <div class="gallery-stats" id="galleryStats">
      <span id="imageCount">0</span> imagens encontradas
    </div>
    
    <% if (images && images.length > 0) { %>
      <div class="gallery-grid grid-view" id="galleryGrid">
        <% images.forEach((image, index) => { 
          const imageName = image.filename.replace(/\.[^/.]+$/, '');
          const imageDate = image.date || new Date().toISOString();
        %>
          <div class="gallery-item grid-view" 
               data-name="<%= imageName.toLowerCase() %>" 
               data-date="<%= imageDate %>"
               style="animation-delay: <%= index * 0.1 %>s">
            
            <div class="zoom-controls">
              <button class="zoom-btn" title="Zoom">
                <i class="fas fa-search-plus"></i>
              </button>
            </div>

            <a 
              href="/media/gallery/<%= image.filename %>" 
              data-lightbox="gallery" 
              data-title="<%= imageName %>"
              class="gallery-link"
              style="display: block; width: 100%; height: 100%;"
            >
              <div class="gallery-image-container">
                <img 
                  src="/media/gallery/<%= image.filename %>" 
                  alt="<%= imageName %>"
                  class="gallery-image loading" 
                  loading="lazy"
                  data-index="<%= index %>"
                >
              </div>
              
              <div class="image-info">
                <h3><%= imageName %></h3>
                <p>Clique para ampliar</p>
              </div>
            </a>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="no-images">
        <p>Nenhuma imagem encontrada na galeria.</p>
      </div>
    <% } %>
  </div>
</main>

<%- contentFor('script') %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.3/js/lightbox-plus-jquery.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Initialize enhanced gallery functionality
  initEnhancedGallery();
});

function initEnhancedGallery() {
  // DOM Elements
  const loadingOverlay = document.getElementById('loadingOverlay');
  const backToTop = document.getElementById('backToTop');
  const keyboardHint = document.getElementById('keyboardHint');
  const galleryGrid = document.getElementById('galleryGrid');
  const viewButtons = document.querySelectorAll('.view-btn');
  const searchInput = document.getElementById('imageSearch');
  const sortSelect = document.getElementById('sortSelect');
  const galleryStats = document.getElementById('galleryStats');
  const imageCount = document.getElementById('imageCount');
  
  let currentView = 'grid';
  let allImages = Array.from(document.querySelectorAll('.gallery-item'));
  let filteredImages = [...allImages];

  // Hide loading overlay after page load
  setTimeout(() => {
    loadingOverlay.classList.add('hidden');
  }, 500);

  // Update image count
  updateImageCount();

  // Back to top functionality
  window.addEventListener('scroll', () => {
    if (window.scrollY > 300) {
      backToTop.classList.add('visible');
    } else {
      backToTop.classList.remove('visible');
    }
  });

  backToTop.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // View toggle functionality
  viewButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const view = btn.dataset.view;
      switchView(view);
      
      // Update active button
      viewButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    });
  });

  // Search functionality
  searchInput.addEventListener('input', debounce(handleSearch, 300));

  // Sort functionality
  sortSelect.addEventListener('change', handleSort);

  // Keyboard navigation
  document.addEventListener('keydown', handleKeyboard);

  // Show keyboard hints temporarily
  setTimeout(() => {
    keyboardHint.classList.add('visible');
    setTimeout(() => {
      keyboardHint.classList.remove('visible');
    }, 3000);
  }, 1000);

  // Image loading handlers
  document.querySelectorAll('.gallery-image').forEach(img => {
    img.addEventListener('load', function() {
      this.classList.remove('loading');
    });
    
    if (img.complete) {
      img.classList.remove('loading');
    }
  });

  // Enhanced Lightbox configuration
  lightbox.option({
    'resizeDuration': 200,
    'wrapAround': true,
    'showImageNumberLabel': true,
    'positionFromTop': 60,
    'alwaysShowNavOnTouchDevices': true,
    'fadeDuration': 300,
    'imageFadeDuration': 300,
    'disableScrolling': true,
    'albumLabel': 'Imagem %1 de %2',
    'fitImagesInViewport': true,
    'maxWidth': 1200,
    'maxHeight': 800
  });

  // Functions
  function switchView(view) {
    currentView = view;
    
    // Update grid class
    galleryGrid.className = `gallery-grid ${view}-view`;
    
    // Update item classes
    allImages.forEach(item => {
      item.className = `gallery-item ${view}-view`;
      if (!filteredImages.includes(item)) {
        item.classList.add('hidden');
      }
    });

    // Trigger reflow for animations
    requestAnimationFrame(() => {
      allImages.forEach((item, index) => {
        if (!item.classList.contains('hidden')) {
          item.style.animationDelay = `${index * 0.05}s`;
          item.style.animation = 'none';
          requestAnimationFrame(() => {
            item.style.animation = 'fadeInUp 0.6s ease forwards';
          });
        }
      });
    });
  }

  function handleSearch() {
    const query = searchInput.value.toLowerCase().trim();
    
    if (query === '') {
      filteredImages = [...allImages];
    } else {
      filteredImages = allImages.filter(item => {
        const name = item.dataset.name || '';
        return name.includes(query);
      });
    }
    
    updateDisplay();
    updateImageCount();
  }

  function handleSort() {
    const sortType = sortSelect.value;
    
    filteredImages.sort((a, b) => {
      switch (sortType) {
        case 'name-asc':
          return a.dataset.name.localeCompare(b.dataset.name);
        case 'name-desc':
          return b.dataset.name.localeCompare(a.dataset.name);
        case 'date-new':
          return new Date(b.dataset.date) - new Date(a.dataset.date);
        case 'date-old':
          return new Date(a.dataset.date) - new Date(b.dataset.date);
        default:
          return 0;
      }
    });
    
    updateDisplay();
  }

  function updateDisplay() {
    // Hide all items first
    allImages.forEach(item => {
      item.classList.add('hidden');
    });
    
    // Show filtered items in order
    filteredImages.forEach((item, index) => {
      item.classList.remove('hidden');
      item.style.order = index;
      item.style.animationDelay = `${index * 0.05}s`;
    });
  }

  function updateImageCount() {
    imageCount.textContent = filteredImages.length;
  }

  function handleKeyboard(e) {
    // Only handle keyboard shortcuts when lightbox is not open
    if (!document.querySelector('.lb-overlay')) {
      switch (e.key) {
        case '1':
          e.preventDefault();
          switchView('grid');
          viewButtons[0].classList.add('active');
          viewButtons[1].classList.remove('active');
          viewButtons[2].classList.remove('active');
          break;
        case '2':
          e.preventDefault();
          switchView('list');
          viewButtons[0].classList.remove('active');
          viewButtons[1].classList.add('active');
          viewButtons[2].classList.remove('active');
          break;
        case '3':
          e.preventDefault();
          switchView('masonry');
          viewButtons[0].classList.remove('active');
          viewButtons[1].classList.remove('active');
          viewButtons[2].classList.add('active');
          break;
        case '/':
          e.preventDefault();
          searchInput.focus();
          break;
        case 'Escape':
          if (document.activeElement === searchInput) {
            searchInput.blur();
            searchInput.value = '';
            handleSearch();
          }
          break;
      }
    }
  }

  function debounce(func, wait) {
    let timeout;
    return function executedFunction(...args) {
      const later = () => {
        clearTimeout(timeout);
        func(...args);
      };
      clearTimeout(timeout);
      timeout = setTimeout(later, wait);
    };
  }

  // Add smooth scrolling to gallery items when they come into view
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.transform = 'translateY(0)';
        entry.target.style.opacity = '1';
      }
    });
  }, observerOptions);

  // Observe all gallery items
  allImages.forEach(item => {
    observer.observe(item);
  });
}
</script>
