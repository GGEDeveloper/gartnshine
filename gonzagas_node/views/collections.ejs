<link rel="stylesheet" href="/css/collections.css?v=<%= Date.now() %>">

<main class="collections-page">
  <div class="container">
    <!-- Header coerente com a home -->
    <div class="collections-header">
      <div class="collections-title">
        <h1><%= title || 'Gallery' %></h1>
        <p class="collections-subtitle">A elegância que nasce da terra</p>
        <div class="geometric-divider">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
    </div>

    <%
      // ===== Instagram =====
      // Fica por cima da galeria local, separado por uma divisória, porque é
      // conteúdo vivo (actualiza-se sozinho) e a galeria local é curada peça
      // a peça. Só aparece se houver alguma coisa para mostrar — se o token
      // expirar, a secção desaparece e o resto da página fica intacta.
      const igMedia = (typeof instagramMedia !== 'undefined' && Array.isArray(instagramMedia))
        ? instagramMedia : [];
    %>
    <% if (igMedia.length > 0) { %>
      <section class="ig-feed-section" aria-labelledby="ig-feed-titulo">
        <header class="ig-feed-header">
          <p class="section-eyebrow">Do nosso Instagram</p>
          <h2 id="ig-feed-titulo" class="ig-feed-title">
            <a href="https://instagram.com/<%= typeof instagramUsername !== 'undefined' && instagramUsername ? instagramUsername : 'artnshine' %>"
               target="_blank" rel="noopener noreferrer">
              @<%= typeof instagramUsername !== 'undefined' && instagramUsername ? instagramUsername : 'artnshine' %>
            </a>
          </h2>
        </header>

        <div class="ig-feed-grid">
          <% igMedia.forEach(function(m) {
            const isVideo = m.media_type === 'VIDEO';
            const thumb = isVideo ? (m.thumbnail_url || m.media_url) : m.media_url;
            const legenda = (m.caption || '').replace(/\s+/g, ' ').trim();
            const alt = legenda ? legenda.slice(0, 110) : 'Publicação do Instagram da Gonzaga\'s Art & Shine';
          %>
            <a class="ig-feed-item<%= m.is_featured ? ' is-featured' : '' %>"
               href="<%= m.permalink %>" target="_blank" rel="noopener noreferrer"
               aria-label="Ver no Instagram: <%= alt %>">
              <img src="<%= thumb %>" alt="<%= alt %>" loading="lazy" class="ig-feed-image">
              <% if (isVideo) { %>
                <span class="ig-feed-badge" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </span>
              <% } else if (m.media_type === 'CAROUSEL_ALBUM') { %>
                <span class="ig-feed-badge" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="8" y="3" width="13" height="13" rx="2"/><path d="M5 7v12a2 2 0 0 0 2 2h12"/>
                  </svg>
                </span>
              <% } %>
              <% if (legenda) { %>
                <span class="ig-feed-caption"><%= legenda.slice(0, 70) %><%= legenda.length > 70 ? '…' : '' %></span>
              <% } %>
            </a>
          <% }); %>
        </div>
      </section>

      <div class="gallery-divider" role="separator" aria-hidden="true">
        <span class="gallery-divider-line"></span>
        <span class="gallery-divider-label">Galeria da casa</span>
        <span class="gallery-divider-line"></span>
      </div>
    <% } %>

    <!-- Gallery Content -->
    <% if (images && images.length > 0) { %>
      <div class="gallery-grid" id="galleryGrid">
        <% images.forEach((image, index) => {
          // Legenda definida no admin (/admin/gallery); sem legenda usa-se o
          // texto genérico, em vez de tentar adivinhar a partir do ficheiro.
          const cleanName = (image.caption && image.caption.trim()) || 'Peça Única';
          const src = '/media/gallery/' + encodeURI(image.filename);
        %>
          <div class="gallery-item">
            <a
              href="<%= src %>"
              data-lightbox="gallery"
              data-title="<%= cleanName %> - Gonzaga's Art & Shine"
              class="gallery-link"
              style="display: block; width: 100%; height: 100%;"
            >
              <div class="gallery-image-container">
                <img
                  src="<%= src %>"
                  alt="<%= cleanName %>"
                  class="gallery-image"
                  loading="lazy"
                  data-index="<%= index %>"
                >
              </div>
            </a>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="no-images">
        <h3>Coleção em Preparação</h3>
        <p>Novas peças únicas em breve. A elegância está sendo criada com dedicação e arte.</p>
      </div>
    <% } %>
  </div>
</main>

<%
  /*
    Esta página carregava o lightbox2 a partir de cdnjs — que a CSP bloqueia
    (cdnjs só está autorizado para estilos), pelo que a ampliação de imagens
    nunca chegou a funcionar aqui. Além disso trazia uma cópia própria do
    jQuery, já carregado no layout. O GLightbox usado no catálogo é carregado
    globalmente e liga-se sozinho a [data-lightbox], que estes links já têm.
    A revelação ao scroll é feita por /js/modules/motion.js.
  */
%>
