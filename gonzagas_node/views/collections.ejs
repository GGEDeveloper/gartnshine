<%- contentFor('style') %>
  <style>
  /* Elegant Earth & Shine Theme - Inspired by "A elegância que nasce da terra" */
    :root {
    /* Earth-inspired palette */
    --earth-deep: #2c1810;
    --earth-rich: #3d2818;
    --earth-warm: #4a3326;
    --earth-light: #6b4c3a;
    
    /* Shine & Gold accents */
    --gold-pure: #d4af37;
    --gold-bright: #f4e4a6;
    --gold-soft: #e8c87c;
    --gold-muted: rgba(212, 175, 55, 0.1);
    
    /* Natural tones */
    --stone-light: #f5f2ed;
    --stone-medium: #e8e2d5;
    --stone-dark: #d0c4b0;
    --silver-shine: #c0c0c0;
    
    /* Sophisticated shadows */
    --shadow-earth: 0 8px 32px rgba(44, 24, 16, 0.3);
    --shadow-gold: 0 4px 20px rgba(212, 175, 55, 0.25);
    --shadow-elegant: 0 12px 48px rgba(0, 0, 0, 0.15);
    
    /* Premium transitions */
    --transition-luxury: cubic-bezier(0.23, 1, 0.32, 1);
    --transition-smooth: cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    * {
      box-sizing: border-box;
    }

    body {
    font-family: 'Playfair Display', 'Georgia', serif;
    background: linear-gradient(135deg, var(--earth-deep) 0%, var(--earth-rich) 50%, var(--earth-warm) 100%);
    min-height: 100vh;
    margin: 0;
    color: var(--stone-light);
    overflow-x: hidden;
  }

  /* Elegant Page Structure */
    .collection-page {
    min-height: 100vh;
    position: relative;
    padding: 0;
  }

  .collection-page::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      radial-gradient(circle at 20% 30%, var(--gold-muted) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(212, 175, 55, 0.05) 0%, transparent 50%),
      linear-gradient(135deg, var(--earth-deep) 0%, var(--earth-rich) 100%);
    z-index: -1;
    }

    .container {
      max-width: 1400px;
      margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 1;
    }

  /* Sophisticated Header */
    .collection-header {
      text-align: center;
    padding: 6rem 0 4rem;
    position: relative;
  }

  .collection-header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 300px;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, var(--gold-pure) 50%, transparent 100%);
    }

    .collection-title h1 {
    font-size: 4rem;
    font-weight: 300;
    letter-spacing: 8px;
      text-transform: uppercase;
    color: var(--gold-pure);
    margin: 0 0 2rem 0;
    position: relative;
    text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.3);
  }

  .collection-subtitle {
    font-size: 1.2rem;
    font-weight: 300;
    font-style: italic;
    color: var(--stone-medium);
    margin-bottom: 3rem;
      letter-spacing: 2px;
    opacity: 0.9;
  }

  .elegant-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 3rem 0;
    opacity: 0.7;
  }

  .elegant-divider::before,
  .elegant-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--gold-soft), transparent);
    max-width: 150px;
  }

  .elegant-divider .ornament {
    width: 40px;
    height: 40px;
    margin: 0 2rem;
    background: radial-gradient(circle, var(--gold-pure), var(--gold-soft));
    border-radius: 50%;
      position: relative;
    box-shadow: var(--shadow-gold);
    }

  .elegant-divider .ornament::before {
    content: '✦';
      position: absolute;
    top: 50%;
      left: 50%;
    transform: translate(-50%, -50%);
    color: var(--earth-deep);
    font-size: 16px;
    animation: sparkle 3s ease-in-out infinite;
  }

  @keyframes sparkle {
    0%, 100% { opacity: 0.8; transform: translate(-50%, -50%) scale(1); }
    50% { opacity: 1; transform: translate(-50%, -50%) scale(1.2); }
  }

  

    /* Elegant Gallery Grid */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2.5rem;
    padding: 2rem 0;
    margin: 0 auto;
    max-width: 1200px;
  }

    /* Sophisticated Gallery Items */
  .gallery-item {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: linear-gradient(145deg, rgba(61, 40, 24, 0.3), rgba(75, 51, 38, 0.3));
    backdrop-filter: blur(15px);
    border: 1px solid rgba(212, 175, 55, 0.2);
    transition: all 0.5s var(--transition-luxury);
    cursor: pointer;
    opacity: 0;
    animation: elegantFadeIn 0.8s ease forwards;
    aspect-ratio: 1;
  }

  @keyframes elegantFadeIn {
    0% {
      opacity: 0;
      transform: translateY(40px) scale(0.95);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .gallery-item:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 
      var(--shadow-elegant),
      0 0 40px rgba(212, 175, 55, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    border-color: var(--gold-pure);
    }

    .gallery-item::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
    background: linear-gradient(
      135deg,
      rgba(212, 175, 55, 0.1) 0%,
      transparent 50%,
      rgba(212, 175, 55, 0.05) 100%
    );
      opacity: 0;
    transition: opacity 0.4s var(--transition-smooth);
      z-index: 1;
    border-radius: 16px;
    }

    .gallery-item:hover::before {
      opacity: 1;
    }

    .gallery-image-container {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    }

    .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: all 0.6s var(--transition-luxury);
    filter: brightness(0.9) contrast(1.1) saturate(1.1);
    }

    .gallery-item:hover .gallery-image {
    transform: scale(1.08);
    filter: brightness(1.1) contrast(1.2) saturate(1.2);
  }

  /* Clean Gallery - No overlays, just pure images */



  /* No Images State - Elegant */
  .no-images {
    text-align: center;
    padding: 6rem 3rem;
    background: rgba(61, 40, 24, 0.3);
    backdrop-filter: blur(20px);
    border-radius: 20px;
    border: 1px solid rgba(212, 175, 55, 0.2);
    margin: 4rem 0;
    box-shadow: var(--shadow-earth);
  }

  .no-images h3 {
    color: var(--gold-soft);
    font-size: 1.5rem;
    margin-bottom: 1rem;
    font-weight: 300;
  }

  .no-images p {
    color: var(--stone-medium);
    font-size: 1rem;
    margin: 0;
    font-family: 'Inter', sans-serif;
  }

  /* Loading Overlay - Refined */
  .loading-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--earth-deep);
    backdrop-filter: blur(20px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 1;
    transition: opacity 0.5s ease;
  }

  .loading-overlay.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .loading-content {
    text-align: center;
    color: var(--stone-light);
  }

  .loading-spinner {
    width: 60px;
    height: 60px;
    border: 2px solid rgba(212, 175, 55, 0.2);
    border-top: 2px solid var(--gold-pure);
    border-radius: 50%;
    animation: elegantSpin 1.5s ease-in-out infinite;
    margin: 0 auto 2rem;
  }

  .loading-text {
    font-family: 'Playfair Display', serif;
    font-size: 1.2rem;
    letter-spacing: 2px;
    color: var(--gold-soft);
  }

  @keyframes elegantSpin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Enhanced Lightbox */
  .lb-nav a.lb-prev,
  .lb-nav a.lb-next {
    background: linear-gradient(135deg, var(--gold-pure), var(--gold-bright)) !important;
    border-radius: 50% !important;
    width: 70px !important;
    height: 70px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: all 0.3s var(--transition-smooth) !important;
    backdrop-filter: blur(15px) !important;
    box-shadow: var(--shadow-gold) !important;
  }

  .lb-nav a.lb-prev:hover,
  .lb-nav a.lb-next:hover {
    transform: scale(1.1);
    box-shadow: 0 8px 30px rgba(212, 175, 55, 0.6) !important;
  }

  .lb-data .lb-caption {
    background: linear-gradient(135deg, rgba(44, 24, 16, 0.95), rgba(61, 40, 24, 0.95)) !important;
    backdrop-filter: blur(20px) !important;
    border-radius: 15px !important;
    padding: 20px 30px !important;
    margin: 30px auto !important;
    max-width: 700px !important;
    text-align: center !important;
    border: 1px solid rgba(212, 175, 55, 0.3) !important;
    color: var(--stone-light) !important;
    font-family: 'Playfair Display', serif !important;
    font-size: 16px !important;
    letter-spacing: 1px !important;
  }

  /* Responsive Design */
  @media (max-width: 1200px) {
    .gallery-grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
    }
    
    .collection-title h1 {
      font-size: 3.5rem;
    }
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 1.5rem;
    }

    .collection-header {
      padding: 4rem 0 3rem;
    }

    .collection-title h1 {
      font-size: 2.8rem;
      letter-spacing: 4px;
    }

    .gallery-grid {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
    }


  }

  @media (max-width: 480px) {
    .collection-title h1 {
      font-size: 2.2rem;
      letter-spacing: 2px;
    }

    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  /* Typography Enhancement */
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap');
  </style>

<%- contentFor('body') %>

<!-- Loading removed for clean gallery experience -->



<main class="collection-page">
  <div class="container">
    <!-- Elegant Header -->
    <div class="collection-header">
      <div class="collection-title">
        <h1>Art & Shine</h1>
        <p class="collection-subtitle">A elegância que nasce da terra</p>
        <div class="elegant-divider">
          <div class="ornament"></div>
        </div>
      </div>
    </div>


    
    <% if (images && images.length > 0) { %>
      <div class="gallery-grid" id="galleryGrid">
        <% images.forEach((image, index) => { 
          const imageName = image.filename.replace(/\.[^/.]+$/, '');
          const imageDate = image.date || new Date().toISOString();
        %>
          <div class="gallery-item" 
               style="animation-delay: <%= index * 0.15 %>s">
            
            <a 
              href="/media/gallery/<%= image.filename %>" 
              data-lightbox="gallery" 
              data-title="Gonzaga's Art & Shine"
              class="gallery-link"
              style="display: block; width: 100%; height: 100%;"
            >
              <div class="gallery-image-container">
                <img 
                  src="/media/gallery/<%= image.filename %>" 
                  alt="Peça única de joalheria artesanal"
                  class="gallery-image" 
                  loading="lazy"
                  data-index="<%= index %>"
                >
              </div>
            </a>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="no-images">
        <h3>Coleção em preparação</h3>
        <p>Novas peças únicas em breve. A elegância está sendo criada.</p>
      </div>
    <% } %>
  </div>
</main>

<%- contentFor('script') %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.3/js/lightbox-plus-jquery.min.js"></script>
<script>
// Clean gallery initialization
document.addEventListener('DOMContentLoaded', function() {
  console.log('Collections gallery loaded');
  initGalleryFeatures();
});

function initGalleryFeatures() {

  // Luxury lightbox configuration
  lightbox.option({
    'resizeDuration': 300,
    'wrapAround': true,
    'showImageNumberLabel': true,
    'positionFromTop': 80,
    'alwaysShowNavOnTouchDevices': true,
    'fadeDuration': 400,
    'imageFadeDuration': 400,
    'disableScrolling': true,
    'albumLabel': 'Peça %1 de %2',
    'fitImagesInViewport': true,
    'maxWidth': 1400,
    'maxHeight': 900
  });



  // Intersection observer for smooth entrance animations
  const observerOptions = {
    threshold: 0.2,
    rootMargin: '0px 0px -100px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.animationPlayState = 'running';
      }
    });
  }, observerOptions);

  allImages.forEach(item => {
    observer.observe(item);
  });
}
</script>
