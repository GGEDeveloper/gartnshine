<link rel="stylesheet" href="/css/collections.css?v=<%= Date.now() %>">

<main class="collections-page">
  <div class="container">
    <!-- Header coerente com a home -->
    <div class="collections-header">
      <div class="collections-title">
        <h1><%= title || 'Gallery' %></h1>
        <p class="collections-subtitle">A elegância que nasce da terra</p>
        <div class="geometric-divider">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
    </div>

    <!-- Gallery Content -->
    <% if (images && images.length > 0) { %>
      <div class="gallery-grid" id="galleryGrid">
        <% images.forEach((image, index) => {
          // Legenda definida no admin (/admin/gallery); sem legenda usa-se o
          // texto genérico, em vez de tentar adivinhar a partir do ficheiro.
          const cleanName = (image.caption && image.caption.trim()) || 'Peça Única';
          const src = '/media/gallery/' + encodeURI(image.filename);
        %>
          <div class="gallery-item">
            <a
              href="<%= src %>"
              data-lightbox="gallery"
              data-title="<%= cleanName %> - Gonzaga's Art & Shine"
              class="gallery-link"
              style="display: block; width: 100%; height: 100%;"
            >
              <div class="gallery-image-container">
                <img
                  src="<%= src %>"
                  alt="<%= cleanName %>"
                  class="gallery-image"
                  loading="lazy"
                  data-index="<%= index %>"
                >
              </div>
            </a>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="no-images">
        <h3>Coleção em Preparação</h3>
        <p>Novas peças únicas em breve. A elegância está sendo criada com dedicação e arte.</p>
      </div>
    <% } %>
  </div>
</main>

<%
  /*
    Esta página carregava o lightbox2 a partir de cdnjs — que a CSP bloqueia
    (cdnjs só está autorizado para estilos), pelo que a ampliação de imagens
    nunca chegou a funcionar aqui. Além disso trazia uma cópia própria do
    jQuery, já carregado no layout. O GLightbox usado no catálogo é carregado
    globalmente e liga-se sozinho a [data-lightbox], que estes links já têm.
    A revelação ao scroll é feita por /js/modules/motion.js.
  */
%>
