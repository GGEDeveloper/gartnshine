<%- contentFor('style') %>
<style>
  :root {
    --color-primary: #1a1a1a;
    --color-secondary: #2a2a2a;
    --color-text: #f5f5f5;
    --color-text-muted: #b0b0b0;
    --color-accent: #d4af37;
    --color-highlight: #f4e4a6;
    --shadow-sm: 0 2px 4px rgba(0,0,0,0.3);
    --shadow-md: 0 4px 6px rgba(0,0,0,0.4);
    --shadow-lg: 0 10px 15px rgba(0,0,0,0.5);
    --transition-medium: cubic-bezier(0.4, 0, 0.2, 1);
  }

  .collection-page {
    padding: 3rem 0;
    min-height: 80vh;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
  }

  .container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .collection-header {
    text-align: center;
    padding: 4rem 0 5rem;
    margin-bottom: 2rem;
    position: relative;
    overflow: hidden;
  }

  .collection-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 200%;
    height: 100%;
    background: radial-gradient(ellipse at center, rgba(212, 175, 55, 0.1) 0%, transparent 70%);
    z-index: 0;
  }

  .collection-title {
    position: relative;
    z-index: 1;
  }

  .collection-title h1 {
    font-size: 3.5rem;
    color: var(--color-accent);
    margin-bottom: 2rem;
    text-transform: uppercase;
    letter-spacing: 4px;
    font-weight: 700;
    position: relative;
    display: inline-block;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
  }

  .collection-title h1::after {
    content: '';
    position: absolute;
    bottom: -20px;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 4px;
    background: linear-gradient(90deg, transparent 0%, var(--color-accent) 20%, var(--color-highlight) 50%, var(--color-accent) 80%, transparent 100%);
    border-radius: 2px;
  }

  .geometric-divider {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    margin-top: 3rem;
    opacity: 0.8;
  }

  .geometric-divider::before,
  .geometric-divider::after {
    content: '';
    width: 80px;
    height: 2px;
    background: linear-gradient(90deg, transparent 0%, var(--color-accent) 50%, transparent 100%);
    border-radius: 1px;
  }

  .geometric-divider span {
    width: 12px;
    height: 12px;
    background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-highlight) 100%);
    transform: rotate(45deg);
    border-radius: 2px;
    box-shadow: 0 0 10px rgba(212, 175, 55, 0.3);
    transition: all 0.3s ease;
  }

  .geometric-divider span:nth-child(1) { 
    animation-delay: 0.1s; 
    transform: rotate(45deg) scale(0.8);
  }
  .geometric-divider span:nth-child(2) { 
    animation-delay: 0.2s; 
    transform: rotate(45deg) scale(1.1);
  }
  .geometric-divider span:nth-child(3) { 
    animation-delay: 0.3s; 
    transform: rotate(45deg) scale(0.9);
  }

  @keyframes sparkle {
    0%, 100% { 
      opacity: 0.6; 
      transform: rotate(45deg) scale(var(--scale, 1));
      box-shadow: 0 0 5px rgba(212, 175, 55, 0.2);
    }
    50% { 
      opacity: 1; 
      transform: rotate(45deg) scale(calc(var(--scale, 1) * 1.3));
      box-shadow: 0 0 20px rgba(212, 175, 55, 0.6);
    }
  }

  .geometric-divider span {
    animation: sparkle 3s ease-in-out infinite;
  }

  .gallery-grid {
    display: grid !important;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)) !important;
    gap: 2rem !important;
    padding: 0 1rem !important;
    margin: 0 auto !important;
    max-width: 1400px !important;
    width: 100% !important;
    justify-items: center !important;
  }

  .gallery-item {
    overflow: hidden !important;
    border-radius: 16px !important;
    box-shadow: var(--shadow-md) !important;
    transition: all 0.4s var(--transition-medium) !important;
    background: linear-gradient(145deg, var(--color-secondary), #3a3a3a) !important;
    aspect-ratio: 1 / 1 !important;
    position: relative !important;
    cursor: pointer !important;
    will-change: transform, box-shadow !important;
    width: 100% !important;
    max-width: 320px !important;
    margin: 0 auto !important;
    border: 1px solid rgba(212, 175, 55, 0.2);
  }

  .gallery-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.2) 0%, rgba(0, 0, 0, 0.4) 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 1;
    border-radius: 16px;
  }

  .gallery-item:hover {
    transform: translateY(-12px) scale(1.02);
    box-shadow: 0 20px 40px rgba(0,0,0,0.6), 0 0 30px rgba(212, 175, 55, 0.3);
    border-color: var(--color-accent);
  }

  .gallery-item:hover::before {
    opacity: 1;
  }

  .gallery-image-container {
    width: 100% !important;
    height: 0 !important;
    padding-bottom: 100% !important;
    position: relative !important;
    overflow: hidden !important;
    border-radius: 16px !important;
  }

  .gallery-image {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    transition: transform 0.6s ease !important;
    display: block !important;
    filter: brightness(0.9) contrast(1.1);
  }

  .gallery-item:hover .gallery-image {
    transform: scale(1.15);
    filter: brightness(1.1) contrast(1.2);
  }

  .no-images {
    text-align: center;
    padding: 6rem 2rem;
    background: linear-gradient(145deg, var(--color-secondary), #3a3a3a);
    border-radius: 16px;
    box-shadow: var(--shadow-sm);
    grid-column: 1 / -1;
    margin: 2rem 0;
    border: 1px solid rgba(212, 175, 55, 0.2);
  }

  .no-images p {
    color: var(--color-text-muted);
    font-size: 1.3rem;
    margin: 0;
    font-weight: 500;
  }

  /* Lightbox customizations */
  .lb-nav a.lb-prev,
  .lb-nav a.lb-next {
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.8), rgba(244, 228, 166, 0.8)) !important;
    border-radius: 50% !important;
    width: 50px !important;
    height: 50px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: all 0.3s ease !important;
  }

  .lb-nav a.lb-prev:hover,
  .lb-nav a.lb-next:hover {
    transform: scale(1.1);
    box-shadow: 0 0 20px rgba(212, 175, 55, 0.6);
  }

  @media (max-width: 1200px) {
    .gallery-grid {
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 1.8rem;
    }
    
    .collection-title h1 {
      font-size: 3rem;
    }
  }

  @media (max-width: 768px) {
    .gallery-grid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 1.5rem;
      padding: 0 1rem;
    }
    
    .collection-title h1 {
      font-size: 2.5rem;
      letter-spacing: 2px;
    }
    
    .collection-header {
      padding: 3rem 0 4rem;
    }
    
    .gallery-item {
      max-width: 100%;
    }
  }

  @media (max-width: 480px) {
    .collection-title h1 {
      font-size: 2rem;
    }
    
    .geometric-divider {
      gap: 1rem;
    }
    
    .geometric-divider::before,
    .geometric-divider::after {
      width: 50px;
    }
  }
</style>
<%- contentFor('body') %>

<main class="collection-page">
  <div class="container">
    <div class="collection-header">
      <div class="collection-title">
        <h1>Gallery</h1>
        <div class="geometric-divider">
          <span style="--scale: 0.8"></span>
          <span style="--scale: 1.1"></span>
          <span style="--scale: 0.9"></span>
        </div>
      </div>
    </div>
    
    <% if (images && images.length > 0) { %>
      <div class="gallery-grid">
        <% images.forEach((image, index) => { 
          const imageName = image.filename.replace(/\.[^/.]+$/, '');
        %>
          <div class="gallery-item">
            <a 
              href="/media/gallery/<%= image.filename %>" 
              data-lightbox="gallery" 
              data-title="<%= imageName %>"
              class="gallery-link"
              style="display: block; width: 100%; height: 100%;"
            >
              <div class="gallery-image-container">
                <img 
                  src="/media/gallery/<%= image.filename %>" 
                  alt="<%= imageName %>"
                  class="gallery-image" 
                  loading="lazy"
                >
              </div>
            </a>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="no-images">
        <p>Nenhuma imagem encontrada na galeria.</p>
      </div>
    <% } %>
  </div>
</main>

<%- contentFor('script') %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.3/js/lightbox-plus-jquery.min.js"></script>
<script>
  // Configuração do Lightbox2
  lightbox.option({
    'resizeDuration': 200,
    'wrapAround': true,
    'showImageNumberLabel': true,
    'positionFromTop': 80,
    'alwaysShowNavOnTouchDevices': true,
    'fadeDuration': 300,
    'imageFadeDuration': 300,
    'disableScrolling': true,
    'albumLabel': 'Imagem %1 de %2'
  });
  
  // Adiciona o título da imagem como legenda
  document.addEventListener('DOMContentLoaded', () => {
    const galleryLinks = document.querySelectorAll('a[data-lightbox="gallery"]');
    galleryLinks.forEach(link => {
      const img = link.querySelector('img');
      if (img) {
        link.setAttribute('data-title', img.alt || 'Imagem da galeria');
      }
    });
  });
</script>
