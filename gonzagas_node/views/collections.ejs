<link rel="stylesheet" href="/css/collections.css?v=<%= Date.now() %>">

<main class="collections-page">
  <div class="container">
    <!-- Header coerente com a home -->
    <div class="collections-header">
      <div class="collections-title">
        <h1><%= title || 'Gallery' %></h1>
        <p class="collections-subtitle">A elegância que nasce da terra</p>
        <div class="geometric-divider">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
    </div>

    <!-- Gallery Content -->
    <% if (images && images.length > 0) { %>
      <div class="gallery-grid" id="galleryGrid">
        <% images.forEach((image, index) => {
          // Legenda definida no admin (/admin/gallery); sem legenda usa-se o
          // texto genérico, em vez de tentar adivinhar a partir do ficheiro.
          const cleanName = (image.caption && image.caption.trim()) || 'Peça Única';
          const src = '/media/gallery/' + encodeURI(image.filename);
        %>
          <div class="gallery-item">
            <a
              href="<%= src %>"
              data-lightbox="gallery"
              data-title="<%= cleanName %> - Gonzaga's Art & Shine"
              class="gallery-link"
              style="display: block; width: 100%; height: 100%;"
            >
              <div class="gallery-image-container">
                <img
                  src="<%= src %>"
                  alt="<%= cleanName %>"
                  class="gallery-image"
                  loading="lazy"
                  data-index="<%= index %>"
                >
              </div>
            </a>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="no-images">
        <h3>Coleção em Preparação</h3>
        <p>Novas peças únicas em breve. A elegância está sendo criada com dedicação e arte.</p>
      </div>
    <% } %>
  </div>
</main>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.3/css/lightbox.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.3/js/lightbox-plus-jquery.min.js"></script>
<script>
(function() {
  'use strict';
  
  console.log('Collections gallery initializing...');
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGallery);
  } else {
    initGallery();
  }

  function initGallery() {
    if (typeof lightbox !== 'undefined') {
  lightbox.option({
        'resizeDuration': 400,
    'wrapAround': true,
    'showImageNumberLabel': true,
        'positionFromTop': 100,
    'alwaysShowNavOnTouchDevices': true,
        'fadeDuration': 500,
        'imageFadeDuration': 500,
    'disableScrolling': true,
    'albumLabel': 'Peça %1 de %2',
    'fitImagesInViewport': true,
        'maxWidth': 1600,
        'maxHeight': 1200
      });
    }
    
    const galleryItems = document.querySelectorAll('.gallery-item');
    if (galleryItems.length > 0) {
  const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry, index) => {
      if (entry.isIntersecting) {
            setTimeout(() => {
        entry.target.style.animationPlayState = 'running';
            }, index * 50);
            observer.unobserve(entry.target);
      }
    });
      }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

      galleryItems.forEach(item => observer.observe(item));
    }
}
})();
</script>
