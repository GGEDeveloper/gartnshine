<%- contentFor('style') %>
<style>
  /* Elegant Earth & Shine Theme - Inspired by "A elegância que nasce da terra" */
  :root {
    /* Earth-inspired palette */
    --earth-deep: #2c1810;
    --earth-rich: #3d2818;
    --earth-warm: #4a3326;
    --earth-light: #6b4c3a;
    
    /* Shine & Gold accents */
    --gold-pure: #d4af37;
    --gold-bright: #f4e4a6;
    --gold-soft: #e8c87c;
    --gold-muted: rgba(212, 175, 55, 0.1);
    
    /* Natural tones */
    --stone-light: #f5f2ed;
    --stone-medium: #e8e2d5;
    --stone-dark: #d0c4b0;
    --silver-shine: #c0c0c0;
    
    /* Sophisticated shadows */
    --shadow-earth: 0 8px 32px rgba(44, 24, 16, 0.3);
    --shadow-gold: 0 4px 20px rgba(212, 175, 55, 0.25);
    --shadow-elegant: 0 12px 48px rgba(0, 0, 0, 0.15);
    
    /* Premium transitions */
    --transition-luxury: cubic-bezier(0.23, 1, 0.32, 1);
    --transition-smooth: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  * {
    box-sizing: border-box;
  }

  body {
    font-family: 'Playfair Display', 'Georgia', serif;
    background: linear-gradient(135deg, var(--earth-deep) 0%, var(--earth-rich) 50%, var(--earth-warm) 100%);
    min-height: 100vh;
    margin: 0;
    color: var(--stone-light);
    overflow-x: hidden;
  }

  /* Elegant Page Structure */
  .collection-page {
    min-height: 100vh;
    position: relative;
    padding: 0;
  }

  .collection-page::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      radial-gradient(circle at 20% 30%, var(--gold-muted) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(212, 175, 55, 0.05) 0%, transparent 50%),
      linear-gradient(135deg, var(--earth-deep) 0%, var(--earth-rich) 100%);
    z-index: -1;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 1;
  }

  /* Sophisticated Header */
  .collection-header {
    text-align: center;
    padding: 6rem 0 4rem;
    position: relative;
  }

  .collection-header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 300px;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, var(--gold-pure) 50%, transparent 100%);
  }

  .collection-title h1 {
    font-size: 4rem;
    font-weight: 300;
    letter-spacing: 8px;
    text-transform: uppercase;
    color: var(--gold-pure);
    margin: 0 0 2rem 0;
    position: relative;
    text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.3);
  }

  .collection-subtitle {
    font-size: 1.2rem;
    font-weight: 300;
    font-style: italic;
    color: var(--stone-medium);
    margin-bottom: 3rem;
    letter-spacing: 2px;
    opacity: 0.9;
  }

  .elegant-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 3rem 0;
    opacity: 0.7;
  }

  .elegant-divider::before,
  .elegant-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--gold-soft), transparent);
    max-width: 150px;
  }

  .elegant-divider .ornament {
    width: 40px;
    height: 40px;
    margin: 0 2rem;
    background: radial-gradient(circle, var(--gold-pure), var(--gold-soft));
    border-radius: 50%;
    position: relative;
    box-shadow: var(--shadow-gold);
  }

  .elegant-divider .ornament::before {
    content: '✦';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: var(--earth-deep);
    font-size: 16px;
    animation: sparkle 3s ease-in-out infinite;
  }

  @keyframes sparkle {
    0%, 100% { opacity: 0.8; transform: translate(-50%, -50%) scale(1); }
    50% { opacity: 1; transform: translate(-50%, -50%) scale(1.2); }
  }

  /* Gallery Controls - Refined */
  .gallery-controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 3rem;
    margin: 4rem 0;
    flex-wrap: wrap;
    padding: 2rem;
    background: rgba(61, 40, 24, 0.4);
    backdrop-filter: blur(20px);
    border-radius: 20px;
    border: 1px solid rgba(212, 175, 55, 0.2);
    box-shadow: var(--shadow-earth);
  }

  .view-toggle {
    display: flex;
    background: rgba(44, 24, 16, 0.6);
    border-radius: 25px;
    padding: 6px;
    border: 1px solid rgba(212, 175, 55, 0.3);
    backdrop-filter: blur(10px);
  }

  .view-toggle button {
    background: none;
    border: none;
    color: var(--stone-medium);
    padding: 12px 24px;
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.4s var(--transition-luxury);
    font-size: 14px;
    font-weight: 400;
    font-family: 'Inter', sans-serif;
    letter-spacing: 1px;
  }

  .view-toggle button.active {
    background: linear-gradient(135deg, var(--gold-pure), var(--gold-bright));
    color: var(--earth-deep);
    box-shadow: var(--shadow-gold);
    font-weight: 500;
  }

  .gallery-search {
    position: relative;
    min-width: 300px;
  }

  .gallery-search input {
    width: 100%;
    background: rgba(44, 24, 16, 0.6);
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 25px;
    padding: 14px 20px 14px 50px;
    color: var(--stone-light);
    font-size: 14px;
    font-family: 'Inter', sans-serif;
    transition: all 0.3s var(--transition-smooth);
    backdrop-filter: blur(10px);
  }

  .gallery-search input::placeholder {
    color: var(--stone-dark);
    font-style: italic;
  }

  .gallery-search input:focus {
    outline: none;
    border-color: var(--gold-pure);
    box-shadow: 0 0 0 3px var(--gold-muted);
    background: rgba(44, 24, 16, 0.8);
  }

  .gallery-search .search-icon {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--gold-soft);
    font-size: 16px;
  }

  .sort-select {
    background: rgba(44, 24, 16, 0.6);
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 25px;
    padding: 14px 20px;
    color: var(--stone-light);
    font-size: 14px;
    font-family: 'Inter', sans-serif;
    cursor: pointer;
    transition: all 0.3s var(--transition-smooth);
    backdrop-filter: blur(10px);
  }

  .sort-select:focus {
    outline: none;
    border-color: var(--gold-pure);
    box-shadow: 0 0 0 3px var(--gold-muted);
  }

  /* Gallery Stats */
  .gallery-stats {
    text-align: center;
    margin: 2rem 0 4rem;
    font-family: 'Inter', sans-serif;
    color: var(--stone-medium);
    font-size: 14px;
    letter-spacing: 1px;
  }

  /* Elegant Gallery Grid */
  .gallery-grid {
    display: grid;
    gap: 3rem;
    padding: 2rem 0;
    margin: 0 auto;
    max-width: 1200px;
    transition: all 0.5s var(--transition-luxury);
  }

  .gallery-grid.grid-view {
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }

  .gallery-grid.list-view {
    grid-template-columns: 1fr;
    max-width: 900px;
    gap: 2rem;
  }

  .gallery-grid.masonry-view {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    grid-auto-rows: 10px;
  }

  /* Sophisticated Gallery Items */
  .gallery-item {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: linear-gradient(145deg, rgba(61, 40, 24, 0.3), rgba(75, 51, 38, 0.3));
    backdrop-filter: blur(15px);
    border: 1px solid rgba(212, 175, 55, 0.2);
    transition: all 0.5s var(--transition-luxury);
    cursor: pointer;
    opacity: 0;
    animation: elegantFadeIn 0.8s ease forwards;
  }

  .gallery-item.grid-view {
    aspect-ratio: 1;
  }

  .gallery-item.list-view {
    aspect-ratio: 16/9;
    max-height: 400px;
  }

  .gallery-item.hidden {
    display: none;
  }

  @keyframes elegantFadeIn {
    0% {
      opacity: 0;
      transform: translateY(40px) scale(0.95);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .gallery-item:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 
      var(--shadow-elegant),
      0 0 40px rgba(212, 175, 55, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    border-color: var(--gold-pure);
  }

  .gallery-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      135deg,
      rgba(212, 175, 55, 0.1) 0%,
      transparent 50%,
      rgba(212, 175, 55, 0.05) 100%
    );
    opacity: 0;
    transition: opacity 0.4s var(--transition-smooth);
    z-index: 1;
    border-radius: 16px;
  }

  .gallery-item:hover::before {
    opacity: 1;
  }

  .gallery-image-container {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    border-radius: 16px;
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: all 0.6s var(--transition-luxury);
    filter: brightness(0.9) contrast(1.1) saturate(1.1);
  }

  .gallery-item:hover .gallery-image {
    transform: scale(1.08);
    filter: brightness(1.1) contrast(1.2) saturate(1.2);
  }

  /* Elegant Image Overlay */
  .image-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(
      transparent 0%,
      rgba(44, 24, 16, 0.8) 50%,
      rgba(44, 24, 16, 0.95) 100%
    );
    backdrop-filter: blur(10px);
    color: var(--stone-light);
    padding: 2rem 1.5rem 1.5rem;
    transform: translateY(100%);
    transition: transform 0.4s var(--transition-luxury);
    z-index: 2;
  }

  .gallery-item:hover .image-overlay {
    transform: translateY(0);
  }

  .image-overlay h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.1rem;
    font-weight: 300;
    letter-spacing: 1px;
    color: var(--gold-bright);
  }

  .image-overlay p {
    margin: 0;
    font-size: 0.85rem;
    opacity: 0.8;
    font-family: 'Inter', sans-serif;
    line-height: 1.4;
  }

  /* Luxury Action Button */
  .zoom-trigger {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: rgba(212, 175, 55, 0.9);
    border: none;
    color: var(--earth-deep);
    font-size: 18px;
    cursor: pointer;
    opacity: 0;
    transform: translateY(-10px);
    transition: all 0.4s var(--transition-luxury);
    z-index: 3;
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow-gold);
  }

  .gallery-item:hover .zoom-trigger {
    opacity: 1;
    transform: translateY(0);
  }

  .zoom-trigger:hover {
    background: var(--gold-pure);
    transform: scale(1.1);
    box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4);
  }

  /* Back to Top - Elegant */
  .back-to-top {
    position: fixed;
    bottom: 40px;
    right: 40px;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--gold-pure), var(--gold-bright));
    border: none;
    color: var(--earth-deep);
    font-size: 20px;
    cursor: pointer;
    opacity: 0;
    transform: translateY(100px);
    transition: all 0.4s var(--transition-luxury);
    z-index: 1000;
    box-shadow: var(--shadow-gold);
  }

  .back-to-top.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .back-to-top:hover {
    transform: translateY(-5px) scale(1.1);
    box-shadow: 0 12px 35px rgba(212, 175, 55, 0.5);
  }

  /* No Images State - Elegant */
  .no-images {
    text-align: center;
    padding: 6rem 3rem;
    background: rgba(61, 40, 24, 0.3);
    backdrop-filter: blur(20px);
    border-radius: 20px;
    border: 1px solid rgba(212, 175, 55, 0.2);
    margin: 4rem 0;
    box-shadow: var(--shadow-earth);
  }

  .no-images h3 {
    color: var(--gold-soft);
    font-size: 1.5rem;
    margin-bottom: 1rem;
    font-weight: 300;
  }

  .no-images p {
    color: var(--stone-medium);
    font-size: 1rem;
    margin: 0;
    font-family: 'Inter', sans-serif;
  }

  /* Loading Overlay - Refined */
  .loading-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--earth-deep);
    backdrop-filter: blur(20px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 1;
    transition: opacity 0.5s ease;
  }

  .loading-overlay.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .loading-content {
    text-align: center;
    color: var(--stone-light);
  }

  .loading-spinner {
    width: 60px;
    height: 60px;
    border: 2px solid rgba(212, 175, 55, 0.2);
    border-top: 2px solid var(--gold-pure);
    border-radius: 50%;
    animation: elegantSpin 1.5s ease-in-out infinite;
    margin: 0 auto 2rem;
  }

  .loading-text {
    font-family: 'Playfair Display', serif;
    font-size: 1.2rem;
    letter-spacing: 2px;
    color: var(--gold-soft);
  }

  @keyframes elegantSpin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Enhanced Lightbox */
  .lb-nav a.lb-prev,
  .lb-nav a.lb-next {
    background: linear-gradient(135deg, var(--gold-pure), var(--gold-bright)) !important;
    border-radius: 50% !important;
    width: 70px !important;
    height: 70px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: all 0.3s var(--transition-smooth) !important;
    backdrop-filter: blur(15px) !important;
    box-shadow: var(--shadow-gold) !important;
  }

  .lb-nav a.lb-prev:hover,
  .lb-nav a.lb-next:hover {
    transform: scale(1.1);
    box-shadow: 0 8px 30px rgba(212, 175, 55, 0.6) !important;
  }

  .lb-data .lb-caption {
    background: linear-gradient(135deg, rgba(44, 24, 16, 0.95), rgba(61, 40, 24, 0.95)) !important;
    backdrop-filter: blur(20px) !important;
    border-radius: 15px !important;
    padding: 20px 30px !important;
    margin: 30px auto !important;
    max-width: 700px !important;
    text-align: center !important;
    border: 1px solid rgba(212, 175, 55, 0.3) !important;
    color: var(--stone-light) !important;
    font-family: 'Playfair Display', serif !important;
    font-size: 16px !important;
    letter-spacing: 1px !important;
  }

  /* Responsive Design */
  @media (max-width: 1200px) {
    .gallery-grid.grid-view {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2.5rem;
    }
    
    .collection-title h1 {
      font-size: 3.5rem;
    }
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 1.5rem;
    }

    .collection-header {
      padding: 4rem 0 3rem;
    }

    .collection-title h1 {
      font-size: 2.8rem;
      letter-spacing: 4px;
    }

    .gallery-controls {
      flex-direction: column;
      gap: 1.5rem;
      padding: 1.5rem;
    }

    .gallery-search {
      min-width: auto;
      width: 100%;
    }

    .gallery-grid.grid-view {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
    }

    .back-to-top {
      bottom: 30px;
      right: 30px;
      width: 55px;
      height: 55px;
    }
  }

  @media (max-width: 480px) {
    .collection-title h1 {
      font-size: 2.2rem;
      letter-spacing: 2px;
    }

    .gallery-controls {
      padding: 1rem;
    }

    .gallery-grid.grid-view {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  /* Typography Enhancement */
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap');
</style>

<%- contentFor('body') %>

<!-- Loading Overlay -->
<div class="loading-overlay" id="loadingOverlay">
  <div class="loading-content">
    <div class="loading-spinner"></div>
    <div class="loading-text">A elegância que nasce da terra</div>
  </div>
</div>

<!-- Back to Top Button -->
<button class="back-to-top" id="backToTop" aria-label="Voltar ao topo">
  <i class="fas fa-arrow-up"></i>
</button>

<main class="collection-page">
  <div class="container">
    <!-- Elegant Header -->
    <div class="collection-header">
      <div class="collection-title">
        <h1>Art & Shine</h1>
        <p class="collection-subtitle">A elegância que nasce da terra</p>
        <div class="elegant-divider">
          <div class="ornament"></div>
        </div>
      </div>
    </div>

    <!-- Refined Gallery Controls -->
    <div class="gallery-controls">
      <div class="view-toggle">
        <button class="view-btn active" data-view="grid">
          <i class="fas fa-th"></i> Galeria
        </button>
        <button class="view-btn" data-view="list">
          <i class="fas fa-list"></i> Lista
        </button>
        <button class="view-btn" data-view="masonry">
          <i class="fas fa-columns"></i> Mosaico
        </button>
      </div>

      <div class="gallery-search">
        <i class="fas fa-search search-icon"></i>
        <input type="text" id="imageSearch" placeholder="Pesquisar peças..." autocomplete="off">
      </div>

      <select class="sort-select" id="sortSelect">
        <option value="name-asc">Nome: A-Z</option>
        <option value="name-desc">Nome: Z-A</option>
        <option value="date-new">Mais recentes</option>
        <option value="date-old">Mais antigas</option>
      </select>
    </div>

    <!-- Gallery Stats -->
    <div class="gallery-stats" id="galleryStats">
      <span id="imageCount">0</span> peças de arte encontradas
    </div>
    
    <% if (images && images.length > 0) { %>
      <div class="gallery-grid grid-view" id="galleryGrid">
        <% images.forEach((image, index) => { 
          const imageName = image.filename.replace(/\.[^/.]+$/, '');
          const imageDate = image.date || new Date().toISOString();
        %>
          <div class="gallery-item grid-view" 
               data-name="<%= imageName.toLowerCase() %>" 
               data-date="<%= imageDate %>"
               style="animation-delay: <%= index * 0.15 %>s">
            
            <button class="zoom-trigger" title="Ampliar">
              <i class="fas fa-expand"></i>
            </button>

            <a 
              href="/media/gallery/<%= image.filename %>" 
              data-lightbox="gallery" 
              data-title="<%= imageName %> - Gonzaga's Art & Shine"
              class="gallery-link"
              style="display: block; width: 100%; height: 100%;"
            >
              <div class="gallery-image-container">
                <img 
                  src="/media/gallery/<%= image.filename %>" 
                  alt="<%= imageName %> - Peça única de joalheria artesanal"
                  class="gallery-image" 
                  loading="lazy"
                  data-index="<%= index %>"
                >
              </div>
              
              <div class="image-overlay">
                <h3><%= imageName %></h3>
                <p>Peça única • Joalheria artesanal • Sterling Silver</p>
              </div>
            </a>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="no-images">
        <h3>Coleção em preparação</h3>
        <p>Novas peças únicas em breve. A elegância está sendo criada.</p>
      </div>
    <% } %>
  </div>
</main>

<%- contentFor('script') %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.3/js/lightbox-plus-jquery.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  initElegantGallery();
});

function initElegantGallery() {
  // DOM Elements
  const loadingOverlay = document.getElementById('loadingOverlay');
  const backToTop = document.getElementById('backToTop');
  const galleryGrid = document.getElementById('galleryGrid');
  const viewButtons = document.querySelectorAll('.view-btn');
  const searchInput = document.getElementById('imageSearch');
  const sortSelect = document.getElementById('sortSelect');
  const imageCount = document.getElementById('imageCount');
  
  let currentView = 'grid';
  let allImages = Array.from(document.querySelectorAll('.gallery-item'));
  let filteredImages = [...allImages];

  // Elegant loading sequence
  setTimeout(() => {
    loadingOverlay.classList.add('hidden');
  }, 1200);

  // Update initial count
  updateImageCount();

  // Smooth scroll detection for back-to-top
  let scrollTimeout;
  window.addEventListener('scroll', () => {
    clearTimeout(scrollTimeout);
    scrollTimeout = setTimeout(() => {
      if (window.scrollY > 400) {
        backToTop.classList.add('visible');
      } else {
        backToTop.classList.remove('visible');
      }
    }, 10);
  });

  backToTop.addEventListener('click', () => {
    window.scrollTo({ 
      top: 0, 
      behavior: 'smooth' 
    });
  });

  // View switching with elegant transitions
  viewButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const view = btn.dataset.view;
      switchView(view);
      
      viewButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    });
  });

  // Enhanced search with debouncing
  searchInput.addEventListener('input', debounce(handleSearch, 400));
  sortSelect.addEventListener('change', handleSort);

  // Luxury lightbox configuration
  lightbox.option({
    'resizeDuration': 300,
    'wrapAround': true,
    'showImageNumberLabel': true,
    'positionFromTop': 80,
    'alwaysShowNavOnTouchDevices': true,
    'fadeDuration': 400,
    'imageFadeDuration': 400,
    'disableScrolling': true,
    'albumLabel': 'Peça %1 de %2',
    'fitImagesInViewport': true,
    'maxWidth': 1400,
    'maxHeight': 900
  });

  // Functions
  function switchView(view) {
    currentView = view;
    
    // Elegant transition
    galleryGrid.style.opacity = '0.7';
    galleryGrid.style.transform = 'translateY(20px)';
    
    setTimeout(() => {
      galleryGrid.className = `gallery-grid ${view}-view`;
      
      allImages.forEach(item => {
        item.className = `gallery-item ${view}-view`;
        if (!filteredImages.includes(item)) {
          item.classList.add('hidden');
        }
      });
      
      galleryGrid.style.opacity = '1';
      galleryGrid.style.transform = 'translateY(0)';
      
      // Stagger animation
      filteredImages.forEach((item, index) => {
        if (!item.classList.contains('hidden')) {
          item.style.animationDelay = `${index * 0.1}s`;
          item.style.animation = 'none';
          requestAnimationFrame(() => {
            item.style.animation = 'elegantFadeIn 0.8s ease forwards';
          });
        }
      });
    }, 200);
  }

  function handleSearch() {
    const query = searchInput.value.toLowerCase().trim();
    
    if (query === '') {
      filteredImages = [...allImages];
    } else {
      filteredImages = allImages.filter(item => {
        const name = item.dataset.name || '';
        return name.includes(query);
      });
    }
    
    updateDisplay();
    updateImageCount();
  }

  function handleSort() {
    const sortType = sortSelect.value;
    
    filteredImages.sort((a, b) => {
      switch (sortType) {
        case 'name-asc':
          return a.dataset.name.localeCompare(b.dataset.name);
        case 'name-desc':
          return b.dataset.name.localeCompare(a.dataset.name);
        case 'date-new':
          return new Date(b.dataset.date) - new Date(a.dataset.date);
        case 'date-old':
          return new Date(a.dataset.date) - new Date(b.dataset.date);
        default:
          return 0;
      }
    });
    
    updateDisplay();
  }

  function updateDisplay() {
    // Smooth hide animation
    allImages.forEach(item => {
      if (!filteredImages.includes(item)) {
        item.style.opacity = '0';
        item.style.transform = 'translateY(20px)';
        setTimeout(() => {
          item.classList.add('hidden');
        }, 300);
      }
    });
    
    // Smooth show animation
    setTimeout(() => {
      filteredImages.forEach((item, index) => {
        item.classList.remove('hidden');
        item.style.order = index;
        item.style.animationDelay = `${index * 0.1}s`;
        
        requestAnimationFrame(() => {
          item.style.opacity = '1';
          item.style.transform = 'translateY(0)';
        });
      });
    }, 350);
  }

  function updateImageCount() {
    imageCount.textContent = filteredImages.length;
  }

  function debounce(func, wait) {
    let timeout;
    return function executedFunction(...args) {
      const later = () => {
        clearTimeout(timeout);
        func(...args);
      };
      clearTimeout(timeout);
      timeout = setTimeout(later, wait);
    };
  }

  // Intersection observer for smooth entrance animations
  const observerOptions = {
    threshold: 0.2,
    rootMargin: '0px 0px -100px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.animationPlayState = 'running';
      }
    });
  }, observerOptions);

  allImages.forEach(item => {
    observer.observe(item);
  });
}
</script>
