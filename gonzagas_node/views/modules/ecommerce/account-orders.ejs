<div class="container py-4">
  <h1>Os meus pedidos</h1>
  <p><a href="/account/logout">Terminar sessão</a></p>

  <% if (!orders.length) { %>
    <p class="text-muted">Ainda não tem pedidos.</p>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-striped">
        <thead>
          <tr><th>Nº</th><th>Total</th><th>Estado</th><th>Data</th></tr>
        </thead>
        <tbody>
          <% orders.forEach(function(o) { %>
            <tr>
              <td><%= o.order_number %></td>
              <td>€<%= parseFloat(o.total_amount).toFixed(2) %></td>
              <td><%= o.status %> / <%= o.payment_status %></td>
              <td><%= new Date(o.created_at).toLocaleDateString('pt-PT') %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
