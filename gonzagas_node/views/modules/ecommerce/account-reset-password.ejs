<link rel="stylesheet" href="/ecommerce/css/account.css">

<section class="account-page">
  <div class="container account-form-wrap">
    <h1>Definir password nova</h1>
    <p class="account-subtitle">Escolha uma password com pelo menos 6 caracteres.</p>

    <% if (messages && messages.error && messages.error.length) { %>
      <div class="account-alert account-alert--error"><%= messages.error[0] %></div>
    <% } %>

    <form method="post" action="/account/reset-password/<%= token %>">
      <div class="mb-3">
        <label class="form-label" for="reset-password">Password nova</label>
        <input type="password" id="reset-password" name="password" class="form-control" required minlength="6" autocomplete="new-password">
      </div>
      <div class="mb-3">
        <label class="form-label" for="reset-password-confirm">Confirmar password</label>
        <input type="password" id="reset-password-confirm" name="confirmPassword" class="form-control" required minlength="6" autocomplete="new-password">
      </div>
      <button type="submit" class="btn btn-primary w-100">Guardar e entrar</button>
    </form>

    <p class="account-footer-link">
      <a href="/account/login">Voltar a entrar</a>
    </p>
  </div>
</section>
