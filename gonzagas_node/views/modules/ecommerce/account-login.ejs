<style>
.ecommerce-account-wrap { max-width: 420px; margin: 0 auto; padding: 3rem 0 4rem; }
.ecommerce-account-wrap h1 {
  color: var(--igp-cream, #f0ece4);
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 1.85rem;
  font-weight: 300;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  margin-bottom: 2rem;
}
.ecommerce-account-wrap h1::after {
  content: '';
  display: block;
  width: 36px;
  height: 1px;
  background: var(--igp-gold, #c9a84c);
  margin: 0.65rem 0 0;
  opacity: 0.7;
}
.ecommerce-account-wrap p a { color: var(--igp-gold, #c9a84c); text-decoration: none; }
.ecommerce-account-wrap p a:hover { color: #e0bc5a; text-decoration: underline; }
.oauth-divider {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin: 1.5rem 0;
  color: var(--igp-muted, rgba(240,236,228,0.45));
  font-size: 0.8rem;
}
.oauth-divider::before, .oauth-divider::after {
  content: '';
  flex: 1;
  height: 1px;
  background: rgba(240,236,228,0.15);
}
.btn-google {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  width: 100%;
  padding: 0.6rem 1rem;
  background: #fff;
  color: #3c4043;
  border: 1px solid rgba(255,255,255,0.25);
  border-radius: 4px;
  font-size: 0.92rem;
  font-weight: 500;
  text-decoration: none;
  transition: box-shadow 0.2s, background 0.2s;
}
.btn-google:hover {
  background: #f5f5f5;
  box-shadow: 0 2px 8px rgba(0,0,0,0.35);
  color: #111;
  text-decoration: none;
}
.btn-google svg { flex-shrink: 0; }
</style>

<div class="ecommerce-account-wrap container">
  <h1>Entrar</h1>
  <% if (messages && messages.error && messages.error.length) { %>
    <div class="alert alert-danger"><%= messages.error[0] %></div>
  <% } %>

  <!-- Google OAuth -->
  <a href="/account/auth/google<% if (typeof returnTo !== 'undefined' && returnTo) { %>?returnTo=<%= encodeURIComponent(returnTo) %><% } %>" class="btn-google">
    <svg width="18" height="18" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
      <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
      <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
      <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
      <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.36-8.16 2.36-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
    </svg>
    Entrar com Google
  </a>

  <div class="oauth-divider">ou</div>

  <form method="post" action="/account/login">
    <% if (typeof returnTo !== 'undefined' && returnTo) { %>
      <input type="hidden" name="returnTo" value="<%= returnTo %>">
    <% } %>
    <div class="mb-3">
      <label class="form-label">Email</label>
      <input type="email" name="email" class="form-control" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Password</label>
      <input type="password" name="password" class="form-control" required>
    </div>
    <button type="submit" class="btn btn-primary w-100">Entrar</button>
  </form>
  <p class="mt-3" style="color: var(--igp-muted, rgba(240,236,228,0.55)); font-size:0.9rem;">
    <a href="/account/register">Criar conta</a>
  </p>
</div>
