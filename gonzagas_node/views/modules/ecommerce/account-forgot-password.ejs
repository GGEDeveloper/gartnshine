<link rel="stylesheet" href="/ecommerce/css/account.css">

<section class="account-page">
  <div class="container account-form-wrap">
    <h1>Recuperar password</h1>
    <p class="account-subtitle">Escreva o seu email e enviamos um link para definir uma password nova.</p>

    <% if (messages && messages.error && messages.error.length) { %>
      <div class="account-alert account-alert--error"><%= messages.error[0] %></div>
    <% } %>
    <% if (messages && messages.success && messages.success.length) { %>
      <div class="account-alert account-alert--success"><%= messages.success[0] %></div>
    <% } %>

    <% if (!mailerReady) { %>
      <div class="account-alert account-alert--error">
        O envio de emails ainda não está activo. Contacte-nos por WhatsApp e resolvemos a sua conta.
      </div>
    <% } %>

    <form method="post" action="/account/forgot-password">
      <div class="mb-3">
        <label class="form-label" for="forgot-email">Email</label>
        <input type="email" id="forgot-email" name="email" class="form-control" required autocomplete="email" <%= mailerReady ? '' : 'disabled' %>>
      </div>
      <button type="submit" class="btn btn-primary w-100" <%= mailerReady ? '' : 'disabled' %>>Enviar link</button>
    </form>

    <p class="account-footer-link">
      Criou a conta com Google? <a href="/account/login">Entre com Google</a> — não precisa de password.
    </p>

    <p class="account-footer-link">
      <a href="/account/login">Voltar a entrar</a>
    </p>
  </div>
</section>
