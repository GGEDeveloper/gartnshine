<!-- Back to Top Button -->
<button class="back-to-top" type="button" aria-label="Voltar ao topo" title="Voltar ao topo">
    <span class="back-to-top__icon" aria-hidden="true">↑</span>
</button>

<!-- JavaScript para Footer -->
<script>
(function() {
    'use strict';
    
    // Newsletter form submission
    const newsletterForm = document.querySelector('.newsletter-form');
    if (newsletterForm) {
        newsletterForm.addEventListener('submit', function(e) {
            e.preventDefault();
            
            const email = this.querySelector('input[name="email"]').value;
            const submitButton = this.querySelector('.newsletter-submit');
            
            // Basic email validation
            if (!email || !email.includes('@')) {
                alert('Por favor, insere um email válido.');
                return;
            }
            
            // Disable submit button
            submitButton.disabled = true;
            submitButton.querySelector('.newsletter-submit__text').textContent = 'A subscrever...';
            
            // Simulate API call (replace with actual implementation)
            setTimeout(() => {
                submitButton.querySelector('.newsletter-submit__text').textContent = 'Subscrito!';
                
                setTimeout(() => {
                    submitButton.disabled = false;
                    submitButton.querySelector('.newsletter-submit__text').textContent = 'Subscrever';
                    this.reset();
                }, 2000);
            }, 1000);
            
            // Analytics tracking
            if (typeof gtag !== 'undefined') {
                gtag('event', 'newsletter_signup', {
                    method: 'footer_form',
                    email_domain: email.split('@')[1]
                });
            }
        });
    }
    
    // Back to top functionality
    const backToTopButton = document.querySelector('.back-to-top');
    if (backToTopButton) {
        // Show/hide based on scroll position
        function toggleBackToTopButton() {
            if (window.scrollY > 500) {
                backToTopButton.classList.add('back-to-top--visible');
            } else {
                backToTopButton.classList.remove('back-to-top--visible');
            }
        }
        
        window.addEventListener('scroll', toggleBackToTopButton, { passive: true });
        
        // Smooth scroll to top
        backToTopButton.addEventListener('click', function() {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
            
            // Analytics tracking
            if (typeof gtag !== 'undefined') {
                gtag('event', 'back_to_top_click');
            }
        });
        
        // Initial check
        toggleBackToTopButton();
    }
    
    // Footer link analytics tracking
    document.querySelectorAll('.footer-nav-link, .footer-collection__link, .contact-method, .social-link').forEach(link => {
        link.addEventListener('click', function() {
            const linkText = this.textContent.trim();
            const linkUrl = this.href;
            const section = this.closest('.site-footer__section')?.className.includes('collections') ? 'collections' : 
                           this.closest('.site-footer__section')?.className.includes('navigation') ? 'navigation' :
                           this.closest('.site-footer__section')?.className.includes('contact') ? 'contact' : 'footer';
            
            if (typeof gtag !== 'undefined') {
                gtag('event', 'footer_link_click', {
                    link_text: linkText,
                    link_url: linkUrl,
                    footer_section: section
                });
            }
        });
    });
    
    // Intersection Observer for footer entrance animation
    if ('IntersectionObserver' in window) {
        const footerObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('site-footer--visible');
                }
            });
        }, {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        });
        
        const footer = document.querySelector('.site-footer');
        if (footer) {
            footerObserver.observe(footer);
        }
    }
    
})();
</script>

