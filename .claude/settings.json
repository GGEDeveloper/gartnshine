{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "docs/memoria/bin/hook-sessao.sh inicio",
            "timeout": 20,
            "statusMessage": "A ler a memória do projeto…"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "docs/memoria/bin/hook-sessao.sh fim",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "docs/memoria/bin/hook-sessao.sh reindexar",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ]
  }
}
